},[239,240],"mx-auto","max-w-3xl",[242,243],"component-example",{"name":244},"home-form",[197,246,247,250],{},[170,248,249],{"v-slot:title":162},"它幫你處理了哪些事",[170,251,252,262,280,288,296,308],{"v-slot:features":162},[253,254,256,259],"u-page-feature",{"icon":255},"i-lucide-layers",[170,257,258],{"v-slot:title":162},"沿用 Nuxt UI",[170,260,261],{"v-slot:description":162},"沒有另外宣告的 Nuxt UI 參數、插槽與 ref 都能直接使用，型別也會一併推導。",[253,263,265,268],{"icon":264},"i-lucide-scan-line",[170,266,267],{"v-slot:title":162},"一致的狀態",[170,269,270,271,275,276,279],{"v-slot:description":162},"尺寸、停用、載入中與骨架在每個表單元件上的行為都相同，並會跟著 ",[272,273,274],"code",{},"UFormField","、",[272,277,278],{},"UForm"," 走。",[253,281,282,285],{"icon":49},[170,283,284],{"v-slot:title":162},"繁體中文預設",[170,286,287],{"v-slot:description":162},"驗證訊息、提示文字與無障礙標籤預設為繁體中文，需要時可在模組設定覆寫。",[253,289,290,293],{"icon":34},[170,291,292],{"v-slot:title":162},"共用驗證規則",[170,294,295],{"v-slot:description":162},"常用的必填、數字等 Valibot 規則已經寫好並自動匯入，錯誤訊息格式全站一致。",[253,297,298,301],{"icon":54},[170,299,300],{"v-slot:title":162},"全站預設值",[170,302,303,304,307],{"v-slot:description":162},"尺寸、顯示格式、圖示等可在 ",[272,305,306],{},"nuxt.config.ts"," 統一設定，元件上明確傳入的值仍然優先。",[253,309,310,313],{"icon":44},[170,311,312],{"v-slot:title":162},"樣式交給專案",[170,314,315],{"v-slot:description":162},"使用 Nuxt UI 的語意色與 CSS 變數，顏色和主題由使用的專案決定，不會被元件庫綁死。",[197,317,318,321,324],{},[170,319,320],{"v-slot:title":162},"有哪些元件",[170,322,323],{"v-slot:description":162},"目前共 15 個元件，大致分成下面幾類。每個元件頁都有可操作的範例和完整參數表。",[206,325,329,333,337,341,345,350],{"className":326},[209,210,327,328],"sm:grid-cols-2","lg:grid-cols-3",[213,330,332],{"icon":75,"title":331,"to":72},"文字與數字","ShuoInputText、ShuoInputNumber、ShuoTextarea",[213,334,336],{"icon":117,"title":335,"to":90},"選擇","ShuoSelectMenu、ShuoCheckbox、ShuoRadioGroup、ShuoCheckboxGroup",[213,338,340],{"icon":99,"title":339,"to":96},"日期與期間","ShuoDatepicker、ShuoMonths",[213,342,344],{"icon":135,"title":343,"to":132},"電話與附件","ShuoPhone、ShuoFile",[213,346,349],{"icon":347,"title":348,"to":138},"i-lucide-layout-list","查詢頁版面","ShuoQueryCard、ShuoListCard、ShuoTable",[213,351,353],{"icon":159,"title":352,"to":156},"輔助說明","ShuoInfoTooltip",[197,355,356,359,362],{},[170,357,358],{"v-slot:title":162},"一起維護",[170,360,361],{"v-slot:description":162},"這個模組是為了多個專案共用而做的，所以新增功能時會先想：這是不是大部分專案都會遇到的需求？只有單一專案用得到的特殊行為，建議留在該專案內，透過 Nuxt UI 原本的參數或插槽處理，讓元件庫保持簡單、好維護。",[170,363,364],{"v-slot:links":162},[187,365,366],{"to":22,"color":193,"trailing-icon":190,"variant":194},"從第一個表單開始",{"title":162,"searchDepth":368,"depth":368,"links":369},2,[],"md",{},true,"\u002F",{"title":375,"description":376},"基於 Nuxt UI 的表單元件庫","基於 Nuxt UI 的表單元件庫，以 Nuxt Module 提供。","index","QveF6h6v5ISK8h5bJ3sn5FvkkjOpf3e7IuSAJAZ9nak",1792887856072]