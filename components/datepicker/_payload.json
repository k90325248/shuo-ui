期時間範圍","：先選完兩個日期，再切換到起迄時間面板，兩端的時間都可即時修改。",[330,711,712,713,180,716,481],{},"單選切換為範圍時清空並等待完整選擇；關閉範圍時保留起日作為單選值，並清空 ",[169,714,715],{},"start",[169,717,718],{},"end",[196,720,721],{"id":721},"鍵盤操作",[166,723,724],{},"開啟選單時焦點移到已選日期（或年份、月份），未選取時移到第一個可選項目。方向鍵移動焦點，Enter 選取，Esc 關閉；選單關閉時若焦點仍在選單內，回到輸入框。選單 teleport 至 body，無法以 Tab 進入。",[196,726,727],{"id":727},"日曆顯示",[166,729,730],{},"日曆以週日為每週第一天，固定顯示六週；前後月份的日期以較淡文字呈現。換月使用透明度過場，避免水平位移產生捲軸。",[192,732,189],{"id":189},[210,734,735,747],{},[213,736,737],{},[216,738,739,741,744],{},[219,740,189],{},[219,742,743],{},"型別",[219,745,746],{},"說明",[230,748,749,772,787],{},[216,750,751,755,764],{},[235,752,753],{},[169,754,189],{},[235,756,757,758,761,762],{},"單選 ",[169,759,760],{},"string","；範圍 ",[169,763,175],{},[235,765,766,767,769,770,481],{},"永遠使用西元字串，範圍以起迄陣列表示；單選空值 ",[169,768,335],{},"，範圍空值 ",[169,771,444],{},[216,773,774,778,782],{},[235,775,776],{},[169,777,179],{},[235,779,780],{},[169,781,760],{},[235,783,784,785,481],{},"範圍起日，可獨立回填，非範圍時為 ",[169,786,335],{},[216,788,789,793,797],{},[235,790,791],{},[169,792,183],{},[235,794,795],{},[169,796,760],{},[235,798,799,800,481],{},"範圍迄日，可獨立回填，尚無完整範圍或非範圍時為 ",[169,801,335],{},[192,803,805],{"id":804},"props","Props",[807,808],"component-props",{":exclude":809,"name":579},"[\"start\", \"end\"]",[166,811,812,180,815,180,818,180,821,180,824,180,827,830,831,481,834,180,836,180,839,180,842,180,844,180,846,849,850,481],{},[169,813,814],{},"size",[169,816,817],{},"disabled",[169,819,820],{},"loading",[169,822,823],{},"skeleton",[169,825,826],{},"id",[169,828,829],{},"name"," 的行為見",[186,832,66],{"href":833},"\u002Fcomponents\u002Fcommon#%E5%85%B1%E7%94%A8%E5%8F%83%E6%95%B8",[169,835,547],{},[169,837,838],{},"calendarIcon",[169,840,841],{},"clearIcon",[169,843,356],{},[169,845,360],{},[169,847,848],{},"yearRange"," 可在全站設定預設值，見",[186,851,853],{"href":852},"\u002Fguides\u002Fcomponent-defaults#%E5%8F%AF%E8%A8%AD%E5%AE%9A%E7%9A%84%E9%A0%85%E7%9B%AE","可設定的項目",[855,856,857,858,861,862,180,865,180,868,180