0,311],{},"roc"," 只切換顯示，不改寫綁定值；",[136,314,315],{},"separator"," 只影響綁定值，顯示仍為斜線。",[270,318],{"name":319},"datepicker-roc",[321,322,323,324,326,327,329,330,333,334,337,338,341,342,326,344,337,346,348],"warning",{},"父層傳入（掛載時或之後回填）不符合目前 ",[136,325,152],{},"、",[136,328,315],{}," 的格式、型別錯誤、民國下限之前的日期，或範圍起日晚於迄日時，元件會清空綁定值，並以 ",[136,331,332],{},"console.warn"," 留下 ",[136,335,336],{},"[ShuoDatepicker] modelValue 格式不符，已清空："," 或 ",[136,339,340],{},"起迄相反"," 紀錄。切換 ",[136,343,152],{},[136,345,311],{},[136,347,315],{}," 後，若既有值不符合新設定，同樣會清空並警告；請同時回填符合新設定的值。",[132,350,351,352,355,356,326,359,362],{},"同一輪清空只送出一次 ",[136,353,354],{},"update:modelValue","（或 ",[136,357,358],{},"update:start",[136,360,361],{},"update:end","）事件；起迄相反時不會先同步出排序後的暫時值。",[145,364,365],{"id":365},"範圍綁定",[132,367,368,369,372],{},"主陣列與獨立起迄同步，方便對接不同 API。只會提交完整起迄陣列或 ",[136,370,371],{},"[]","，不回傳半個範圍。",[270,374],{"name":375},"datepicker-range",[274,377,378,384,409,412],{},[277,379,380,381,383],{},"初始化同時提供兩種綁定時，以主 ",[136,382,174],{}," 為準；之後可由父層更新主值或起迄。",[277,385,386,387,389,390,392,393,337,396,399,400,402,403,405,406,408],{},"清空時主值為 ",[136,388,371],{},"，起迄為 ",[136,391,285],{},"。父層綁定 ",[136,394,395],{},"null",[136,397,398],{},"undefined"," 時，元件回寫為單選 ",[136,401,285],{},"、範圍 ",[136,404,371],{},"、起迄 ",[136,407,285],{},"。",[277,410,411],{},"只綁起迄時允許分次回填，單邊格式不符只清空該端，兩端皆有值但起日晚於迄日則兩端都清空。",[277,413,414,415,418],{},"不需要主陣列時，可以只寫 ",[136,416,417],{},"\u003CShuoDatepicker v-model:start=\"start\" v-model:end=\"end\" range \u002F>","。迄日須配合起日使用，元件不將單獨迄日視為完整範圍。",[141,420,421],{"id":421},"選取流程",[274,423,424,431,439,445,451],{},[277,425,426,430],{},[427,428,429],"strong",{},"年、年月、日期","：選取即套用並關閉選單，不再顯示確認／取消按鈕。",[277,432,433,436,437,408],{},[427,434,435],{},"範圍","：僅選起日時保留草稿，父層三個綁定值維持原值；起迄皆選完才一次提交並關閉。中途點外面、按 Esc 或關閉選單，捨棄草稿並恢復上次完整範圍；原本為空值則保持 ",[136,438,371],{},[277,440,441,444],{},[427,442,443],{},"日期時分／秒","：選取日期後，立即帶入完整日期時間並切到時間面板；時間沿用既有值，空值以套件初始化的本地目前時間為準。調整時間即更新，點外面關閉即可保留。",[277,446,447,450],{},[427,448,449],{},"日期時間範圍","：先選完兩個日期，再切換到起迄時間面板，兩端的時間都可即時修改。",[277,452,453,454,326,457,408],{},"單選切換為範圍時清空並等待完整選擇；關閉範圍時保留起日作為單選值，並清空 ",[136,455,456],{},"start",[136,458,459],{},"end",[141,461,462],{"id":462},"鍵盤操作",[132,464,465],{},"開啟選單時焦點移到已選日期（或年份、月份），未選取時移到第一個可選項目。方向鍵移動焦點，Enter 選取，Esc 關閉；選單關閉時若焦點仍在選單內，回到輸入框。選單 teleport 至 body，無法以 Tab 進入。",[141,467,468],{"id":468},"日曆顯示",[132,470,471],{},"日曆以週日為每週第一天，固定顯示六週；前後月份的日期以較淡文字呈現。換月使用透明度過場，避免水平位移產生捲軸。",[141,473,174],{"id":174},[155,475,476,488],{},[158,477,478],{},[161,479,480,482,485],{},[164,481,174],{},[164,483,484],{},"型別",[164,486,487],{},"說明",[176,489,490,514,530],{},[161,491,492,496,506],{},[181,493,494],{},[136,495,174],{},[181,497,498,499,502,503],{},"單選 ",[136,500,501],{},"string","；範圍 ",[136,504,505],{},"[string, string] | []",[181,507,508,509,511,512,408],{},"永遠使用西元字串，範圍以起迄陣列表示；單選空值 ",[136,510,285],{},"，範圍空值 ",[136,513,371],{},[161,515,516,521,525],{},[181,517,518],{},[136,519,520],{},"v-model:start",[181,522,523],{},[136,524,501],{},[181,526,527,528,408],{},"範圍起日，可獨立回填，非範圍時為 ",[136,529,285],{},[161,531,532,537,541],{},[181,533,534],{},[136,535,536],{},"v-model:end",[181,538,539],{},[136,540,501],{},[181,542,543,544,408],{},"範圍迄日，可獨立回填，尚無完整範圍或非範圍時為 ",[136,545,285],{},[141,547,549],{"id":548},"props","Props",[551,552],"component-props",{":exclude":553,"name":554},"[\"start\", \"end\"]","ShuoDatepicker",[556,557,558,559,562,563,326,566,569,570,573,574,576,577,326,580,583,584,326,587,326,590,326,593,326,596,599],"note",{},"元件只開放上表的參數，不繼承 ",[136,560,561],{},"@vuepic\u002Fvue-datepicker"," 的全部 props。",[136,564,565],{},"class",[136,567,568],{},"style"," 等 HTML attributes 套用在外層容器，不會透傳到日期套件。外層內建 ",[136,571,572],{},"w-full min-w-0","，",[136,575,565],{}," 與其合併且衝突時優先，可覆寫寬度與最小寬度（例如 ",[136,578,579],{},"class=\"w-40\"",[136,581,582],{},"class=\"min-w-20\"","）；",[136,585,586],{},"auto-apply",[136,588,589],{},"flow",[136,591,592],{},"config",[136,594,595],{},"formats",[136,597,598],{},"model-type"," 等由元件內部統一管理。",[141,601,603],{"id":602},"與-uform-搭配","與 UForm 搭配",[132,605,606