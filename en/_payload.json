on":12,"path":275,"stem":276,"children":277,"page":12},"Versions","\u002Fen\u002Freleases\u002Fversions","en\u002F5.releases\u002F1.versions",[278],{"title":279,"path":280,"stem":281},"v3.0.0","\u002Fen\u002Freleases\u002Fversions\u002Fv3-0-0","en\u002F5.releases\u002F1.versions\u002F1.v3-0-0",{"id":283,"title":284,"body":285,"description":284,"extension":494,"meta":495,"navigation":496,"path":497,"seo":498,"stem":501,"__hash__":502},"landing_en\u002Fen\u002Findex.md","",{"type":286,"value":287,"toc":491},"minimark",[288,320,352,369,440,477],[289,290,291,295,305],"u-page-hero",{},[292,293,294],"template",{"v-slot:title":284},"Shuo UI",[292,296,297,304],{"v-slot:description":284},[298,299,303],"a",{"href":300,"rel":301},"https:\u002F\u002Fui.nuxt.com",[302],"nofollow","Nuxt UI"," components shaped around the way our projects build forms. Masking, thousands separators, ROC dates, query cards and other features that every project used to implement on its own now live in one module, so everyone uses the same set and fixes only need to happen in one place.",[292,306,307,314],{"v-slot:links":284},[308,309,313],"u-button",{"to":310,"size":311,"trailing-icon":312},"\u002Fgetting-started\u002Foverview\u002Finstallation","xl","i-lucide-arrow-right","Get started",[308,315,319],{"to":316,"color":317,"size":311,"variant":318},"\u002Fgetting-started\u002Foverview\u002Fintroduction","neutral","subtle","Learn more",[321,322,323,326,329],"u-page-section",{},[292,324,325],{"v-slot:title":284},"Why this module",[292,327,328],{"v-slot:description":284},"Each project used to write its own set of form components: ID numbers need masking, amounts need thousands separators, dates need ROC years, and query pages need a collapsible filter section. The features were much the same, but the code, prop names and details all differed, so fixing one issue meant changing every project.",[330,331,336,342,347],"div",{"className":332},[333,334,335],"grid","gap-6","md:grid-cols-3",[337,338,341],"u-page-card",{"icon":339,"title":340},"i-lucide-copy-check","Consistent usage","The same need uses the same component and props, so switching projects or picking up someone else's code takes no relearning.",[337,343,346],{"icon":344,"title":345},"i-lucide-wrench","Maintained in one place","Fix an issue once and every project gets it by updating the version, with no more copy and paste.",[337,348,351],{"icon":349,"title":350},"i-lucide-feather","No reinventing","Every component is built on Nuxt UI and only adds what we commonly need; for everything else, follow the Nuxt UI docs.",[321,353,354,357,360],{},[292,355,356],{"v-slot:title":284},"See it in action",[292,358,359],{"v-slot:description":284},"Below is a set of fields you can actually use. Turn on the switch to see each component's skeleton while data is loading; turn it off and everything you entered is still there.",[330,361,365],{"className":362},[363,364],"mx-auto","max-w-3xl",[366,367],"component-example",{"name":368},"home-form",[321,370,371,374],{},[292,372,373],{"v-slot:title":284},"What it takes care of",[292,375,376,386,404,412,420,432],{"v-slot:features":284},[377,378,380,383],"u-page-feature",{"icon":379},"i-lucide-layers",[292,381,382],{"v-slot:title":284},"Built on Nuxt UI",[292,384,385],{"v-slot:description":284},"Nuxt UI props, slots and refs that are not redeclared can be used directly, with full type inference.",[377,387,389,392],{"icon":388},"i-lucide-scan-line",[292,390,391],{"v-slot:title":284},"Consistent states",[292,393,394,395,399,400,403],{"v-slot:description":284},"Size, disabled, loading and skeleton behave the same on every form component, and follow ",[396,397,398],"code",{},"UFormField"," and ",[396,401,402],{},"UForm",".",[377,405,406,409],{"icon":50},[292,407,408],{"v-slot:title":284},"Traditional Chinese and English",[292,410,411],{"v-slot:description":284},"Validation messages, tooltips and accessible labels default to Traditional Chinese, follow the Nuxt UI locale with English built in, and can be overridden in the module options.",[377,413,414,417],{"icon":65},[292,415,416],{"v-slot:title":284},"Shared validation rules",[292,418,419],{"v-slot:description":284},"Common Valibot rules for required fields, numbers and more are ready and auto-imported, with consistent error messages across the site.",[377,421,422,425],{"icon":45},[292,423,424],{"v-slot:title":284},"Site-wide defaults",[292,426,427,428,431],{"v-slot:description":284},"Size, display format, icons and more can be set once in ",[396,429,430],{},"nuxt.config.ts",", while values passed explicitly on a component still win.",[377,433,434,437],{"icon":40},[292,435,436],{"v-slot:title":284},"Styling stays with your project",[292,438,439],{"v-slot:description":284},"Built on Nuxt UI semantic colors and CSS variables, so colors and themes are decided by your project, not locked in by the library.",[321,441,442,444,447],{},[292,443,92],{"v-slot:title":284},[292,445,446],{"v-slot:description":284},"There are 16 components, roughly grouped as below. Every component page has live examples and a full props table.",[330,448,452,456,460,464,468,473],{"className":449},[333,334,450,451],"sm:grid-cols-2","lg:grid-cols-3",[337,453,455],{"icon":115,"title":107,"to":454},"\u002Fcomponents\u002Ftext\u002Finput-text","ShuoInputText, ShuoInputNumber, ShuoTextarea",[337,457,459],{"icon":150,"title":127,"to":458},"\u002Fcomponents\u002Fchoice\u002Fselect-menu","ShuoSelectMenu, ShuoCheckbox, ShuoRadioGroup, ShuoCheckboxGroup, ShuoSwitch",[337,461,463],{"icon":165,"title":157,"to":462},"\u002Fcomponents\u002Fdate\u002Fdatepicker","ShuoDatepicker, ShuoMonths",[337,465,467],{"icon":180,"title":172,"to":466},"\u002Fcomponents\u002Fphone-file\u002Fphone","ShuoPhone, ShuoFile",[337,469,472],{"icon":470,"title":187,"to":471},"i-lucide-layout-list","\u002Fcomponents\u002Flayout\u002Fquery-card","ShuoQueryCard, ShuoListCard, ShuoTable",[337,474,476],{"icon":215,"title":207,"to":475},"\u002Fcomponents\u002Fhelper\u002Finfo-tooltip","ShuoInfoTooltip, ShuoTooltip",[321,478,479,482,485],{},[292,480,481],{"v-slot:title":284},"Maintained together",[292,483,484],{"v-slot:description":284},"This module exists to be shared by many projects, so before adding a feature we ask: is this something most projects need? Special behavior that only one project needs is best kept in that project, handled through Nuxt UI's own props or slots, so the library stays simple and easy to maintain.",[292,486,487],{"v-slot:links":284},[308,488,490],{"to":489,"color":317,"trailing-icon":312,"variant":318},"\u002Fgetting-started\u002Foverview\u002Fquick-start","Start with your first form",{"title":284,"searchDepth":492,"depth":492,"links":493},2,[],"md",{},true,"\u002Fen",{"title":499,"description":500},"A form component library built on Nuxt UI","A form component library built on Nuxt UI, shipped as a Nuxt module.","en\u002Findex","206FRS4aHC3CYg-1cmHeTh6t9cQSCG_RnlmfllYJZ4o",1793610231419]