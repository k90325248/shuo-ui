49,350],"component-example",{"name":351},"checkbox-group-items",[318,353,355],{"id":354},"orientation","Orientation",[296,357,358,360,361,364,365,368,369,372,373,340,376,379,380,383,384,386,387,386,389,386,392,340,395,398,399,347],{},[299,359,354],{}," defaults to ",[299,362,363],{},"auto",", switching between vertical and horizontal around ",[299,366,367],{},"breakpoint"," (default ",[299,370,371],{},"md",") by viewport width; ",[299,374,375],{},"horizontal",[299,377,378],{},"vertical"," fix the direction regardless of the viewport. When an item label is truncated, hovering or keyboard focus shows a tooltip with the full text, or a long press on touch devices (see ",[308,381,217],{"href":382},"\u002Fcomponents\u002Fhelper\u002Ftooltip#touch-long-press","); a long press that shows the tooltip does not check the item. ",[299,385,354],{},", ",[299,388,367],{},[299,390,391],{},"label-key",[299,393,394],{},"value-key",[299,396,397],{},"ui"," can have site-wide defaults; see ",[308,400,402],{"href":401},"\u002Fgetting-started\u002Ftheme\u002Fcomponent-defaults#configurable-props","Configurable props",[349,404],{"name":405},"checkbox-group-orientation",[318,407,409],{"id":408},"responsive-columns","Responsive columns",[296,411,412,413,416,417,420],{},"Use ",[299,414,415],{},"orientation=\"grid\""," and override the Tailwind column and breakpoint classes with ",[299,418,419],{},"ui.fieldset",". It defaults to one column, and each row is at least as tall as an input of the same size; truncation tooltips and skeleton behavior are kept.",[349,422],{"name":423},"checkbox-group-grid",[296,425,426,427,429,430,433,434,437,438,440],{},"The first group is set to one column by default, two from md and four from xl. ",[299,428,367],{}," is only used for the horizontal \u002F vertical switch of ",[299,431,432],{},"orientation=\"auto\"","; grid breakpoints are controlled by the classes. ",[299,435,436],{},"class"," sets the outer frame and ",[299,439,419],{}," sets the item container. Use complete static classes so Tailwind can scan them.",[318,442,444],{"id":443},"custom-item-fields","Custom item fields",[296,446,447,448,340,450,452,453,456,457,340,459,461],{},"When the back-end item fields are not ",[299,449,329],{},[299,451,305],{}," (for example ",[299,454,455],{},"{ Code, Name }","), set them with ",[299,458,391],{},[299,460,394],{}," instead of converting the data first:",[349,463],{"name":464},"checkbox-group-keys",[466,467,468,487,515,539],"ul",{},[469,470,471,475,476,479,480,483,484,347],"li",{},[472,473,474],"strong",{},"The bound values must be strings",": the ",[299,477,478],{},"v-model"," type stays ",[299,481,482],{},"string[]",". If the back-end codes are numbers, convert them to strings first, for example ",[299,485,486],{},"items.map((item) => ({ ...item, Code: String(item.Code) }))",[469,488,489,497,498,340,500,502,503,340,506,509,510,340,512,514],{},[472,490,491,492,340,494,496],{},"The original ",[299,493,329],{},[299,495,305],{}," fields are replaced",": the component turns each object item into \"the original fields + ",[299,499,329],{},[299,501,305],{}," resolved by ",[299,504,505],{},"labelKey",[299,507,508],{},"valueKey","\". If the original data already has ",[299,511,329],{},[299,513,305],{}," fields, they are replaced by the resolved values.",[469,516,517,518,521,522,525,526,386,529,532,533,386,536,347],{},"The ",[299,519,520],{},"item"," of ",[299,523,524],{},"#item-append"," is the converted object, with both the original fields (",[299,527,528],{},"item.Code",[299,530,531],{},"item.Name",") and ",[299,534,535],{},"item.label",[299,537,538],{},"item.value",[469,540,541,542,544,545,547,548,551],{},"In development mode, when the first object item lacks the field set by ",[299,543,505],{}," or ",[299,546,508],{},", the console warns once (with the component and field names); production does not check. ",[299,549,550],{},"ShuoSelectMenu"," has the same check.",[318,553,555],{"id":554},"item-descriptions","Item descriptions",[296,557,558,559,562,563,566],{},"An item's ",[299,560,561],{},"description"," field (or the field set by ",[299,564,565],{},"description-key",") shows below its label. Items without a description match the height of an input of the same size; items with one grow and wrap the description. In horizontal layout the whole row grows, the first lines of all items stay aligned, and the description does not squeeze the labels of other items.",[349,568],{"name":569},"checkbox-group-description",[318,571,573],{"id":572},"color-and-icon","Color and icon",[296,575,576,577,340,580,521,583,586,587,589,590,592,593,595],{},"Uses the ",[299,578,579],{},"color",[299,581,582],{},"icon",[299,584,585],{},"UCheckboxGroup",": ",[299,588,579],{}," changes the checked color, and ",[299,591,582],{}," is the icon shown when checked; a single item can also set its own with the item's ",[299,594,582],{}," field.",[349,597],{"name":598},"checkbox-group-color",[318,600,602],{"id":601},"size-and-states","Size and states",[296,604,605,606,609,610,613],{},"In horizontal layout, the height matches an input of the same size; the example puts a ",[299,607,608],{},"ShuoInputText"," of the same size on the right for comparison. While loading, spinners replace the checkboxes and the group is disabled. See ",[308,611,102],{"href":612},"\u002Fcomponents\u002Foverview\u002Fcommon"," for the behavior shared by all states.",[349,615],{"name":616},"checkbox-group-states",[313,618,620],{"id":619},"examples","Examples",[318,622,624],{"id":623},"item-append-content","Item append content",[296,626,627,628,632,633,635],{},"When an item needs an input right next to its label (for example \"☐ Other ",[629,630,631],"span",{}," please specify","\"), use the ",[299,634,524],{}," slot. The example checks \"Other\" when its description input is focused:",[349,637],{"name":638},"checkbox-group-append",[466,640,641,647,652,662],{},[469,642,643,644,347],{},"Clicking the appended content (the input, the unit or empty space) does not change the checked state; to check on focus, bind ",[299,645,646],{},"@focus=\"check\"",[469,648,649,651],{},[299,650,336],{}," already covers a disabled item, a disabled component, loading and a disabled form.",[469,653,654,657,658,661],{},[299,655,656],{},"labelId"," is the id of the item label; set it as the appended input's ",[299,659,660],{},"aria-labelledby",". The checkbox itself is named only by the item label and does not include the input's value.",[469,663,664,665,668,669,671,672,347],{},"The appended input is not part of the outer ",[299,666,667],{},"UFormField",". To validate it, wrap it in its own ",[299,670,667],{},", or show its error together through the outer ",[299,673,674],{},"error-pattern",[318,676,678],{"id":677},"with-form-validation","With form validation",[296,680,412,681,684,685,688,689,691,692,694],{},[299,682,683],{},"requiredArray"," to require at least one item, with your own item schema (see ",[308,686,62],{"href":687},"\u002Fgetting-started\u002Fform\u002Fvalidation#shared-rules","). In the example, the \"Other\" description input is wrapped in its own ",[299,690,667],{},", and the outer ",[299,693,674],{}," shows its error together; when \"Other\" is not checked, the input is disabled and not checked.",[349,696],{"name":697},"checkbox-group-validation",[318,699,701],{"id":700},"select-all-and-clear","Select all and clear",[296,703,704,705,707,708,521,711,713],{},"Select all and clear rewrite the ",[299,706,478],{}," array directly; the example puts the buttons in the ",[299,709,710],{},"#hint",[299,712,667],{},", and select all skips disabled items.",[349,715],{"name":716},"checkbox-group-select-all",[313,718,720],{"id":719},"props","Props",[722,723],"component-props",{"name":724},"ShuoCheckboxGroup",[296,726,727,728,731,732,386,735,386,737,386,740,386,743,340,746,347],{},"See ",[308,729,102],{"href":730},"\u002Fcomponents\u002Foverview\u002Fcommon#shared-props"," for the behavior of ",[299,733,734],{},"size",[299,736,336],{},[299,738,739],{},"loading",[299,741,742],{},"skeleton",[299,744,745],{},"id",[299,747,748],{},"name",[296,750,751,752,755,756,340,759,762,763,767],{},"Nuxt UI's ",[299,753,754],{},"variant"," (card, table), ",[299,757,758],{},"indicator",[299,760,761],{},"highlight"," are not supported, so that a frame does not make the items taller and break the height alignment with inputs; see ",[308,764,766],{"href":765},"\u002Fcomponents\u002Foverview\u002Fcommon#built-on-nuxt-ui","Built on Nuxt UI"," for why.",[318,769,771],{"id":770},"item-fields","Item fields",[296,773,774,775,778,779,781],{},"Items (",[299,776,777],{},"CheckboxGroupOption",") use Nuxt UI's item fields, with ",[299,780,305],{}," limited to strings.",[783,784,785,801],"table",{},[786,787,788],"thead",{},[789,790,791,795,798],"tr",{},[792,793,794],"th",{},"Field",[792,796,797],{},"Type",[792,799,800],{},"Description",[802,803,804,822,837,851,864,885,901],"tbody",{},[789,805,806,811,817],{},[807,808,809],"td",{},[299,810,329],{},[807,812,813,816],{},[299,814,815],{},"string"," (required)",[807,818,819,820],{},"Label; the field name can be set with ",[299,821,505],{},[789,823,824,828,832],{},[807,825,826],{},[299,827,305],{},[807,829,830,816],{},[299,831,815],{},[807,833,834,835],{},"Bound value; the field name can be set with ",[299,836,508],{},[789,838,839,843,848],{},[807,840,841],{},[299,842,336],{},[807,844,845],{},[299,846,847],{},"boolean",[807,849,850],{},"Disables this item; a checked disabled item stays checked, and Tab skips it",[789,852,853,857,861],{},[807,854,855],{},[299,856,582],{},[807,858,859],{},[299,860,815],{},[807,862,863],{},"Icon shown when checked",[789,865,866,872,875],{},[807,867,868,386,870],{},[299,869,436],{},[299,871,397],{},[807,873,874],{},"—",[807,876,877,878,880,881,884],{},"Class and style overrides for this item, with the same parts as Nuxt UI; each ",[299,879,397],{}," part only accepts a class string or a ",[299,882,883],{},"(defaults) => string"," function, not array