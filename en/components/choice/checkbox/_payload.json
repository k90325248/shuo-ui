,344,345],{},"N"," or booleans; if the whole project uses the same values, set site-wide defaults for ",[307,348,349],{},"trueValue"," and ",[307,352,353],{},"falseValue","; see ",[356,357,359],"a",{"href":358},"\u002Fgetting-started\u002Ftheme\u002Fcomponent-defaults#configurable-props","Configurable props",".",[362,363],"component-example",{"name":364},"checkbox-values",[366,367,368,378],"ul",{},[369,370,371,372,374,375,377],"li",{},"When the bound value is not ",[307,373,325],{},", the checkbox shows unchecked. In the example, changing only ",[307,376,325],{}," makes the existing value no longer match, so it shows unchecked.",[369,379,380,381,383,384,360],{},"A native form submission sends ",[307,382,325],{}," instead of the browser's default ",[307,385,386],{},"on",[317,388,390],{"id":389},"label","Label",[304,392,393,395,396,399,400,360],{},[307,394,389],{}," defaults to \"Enable\" (\"啟用\" in Traditional Chinese), switching with the locale, and can be overridden with the ",[307,397,398],{},"checkbox.label"," text; see ",[356,401,47],{"href":402},"\u002Fgetting-started\u002Ftheme\u002Fmessages",[362,404],{"name":405},"checkbox-label",[304,407,408,409,412],{},"The label shows on one line and is truncated when wider than its container. A tooltip shows the full text on hover or focus, or on long press on touch devices (see ",[356,410,217],{"href":411},"\u002Fcomponents\u002Fhelper\u002Ftooltip#touch-long-press","); a long press that shows the tooltip does not change the checked state.",[317,414,416],{"id":415},"description","Description",[304,418,419,421],{},[307,420,415],{}," shows below the label. Without a description, the height matches an input of the same size; with one, the checkbox grows and the description wraps, while the first line still lines up with fields next to it that have no description.",[362,423],{"name":424},"checkbox-description",[317,426,428],{"id":427},"color-and-icon","Color and icon",[304,430,431,432,350,435,438,439,360],{},"Uses the ",[307,433,434],{},"color",[307,436,437],{},"icon"," (the checked icon) of ",[307,440,441],{},"UCheckbox",[362,443],{"name":444},"checkbox-color",[317,446,448],{"id":447},"size-and-states","Size and states",[304,450,451,452,455],{},"The frame height matches an input of the same size. While loading, a spinner of the same size replaces the checkbox and it is disabled. See ",[356,453,102],{"href":454},"\u002Fcomponents\u002Foverview\u002Fcommon"," for the behavior shared by all states.",[362,457],{"name":458},"checkbox-states",[312,460,462],{"id":461},"examples","Examples",[317,464,466],{"id":465},"next-to-an-input","Next to an input",[304,468,469,470,473,474,477],{},"Inside a flex container, the wrapper shrinks with the available space and truncates the label. To show the full label, set ",[307,471,472],{},"ui.wrapper"," to ",[307,475,476],{},"shrink-0","; a label wider than the container is still truncated with a tooltip.",[362,479],{"name":480},"checkbox-inline",[317,482,484],{"id":483},"input-next-to-the-label","Input next to the label",[304,486,487,488,491,492,495,496,499,500,503,504,508],{},"Put an input next to the label with ",[307,489,490],{},"#append",". When the input is focused, call ",[307,493,494],{},"check()"," from the slot props to check the box too, and use ",[307,497,498],{},"labelId"," as the input's ",[307,501,502],{},"aria-labelledby",". Clicking non-interactive parts of the appended content does not change the checked state; see ",[356,505,507],{"href":506},"\u002Fcomponents\u002Fchoice\u002Fcheckbox-group#item-append-content","Item append content"," for details.",[362,510],{"name":511},"checkbox-append",[317,513,515],{"id":514},"must-be-checked","Must be checked",[304,517,518,519,522,523,525,526,529],{},"For fields that must be checked, such as agreeing to terms, use ",[307,520,521],{},"v.check"," to check that the bound value equals ",[307,524,325],{}," (not ",[307,527,528],{},"v.literal",", which would narrow the UForm state type).",[362,531],{"name":532},"checkbox-validation",[312,534,536],{"id":535},"props","Props",[538,539],"component-props",{"name":540},"ShuoCheckbox",[304,542,543,544,547,548,551,552,551,555,551,558,551,561,350,564,567,568,570,571,573],{},"See ",[356,545,102],{"href":546},"\u002Fcomponents\u002Foverview\u002Fcommon#shared-props"," for the behavior of ",[307,549,550],{},"size",", ",[307,553,554],{},"disabled",[307,556,557],{},"loading",[307,559,560],{},"skeleton",[307,562,563],{},"id",[307,565,566],{},"name",". The default of ",[307,569,389],{}," can be overridden with the ",[307,572,398],{}," text.",[304,575,576,577,580,581,350,584,587,588,592],{},"Nuxt UI's ",[307,578,579],{},"variant"," (card), ",[307,582,583],{},"indicator",[307,585,586],{},"highlight"," are not supported, so that a frame does not make the option taller and break the height alignment with inputs; see ",[356,589,591],{"href":590},"\u002Fcomponents\u002Foverview\u002Fcommon#built-on-nuxt-ui","Built on Nuxt UI"," for why.",[312,594,596],{"id":595},"slots","Slots",[598,599,600,614],"table",{},[601,602,603],"thead",{},[604,605,606,610,612],"tr",{},[607,608,609],"th",{},"Slot",[607,611,536],{},[607,613,416],{},[615,616,617],"tbody",{},[604,618,619,625,636],{},[620,621,622],"td",{},[307,623,624],{},"append",[620,626,627,551,630,551,632,551,634],{},[307,628,629],{},"checked",[307,631,554],{},[307,633,498],{},[307,635,494],{},[620,637,638,639],{},"Content next to the label; see ",[356,640,507],{"href":506},[312,642,644],{"id":643},"styling","Styling",[304,646,647,650,651,653,654,661,662,665],{},[307,648,649],{},"ui"," accepts every slot of Nuxt UI ",[307,652,441],{},", merged as described in ",[356,655,657,658,660],{"href":656},"\u002Fgetting-started\u002Ftheme\u002Ftheming#per-component-ui-prop","Per-component ",[307,659,649],{}," prop",", plus ",[307,663,664],{},"wrapper",":",[598,667,668,680],{},[601,669,670],{},[604,671,672,674,677],{},[607,673,609],{},[607,675,676],{},"Part",[607,678,679],{},"Built-in styles",[615,681,682,