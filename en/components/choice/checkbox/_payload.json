15,332,333],{},"true-value"," is the bound value when checked, the number ",[315,336,337],{},"1"," by default; ",[315,340,341],{},"false-value"," is the bound value when unchecked, the number ",[315,344,345],{},"0"," by default. Change them when the back end uses ",[315,348,349],{},"Y"," \u002F ",[315,352,353],{},"N"," or booleans; if the whole project uses the same values, set site-wide defaults for ",[315,356,357],{},"trueValue"," and ",[315,360,361],{},"falseValue","; see ",[364,365,367],"a",{"href":366},"\u002Fgetting-started\u002Ftheme\u002Fcomponent-defaults#configurable-props","Configurable props",".",[370,371],"component-example",{"name":372},"checkbox-values",[374,375,376,386],"ul",{},[377,378,379,380,382,383,385],"li",{},"When the bound value is not ",[315,381,333],{},", the checkbox shows unchecked. In the example, changing only ",[315,384,333],{}," makes the existing value no longer match, so it shows unchecked.",[377,387,388,389,391,392,368],{},"A native form submission sends ",[315,390,333],{}," instead of the browser's default ",[315,393,394],{},"on",[325,396,398],{"id":397},"label","Label",[312,400,401,403,404,407,408,368],{},[315,402,397],{}," defaults to \"Enable\" (\"啟用\" in Traditional Chinese), switching with the locale, and can be overridden with the ",[315,405,406],{},"checkbox.label"," text; see ",[364,409,47],{"href":410},"\u002Fgetting-started\u002Ftheme\u002Fmessages",[370,412],{"name":413},"checkbox-label",[312,415,416,417,420],{},"The label shows on one line and is truncated when wider than its container. A tooltip shows the full text on hover or focus, or on long press on touch devices (see ",[364,418,217],{"href":419},"\u002Fcomponents\u002Fhelper\u002Ftooltip#touch-long-press","); a long press that shows the tooltip does not change the checked state.",[325,422,424],{"id":423},"description","Description",[312,426,427,429],{},[315,428,423],{}," shows below the label. Without a description, the height matches an input of the same size; with one, the checkbox grows and the description wraps, while the first line still lines up with fields next to it that have no description.",[370,431],{"name":432},"checkbox-description",[325,434,436],{"id":435},"color-and-icon","Color and icon",[312,438,439,440,358,443,446,447,368],{},"Uses the ",[315,441,442],{},"color",[315,444,445],{},"icon"," (the checked icon) of ",[315,448,449],{},"UCheckbox",[370,451],{"name":452},"checkbox-color",[325,454,456],{"id":455},"size-and-states","Size and states",[312,458,459,460,463],{},"The frame height matches an input of the same size. While loading, a spinner of the same size replaces the checkbox and it is disabled. See ",[364,461,102],{"href":462},"\u002Fcomponents\u002Foverview\u002Fcommon"," for the behavior shared by all states.",[370,465],{"name":466},"checkbox-states",[320,468,470],{"id":469},"examples","Examples",[325,472,474],{"id":473},"next-to-an-input","Next to an input",[312,476,477,478,481,482,485],{},"Inside a flex container, the wrapper shrinks with the available space and truncates the label. To show the full label, set ",[315,479,480],{},"ui.wrapper"," to ",[315,483,484],{},"shrink-0","; a label wider than the container is still truncated with a tooltip.",[370,487],{"name":488},"checkbox-inline",[325,490,492],{"id":491},"input-next-to-the-label","Input next to the label",[312,494,495,496,499,500,503,504,507,508,511,512,516],{},"Put an input next to the label with ",[315,497,498],{},"#append",". When the input is focused, call ",[315,501,502],{},"check()"," from the slot props to check the box too, and use ",[315,505,506],{},"labelId"," as the input's ",[315,509,510],{},"aria-labelledby",". Clicking non-interactive parts of the appended content does not change the checked state; see ",[364,513,515],{"href":514},"\u002Fcomponents\u002Fchoice\u002Fcheckbox-group#item-append-content","Item append content"," for details.",[370,518],{"name":519},"checkbox-append",[325,521,523],{"id":522},"must-be-checked","Must be checked",[312,525,526,527,530,531,533,534,537],{},"For fields that must be checked, such as agreeing to terms, use ",[315,528,529],{},"v.check"," to check that the bound value equals ",[315,532,333],{}," (not ",[315,535,536],{},"v.literal",", which would narrow the UForm state type).",[370,539],{"name":540},"checkbox-validation",[320,542,544],{"id":543},"props","Props",[546,547],"component-props",{"name":548},"ShuoCheckbox",[312,550,551,552,555,556,559,560,559,563,559,566,559,569,358,572,575,576,578,579,581],{},"See ",[364,553,102],{"href":554},"\u002Fcomponents\u002Foverview\u002Fcommon#shared-props"," for the behavior of ",[315,557,558],{},"size",", ",[315,561,562],{},"disabled",[315,564,565],{},"loading",[315,567,568],{},"skeleton",[315,570,571],{},"id",[315,573,574],{},"name",". The default of ",[315,577,397],{}," can be overridden with the ",[315,580,406],{}," text.",[312,583,584,585,588,589,358,592,595,596,600],{},"Nuxt UI's ",[315,586,587],{},"variant"," (card), ",[315,590,591],{},"indicator",[315,593,594],{},"highlight"," are not supported, so that a frame does not make the option taller and break the height alignment with inputs; see ",[364,597,599],{"href":598},"\u002Fcomponents\u002Foverview\u002Fcommon#built-on-nuxt-ui","Built on Nuxt UI"," for why.",[320,602,604],{"id":603},"slots","Slots",[606,607,608,622],"table",{},[609,610,611],"thead",{},[612,613,614,618,620],"tr",{},[615,616,617],"th",{},"Slot",[615,619,544],{},[615,621,424],{},[623,624,625],"tbody",{},[612,626,627,633,644],{},[628,629,630],"td",{},[315,631,632],{},"append",[628,634,635,559,638,559,640,559,642],{},[315,636,637],{},"checked",[315,639,562],{},[315,641,506],{},[315,643,502],{},[628,645,646,647],{},"Content next to the label; see ",[364,648,515],{"href":514},[320,650,652],{"id":651},"styling","Styling",[312,654,655,658,659,661,662,669,670,673],{},[315,656,657],{},"ui"," accepts every slot of Nuxt UI ",[315,660,449],{},", merged as described in ",[364,663,665,666,668],{"href":664},"\u