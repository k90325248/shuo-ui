49],{},"falseValue","; see ",[352,353,355],"a",{"href":354},"\u002Fgetting-started\u002Ftheme\u002Fcomponent-defaults#configurable-props","Configurable props",".",[358,359],"component-example",{"name":360},"checkbox-values",[362,363,364,374],"ul",{},[365,366,367,368,370,371,373],"li",{},"When the bound value is not ",[303,369,321],{},", the checkbox shows unchecked. In the example, changing only ",[303,372,321],{}," makes the existing value no longer match, so it shows unchecked.",[365,375,376,377,379,380,356],{},"A native form submission sends ",[303,378,321],{}," instead of the browser's default ",[303,381,382],{},"on",[313,384,386],{"id":385},"label","Label",[300,388,389,391,392,395,396,356],{},[303,390,385],{}," defaults to \"Enable\" (\"啟用\" in Traditional Chinese), switching with the locale, and can be overridden with the ",[303,393,394],{},"checkbox.label"," text; see ",[352,397,47],{"href":398},"\u002Fgetting-started\u002Ftheme\u002Fmessages",[358,400],{"name":401},"checkbox-label",[300,403,404,405,408],{},"The label shows on one line and is truncated when wider than its container. A tooltip shows the full text on hover or focus, or on long press on touch devices (see ",[352,406,217],{"href":407},"\u002Fcomponents\u002Fhelper\u002Ftooltip#touch-long-press","); a long press that shows the tooltip does not change the checked state.",[313,410,412],{"id":411},"description","Description",[300,414,415,417],{},[303,416,411],{}," shows below the label. Without a description, the height matches an input of the same size; with one, the checkbox grows and the description wraps, while the first line still lines up with fields next to it that have no description.",[358,419],{"name":420},"checkbox-description",[313,422,424],{"id":423},"color-and-icon","Color and icon",[300,426,427,428,346,431,434,435,356],{},"Uses the ",[303,429,430],{},"color",[303,432,433],{},"icon"," (the checked icon) of ",[303,436,437],{},"UCheckbox",[358,439],{"name":440},"checkbox-color",[313,442,444],{"id":443},"size-and-states","Size and states",[300,446,447,448,451],{},"The frame height matches an input of the same size. While loading, a spinner of the same size replaces the checkbox and it is disabled. See ",[352,449,102],{"href":450},"\u002Fcomponents\u002Foverview\u002Fcommon"," for the behavior shared by all states.",[358,453],{"name":454},"checkbox-states",[308,456,458],{"id":457},"examples","Examples",[313,460,462],{"id":461},"next-to-an-input","Next to an input",[300,464,465,466,469,470,473],{},"Inside a flex container, the wrapper shrinks with the available space and truncates the label. To show the full label, set ",[303,467,468],{},"ui.wrapper"," to ",[303,471,472],{},"shrink-0","; a label wider than the container is still truncated with a tooltip.",[358,475],{"name":476},"checkbox-inline",[313,478,480],{"id":479},"input-next-to-the-label","Input next to the label",[300,482,483,484,487,488,491,492,495,496,499,500,504],{},"Put an input next to the label with ",[303,485,486],{},"#append",". When the input is focused, call ",[303,489,490],{},"check()"," from the slot props to check the box too, and use ",[303,493,494],{},"labelId"," as the input's ",[303,497,498],{},"aria-labelledby",". Clicking non-interactive parts of the appended content does not change the checked state; see ",[352,501,503],{"href":502},"\u002Fcomponents\u002Fchoice\u002Fcheckbox-group#item-append-content","Item append content"," for details.",[358,506],{"name":507},"checkbox-append",[313,509,511],{"id":510},"must-be-checked","Must be checked",[300,513,514,515,518,519,521,522,525],{},"For fields that must be checked, such as agreeing to terms, use ",[303,516,517],{},"v.check"," to check that the bound value equals ",[303,520,321],{}," (not ",[303,523,524],{},"v.literal",", which would narrow the UForm state type).",[358,527],{"name":528},"checkbox-validation",[308,530,532],{"id":531},"props","Props",[534,535],"component-props",{"name":536},"ShuoCheckbox",[300,538,539,540,543,544,547,548,547,551,547,554,547,557,346,560,563,564,566,567,569],{},"See ",[352,541,102],{"href":542},"\u002Fcomponents\u002Foverview\u002Fcommon#shared-props"," for the behavior of ",[303,545,546],{},"size",", ",[303,549,550],{},"disabled",[303,552,553],{},"loading",[303,555,556],{},"skeleton",[303,558,559],{},"id",[303,561,562],{},"name",". The default of ",[303,565,385],{}," can be overridden with the ",[303,568,394],{}," text.",[300,571,572,573,576,577,346,580,583,584,588],{},"Nuxt UI's ",[303,574,575],{},"variant"," (card), ",[303,578,579],{},"indicator",[303,581,582],{},"highlight"," are not supported, so that a frame does not make the option taller and break the height alignment with inputs; see ",[352,585,587],{"href":586},"\u002Fcomponents\u002Foverview\u002Fcommon#built-on-nuxt-ui","Built on Nuxt UI"," for why.",[308,590,592],{"id":591},"slots","Slots",[594,595,596,610],"table",{},[597,598,599],"thead",{},[600,601,602,606,608],"tr",{},[603,604,605],"th",{},"Slot",[603,607,532],{},[603,609,412],{},[611,612,613],"tbody",{},[600,614,615,621,632],{},[616,617,618],"td",{},[303,619,620],{},"append",[616,622,623,547,626,547,628,547,630],{},[303,624,625],{},"checked",[303,627,550],{},[303,629,494],{},[303,631,490],{},[616,633,634,635],{},"Content next to the label; see ",[352,636,503],{"href":502},[308,638,640],{"id":639},"styling","Styling",[300,642,643,646,647,649,650,657,658,661],{},[303,644,645],{},"ui"," accepts every slot of Nuxt UI ",[303,648,437],{},", merged as described in ",[352,651,653,654,656],{"href":652},"\u002Fgetting-started\u002Ftheme\u002Ftheming#per-component-ui-prop","Per-component ",[303,655,645],{}," prop",", plus ",[303,659,660],{},"wrapper",":",[594,663,664,676],{},[597,665,666],{},[600,667,668,670,673],{},[603,669,605],{},[603,671,672],{},"Part",[603,674,675],{},"Built-in styles",[611,677,678,692,708,722],{},[600,679,680,684,687],{},[616,681,682],{},[303,683,660],{},[616,685,686],{},"Outer wrapper that measures truncation, holds the tooltip 