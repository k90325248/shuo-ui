.1","\u002Fen\u002Freleases\u002Fversions\u002Fv1-0-1","en\u002F5.releases\u002F1.versions\u002F3.v1-0-1",{"id":276,"title":122,"body":277,"description":758,"extension":759,"links":760,"meta":765,"navigation":766,"path":123,"seo":767,"stem":124,"__hash__":768},"docs_en\u002Fen\u002F3.components\u002F3.choice\u002F2.checkbox.md",{"type":278,"value":279,"toc":737},"minimark",[280,288,293,298,338,342,364,368,380,383,390,394,399,402,406,419,422,426,433,436,440,444,455,458,462,486,489,493,507,510,514,518,551,570,574,618,622,643,719,730,734],[281,282,283,287],"p",{},[284,285,286],"code",{},"v-model: string | number | boolean",", required.",[289,290,292],"h2",{"id":291},"usage","Usage",[294,295,297],"h3",{"id":296},"checked-values","Checked values",[281,299,300,303,304,307,308,311,312,315,316,319,320,323,324,327,328,331,332,337],{},[284,301,302],{},"true-value"," is the bound value when checked, the number ",[284,305,306],{},"1"," by default; ",[284,309,310],{},"false-value"," is the bound value when unchecked, the number ",[284,313,314],{},"0"," by default. Change them when the back end uses ",[284,317,318],{},"Y"," \u002F ",[284,321,322],{},"N"," or booleans; if the whole project uses the same values, set site-wide defaults for ",[284,325,326],{},"trueValue"," and ",[284,329,330],{},"falseValue","; see ",[333,334,336],"a",{"href":335},"\u002Fgetting-started\u002Ftheme\u002Fcomponent-defaults#configurable-props","Configurable props",".",[339,340],"component-example",{"name":341},"checkbox-values",[343,344,345,355],"ul",{},[346,347,348,349,351,352,354],"li",{},"When the bound value is not ",[284,350,302],{},", the checkbox shows unchecked. In the example, changing only ",[284,353,302],{}," makes the existing value no longer match, so it shows unchecked.",[346,356,357,358,360,361,337],{},"A native form submission sends ",[284,359,302],{}," instead of the browser's default ",[284,362,363],{},"on",[294,365,367],{"id":366},"label","Label",[281,369,370,372,373,376,377,337],{},[284,371,366],{}," defaults to \"Enable\" (\"啟用\" in Traditional Chinese), switching with the locale, and can be overridden with the ",[284,374,375],{},"checkbox.label"," text; see ",[333,378,47],{"href":379},"\u002Fgetting-started\u002Ftheme\u002Fmessages",[339,381],{"name":382},"checkbox-label",[281,384,385,386,389],{},"The label shows on one line and is truncated when wider than its container. A tooltip shows the full text on hover or focus, or on long press on touch devices (see ",[333,387,202],{"href":388},"\u002Fcomponents\u002Fhelper\u002Ftooltip#touch-long-press","); a long press that shows the tooltip does not change the checked state.",[294,391,393],{"id":392},"description","Description",[281,395,396,398],{},[284,397,392],{}," shows below the label. Without a description, the height matches an input of the same size; with one, the checkbox grows and the description wraps, while the first line still lines up with fields next to it that have no description.",[339,400],{"name":401},"checkbox-description",[294,403,405],{"id":404},"color-and-icon","Color and icon",[281,407,408,409,327,412,415,416,337],{},"Uses the ",[284,410,411],{},"color",[284,413,414],{},"icon"," (the checked icon) of ",[284,417,418],{},"UCheckbox",[339,420],{"name":421},"checkbox-color",[294,423,425],{"id":424},"size-and-states","Size and states",[281,427,428,429,432],{},"The frame height matches an input of the same size. While loading, a spinner of the same size replaces the checkbox and it is disabled. See ",[333,430,87],{"href":431},"\u002Fcomponents\u002Foverview\u002Fcommon"," for the behavior shared by all states.",[339,434],{"name":435},"checkbox-states",[289,437,439],{"id":438},"examples","Examples",[294,441,443],{"id":442},"next-to-an-input","Next to an input",[281,445,446,447,450,451,454],{},"Inside a flex container, the wrapper shrinks with the available space and truncates the label. To show the full label, set ",[284,448,449],{},"ui.wrapper"," to ",[284,452,453],{},"shrink-0","; a label wider than the container is still truncated with a tooltip.",[339,456],{"name":457},"checkbox-inline",[294,459,461],{"id":460},"input-next-to-the-label","Input next to the label",[281,463,464,465,468,469,472,473,476,477,480,481,485],{},"Put an input next to the label with ",[284,466,467],{},"#append",". When the input is focused, call ",[284,470,471],{},"check()"," from the slot props to check the box too, and use ",[284,474,475],{},"labelId"," as the input's ",[284,478,479],{},"aria-labelledby",". Clicking non-interactive parts of the appended content does not change the checked state; see ",[333,482,484],{"href":483},"\u002Fcomponents\u002Fchoice\u002Fcheckbox-group#item-append-content","Item append content"," for details.",[339,487],{"name":488},"checkbox-append",[294,490,492],{"id":491},"must-be-checked","Must be checked",[281,494,495,496,499,500,502,503,506],{},"For fields that must be checked, such as agreeing to terms, use ",[284,497,498],{},"v.check"," to check that the bound value equals ",[284,501,302],{}," (not ",[284,504,505],{},"v.literal",", which would narrow the UForm state type).",[339,508],{"name":509},"checkbox-validation",[289,511,513],{"id":512},"props","Props",[515,516],"component-props",{"name":517},"ShuoCheckbox",[281,519,520,521,524,525,528,529,528,532,528,535,528,538,327,541,544,545,547,548,550],{},"See ",[333,522,87],{"href":523},"\u002Fcomponents\u002Foverview\u002Fcommon#shared-props"," for the behavior of ",[284,526,527],{},"size",", ",[284,530,531],{},"disabled",[284,533,534],{},"loading",[284,536,537],{},"skeleton",[284,539,540],{},"id",[284,542,543],{},"name",". The default of ",[284,546,366],{}," can be overridden with the ",[284,549,375],{}," text.",[281,552,553,554,557,558,327,561,564,565,569],{},"Nuxt UI's ",[284,555,556],{},"variant"," (card), ",[284,559,560],{},"indicator",[284,562,563],{},"highlight"," are not supported, so that a frame does not make the option taller and break the height alignment with inputs; see ",[333,566,568],{"href":567},"\u002Fcomponents\u002Foverview\u002Fcommon#built-on-nuxt-ui","Built on Nuxt UI"," for why.",[289,571,573],{"id":572},"slots","Slots",[575,576,577,591],"table",{},[578,579,580],"thead",{},[581,582,583,587,589],"tr",{},[584,585,586],"th",{},"Slot",[584,588,513],{},[584,590,393],{},[592,593,594],"tbody",{},[581,595,596,602,613],{},[597,598,599],"td",{},[284,600,601],{},"append",[597,603,604,528,607,528,609,528,611],{},[284,605,606],{},"checked",[284,608,531],{},[284,610,475],{},[284,612,471],{},[597,614,615,616],{},"Content next to the label; see ",[333,617,484],{"href":483},[289,619,621],{"id":620},"styling","Styling",[281,623,624,627,628,630,631,638,639,642],{},[284,625,626],{},"ui"," accepts every slot of Nuxt UI ",[284,629,418],{},", merged as described in ",[333,632,634,635,637],{"href":633},"\u002Fgetting-started\u002Ftheme\u002Ftheming#per-component-ui-prop","Per-component ",[284,636,626],{}," prop",", plus ",[284,640,641],{},"wrapper",":",[575,644,645,657],{},[578,646,647],{},[581,648,649,651,654],{},[584,650,586],{},[584,652,653],{},"Part",[584,655,656],{},"Built-in styles",[592,658,659,673,689,703],{},[581,660,661,665,668],{},[597,662,663],{},[284,664,641],{},[597,666,667],{},"Outer wrapper that measures truncation, holds the tooltip and positions the loading icon",[597,669,670],{},[284,671,672],{},"relative inline-flex w-fit max-w-full min-w-0 align-top",[581,674,675,680,683],{},[597,676,677],{},[284,678,679],{},"root",[597,681,682],{},"Checkbox frame (Nuxt UI)",[597,684,685,688],{},[284,686,687],{},"w-fit max-w-full min-w-0",", with height matching inputs of the same size and centered vertically",[581,690,691,695,698],{},[597,692,693],{},[284,694,366],{},[597,696,697],{},"Label (Nuxt UI)",[597,699,700],{},[284,701,702],{},"truncate",[581,704,705,710,713],{},[597,706,707],{},[284,708,709],{},"base",[597,711,712],{},"Checkbox (Nuxt UI)",[597,714,715,718],{},[284,716,717],{},"opacity-0"," while loading",[281,720,721,722,725,726,729