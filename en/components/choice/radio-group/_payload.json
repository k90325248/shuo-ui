369,336,372,375,376,379,380,382,383,382,385,382,388,336,391,394,395,343],{},[295,355,350],{}," defaults to ",[295,358,359],{},"auto",", switching between vertical and horizontal around ",[295,362,363],{},"breakpoint"," (default ",[295,366,367],{},"md",") by viewport width; ",[295,370,371],{},"horizontal",[295,373,374],{},"vertical"," fix the direction regardless of the viewport. When an item label is truncated, hovering or keyboard focus shows a tooltip with the full text, or a long press on touch devices (see ",[304,377,217],{"href":378},"\u002Fcomponents\u002Fhelper\u002Ftooltip#touch-long-press","); a long press that shows the tooltip does not select the item. ",[295,381,350],{},", ",[295,384,363],{},[295,386,387],{},"label-key",[295,389,390],{},"value-key",[295,392,393],{},"ui"," can have site-wide defaults; see ",[304,396,398],{"href":397},"\u002Fgetting-started\u002Ftheme\u002Fcomponent-defaults#configurable-props","Configurable props",[345,400],{"name":401},"radio-group-orientation",[314,403,405],{"id":404},"responsive-columns","Responsive columns",[292,407,408,409,412,413,416],{},"Use ",[295,410,411],{},"orientation=\"grid\""," and override the Tailwind column and breakpoint classes with ",[295,414,415],{},"ui.fieldset",". It defaults to one column, and each row is at least as tall as an input of the same size; truncation tooltips and skeleton behavior are kept.",[345,418],{"name":419},"radio-group-grid",[292,421,422,423,425,426,429,430,433,434,436],{},"The first group is set to one column by default, two from md and four from xl. ",[295,424,363],{}," is only used for the horizontal \u002F vertical switch of ",[295,427,428],{},"orientation=\"auto\"","; grid breakpoints are controlled by the classes. ",[295,431,432],{},"class"," sets the outer frame and ",[295,435,415],{}," sets the item container. Use complete static classes so Tailwind can scan them.",[314,438,440],{"id":439},"custom-item-fields","Custom item fields",[292,442,443,444,336,446,448,449,452,453,336,455,457],{},"When the back-end item fields are not ",[295,445,325],{},[295,447,301],{}," (for example ",[295,450,451],{},"{ Code, Name }","), set them with ",[295,454,387],{},[295,456,390],{}," instead of converting the data first:",[345,459],{"name":460},"radio-group-keys",[462,463,464,483,511,535],"ul",{},[465,466,467,471,472,475,476,479,480,343],"li",{},[468,469,470],"strong",{},"The bound value must be a string",": the ",[295,473,474],{},"v-model"," type stays ",[295,477,478],{},"string",". If the back-end codes are numbers, convert them to strings first, for example ",[295,481,482],{},"items.map((item) => ({ ...item, Code: String(item.Code) }))",[465,484,485,493,494,336,496,498,499,336,502,505,506,336,508,510],{},[468,486,487,488,336,490,492],{},"The original ",[295,489,325],{},[295,491,301],{}," fields are replaced",": the component turns each object item into \"the original fields + ",[295,495,325],{},[295,497,301],{}," resolved by ",[295,500,501],{},"labelKey",[295,503,504],{},"valueKey","\". If the original data already has ",[295,507,325],{},[295,509,301],{}," fields, they are replaced by the resolved values.",[465,512,513,514,517,518,521,522,382,525,528,529,382,532,343],{},"The ",[295,515,516],{},"item"," of ",[295,519,520],{},"#item-append"," is the converted object, with both the original fields (",[295,523,524],{},"item.Code",[295,526,527],{},"item.Name",") and ",[295,530,531],{},"item.label",[295,533,534],{},"item.value",[465,536,537,538,540,541,543,544,547],{},"In development mode, when the first object item lacks the field set by ",[295,539,501],{}," or ",[295,542,504],{},", the console warns once (with the component and field names); production does not check. ",[295,545,546],{},"ShuoSelectMenu"," has the same check.",[314,549,551],{"id":550},"item-descriptions","Item descriptions",[292,553,554,555,558,559,562],{},"An item's ",[295,556,557],{},"description"," field (or the field set by ",[295,560,561],{},"description-key",") shows below its label. Items without a description match the height of an input of the same size; items with one grow and wrap the description. In horizontal layout the whole row grows, the first lines of all items stay aligned, and the description does not squeeze the labels of other items.",[345,564],{"name":565},"radio-group-description",[314,567,569],{"id":568},"card-appearance","Card appearance",[292,571,572,575,576,579,580,583,584,587,588,591,592,595],{},[295,573,574],{},"variant=\"card\""," shows each item as a card (using Nuxt UI's border, padding and selected background), and clicking anywhere on a card selects it; ",[295,577,578],{},"variant=\"list\""," is the default layout. ",[295,581,582],{},"indicator"," sets where the radio button goes: ",[295,585,586],{},"start"," (default), ",[295,589,590],{},"end",", or ",[295,593,594],{},"hidden",", which hides the button and shows the selection only through the card border and background; arrow keys still work.",[345,597],{"name":598},"radio-group-card",[462,600,601,604,610,627],{},[465,602,603],{},"Cards do not match the input height; cards in the same row have equal height.",[465,605,606,607,609],{},"In horizontal layout, cards size to their content and shrink when space runs out; long text is truncated with an ellipsis and the full text shows in a Tooltip. In vertical layout (including when ",[295,608,428],{}," switches to vertical on narrow viewports), cards fill the group width.",[465,611,612,614,615,618,619,622,623,626],{},[295,613,582],{}," also works with the list layout; ",[295,616,617],{},"variant"," does not support Nuxt UI's ",[295,620,621],{},"table",", which falls back to ",[295,624,625],{},"list"," with a development warning.",[465,628,629,630,633,634,637],{},"When the surrounding ",[295,631,632],{},"UFormField"," has an error (or with ",[295,635,636],{},"color=\"error\"","), the borders of all enabled cards turn to the error color; disabled cards use the form disabled background; a focused card shows a primary-color outline when focused with the keyboard.",[314,639,641],{"id":640},"color","Color",[292,643,644,645,517,647,650],{},"Uses the ",[295,646,640],{},[295,648,649],{},"URadioGroup"," to change the selected color.",[345,652],{"name":653},"radio-group-color",[314,655,657],{"id":656},"size-and-states","Size and states",[292,659,660,661,664,665,668],{},"In horizontal layout, the height matches an input of the same size; the example puts a ",[295,662,663],{},"ShuoInputText"," of the same size on the right for comparison. While loading, spinners replace the radio buttons and the group is disabled. See ",[304,666,102],{"href":667},"\u002Fcomponents\u002Foverview\u002Fcommon"," for the behavior shared by all states.",[345,670],{"name":671},"radio-group-states",[309,673,675],{"id":674},"examples","Examples",[314,677,679],{"id":678},"item-append-content","Item append content",[292,681,682,683,687,688,690],{},"When an item needs an input right next to its label (for example \"○ Fixed amount ",[684,685,686],"span",{}," hundreds","\"), use the ",[295,689,520],{}," slot. The example selects \"Fixed amount\" when its amount input is focused:",[345,692],{"name":693},"radio-group-append",[462,695,696,702,707,717],{},[465,697,698,699,343],{},"Clicking the appended content (the input, the unit or empty space) does not change the selection; to select on focus, bind ",[295,700,701],{},"@focus=\"select\"",[465,703,704,706],{},[295,705,332],{}," already covers a disabled item, a disabled component, loading and a disabled form.",[465,708,709,712,713,716],{},[295,710,711],{},"labelId"," is the id of the item label; set it as the appended input's ",[295,714,715],{},"aria-labelledby",". The radio button itself is named only by the item label and does not include the input's value.",[465,718,719,720,722,723,725,726,343],{},"The appended input is not part of the outer ",[295,721,632],{},". To validate it, wrap it in its own ",[295,724,632],{},", or show its error together through the outer ",[295,727,728],{},"error-pattern",[314,730,732],{"id":731},"with-form-validation","With form validation",[292,734,408,735,738,739,741,742,744,745,747],{},[295,736,737],{},"requiredText"," for a required group (empty is ",[295,740,342],{},"). To validate an appended input, wrap it in its own ",[295,743,632],{}," and show its error through the outer ",[295,746,728],{},". The example only requires the amount when \"Fixed amount\" is selected; otherwise the amount input is disabled.",[345,749],{"name":750},"radio-group-validation",[314,752,754],{"id":753},"card-grid","Card grid",[292,756,757,758,760,761,763,764,766,767,769],{},"Combine ",[295,759,574],{}," with ",[295,762,411],{}," and set the columns with ",[295,765,415],{},"; cards fill each cell with equal height, and the item ",[295,768,557],{}," shows inside the card.",[345,771],{"name":772},"radio-group-card-grid",[314,774,776],{"id":775},"custom-card-content","Custom card content",[292,778,779,780,783,784,787,788,790,791,794,795,797,798,801,802,336,805,807,808,343],{},"Use the ",[295,781,782],{},"#description"," slot to put custom content in each card, such as a mini preview of a color theme. The example hides the radio button (",[295,785,786],{},"indicator=\"hidden\"",") and uses ",[295,789,393],{}," so the preview fills the card: ",[295,792,793],{},"fieldset"," sets three columns, ",[295,796,516],{}," adds ",[295,799,800],{},"min-w-0"," so cards can shrink, and ",[295,803,804],{},"wrapper",[295,806,557],{}," get ",[295,809,810],{},"w-full",[345,812],{"name":813},"radio-group-card-preview",[462,815,816,831],{},[465,817,818,819,821,822,824,825,336,828,343],{},"With ",[295,820,782],{},", every item shows a description area; the slot props are ",[295,823,516],{}," (the resolved item), ",[295,826,827],{},"modelValue",[295,829,830],{},"selected",[465,832,833,834,837,838,840,841,540,844,847,848,851,852,854],{},"The description area is a ",[295,835,836],{},"\u003Cp>"," element, so build the preview with ",[295,839,684],{}," and classes such as ",[295,842,843],{},"block",[295,845,846],{},"flex","; a ",[295,849,850],{},"div"," inside ",[295,853,836],{}," causes a hydration mismatch.",[314,856,858],{"id":857},"showing-fields-by-selection","Showing fields by selection",[292,860,861,862,865],{},"The mailing address only appears when \"Mail\" is selected; the schema switches by delivery method with ",[295,863,864],{},"v.variant",", and the address is required for mail.",[345,867],{"name":868},"radio-group-conditional",[309,870,872],{"id":871},"props","Props",[874,875],"component-props",{"name":876},"ShuoRadioGroup",[292,878,879,880,883,884,382,887,382,889,382,892,382,895,336,898,343],{},"See ",[304,881,102],{"href":882},"\u002Fcomponents\u002Foverview\u002Fcommon#shared-props"," for the behavior of ",[295,885,886],{},"size",[295,888,332],{},[295,890,891],{},"loading",[295,893,894],{},"skeleton",[295,896,897],{},"id",[295,899,900],{},"name",[292,902,903,905,906,336,908,911,912,336,914,917,918,343],{},[295,904,617],{}," supports ",[295,907,625],{},[295,909,910],{},"card","; Nuxt UI's ",[295,913,621],{},[295,915,916],{},"highlight"," are not supported; see ",[304,919,921],{"href":920},"\u002Fcomponents\u002Foverview\u002Fcommon#built-on-nuxt-ui","Built on Nuxt UI",[314,923,925],{"id":924},"item-fields","Item fields",[292,927,928,929,932,933,935],{},"Items (",[295,930,931],{},"RadioGroupOption",") use Nuxt UI's item fields, with ",[295,934,301],{}," limited to strings.",[621,937,938,954],{},[939,940,941],"thead",{},[942,943,944,948,951],"tr",{},[945,946,947],"th",{},"Field",[945,949,950],{},"Type",[945,952,953],{},"Description",[955,956,957,974,989,1003,1024,1040],"tbody",{},[942,958,959,964,969],{},[960,961,962],"td",{},[295,963,325],{},[960,965,966,968],{},[295,967,478],{}," (required)",[960,970,971,972],{},"Label; the field name can be set with ",[295,973,501],{},[942,975,976,980,984],{},[960,977,978],{},[295,979,301],{},[960,981,982,968],{},[295,983,478],{},[960,985,986,987],{},"Bound value; the field name can be set with ",[295,988,504],{},[942,990,991,995,1000],{},[960,992,993],{},[295,994,332],{},[960,996,997],{},[295,998,999],{},"boolean",[960,1001,1002],{},"Disables this item; a selected disabled item stays selected, and arrow keys and Tab skip it",[942,1004,1005,1011,1014],{},[960,1006,1007,382,1009],{},[295,1008,432],{},[295,1010,393],{},[960,1012,1013],{},"—",[960,1015,1016,1017,1019,1020,1023],{},"Class and style overrides for this item, with the same parts as Nuxt UI; each ",[295,1018,393],{}," part only accepts a class string or a ",[295,1021,1022],{},"(defaults) => string"," function, not arrays or objects",[942,1025,1026,1030,1034],{},[960,1027,1028],{},[295,1029,557],{},[960,1031,1032],{},[295,1033,478],{},[960,1035,1036,1037],{},"Item description, shown below the label and wrapped; the field name can be set with ",[295,1038,1039],{},"descriptionKey",[942,1041,1042,1045,1047],{},[960,1043,1044],{},"Other fields",[960,1046,1013],{},[960,1048,1049,1050,517,1052,382,1055,336,1057],{},"Custom fields are kept as is and available on the ",[295,1051,516],{},[295,1053,1054],{},"#label",[295,1056,782],{},[295,1058,520],{},[309,1060,1062],{"id":1061},"slots","Slots",[621,1064,1065,1076],{},[939,1066,1067],{},[942,1068,1069,1072,1074],{},[945,1070,1071],{},"Slot",[945,1073,872],{},[945,1075,953],{},[955,1077,1078,1093,1110,1130],{},[942,1079,1080,1085,1087],{},[960,1081,1082],{},[295,1083,1084],{},"legend",[960,1086,1013],{},[960,1088,1089,1090,1092],{},"Group title, as in Nuxt UI; use the ",[295,1091,1084],{}," prop when you only need text",[942,1094,1095,1099,1107],{},[960,1096,1097],{},[295,1098,325],{},[960,1100,1101,382,1103,382,1105],{},[295,1102,516],{},[295,1104,827],{},[295,1106,830],{},[960,1108,1109],{},"Item label, inside the truncation layer; truncated with a Tooltip when too wide",[942,1111,1112,1116,1124],{},[960,1113,1114],{},[295,1115,557],{},[960,1117,1118,382,1120,382,1122],{},[295,1119,516],{},[295,1121,827],{},[295,1123,830],{},[960,1125,1126,1127],{},"Item description; see ",[304,1128,776],{"href":1129},"#custom-card-content",[942,1131,1132,1137,1150],{},[960,1133,1134],{},[295,1135,1136],{},"item-append",[960,1138,1139,382,1141,382,1143,382,1145,382,1147],{},[295,1140,516],{},[295,1142,830],{},[295,1144,332],{},[295,1146,711],{},[295,1148,1149],{},"select()",[960,1151,1152,1153],{},"Content next to the item label; see ",[304,1154,679],{"href":1155},"#item-append-content",[309,1157,1159],{"id":1158},"styling","Styling",[292,1161,1162,1163,1165,1166,1173],{},"The built-in styles are written in ",[295,1164,393],{}," and can be overridden directly (see ",[304,1167,1169,1170,1172],{"href":1168},"\u002Fgetting-started\u002Ftheme\u002Ftheming#per-component-ui-prop","Per-component ",[295,1171,393],{}," prop","):",[621,1175,1176,1188],{},[939,1177,1178],{},[942,1179,1180,1182,1185],{},[945,1181,1071],{},[945,1183,1184],{},"Part",[945,1186,1187],{},"Built-in styles",[955,1189,1190,1213,1237,1264,1279,1309],{},[942,1191,1192,1197,1200],{},[960,1193,1194],{},[295,1195,1196],{},"root",[960,1198,1199],{},"Outer frame",[960,1201,1202,1205,1206,1209,1210],{},[295,1203,1204],{},"w-fit max-w-full min-w-0","; ",[295,1207,1208],{},"w-full max-w-full min-w-0"," for ",[295,1211,1212],{},"grid",[942,1214,1215,1219,1222],{},[960,1216,1217],{},[295,1218,793],{},[960,1220,1221],{},"Item container",[960,1223,1224,1227,1228,1231,1232,797,1234],{},[295,1225,1226],{},"min-w-0 flex-nowrap justify-start","; horizontal adds ",[295,1229,1230],{},"items-center gap-x-2"," with height matching inputs of the same size; ",[295,1233,1212],{},[295,1235,1236],{},"grid grid-cols-1",[942,1238,1239,1243,1246],{},[960,1240,1241],{},[295,1242,516],{},[960,1244,1245],{},"Single item",[960,1247,1248,1227,1251,1254,1255,797,1257,1259,1260,1263],{},[295,1249,1250],{},"min-w-0 w-fit max-w-full text-start",[295,1252,1253],{},"items-center"," and can shrink; ",[295,1256,1212],{},[295,1258,1253],{}," with a minimum height matching inputs of the same size; ",[295,1261,1262],{},"relative"," while loading",[942,1265,1266,1271,1274],{},[960,1267,1268],{},[295,1269,1270],{},"base",[960,1272,1273],{},"Radio button",[960,1275,1276,1263],{},[295,1277,1278],{},"opacity-0",[942,1280,1281,1285,1288],{},[960,1282,1283],{},[295,1284,804],{},[960,1286,1287],{},"Item label wrapper",[960,1289,1290,1205,1293,1296,1297,760,1300,382,1303,760,1306,1308],{},[295,1291,1292],{},"w-auto min-w-0",[295,1294,1295],{},"ms-1"," in horizontal layout (",[295,1298,1299],{},"me-1",[295,1301,1302],{},"indicator=\"end\"",[295,1304,1305],{},"ms-0",[295,1307,594],{},")",[942,1310,1311,1315,1318],{},[960,1312,1313],{},[295,1314,325],{},[960,1316,1317],{},"Item label",[960,1319,1320],{},[295,1321,1322],{},"w-fit max-w-full",[292,1324,818,1325,1327,1328,1331,1332,1335],{},[295,1326,574],{},", these built-in styles are used instead; the other slots keep Nuxt UI's card styles (border, ",[295,1329,1330],{},"p-2.5"," to ",[295,1333,1334],{},"p-4.5"," padding, selected background):",[621,1337,1338,1347],{},[939,1339,1340],{},[942,1341,1342,1344],{},[945,1343,1071],{},[945,1345,1346],{},"Built-in styles (card)",[955,1348,1349,1365,1380,1402,1413],{},[942,1350,1351,1355],{},[960,1352,1353],{},[295,1354,1196],{},[960,1356,1357,1359,1360,1362,1363],{},[295,1358,1204],{}," when horizontal; ",[295,1361,1208],{}," for vertical and ",[295,1364,1212],{},[942,1366,1367,1371],{},[960,1368,1369],{},[295,1370,793],{},[960,1372,1373,1205,1376,797,1378],{},[295,1374,1375],{},"min-w-0 flex-nowrap justify-start gap-2",[295,1377,1212],{},[295,1379,1236],{},[942,1381,1382,1386],{},[960,1383,1384],{},[295,1385,516],{},[960,1387,1388,1227,1391,1394,1395,1397,1398,1205,1400,1263],{},[295,1389,1390],{},"min-w-0 max-w-full text-start",[295,1392,1393],{},"flex-[0_1_auto]"," to shrink, vertical and ",[295,1396,1212],{}," add ",[295,1399,810],{},[295,1401,1262],{},[942,1403,1404,1408],{},[960,1405,1406],{},[295,1407,804],{},[960,1409,1410],{},[295,1411,1412],{},"min-w-0 flex-1",[942,1414,1415,1419],{},[960,1416,1417],{},[295,1418,325],{},[960,1420,1421],{},[295,1422,1322],{},[292,1424,1425,1426,1429,1430,1432,1433,1435,1436,1438,1439,343],{},"For example, ",[295,1427,1428],{},":ui=\"{ fieldset: 'gap-x-8' }\""," widens the gap between items in horizontal layout. The defaults passed to the function form include the built-in styles above; when replacing ",[295,1431,793],{}," in ",[295,1434,1212],{}," mode, keep ",[295,1437,1212],{},", for example ",[295,1440,1441],{},"(defaults) => defaults.replace('grid-cols-1', 'grid-cols-3')",[309,1443,1445],{"id":1444},"changelog","Changelog",[1447,1448],"component-changelog",{"name":876},{"title":1450,"searchDepth":1451,"depth":1451,"links":1452},"",2,[1453,1464,1471,1474,1475,1476],{"id":311,"depth":1451,"text":312,"children":1454},[1455,1457,1458,1459,1460,1461,1462,1463],{"id":316,"depth":1456,"text":317},3,{"id":350,"depth":1456,"text":351},{"id":404,"depth":1456,"text":405},{"id":439,"depth":1456,"text":440},{"id":550,"depth":1456,"text":551},{"id":568,"depth":1456,"text":569},{"id":640,"depth":1456,"text":641},{"id":656,"depth":1456,"text":657},{"id":674,"depth":1451,"text":675,"children":1465},[1466,1467,1468,1469,1470],{"id":678,"depth":1456,"text":679},{"id":731,"depth":1456,"text":732},{"id":753,"depth":1456,"text":754},{"id":775,"depth":1456,"text":776},{"id":857,"depth":1456,"text":858},{"id":871,"depth":1451,"text":872,"children":1472},[1473],{"id":924,"depth":1456,"text":925},{"id":1061,"depth":1451,"text":1062},{"id":1158,"depth":1451,"text":1159},{"id":1444,"depth":1451,"text":1445},"Radio group that lays out by viewport width, with a card appearance, custom item fields and appended content.",[1479],{"label":649,"icon":1480,"to":1481,"target":1482},"i-simple-icons-nuxtdotjs","https:\u002F\u002Fui.nuxt.com\u002Fdocs\u002Fcomponents\u002Fradio-group","_blank",{},{"title":142,"icon":145},{"title":142,"description":1477},"Pi-2uy7ICUx1NUkiKDAuSQMvh62vUYxHQrx9gvDn9UY",[1488,1490],{"title":137,"path":138,"stem":139,"description":1489,"icon":140,"children":-1},"Single checkbox with custom checked values and optional content next to the label.",{"title":147,"path":148,"stem":149,"description":1491,"icon":150,"children":-1},"Checkbox group that lays out by viewport width, with custom item fields and appended content.",1793866147372]