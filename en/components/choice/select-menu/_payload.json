fields",[304,575,576,577,374,580,583,584,374,587,590,591,594,595,598,599,601],{},"When the back-end fields are not ",[307,578,579],{},"label",[307,581,582],{},"value",", set them with ",[307,585,586],{},"label-key",[307,588,589],{},"value-key",". Props of ",[307,592,593],{},"USelectMenu"," such as ",[307,596,597],{},"description-key"," work directly too; field names are inferred from ",[307,600,439],{},", and a wrong name is a type error.",[355,603],{"name":604},"select-menu-keys",[329,606,608],{"id":607},"search","Search",[304,610,611,612,615,616,618,619,622],{},"The menu has a built-in search input with the placeholder \"Search...\" (\"關鍵字查詢...\" in Traditional Chinese), which can be changed in ",[316,613,47],{"href":614},"\u002Fgetting-started\u002Ftheme\u002Fmessages#overridable-items",". The search matches the ",[307,617,586],{}," field and is not affected by the display format. With only a few items, pass ",[307,620,621],{},":search-input=\"false\""," to hide the search input.",[355,624],{"name":625},"select-menu-search",[329,627,629],{"id":628},"variants","Variants",[304,631,632,633,636,637,374,640,643,644,353],{},"Uses the ",[307,634,635],{},"variant",", ",[307,638,639],{},"color",[307,641,642],{},"highlight"," of ",[307,645,593],{},[355,647],{"name":648},"select-menu-variant",[329,650,652],{"id":651},"icon","Icon",[304,654,632,655,374,657,643,660,662,663,665,666,668],{},[307,656,651],{},[307,658,659],{},"trailing-icon",[307,661,593],{},"; ",[307,664,651],{}," shows on the left, and ",[307,667,659],{}," replaces the arrow on the right.",[355,670],{"name":671},"select-menu-icon",[329,673,675],{"id":674},"size-and-states","Size and states",[304,677,678,679,682],{},"While loading, a spinner replaces the arrow on the right and the menu is disabled. Switching to skeleton, disabled or loading closes an open menu, and it does not reopen afterwards. See ",[316,680,102],{"href":681},"\u002Fcomponents\u002Foverview\u002Fcommon"," for the behavior shared by all states.",[355,684],{"name":685},"select-menu-states",[324,687,689],{"id":688},"examples","Examples",[329,691,693],{"id":692},"with-form-validation","With form validation",[304,695,696,697,699,700,703,704,699,706,353],{},"An empty single selection is ",[307,698,344],{},", so use ",[307,701,702],{},"requiredText","; an empty multiple selection is ",[307,705,352],{},[307,707,708],{},"requiredArray",[355,710],{"name":711},"select-menu-validation",[329,713,715],{"id":714},"truncated-text-tooltip","Truncated text tooltip",[304,717,718,719,722,723,314,726,730],{},"When the selected text is wider than the field, it is truncated with an ellipsis, and a tooltip shows the full text on hover or focus, or on long press on touch devices (see ",[316,720,217],{"href":721},"\u002Fcomponents\u002Fhelper\u002Ftooltip#touch-long-press","); a long press does not open the menu. The tooltip is not shown while the menu is open. Set the width on ",[307,724,725],{},"ui.wrapper",[316,727,729],{"href":728},"#styling","Styling"," below.",[355,732],{"name":733},"select-menu-truncate",[329,735,737],{"id":736},"loading-items-asynchronously","Loading items asynchronously",[304,739,740,741,744,745,747,748,751],{},"While fetching items from the back end, use ",[307,742,743],{},"loading"," to show a spinner and disable the menu, then fill in ",[307,746,439],{}," when the request completes. When the bound value has no matching item, ",[307,749,750],{},"placeholder"," is shown, and the label appears automatically once the items arrive.",[355,753],{"name":754},"select-menu-async",[329,756,758],{"id":757},"dependent-menus","Dependent menus",[304,760,761,762,764],{},"When the city changes, the district is cleared, and the district ",[307,763,439],{}," are computed from the city.",[355,766],{"name":767},"select-menu-cascade",[329,769,771],{"id":770},"opening-the-menu","Opening the menu",[304,773,774,775,778,779,782],{},"Get the trigger button through ",[307,776,777],{},"triggerRef"," on the template ref and call ",[307,780,781],{},"click()"," to open the menu.",[355,784],{"name":785},"select-menu-expose",[324,787,789],{"id":788},"props","Props",[791,792],"component-props",{"name":412},[304,794,795,796,799,800,636,803,636,806,636,808,636,811,374,814,353],{},"See ",[316,797,102],{"href":798},"\u002Fcomponents\u002Foverview\u002Fcommon#shared-props"," for the behavior of ",[307,801,802],{},"size",[307,804,805],{},"disabled",[307,807,743],{},[307,809,810],{},"skeleton",[307,812,813],{},"id",[307,815,816],{},"name",[304,818,819,820,823,824,374,827,830],{},"When ",[307,821,822],{},"open"," is not set, the user opens and closes the menu; there is no v-model for it. The types of ",[307,825,826],{},"clear",[307,828,829],{},"clearIcon"," are inferred from another Nuxt UI generic that this component does not provide, so they are not in its types.",[324,832,834],{"id":833},"slots","Slots",[304,836,837,838,840,841,636,844,636,847,636,850,636,853,856],{},"Every slot of ",[307,839,593],{}," is available (",[307,842,843],{},"leading",[307,845,846],{},"trailing",[307,848,849],{},"item",[307,851,852],{},"item-leading",[307,854,855],{},"content-top"," and so on). These three replace the component's built-in content when passed:",[858,859,860,873],"table",{},[861,862,863],"thead",{},[864,865,866,870],"tr",{},[867,868,869],"th",{},"Slot",[867,871,872],{},"Built-in content",[874,875,876,889,901],"tbody",{},[864,877,878,884],{},[879,880,881],"td",{},[307,882,883],{},"item-label",[879,885,886,887],{},"The item text formatted by ",[307,888,365],{},[864,890,891,896],{},[879,892,893],{},[307,894,895],{},"default",[879,897,898,899],{},"The selected text formatted by ",[307,900,365],{},[864,902,903,908],{},[879,904,905],{},[307,906,907],{},"empty",[879,909,910],{},"\"No options\" (by locale)",[324,912,914],{"id":913},"expose","Expose",[858,916,917,930],{},[861,918,919],{},[864,920,921,924,927],{},[867,922,923],{},"Name",[867,925,926],{},"Type",[867,928,929],{},"Description",[874,931,932,946],{},[864,933