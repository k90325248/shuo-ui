},", and a wrong name is a type error.",[355,788],{"name":789},"select-menu-keys",[329,791,793],{"id":792},"search","Search",[304,795,796,797,800,801,803,804,807],{},"The menu has a built-in search input with the placeholder \"Search...\" (\"關鍵字查詢...\" in Traditional Chinese), which can be changed in ",[316,798,47],{"href":799},"\u002Fgetting-started\u002Ftheme\u002Fmessages#overridable-items",". The search matches the ",[307,802,771],{}," field and is not affected by the display format. With only a few items, pass ",[307,805,806],{},":search-input=\"false\""," to hide the search input.",[355,809],{"name":810},"select-menu-search",[329,812,814],{"id":813},"variants","Variants",[304,816,817,818,821,822,374,825,828,829,353],{},"Uses the ",[307,819,820],{},"variant",", ",[307,823,824],{},"color",[307,826,827],{},"highlight"," of ",[307,830,778],{},[355,832],{"name":833},"select-menu-variant",[329,835,837],{"id":836},"icon","Icon",[304,839,817,840,374,842,828,845,847,848,850,851,853],{},[307,841,836],{},[307,843,844],{},"trailing-icon",[307,846,778],{},"; ",[307,849,836],{}," shows on the left, and ",[307,852,844],{}," replaces the arrow on the right.",[355,855],{"name":856},"select-menu-icon",[329,858,860],{"id":859},"size-and-states","Size and states",[304,862,863,864,867],{},"While loading, a spinner replaces the arrow on the right and the menu is disabled. Switching to skeleton, disabled or loading closes an open menu, and it does not reopen afterwards. See ",[316,865,102],{"href":866},"\u002Fcomponents\u002Foverview\u002Fcommon"," for the behavior shared by all states.",[355,869],{"name":870},"select-menu-states",[324,872,874],{"id":873},"examples","Examples",[329,876,878],{"id":877},"with-form-validation","With form validation",[304,880,881,882,884,885,888,889,884,891,353],{},"An empty single selection is ",[307,883,344],{},", so use ",[307,886,887],{},"requiredText","; an empty multiple selection is ",[307,890,352],{},[307,892,893],{},"requiredArray",[355,895],{"name":896},"select-menu-validation",[329,898,900],{"id":899},"truncated-text-tooltip","Truncated text tooltip",[304,902,903,904,907,908,314,911,915],{},"When the selected text is wider than the field, it is truncated with an ellipsis, and a tooltip shows the full text on hover or focus, or on long press on touch devices (see ",[316,905,217],{"href":906},"\u002Fcomponents\u002Fhelper\u002Ftooltip#touch-long-press","); a long press does not open the menu. The tooltip is not shown while the menu is open. Set the width on ",[307,909,910],{},"ui.wrapper",[316,912,914],{"href":913},"#styling","Styling"," below.",[355,917],{"name":918},"select-menu-truncate",[329,920,922],{"id":921},"loading-items-asynchronously","Loading items asynchronously",[304,924,925,926,929,930,932,933,936],{},"While fetching items from the back end, use ",[307,927,928],{},"loading"," to show a spinner and disable the menu, then fill in ",[307,931,439],{}," when the request completes. When the bound value has no matching item, ",[307,934,935],{},"placeholder"," is shown, and the label appears automatically once the items arrive.",[355,938],{"name":939},"select-menu-async",[329,941,943],{"id":942},"dependent-menus","Dependent menus",[304,945,946,947,949],{},"When the city changes, the district is cleared, and the district ",[307,948,439],{}," are computed from the city.",[355,951],{"name":952},"select-menu-cascade",[329,954,956],{"id":955},"opening-the-menu","Opening the menu",[304,958,959,960,963,964,967],{},"Get the trigger button through ",[307,961,962],{},"triggerRef"," on the template ref and call ",[307,965,966],{},"click()"," to open the menu.",[355,969],{"name":970},"select-menu-expose",[324,972,974],{"id":973},"props","Props",[976,977],"component-props",{"name":412},[304,979,980,981,984,985,821,988,821,991,821,993,821,996,374,999,353],{},"See ",[316,982,102],{"href":983},"\u002Fcomponents\u002Foverview\u002Fcommon#shared-props"," for the behavior of ",[307,986,987],{},"size",[307,989,990],{}