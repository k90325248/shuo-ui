9,800,803],{},"The menu has a built-in search input with the placeholder \"Search...\" (\"關鍵字查詢...\" in Traditional Chinese), which can be changed in ",[312,794,47],{"href":795},"\u002Fgetting-started\u002Ftheme\u002Fmessages#overridable-items",". The search matches the ",[303,798,767],{}," field and is not affected by the display format. With only a few items, pass ",[303,801,802],{},":search-input=\"false\""," to hide the search input.",[351,805],{"name":806},"select-menu-search",[325,808,810],{"id":809},"variants","Variants",[300,812,813,814,817,818,370,821,824,825,349],{},"Uses the ",[303,815,816],{},"variant",", ",[303,819,820],{},"color",[303,822,823],{},"highlight"," of ",[303,826,774],{},[351,828],{"name":829},"select-menu-variant",[325,831,833],{"id":832},"icon","Icon",[300,835,813,836,370,838,824,841,843,844,846,847,849],{},[303,837,832],{},[303,839,840],{},"trailing-icon",[303,842,774],{},"; ",[303,845,832],{}," shows on the left, and ",[303,848,840],{}," replaces the arrow on the right.",[351,851],{"name":852},"select-menu-icon",[325,854,856],{"id":855},"size-and-states","Size and states",[300,858,859,860,863],{},"While loading, a spinner replaces the arrow on the right and the menu is disabled. Switching to skeleton, disabled or loading closes an open menu, and it does not reopen afterwards. See ",[312,861,102],{"href":862},"\u002Fcomponents\u002Foverview\u002Fcommon"," for the behavior shared by all states.",[351,865],{"name":866},"select-menu-states",[320,868,870],{"id":869},"examples","Examples",[325,872,874],{"id":873},"with-form-validation","With form validation",[300,876,877,878,880,881,884,885,880,887,349],{},"An empty single selection is ",[303,879,340],{},", so use ",[303,882,883],{},"requiredText","; an empty multiple selection is ",[303,886,348],{},[303,888,889],{},"requiredArray",[351,891],{"name":892},"select-menu-validation",[325,894,896],{"id":895},"truncated-text-tooltip","Truncated text tooltip",[300,898,899,900,903,904,310,907,911],{},"When the selected text is wider than the field, it is truncated with an ellipsis, and a tooltip shows the full text on hover or focus, or on long press on touch devices (see ",[312,901,217],{"href":902},"\u002Fcomponents\u002Fhelper\u002Ftooltip#touch-long-press","); a long press does not open the menu. The tooltip is not shown while the menu is open. Set the width on ",[303,905,906],{},"ui.wrapper",[312,908,910],{"href":909},"#styling","Styling"," below.",[351,913],{"name":914},"select-menu-truncate",[325,916,918],{"id":917},"loading-items-asynchronously","Loading items asynchronously",[300,920,921,922,925,926,928,929,932],{},"While fetching items from the back end, use ",[303,923,924],{},"loading"," to show a spinner and disable the menu, then fill in ",[303,927,435],{}," when the request completes. When the bound value has no matching item, ",[303,930,931],{},"placeholder"," is shown, and the label appears automatically once the items arrive.",[351,934],{"name":935},"select-menu-async",[325,937,939],{"id":938},"dependent-menus","Dependent menus",[300,941,942,943,945],{},"When the city changes, the district is cleared, and the district ",[303,944,435],{}," are computed from the city.",[351,947],{"name":948},"select-menu-cascade",[325,950,952],{"id":951},"opening-the-menu","Opening the menu",[300,954,955,956,959,960,963],{},"Get the trigger button through ",[303,957,958],{},"triggerRef"," on the template ref and call ",[303,961,962],{},"click()"," to open the menu.",[351,965],{"name":966},"select-menu-expose",[320,968,970],{"id":969},"props","Props",[972,973],"component-props",{"name":408},[300,975,976,977,980,981,817,984,817,987,817,989,817,992,370,995,349],{},"See ",[312,978,102],{"href":979},"\u002Fcomponents\u002Foverview\u002Fcommon#shared-props"," for the behavior of ",[303,982,983],{},"size",[303,985,986],{},"disabled",[303,988,924],{},[303,990,991],{},"skeleton",[303,993,994],{},"id",[303,996,997],{},"name",[300,999,1000,1001,1004,1005,370,1007,1010],{},"W