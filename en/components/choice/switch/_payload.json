tip shows the full text on hover or focus, or on long press on touch devices (see ",[340,341,217],"a",{"href":342},"\u002Fcomponents\u002Fhelper\u002Ftooltip#touch-long-press","), the same as the ",[340,345,347],{"href":346},"\u002Fcomponents\u002Fchoice\u002Fcheckbox#label","checkbox",". The description wraps: without one the height matches an input, and with one the switch grows while its first line still lines up with fields next to it.",[350,351],"component-example",{"name":352},"switch-basic",[325,354,355],{"id":313},"Action",[304,357,358,360],{},[307,359,313],{}," runs after toggling, receives the new value and may return a Promise. Use it for settings that are saved through an API as soon as they change, such as enabling an account or notifications.",[350,362],{"name":363},"switch-action",[365,366,367,390],"table",{},[368,369,370],"thead",{},[371,372,373,377,379,384],"tr",{},[374,375,376],"th",{},"Stage",[374,378,152],{},[374,380,381],{},[307,382,383],{},"v-model",[374,385,386,389],{},[307,387,388],{},"change"," event",[391,392,393,408,422,434],"tbody",{},[371,394,395,399,402,405],{},[396,397,398],"td",{},"Pending",[396,400,401],{},"Shows the new value, loading and disabled",[396,403,404],{},"Unchanged",[396,406,407],{},"Not emitted",[371,409,410,413,416,419],{},[396,411,412],{},"Success",[396,414,415],{},"Keeps the new value, loading and disabled end",[396,417,418],{},"Updated to the new value",[396,420,421],{},"Emitted",[371,423,424,427,430,432],{},[396,425,426],{},"Failure",[396,428,429],{},"Goes back to the old value, loading and disabled end",[396,431,404],{},[396,433,407],{},[371,435,436,439,442,444],{},[396,437,438],{},"Error",[396,440,441],{},"Same as failure",[396,443,404],{},[396,445,407],{},[447,448,449,466,483,491],"ul",{},[450,451,452,455,456,459,460,462,463,318],"li",{},[453,454,412],"strong",{},": only returning ",[307,457,458],{},"false"," (or a Promise resolving to ",[307,461,458],{},") counts as a failure. Any other value is a success, inclu