s layout. See ",[324,413,102],{"href":414},"\u002Fcomponents\u002Foverview\u002Fcommon"," for the behavior shared by all states.",[350,417],{"name":418},"months-states",[330,420,422],{"id":421},"examples","Examples",[335,424,426],{"id":425},"with-form-validation","With form validation",[308,428,429,430,433,434,318,437,440],{},"Bind the total months, use ",[311,431,432],{},"requiredNumber"," for a required field, and check bounds separately with ",[311,435,436],{},"v.minValue",[311,438,439],{},"v.maxValue",".",[350,442],{"name":443},"months-validation",[335,445,447],{"id":446},"binding-only-years-and-months","Binding only years and months",[308,449,450,451,318,453,440],{},"When the API splits seniority into year and month fields, bind only ",[311,452,317],{},[311,454,321],{},[350,456],{"name":457},"months-year-month",[330,459,327],{"id":327},[461,462,463,478],"table",{},[464,465,466],"thead",{},[467,468,469,472,475],"tr",{},[470,471,327],"th",{},[470,473,474],{},"Type",[470,476,477],{},"Description",[479,480,481,496,509],"tbody",{},[467,482,483,488,493],{},[484,485,486],"td",{},[311,487,327],{},[484,489,490],{},[311,491,492],{},"number | null",[484,494,495],{},"Total months",[467,497,498,502,506],{},[484,499,500],{},[311,501,317],{},[484,503,504],{},[311,505,492],{},[484,507,508],{},"Years",[467,510,511,515,519],{},[484,512,513],{},[311,514,321],{},[484,516,517],{},[311,518,492],{},[484,520,167],{},[330,522,524],{"id":523},"props","Props",[526,527],"component-props",{"name":528},"ShuoMonths",[308,530,531,532,535,536,539,540,539,543,539,546,318,549,552,553,556],{},"See ",[324,533,102],{"href":534},"\u002Fcomponents\u002Foverview\u002Fcommon#shared-props"," for the behavior of ",[311,537,538],{},"size",", ",[311,541,542],{},"disabled",[311,544,545],{},"loading",[311,547,548],{},"skeleton",[311,550,551],{},"name","; ",[311,554,555],{},"id"," points to the years input, or the total months input in narrow containers.",[330,558,560],{"id":559},"styling","Styling",[308,562,