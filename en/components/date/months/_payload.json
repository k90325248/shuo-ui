id":336},"usage","Usage",[339,340,342],"h3",{"id":341},"converting-years-and-months","Converting years and months",[312,344,345,347,348,322,350,352],{},[315,346,331],{}," is the total number of months, and ",[315,349,321],{},[315,351,325],{}," are the split years and months (0–11); the three bindings stay in sync.",[354,355],"component-example",{"name":356},"months-basic",[358,359,360,364,367],"ul",{},[361,362,363],"li",{},"Only non-negative integers are accepted. The value carries over only after focus leaves the whole group (moving focus between years and months does not commit, so both can be cleared together): 0 years 13 months becomes 1 year 1 month, 13 months in total.",[361,365,366],{},"The three bindings can be used alone or together. When the parent fills in total months and years\u002Fmonths that conflict, total months win; when only years\u002Fmonths are filled in, they are summed again and carried over.",[361,368,369,370,373,374,377],{},"An empty side counts as 0; when both are empty, all three bindings are ",[315,371,372],{},"null",". Strings, negative numbers, decimals, ",[315,375,376],{},"NaN"," or values beyond the safe integer range from the parent count as empty.",[339,379,381],{"id":380},"narrow-containers","Narrow containers",[312,383,384],{},"When the container is too narrow for both the years and months inputs, it switches to a single \"total months\" input; with enough width it goes back to both inputs, keeping any input not yet committed.",[354,386],{"name":387},"months-compact",[339,389,391],{"id":390},"variants","Variants",[312,393,394,395,322,398,401,402,405],{},"Uses the ",[315,396,397],{},"color",[315,399,400],{},"highlight"," of ",[315,403,404],{},"UInput",", applied to every input.",[354,407],{"name":408},"months-color",[339,410,412],{"id":411},"size-and-states","Size and states",[312,414,415,416,419],{},"While loading, a spinner shows after the months unit and input is disabled. The year and month units switch with the locale (\"yr\" and \"mo\" in English, \"年\" and \"月\" in Traditional Chinese); their width follows the text, and so does the width needed for the full years and months layout. See ",[328,417,102],{"href":418},"\u002Fcomponents\u002Foverview\u002Fcommon"," for the behavior shared by all states.",[354,421],{"name":422},"months-states",[334,424,426],{"id":425},"examples","Examples",[339,428,430],{"id":429},"with-form-validation","With form validation",[312,432,433,434,437,438,322,441,444],{},"Bind the total months, use ",[315,435,436],{},"requiredNumber"," for a required field, and check bounds separately with ",[315,439,440],{},"v.minValue",[315,442,443],{},"v.maxValue",".",[354,446],{"name":447},"months-validation",[339,449,451],{"id":450},"binding-only-years-and-months","Binding only years and months",[312,453,454,455,322,457,444],{},"When the API splits seniority into year and month fields, bind only ",[315,456,321],{},[315,458,325],{},[354,460],{"name":461},"months-year-month",[334,463,331],{"id":331},[465,466,467,482],"table",{},[468,469,470],"thead",{},[471,472,473,476,479],"tr",{},[474,475,331],"th",{},[474,477,478],{},"Type",[474,480,481],{},"Description",[483,484,485,500,513],"tbody",{},[471,486,487,492,497],{},[488,489,490],"td",{},[315,491,331],{},[488,493,494],{},[315,495,496],{},"number | null",[488,498,499],{},"Total months",[471,501,502,506,510],{},[488,503,504],{},[315,505,321],{},[488,507,508],{},[315,509,496],{},[488,511,512],{},"Years",[471,514,515,519,523],{},[488,516,517],{},[315,518,325],{},[488,520,521],{},[315,522,496],{},[488,524,167],{},[334,526,528],{"id":527},"props","Props",[530,531],"component-props",{"name":532},"ShuoMonths",[312,534,535,536,539,540,543,544,543,547,543,550,322,553,556,557,560],{},"See ",[328,537,102],{"href":538},"\u002Fcomponents\u002Foverview\u002Fcommon#shared-props"," for the behavior of ",[315,541,542],{},"size",", ",[315,545,546],{},"disabled",[315,548,549],{},"loading",[315,551,552],{},"skeleton",[315,554,555],{},"name","; ",[31