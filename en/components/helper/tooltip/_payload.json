","\u002Fen\u002Freleases\u002Fversions\u002Fv1-0-1","en\u002F5.releases\u002F1.versions\u002F3.v1-0-1",{"id":276,"title":202,"body":277,"description":480,"extension":481,"links":482,"meta":487,"navigation":488,"path":203,"seo":489,"stem":204,"__hash__":490},"docs_en\u002Fen\u002F3.components\u002F7.helper\u002F2.tooltip.md",{"type":278,"value":279,"toc":467},"minimark",[280,302,309,314,319,340,343,347,350,366,377,380,391,395,405,408,412,415,419,460,464],[281,282,283,284,288,289,292,293,295,296,298,299,301],"p",{},"Nuxt UI's ",[285,286,287],"code",{},"UTooltip"," only shows on hover or keyboard focus, so on phones neither tapping nor holding shows it. ",[285,290,291],{},"ShuoTooltip"," keeps every prop and slot of ",[285,294,287],{}," and only adds long press on touch devices; just change ",[285,297,287],{}," to ",[285,300,291],{},".",[281,303,304,305,308],{},"Every tooltip in the library uses it: ",[285,306,307],{},"ShuoInfoTooltip"," and the truncated-text tooltips of the select menu, date picker, file input, checkbox and option groups all show on long press on phones too.",[310,311,313],"h2",{"id":312},"usage","Usage",[315,316,318],"h3",{"id":317},"tooltip-text","Tooltip text",[281,320,321,324,325,328,329,328,332,335,336,339],{},[285,322,323],{},"text"," is the tooltip content, and the trigger goes in the default slot. Props such as ",[285,326,327],{},"kbds",", ",[285,330,331],{},"content",[285,333,334],{},"arrow"," and ",[285,337,338],{},"delayDuration"," are the same as Nuxt UI.",[341,342],"component-example",{"name":317},[315,344,346],{"id":345},"touch-long-press","Touch long press",[281,348,349],{},"On touch devices, holding the trigger for about 0.5 seconds shows the tooltip, which stays open after you lift your finger and closes when you tap elsewhere or scroll the page.",[351,352,353,357,360,363],"ul",{},[354,355,356],"li",{},"When a long press shows the tooltip, lifting your finger does not trigger the trigger's own action (click, check, open a menu and so on).",[354,358,359],{},"A normal tap triggers the original action as usual without showing the tooltip; focus caused by a tap does not show it either.",[354,361,362],{},"Moving your finger after pressing counts as scrolling and does not show the tooltip.",[354,364,365],{},"During a long press, the browser's long-press menu is not shown and text inside the trigger is not selected (except in inputs).",[281,367,368,369,372,373,376],{},"With ",[285,370,371],{},"touch"," set to ",[285,374,375],{},"false",", it behaves like the original Nuxt UI tooltip and touch cannot open it.",[341,378],{"name":379},"tooltip-touch",[281,381,382,383,386,387,301],{},"To turn it off site-wide, set ",[285,384,385],{},"components.tooltip.touch: false","; the tooltips inside the library turn off too. See ",[388,389,42],"a",{"href":390},"\u002Fgetting-started\u002Ftheme\u002Fcomponent-defaults",[315,392,394],{"id":393},"open-state","Open state",[281,396,397,398,401,402,301],{},"Bind the open state with ",[285,399,400],{},"v-model:open"," to open or close it from code; without binding, set the initial state with ",[285,403,404],{},"default-open",[341,406],{"name":407},"tooltip-open",[310,409,411],{"id":410},"props","Props",[413,414],"component-props",{"name":291},[310,416,418],{"id":417},"slots","Slots",[420,421,422,435],"table",{},[423,424,425],"thead",{},[426,427,428,432],"tr",{},[429,430,431],"th",{},"Slot",[429,433,434],{},"Description",[436,437,438,449],"tbody",{},[426,439,440,446],{},[441,442,443],"td",{},[285,444,445],{},"default",[441,447,448],{},"The trigger",[426,450,451,455],{},[441,452,453],{},[285,454,331],{},[441,456,457,458],{},"Custom tooltip content, like Nuxt UI's ",[285,459,331],{},[310,461,463],{"id":462},"changelog","Changelog",[465,466],"component-changelog",{"name":291},{"title":468,"searchDepth":469,"depth":469,"links":470},"",2,[471,477,478,479],{"id":312,"depth":469,"text":313,"children":472},[473,475,476],{"id":317,"depth":474,"text":318},3,{"id":345,"depth":474,"text":346},{"id":393,"depth":474,"text":394},{"id":410,"depth":469,"text":411},{"id":417,"depth":469,"text":418},{"id":462,"depth":469,"text":463},"Tooltip built on UTooltip that adds long press on touch devices.","md",[483],{"label":287,"icon":484,"to":485,"target":486},"i-simple-icons-nuxtdotjs","https:\u002F\u002Fui.nuxt.com\u002Fdocs\u002Fcomponents\u002Ftooltip","_blank",{},{"title":202,"icon":205},{"title":202,"description":480},"4565oldi4mLlQ23DDtLB3PNuatpzumlaK2Y6aSQ2HM4",[492,494],{"title":197,"path":198,"stem":199,"description":493,"icon":200,"children":-1},"Info icon with a tooltip, shown on hover, keyboard focus or long press on touch devices.",{"title":62,"path":217,"stem":218,"description":495,"icon":65,"children":-1},"Shared validation rules for Valibot, with consistent error messages across the site.",1793083692382]