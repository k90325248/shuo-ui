02Fen\u002Freleases","en\u002F5.releases",[273],{"title":274,"icon":12,"path":275,"stem":276,"children":277,"page":12},"Versions","\u002Fen\u002Freleases\u002Fversions","en\u002F5.releases\u002F1.versions",[278,282],{"title":279,"path":280,"stem":281},"v2.0.1","\u002Fen\u002Freleases\u002Fversions\u002Fv2-0-1","en\u002F5.releases\u002F1.versions\u002F1.v2-0-1",{"title":283,"path":284,"stem":285},"v2.0.0","\u002Fen\u002Freleases\u002Fversions\u002Fv2-0-0","en\u002F5.releases\u002F1.versions\u002F2.v2-0-0",{"id":287,"title":217,"body":288,"description":491,"extension":492,"links":493,"meta":498,"navigation":499,"path":218,"seo":500,"stem":219,"__hash__":501},"docs_en\u002Fen\u002F3.components\u002F7.helper\u002F2.tooltip.md",{"type":289,"value":290,"toc":478},"minimark",[291,313,320,325,330,351,354,358,361,377,388,391,402,406,416,419,423,426,430,471,475],[292,293,294,295,299,300,303,304,306,307,309,310,312],"p",{},"Nuxt UI's ",[296,297,298],"code",{},"UTooltip"," only shows on hover or keyboard focus, so on phones neither tapping nor holding shows it. ",[296,301,302],{},"ShuoTooltip"," keeps every prop and slot of ",[296,305,298],{}," and only adds long press on touch devices; just change ",[296,308,298],{}," to ",[296,311,302],{},".",[292,314,315,316,319],{},"Every tooltip in the library uses it: ",[296,317,318],{},"ShuoInfoTooltip"," and the truncated-text tooltips of the select menu, date picker, file input, checkbox and option groups all show on long press on phones too.",[321,322,324],"h2",{"id":323},"usage","Usage",[326,327,329],"h3",{"id":328},"tooltip-text","Tooltip text",[292,331,332,335,336,339,340,339,343,346,347,350],{},[296,333,334],{},"text"," is the tooltip content, and the trigger goes in the default slot. Props such as ",[296,337,338],{},"kbds",", ",[296,341,342],{},"content",[296,344,345],{},"arrow"," and ",[296,348,349],{},"delayDuration"," are the same as Nuxt UI.",[352,353],"component-example",{"name":328},[326,355,357],{"id":356},"touch-long-press","Touch long press",[292,359,360],{},"On touch devices, holding the trigger for about 0.5 seconds shows the tooltip, which stays open after you lift your finger and closes when you tap elsewhere or scroll the page.",[362,363,364,368,371,374],"ul",{},[365,366,367],"li",{},"When a long press shows the tooltip, lifting your finger does not trigger the trigger's own action (click, check, open a menu and so on).",[365,369,370],{},"A normal tap triggers the original action as usual without showing the tooltip; focus caused by a tap does not show it either.",[365,372,373],{},"Moving your finger after pressing counts as scrolling and does not show the tooltip.",[365,375,376],{},"During a long press, the browser's long-press menu is not shown and text inside the trigger is not selected (except in inputs).",[292,378,379,380,383,384,387],{},"With ",[296,381,382],{},"touch"," set to ",[296,385,386],{},"false",", it behaves like the original Nuxt UI tooltip and touch cannot open it.",[352,389],{"name":390},"tooltip-touch",[292,392,393,394,397,398,312],{},"To turn it off site-wide, set ",[296,395,396],{},"components.tooltip.touch: false","; the tooltips inside the library turn off too. See ",[399,400,42],"a",{"href":401},"\u002Fgetting-started\u002Ftheme\u002Fcomponent-defaults",[326,403,405],{"id":404},"open-state","Open state",[292,407,408,409,412,413,312],{},"Bind the open state with ",[296,410,411],{},"v-model:open"," to open or close it from code; without binding, set the initial state with ",[296,414,415],{},"default-open",[352,417],{"name":418},"tooltip-open",[321,420,422],{"id":421},"props","Props",[424,425],"component-props",{"name":302},[321,427,429],{"id":428},"slots","Slots",[431,432,433,446],"table",{},[434,435,436],"thead",{},[437,438,439,443],"tr",{},[440,441,442],"th",{},"Slot",[440,444,445],{},"Description",[447,448,449,460],"tbody",{},[437,450,451,457],{},[452,453,454],"td",{},[296,455,456],{},"default",[452,458,459],{},"The trigger",[437,461,462,466],{},[452,463,464],{},[296,465,342],{},[452,467,468,469],{},"Custom tooltip content, like Nuxt UI's ",[296,470,342],{},[321,472,474],{"id":473},"changelog","Changelog",[476,477],"component-changelog",{"name":302},{"title":479,"searchDepth":480,"depth":480,"links":481},"",2,[482,488,489,490],{"id":323,"depth":480,"text":324,"children":483},[484,486,487],{"id":328,"depth":485,"text":329},3,{"id":356,"depth":485,"text":357},{"id":404,"depth":485,"text":405},{"id":421,"depth":480,"text":422},{"id":428,"depth":480,"text":429},{"id":473,"depth":480,"text":474},"Tooltip built on UTooltip that adds long press on touch devices.","md",[494],{"label":298,"icon":495,"to":496,"target":497},"i-simple-icons-nuxtdotjs","https:\u002F\u002Fui.nuxt.com\u002Fdocs\u002Fcomponents\u002Ftooltip","_blank",{},{"title":217,"icon":220},{"title":217,"description":491},"4565oldi4mLlQ23DDtLB3PNuatpzumlaK2Y6aSQ2HM4",[503,505],{"title":212,"path":213,"stem":214,"description":504,"icon":215,"children":-1},"Info icon with a tooltip, shown on hover, keyboard focus or long press on touch devices.",{"title":62,"path":232,"stem":233,"description":506,"icon":65,"children":-1},"Shared validation rules for Valibot, with consistent error messages across the site.",1793594917049]