02Fen\u002Freleases","en\u002F5.releases",[273],{"title":274,"icon":12,"path":275,"stem":276,"children":277,"page":12},"Versions","\u002Fen\u002Freleases\u002Fversions","en\u002F5.releases\u002F1.versions",[278,282,286,290],{"title":279,"path":280,"stem":281},"v1.2.1","\u002Fen\u002Freleases\u002Fversions\u002Fv1-2-1","en\u002F5.releases\u002F1.versions\u002F1.v1-2-1",{"title":283,"path":284,"stem":285},"v1.2.0","\u002Fen\u002Freleases\u002Fversions\u002Fv1-2-0","en\u002F5.releases\u002F1.versions\u002F2.v1-2-0",{"title":287,"path":288,"stem":289},"v1.1.0","\u002Fen\u002Freleases\u002Fversions\u002Fv1-1-0","en\u002F5.releases\u002F1.versions\u002F3.v1-1-0",{"title":291,"path":292,"stem":293},"v1.0.1","\u002Fen\u002Freleases\u002Fversions\u002Fv1-0-1","en\u002F5.releases\u002F1.versions\u002F4.v1-0-1",{"id":295,"title":217,"body":296,"description":499,"extension":500,"links":501,"meta":506,"navigation":507,"path":218,"seo":508,"stem":219,"__hash__":509},"docs_en\u002Fen\u002F3.components\u002F7.helper\u002F2.tooltip.md",{"type":297,"value":298,"toc":486},"minimark",[299,321,328,333,338,359,362,366,369,385,396,399,410,414,424,427,431,434,438,479,483],[300,301,302,303,307,308,311,312,314,315,317,318,320],"p",{},"Nuxt UI's ",[304,305,306],"code",{},"UTooltip"," only shows on hover or keyboard focus, so on phones neither tapping nor holding shows it. ",[304,309,310],{},"ShuoTooltip"," keeps every prop and slot of ",[304,313,306],{}," and only adds long press on touch devices; just change ",[304,316,306],{}," to ",[304,319,310],{},".",[300,322,323,324,327],{},"Every tooltip in the library uses it: ",[304,325,326],{},"ShuoInfoTooltip"," and the truncated-text tooltips of the select menu, date picker, file input, checkbox and option groups all show on long press on phones too.",[329,330,332],"h2",{"id":331},"usage","Usage",[334,335,337],"h3",{"id":336},"tooltip-text","Tooltip text",[300,339,340,343,344,347,348,347,351,354,355,358],{},[304,341,342],{},"text"," is the tooltip content, and the trigger goes in the default slot. Props such as ",[304,345,346],{},"kbds",", ",[304,349,350],{},"content",[304,352,353],{},"arrow"," and ",[304,356,357],{},"delayDuration"," are the same as Nuxt UI.",[360,361],"component-example",{"name":336},[334,363,365],{"id":364},"touch-long-press","Touch long press",[300,367,368],{},"On touch devices, holding the trigger for about 0.5 seconds shows the tooltip, which stays open after you lift your finger and closes when you tap elsewhere or scroll the page.",[370,371,372,376,379,382],"ul",{},[373,374,375],"li",{},"When a long press shows the tooltip, lifting your finger does not trigger the trigger's own action (click, check, open a menu and so on).",[373,377,378],{},"A normal tap triggers the original action as usual without showing the tooltip; focus caused by a tap does not show it either.",[373,380,381],{},"Moving your finger after pressing counts as scrolling and does not show the tooltip.",[373,383,384],{},"During a long press, the browser's long-press menu is not shown and text inside the trigger is not selected (except in inputs).",[300,386,387,388,391,392,395],{},"With ",[304,389,390],{},"touch"," set to ",[304,393,394],{},"false",", it behaves like the original Nuxt UI tooltip and touch cannot open it.",[360,397],{"name":398},"tooltip-touch",[300,400,401,402,405,406,320],{},"To turn it off site-wide, set ",[304,403,404],{},"components.tooltip.touch: false","; the tooltips inside the library turn off too. See ",[407,408,42],"a",{"href":409},"\u002Fgetting-started\u002Ftheme\u002Fcomponent-defaults",[334,411,413],{"id":412},"open-state","Open state",[300,415,416,417,420,421,320],{},"Bind the open state with ",[304,418,419],{},"v-model:open"," to open or close it from code; without binding, set the initial state with ",[304,422,423],{},"default-open",[360,425],{"name":426},"tooltip-open",[329,428,430],{"id":429},"props","Props",[432,433],"component-props",{"name":310},[329,435,437],{"id":436},"slots","Slots",[439,440,441,454],"table",{},[442,443,444],"thead",{},[445,446,447,451],"tr",{},[448,449,450],"th",{},"Slot",[448,452,453],{},"Description",[455,456,457,468],"tbody",{},[445,458,459,465],{},[460,461,462],"td",{},[304,463,464],{},"default",[460,466,467],{},"The trigger",[445,469,470,474],{},[460,471,472],{},[304,473,350],{},[460,475,476,477],{},"Custom tooltip content, like Nuxt UI's ",[304,478,350],{},[329,480,482],{"id":481},"changelog","Changelog",[484,485],"component-changelog",{"name":310},{"title":487,"searchDepth":488,"depth":488,"links":489},"",2,[490,496,497,498],{"id":331,"depth":488,"text":332,"children":491},[492,494,495],{"id":336,"depth":493,"text":337},3,{"id":364,"depth":493,"text":365},{"id":412,"depth":493,"text":413},{"id":429,"depth":488,"text":430},{"id":436,"depth":488,"text":437},{"id":481,"depth":488,"text":482},"Tooltip built on UTooltip that adds long press on touch devices.","md",[502],{"label":306,"icon":503,"to":504,"target":505},"i-simple-icons-nuxtdotjs","https:\u002F\u002Fui.nuxt.com\u002Fdocs\u002Fcomponents\u002Ftooltip","_blank",{},{"title":217,"icon":220},{"title":217,"description":499},"4565oldi4mLlQ23DDtLB3PNuatpzumlaK2Y6aSQ2HM4",[511,513],{"title":212,"path":213,"stem":214,"description":512,"icon":215,"children":-1},"Info icon with a tooltip, shown on hover, keyboard focus or long press on touch devices.",{"title":62,"path":232,"stem":233,"description":514,"icon":65,"children":-1},"Shared validation rules for Valibot, with consistent error messages across the site.",1793087860377]