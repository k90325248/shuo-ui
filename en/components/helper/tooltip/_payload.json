38,339,341],"h3",{"id":340},"tooltip-text","Tooltip text",[304,343,344,347,348,351,352,351,355,358,359,362],{},[308,345,346],{},"text"," is the tooltip content, and the trigger goes in the default slot. Props such as ",[308,349,350],{},"kbds",", ",[308,353,354],{},"content",[308,356,357],{},"arrow"," and ",[308,360,361],{},"delayDuration"," are the same as Nuxt UI.",[364,365],"component-example",{"name":340},[338,367,369],{"id":368},"touch-long-press","Touch long press",[304,371,372],{},"On touch devices, holding the trigger for about 0.5 seconds shows the tooltip, which stays open after you lift your finger and closes when you tap elsewhere or scroll the page.",[374,375,376,380,383,386],"ul",{},[377,378,379],"li",{},"When a long press shows the tooltip, lifting your finger does not trigger the trigger's own action (click, check, open a menu and so on).",[377,381,382],{},"A normal tap triggers the original action as usual without showing the tooltip; focus caused by a tap does not show it either.",[377,384,385],{},"Moving your finger after pressing counts as scrolling and does not show the tooltip.",[377,387,388],{},"During a long press, the browser's long-press menu is not shown and text inside the trigger is not selected (except in inputs).",[304,390,391,392,395,396,399],{},"With ",[308,393,394],{},"touch"," set to ",[308,397,398],{},"false",", it behaves like the original Nuxt UI tooltip and touch cannot open it.",[364,401],{"name":402},"tooltip-touch",[304,404,405,406,409,410,324],{},"To turn it off site-wide, set ",[308,407,408],{},"components.tooltip.touch: false","; the tooltips inside the library turn off too. See ",[411,412,42],"a",{"href":413},"\u002Fgetting-started\u002Ftheme\u002Fcomponent-defaults",[338,415,417],{"id":416},"open-state","Open state",[304,419,420,421,424,425,324],{},"Bind the open state with ",[308,422,423],{},"v-model:open"," to open or close it from code; without binding, set the initial state with ",[308,426,427],{},"default-open",[364,429],{"name":430},"tooltip-open",[333,432,434],{"id":433},"props","Props",[436,437],"component-props",{"name":314},[333,439,441],{"id":440},"slots","Slots",[443,444,445,458],"table",{},[446,447,448],"thead",{},[449,450,451,455],"tr",{},[452,453,454],"th",{},"Slot",[452,456,457],{},"Description",[459,460,461,472],"tbody",{},[449,462,463,469],{},[464,465,466],"td",{},[308,467,468],{},"default",[464,470,471],{},"The trigger",[449,473,474,478],{},[464,475,476],{},[308,477,354],{},[464,479,480,481],{},"Custom tooltip content, like Nuxt UI's ",[308,482,354],{},[333,484,486],{"id":485},"changelog","Changelog",[488,489],"component-changelog",{"name":314},{"title":491,"searchDepth":492,"depth":492,"links":493},"",2,[494,500,501,502],{"id":335,"depth":492,"text":336,"children":495},[496,498,499],{"id":340,"depth":497,"text":341},3,{"id":368,"depth":497,"text":369},{"id":416,"depth":497,"text":417},{"id":433,"depth":492,"text":434},{"id":440,"depth":492,"text":441},{"id":485,"depth":492,"text":486},"Tooltip built on UTooltip that adds long press on touch devices.","md",[506],{"label":310,"icon":507,"to":508,"target":509},"i-simple-icons-nuxtdotjs","https:\u002F\u002Fui.nuxt.com\u002Fdocs\u002Fcomponents\u002Ftooltip","_blank",{},{"title":217,"icon":220},{"title":217,"description":503},"4565oldi4mLlQ23DDtLB3PNuatpzumlaK2Y6aSQ2HM4",[515,517],{"title":212,"path":213,"stem":214,"description":516,"icon":215,"children":-1},"Info icon with a tooltip, shown on hover, keyboard focus or long press on touch devices.",{"title":62,"path":232,"stem":233,"description":518,"icon":65,"children":-1},"Shared validation rules for Valibot, with consistent error messages across the site.",1793270250512]