02Fen\u002Freleases","en\u002F5.releases",[273],{"title":274,"icon":12,"path":275,"stem":276,"children":277,"page":12},"Versions","\u002Fen\u002Freleases\u002Fversions","en\u002F5.releases\u002F1.versions",[278],{"title":279,"path":280,"stem":281},"v2.0.0","\u002Fen\u002Freleases\u002Fversions\u002Fv2-0-0","en\u002F5.releases\u002F1.versions\u002F1.v2-0-0",{"id":283,"title":217,"body":284,"description":487,"extension":488,"links":489,"meta":494,"navigation":495,"path":218,"seo":496,"stem":219,"__hash__":497},"docs_en\u002Fen\u002F3.components\u002F7.helper\u002F2.tooltip.md",{"type":285,"value":286,"toc":474},"minimark",[287,309,316,321,326,347,350,354,357,373,384,387,398,402,412,415,419,422,426,467,471],[288,289,290,291,295,296,299,300,302,303,305,306,308],"p",{},"Nuxt UI's ",[292,293,294],"code",{},"UTooltip"," only shows on hover or keyboard focus, so on phones neither tapping nor holding shows it. ",[292,297,298],{},"ShuoTooltip"," keeps every prop and slot of ",[292,301,294],{}," and only adds long press on touch devices; just change ",[292,304,294],{}," to ",[292,307,298],{},".",[288,310,311,312,315],{},"Every tooltip in the library uses it: ",[292,313,314],{},"ShuoInfoTooltip"," and the truncated-text tooltips of the select menu, date picker, file input, checkbox and option groups all show on long press on phones too.",[317,318,320],"h2",{"id":319},"usage","Usage",[322,323,325],"h3",{"id":324},"tooltip-text","Tooltip text",[288,327,328,331,332,335,336,335,339,342,343,346],{},[292,329,330],{},"text"," is the tooltip content, and the trigger goes in the default slot. Props such as ",[292,333,334],{},"kbds",", ",[292,337,338],{},"content",[292,340,341],{},"arrow"," and ",[292,344,345],{},"delayDuration"," are the same as Nuxt UI.",[348,349],"component-example",{"name":324},[322,351,353],{"id":352},"touch-long-press","Touch long press",[288,355,356],{},"On touch devices, holding the trigger for about 0.5 seconds shows the tooltip, which stays open after you lift your finger and closes when you tap elsewhere or scroll the page.",[358,359,360,364,367,370],"ul",{},[361,362,363],"li",{},"When a long press shows the tooltip, lifting your finger does not trigger the trigger's own action (click, check, open a menu and so on).",[361,365,366],{},"A normal tap triggers the original action as usual without showing the tooltip; focus caused by a tap does not show it either.",[361,368,369],{},"Moving your finger after pressing counts as scrolling and does not show the tooltip.",[361,371,372],{},"During a long press, the browser's long-press menu is not shown and text inside the trigger is not selected (except in inputs).",[288,374,375,376,379,380,383],{},"With ",[292,377,378],{},"touch"," set to ",[292,381,382],{},"false",", it behaves like the original Nuxt UI tooltip and touch cannot open it.",[348,385],{"name":386},"tooltip-touch",[288,388,389,390,393,394,308],{},"To turn it off site-wide, set ",[292,391,392],{},"components.tooltip.touch: false","; the tooltips inside the library turn off too. See ",[395,396,42],"a",{"href":397},"\u002Fgetting-started\u002Ftheme\u002Fcomponent-defaults",[322,399,401],{"id":400},"open-state","Open state",[288,403,404,405,408,409,308],{},"Bind the open state with ",[292,406,407],{},"v-model:open"," to open or close it from code; without binding, set the initial state with ",[292,410,411],{},"default-open",[348,413],{"name":414},"tooltip-open",[317,416,418],{"id":417},"props","Props",[420,421],"component-props",{"name":298},[317,423,425],{"id":424},"slots","Slots",[427,428,429,442],"table",{},[430,431,432],"thead",{},[433,434,435,439],"tr",{},[436,437,438],"th",{},"Slot",[436,440,441],{},"Description",[443,444,445,456],"tbody",{},[433,446,447,453],{},[448,449,450],"td",{},[292,451,452],{},"default",[448,454,455],{},"The trigger",[433,457,458,462],{},[448,459,460],{},[292,461,338],{},[448,463,464,465],{},"Custom tooltip content, like Nuxt UI's ",[292,466,338],{},[317,468,470],{"id":469},"changelog","Changelog",[472,473],"component-changelog",{"name":298},{"title":475,"searchDepth":476,"depth":476,"links":477},"",2,[478,484,485,486],{"id":319,"depth":476,"text":320,"children":479},[480,482,483],{"id":324,"depth":481,"text":325},3,{"id":352,"depth":481,"text":353},{"id":400,"depth":481,"text":401},{"id":417,"depth":476,"text":418},{"id":424,"depth":476,"text":425},{"id":469,"depth":476,"text":470},"Tooltip built on UTooltip that adds long press on touch devices.","md",[490],{"label":294,"icon":491,"to":492,"target":493},"i-simple-icons-nuxtdotjs","https:\u002F\u002Fui.nuxt.com\u002Fdocs\u002Fcomponents\u002Ftooltip","_blank",{},{"title":217,"icon":220},{"title":217,"description":487},"4565oldi4mLlQ23DDtLB3PNuatpzumlaK2Y6aSQ2HM4",[499,501],{"title":212,"path":213,"stem":214,"description":500,"icon":215,"children":-1},"Info icon with a tooltip, shown on hover, keyboard focus or long press on touch devices.",{"title":62,"path":232,"stem":233,"description":502,"icon":65,"children":-1},"Shared validation rules for Valibot, with consistent error messages across the site.",1793590087307]