foTooltip"," and the truncated-text tooltips of the select menu, date picker, file input, checkbox and option groups all show on long press on phones too.",[283,284,286],"h2",{"id":285},"usage","Usage",[288,289,291],"h3",{"id":290},"tooltip-text","Tooltip text",[254,293,294,297,298,301,302,301,305,308,309,312],{},[258,295,296],{},"text"," is the tooltip content, and the trigger goes in the default slot. Props such as ",[258,299,300],{},"kbds",", ",[258,303,304],{},"content",[258,306,307],{},"arrow"," and ",[258,310,311],{},"delayDuration"," are the same as Nuxt UI.",[314,315],"component-example",{"name":290},[288,317,319],{"id":318},"touch-long-press","Touch long press",[254,321,322],{},"On touch devices, holding the trigger for about 0.5 seconds shows the tooltip, which stays open after you lift your finger and closes when you tap elsewhere or scroll the page.",[324,325,326,330,333,336],"ul",{},[327,328,329],"li",{},"When a long press shows the tooltip, lifting your finger does not trigger the trigger's own action (click, check, open a menu and so on).",[327,331,332],{},"A normal tap triggers the original action as usual without showing the tooltip; focus caused by a tap does not show it either.",[327,334,335],{},"Moving your finger after pressing counts as scrolling and does not show the tooltip.",[327,337,338],{},"During a long press, the browser's long-press menu is not shown and text inside the trigger is not selected (except in inputs).",[254,340,341,342,345,346,349],{},"With ",[258,343,344],{},"touch"," set to ",[258,347,348],{},"false",", it behaves like the original Nuxt UI tooltip and touch cannot open it.",[314,351],{"name":352},"tooltip-touch",[254,354,355,356,359,360,274],{},"To turn it off site-wide, set ",[258,357,358],{},"components.tooltip.touch: false","; the tooltips inside the library turn off too. See ",[361,362,42],"a",{"href":363},"\u002Fgetting-started\u002Ftheme\u002Fcomponent-defaults",[288,365,367],{"id":366},"open-state","Open state",[254,369,370,371,374,375,274],{},"Bind the open state with ",[258,372,373],{},"v-model:open"," to open or close it from code; without binding, set the initial state with ",[258,376,377],{},"default-open",[314,379],{"name":380},"tooltip-open",[283,382,384],{"id":383},"props","Props",[386,387],"component-props",{"name":264},[283,389,391],{"id":390},"slots","Slots",[393,394,395,408],"table",{},[396,397,398],"thead",{},[399,400,401,405],"tr",{},[402,403,404],"th",{},"Slot",[402,406,407],{},"Description",[409,410,411,422],"tbody",{},[399,412,413,419],{},[414,415,416],"td",{},[258,417,418],{},"default",[414,420,421],{},"The trigger",[399,423,424,428],{},[414,425,426],{},[258,427,304],{},[414,429,430,431],{},"Custom tooltip content, like Nuxt UI's ",[258,432,304],{},[283,434,436],{"id":435},"changelog","Changelog",[438,439],"component-changelog",{"name":264},{"title":441,"searchDepth":442,"depth":442,"links":443},"",2,[444,450,451,452],{"id":285,"depth":442,"text":286,"children":445},[446,448,449],{"id":290,"depth":447,"text":291},3,{"id":318,"depth":447,"text":319},{"id":366,"depth":447,"text":367},{"id":383,"depth":442,"text":384},{"id":390,"depth":442,"text":391},{"id":435,"depth":442,"text":436},"Tooltip built on UTooltip that adds long press on touch devices.","md",[456],{"label":260,"icon":457,"to":458,"target":459},"i-simple-icons-nuxtdotjs","https:\u002F\u002Fui.nuxt.com\u002Fdocs\u002Fcomponents\u002Ftooltip","_blank",{},{"title":197,"icon":200},{"title":197,"description":453},"4565oldi4mLlQ23DDtLB3PNuatpzumlaK2Y6aSQ2HM4",[465,467],{"title":192,"path":193,"stem":194,"description":466,"icon":195,"children":-1},"Info icon with a tooltip, shown on hover, keyboard focus or long press on touch devices.",{"title":62,"path":212,"stem":213,"description":468,"icon":65,"children":-1},"Shared validation rules for Valibot, with consistent error messages across the site.",1792954457282]