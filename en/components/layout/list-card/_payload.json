335],{},"page-change",", and the page updates ",[310,338,339],{},"page"," and ",[310,342,343],{},"data"," after the query for that page succeeds. It is not emitted while loading, or when the page is the current one or out of range. ",[310,346,347],{},"interactionDisabled"," is ",[310,350,351],{},"true"," while loading and can be used to disable actions in the list.",[354,355],"component-example",{"name":356},"list-card-basic",[300,358,359,360,363,364,367,368,371,372,376],{},"The ",[310,361,362],{},"PageRequest"," type can be imported from ",[310,365,366],{},"#shuo-ui\u002Ftypes\u002Fpagination","; see ",[304,369,72],{"href":370},"\u002Fgetting-started\u002Fadvanced\u002Fauto-imports#types",". For the full pattern with query fields, see ",[304,373,375],{"href":374},"\u002Fcomponents\u002Flayout\u002Fquery-card#with-listcard","With ListCard"," on ShuoQueryCard.",[326,378,380],{"id":379},"title-and-icon","Title and icon",[300,382,383,386,387,390,391,367,394,398],{},[310,384,385],{},"title"," is the title text and ",[310,388,389],{},"icon"," is the icon to the left of the title; pass an empty string to hide the icon. The title bar wraps by the same rules as ",[310,392,393],{},"ShuoQueryCard",[304,395,397],{"href":396},"\u002Fcomponents\u002Flayout\u002Fquery-card#long-titles","Long titles",".",[354,400],{"name":401},"list-card-title",[326,403,405],{"id":404},"pagination-and-counts","Pagination and counts",[300,407,408,411,412,415,416,419],{},[310,409,410],{},"show-pagination"," controls the pagination at the bottom left, shown even with a single page; ",[310,413,414],{},"show-summary"," controls the count and range at the bottom right; ",[310,417,418],{},"page-size"," is the number of rows per page, 10 by default.",[354,421],{"name":422},"list-card-footer",[424,425,426,440],"ul",{},[427,428,429,430,432,433,367,436,398],"li",{},"After changing ",[310,431,418],{},", query again from the first page with ",[310,434,435],{},"getPagination(1)",[304,437,439],{"href":438},"#re-