],{},[308,1228,541],{}," is also used as the ",[308,1231,1232],{},"getRowId"," of ",[308,1235,1168],{}," when selection is off.",[304,1238,1239,1240,402,1243,1246,1247,1250,1251,573,1254,402,1257,1260,1261,1264],{},"\"Loading…\" and \"No data\" switch with the locale (\"查詢中…\" and \"查無資料\" in Traditional Chinese), and can be overridden globally with the ",[308,1241,1242],{},"table.loading",[308,1244,1245],{},"table.empty"," texts; see ",[317,1248,47],{"href":1249},"\u002Fgetting-started\u002Ftheme\u002Fmessages",". The accessible names of the select-all and row checkboxes (\"Select all\", \"Select row\") and the header text when select all is off (empty by default) come from ",[308,1252,1253],{},"table.selectAll",[308,1255,1256],{},"table.selectRow",[308,1258,1259],{},"table.selectionHeader",". Set styles for headers, cells and so on with ",[308,1262,1263],{},"tableProps.ui",", merged with the built-in styles.",[327,1266,1268],{"id":1267},"slots","Slots",[726,1270,1271,1282],{},[729,1272,1273],{},[732,1274,1275,1278,1280],{},[735,1276,1277],{},"Slot",[735,1279,1185],{},[735,1281,743],{},[745,1283,1284,1303,1317,1331],{},[732,1285,1286,1295,1300],{},[750,1287,1288,1291,1292,1294],{},[308,1289,1290],{},"\u003Ccolumn>-cell"," and other ",[308,1293,1168],{}," slots",[750,1296,1297,1298],{},"Original props + ",[308,1299,314],{},[750,1301,1302],{},"Custom cells and headers",[732,1304,1305,1310,1314],{},[750,1306,1307],{},[308,1308,1309],{},"body-top",[750,1311,1312],{},[308,1313,314],{},[750,1315,1316],{},"A row above the table",[732,1318,1319,1325,1328],{},[750,1320,1321,573,1323],{},[308,1322,340],{},[308,1324,344],{},[750,1326,1327],{},"—",[750,1329,1330],{},"Loading and empty-data content",[732,1332,1333,1341,1345],{},[750,1334,1335,573,1338],{},[308,1336,1337],{},"select-header",[308,1339,1340],{},"select-cell",[750,1342,1297,1343],{},[308,1344,314],{},[750,1346,1347],{},"Replace the select-all and row checkboxes",[327,1349,1351],{"id":1350},"changelog","Changelog",[