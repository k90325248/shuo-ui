on",[304,530,531,534,535,538,539,542,543,546,547,517,550,552,553,556],{},[308,532,533],{},"selectable"," adds a selection column at the front, and the selection is bound to an array of keys with ",[308,536,537],{},"v-model:selected",". ",[308,540,541],{},"row-key"," sets the key: a field name (such as ",[308,544,545],{},"row-key=\"id\"",") or a function that builds the key from the row; the selection keeps the original type of the keys. Select all in the header only selects the selectable rows on the current page, and shows an indeterminate state when only some are selected. With ",[308,548,549],{},"select-all",[308,551,520],{},", the header shows the ",[308,554,555],{},"selection-header"," text instead.",[347,558],{"name":559},"table-selection",[561,562,563,581,591,597],"ul",{},[564,565,566,567,569,570,573,574,577,578,580],"li",{},"Without ",[308,568,541],{},", the row index (",[308,571,572],{},"'0'",", ",[308,575,576],{},"'1'","…) is the key. The first row is still ",[308,579,572],{}," after changing pages and selects different data, so always set it with server-side pagination.",[564,582,583,584,586,587,590],{},"Selected keys are kept when changing pages or re-querying, including those on other pages; set ",[308,585,537],{}," to ",[308,588,589],{},"[]"," to clear the selection.",[564,592,593,594,596],{},"All checkboxes are disabled while loading (",[308,595,340],{},").",[564,598,599,601,602,406,605,380],{},[308,600,549],{}," can be set site-wide with ",[308,603,604],{},"components.table.selectAll",[317,606,42],{"href":409},[332,608,610],{"id":609},"rows-that-cannot-be-selected","Rows that cannot be selected",[304,612,613,614,617,618,620,621,624],{},"Rows for which ",[308,615,616],{},"row-selectable"," returns ",[308,619,520],{}," cannot be selected and are skipped by select all. In this example the key combines the year and number (such as ",[308,622,623],{},"115-1","), and closed rows cannot be selected.",[347,626],{"name":627},"table-selection-disabled",[327,629,631],{"id":630},"examples","Examples",[332,633,635],{"id":634},"editable-table","Editable table",[304,637,638,639,380],{},"Put Shuo input components in cell slots, with a title and bottom buttons from ",[308,640,310],{},[347,642],{"name":643},"table-editable",[332,645,647],{"id":646},"detail-table-in-a-modal","Detail table in a modal",[304,649,650,651,402,654,657,658,661],{},"To limit the height and keep the header fixed, set ",[308,652,653],{},"ui.root",[308,655,656],{},"sticky"," through ",[308,659,660],{},"tableProps",", so the table itself scrolls and the header stays in place. The table is recreated each time the modal opens and shows skeleton rows while loading.",[347,663],{"name":664},"table-modal",[332,666,668],{"id":667},"disabling-actions-while-loading","Disabling actions while loading",[304,670,671,672,573,674,676],{},"Cell slots get an extra ",[308,673,314],{},[308,675,369],{}," while loading, to disable buttons in the rows.",[347,678],{"name":679},"table-interaction",[332,681,683],{"id":682},"custom-loading-and-empty-content","Custom loading and empty content",[304,685,686,687,402,690,538,693,695],{},"Replace the built-in texts with ",[308,688,689],{},"#loading",[308,691,692],{},"#empty",[308,694,689],{}," only shows when there is no data and it is not the first-load skeleton.",[347,697],{"name":698},"table-empty-slot",[332,700,702],{"id":701},"selection-checkbox-styles","Selection checkbox styles",[304,704,705,708,709,366,712,406,715,717,718,380],{},[308,706,707],{},"checkbox-props"," sets the appearance of the select-all and row checkboxes, which share the same settings. The width and alignment of the selection column cells are set with a column whose ",[308,710,711],{},"id",[308,713,714],{},"select",[308,716,457],{},"; see ",[317,719,721],{"href":720},"#selection-column-position-and-custom-cells","Selection column position and custom cells",[347,723],{"name":724},"table-selection-style",[726,727,728,744],"table",{},[729,730,731],"thead",{},[732,733,734,738,741],"tr",{},[735,736,737],"th",{},"Property",[735,739,740],{},"Type",[735,742,743],{},"Description",[745,746,747,767,799,822,852,870],"tbody",{},[732,748,749,755,760],{},[750,751,752],"td",{},[308,753,754],{},"class",[750,756,757],{},[308,758,759],{},"any",[750,761,762,763,766],{},"Class of the checkbox wrapper (the ",[308,764,765],{},"root"," of UCheckbox)",[732,768,769,774,779],{},[750,770,771],{},[308,772,773],{},"ui",[750,775,776,778],{},[308,777,773],{}," of UCheckbox",[750,780,781,782,573,784,573,787,790,791,794,795,798],{},"Part styles: ",[308,783,765],{},[308,785,786],{},"container",[308,788,789],{},"base"," (the box), ",[308,792,793],{},"indicator"," (checked background), ",[308,796,797],{},"icon"," and so on, merged with the UCheckbox theme; a function receives the defaults so you can replace them",[732,800,801,806,815],{},[750,802,803],{},[308,804,805],{},"color",[750,807,808,809,573,812],{},"Theme colors such as ",[308,810,811],{},"'primary'",[308,813,814],{},"'neutral'",[750,816,817,818,821],{},"Background when checked; ",[308,819,820],{},"primary"," when not set",[732,823,824,829,846],{},[750,825,826],{},[308,827,828],{},"size",[750,830,831,573,834,573,837,573,840,573,843],{},[308,832,833],{},"'xs'",[308,835,836],{},"'sm'",[308,838,839],{},"'md'",[308,841,842],{},"'lg'",[308,844,845],{},"'xl'",[750,847,848,849,821],{},"Box size; ",[308,850,851],{},"md",[732,853,854,858,863],{},[750,855,856],{},[308,857,797],{},[750,859,860],{},[308,861,862],{},"string",[750,864,865,866,869],{},"Icon when checked; the Nuxt UI ",[308,867,868],{},"check"," icon when not set",[732,871,872,877,881],{},[750,873,874],{},[308,875,876],{},"indeterminateIcon",[750,878,879],{},[308,880,862],{},[750,882,883,884,869],{},"Icon when partly selected; the Nuxt UI ",[308,885,886],{},"minus",[561,888,889,899,913,928],{},[564,890,891,892,895,896,380],{},"The type is ",[308,893,894],{},"TableCheckboxProps",", importable from ",[308,897,898],{},"#shuo-ui\u002Fcomponents\u002FShuoT