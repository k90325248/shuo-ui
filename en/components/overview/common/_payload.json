,[309,430,368],{}," only follows ",[309,433,391],{},[380,435,437,438,328],{"name":436,"type":418},"name","Field name; when not set, it follows ",[309,439,391],{},[305,441,442,443,445,446,449,450,453,454,456,457,460,461,316,463,465,466,469,470,472,473,475,476,328],{},"Except for ",[309,444,350],{}," (which uses ",[309,447,448],{},"state"," instead; see ",[397,451,162],{"href":452},"\u002Fcomponents\u002Fdate\u002Fdatepicker",") and ",[309,455,368],{},", components also support Nuxt UI's ",[309,458,459],{},"color"," (component color). Input-style components other than ",[309,462,350],{},[309,464,368],{}," also support ",[309,467,468],{},"highlight"," (emphasized border); checkboxes and groups have no border and do not support ",[309,471,468],{},". The color and error border of ",[309,474,368],{}," follow ",[309,477,391],{},[479,480,482],"h3",{"id":481},"with-uform-and-uformfield","With UForm and UFormField",[305,484,485,486,488,489,491,492,494],{},"Wrap the component in ",[309,487,391],{}," with ",[309,490,436],{}," matching the schema field. The component picks up the id, size, disabled and error state of ",[309,493,391],{},", and triggers validation on input, blur and change:",[496,497,502],"pre",{"className":498,"code":499,"language":500,"meta":501,"style":501},"language-vue shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","\u003C!-- Name -->\n\u003CUFormField label=\"Name\" name=\"name\" required>\n  \u003CShuoInputText v-model=\"state.name\" \u002F>\n\u003C\u002FUFormField>\n\n","vue","",[309,503,504,513,556,563],{"__ignoreMap":501},[505,506,509],"span",{"class":507,"line":508},"line",1,[505,510,512],{"class":511},"sHwdD","\u003C!-- Name -->\n",[505,514,516,520,523,527,530,533,537,539,542,544,546,548,550,553],{"class":507,"line":515},2,[505,517,519],{"class":518},"sMK4o","\u003C",[505,521,391],{"class":522},"swJcz",[505,524,526],{"class":525},"spNyl"," label",[505,528,529],{"class":518},"=",[505,531,532],{"class":518},"\"",[505,5