[338,358,359],{},"When the user types or pastes, only half-width digits are kept; values filled in by the parent are shown as is, and are only filtered after the user edits that input.",[338,361,362],{},"When the area code or number has the wrong type, only that input is cleared and the full number is joined again; when the full number has the wrong type, both inputs are cleared.",[323,364,366],{"id":365},"filling-in-only-the-full-number","Filling in only the full number",[296,368,369,370,372,373,376],{},"When only the full number is filled in, it is split by a known area code that matches its prefix; without a usable area code, the whole number goes into the number input and the area code is cleared, with no guessing by length. To split it into both inputs, also bind ",[299,371,305],{}," with a known area code. Switch ",[299,374,375],{},"area-code"," to compare the two results:",[331,378],{"name":379},"phone-split",[323,381,383],{"id":382},"variants","Variants",[296,385,386,387,306,390,393,394,397],{},"Uses the ",[299,388,389],{},"color",[299,391,392],{},"highlight"," of ",[299,395,396],{},"UInput",", applied to both the area code and number inputs.",[331,399],{"name":400},"phone-color",[323,402,404],{"id":403},"size-and-states","Size and states",[296,406,407,408,411],{},"While loading, a spinner shows at the far right of the number input and both inputs are disabled. See ",[312,409,102],{"href":410},"\u002Fcomponents\u002Foverview\u002Fcommon"," for the behavior shared by all states.",[331,413],{"name":414},"phone-states",[318,416,418],{"id":417},"examples","Examples",[323,420,422],{"id":421},"with-form-validation","With form validation",[296,424,425,426,429,430,356],{},"The component has no built-in rules for phone number length or valid area codes; define them in the form schema. The example checks required with ",[299,427,428],{},"requiredText",", then the format of the full number with ",[299,431,432],{},"v.regex",[331,434],{"name":435},"phone-validation",[323,437,439],{"id":438},"storing-area-code-and-number-separately","Storing area code and number separately",[296,441,442,443,306,445,447,448,451],{},"When the back end stores two fields, bind only ",[299,444,305],{},[299,446,309],{},". Press \"Load data\" to simulate fetching from the back end, with ",[299,449,450],{},"loading"," disabling input meanwhile.",[331,453],{"name":454},"phone-parts",[318,456,315],{"id":315},[458,459,460,475],"table",{},[461,462,463],"thead",{},[464,465,466,469,472],"tr",{},[467,468,315],"th",{},[467,470,471],{},"Type",[467,473,474],{},"Description",[476,477,478,493,506],"tbody",{},[464,479,480,485,490],{},[481,482,483],"td",{},[299,484,315],{},[481,486,487],{},[299,488,489],{},"string",[481,491,492],{},"Full number (area code plus number, no separator)",[464,494,495,499,503],{},[481,496,497],{},[299,498,305],{},[481,500,501],{},[299,502,489],{},[481,504,505],{},"Area code",[464,507,508,512,516],{},[481,509,510],{},[299,511,309],{},[481,513,514],{},[299,515,489],{},[481,517,518],{},"Phone number",[318,520,522],{"id":521},"props","Props",[524,525],"component-props",{"name":526},"ShuoPhone",[296,528,529,530,533,534,537,538,537,541,537,543,306,546,549,550,553],{},"See ",[312,531,102],{"href":532},"\u002Fcomponents\u002Foverview\u002Fcommon#shared-props"," for the behavior of ",[299,535,536],{},"size",", ",[299,539,540],{},"disabled",[299,542,450],{},[299,544,545],{},"skeleton",[299,547,548],{},"name","; ",[299,551,552],{},"id"," points to the area code input.",[318,555,557],{"id":556},"styling","Styling",[296,559,529,560,568,569,571,572,306,575,578,579,581,582,584],{},[312,561,563,564,567],{"href":562},"\u002Fgetting-started\u002Ftheme\u002Ftheming#per-component-ui-prop","Per-component ",[299,565,566],{},"ui"," prop"," for how ",[299,570,566],{}," is merged; the values of ",[299,573,574],{},"areaCode",[299,576,577],{},"number"," are the same as the ",[299,580,566],{}," of Nuxt UI ",[299,583,396],{},":",[458,586,587,600],{},[461,588,589],{},[464,