es","\u002Fen\u002Freleases","en\u002F5.releases",[273],{"title":274,"icon":12,"path":275,"stem":276,"children":277,"page":12},"Versions","\u002Fen\u002Freleases\u002Fversions","en\u002F5.releases\u002F1.versions",[278,282,286,290],{"title":279,"path":280,"stem":281},"v3.2.1","\u002Fen\u002Freleases\u002Fversions\u002Fv3-2-1","en\u002F5.releases\u002F1.versions\u002F1.v3-2-1",{"title":283,"path":284,"stem":285},"v3.2.0","\u002Fen\u002Freleases\u002Fversions\u002Fv3-2-0","en\u002F5.releases\u002F1.versions\u002F2.v3-2-0",{"title":287,"path":288,"stem":289},"v3.1.0","\u002Fen\u002Freleases\u002Fversions\u002Fv3-1-0","en\u002F5.releases\u002F1.versions\u002F3.v3-1-0",{"title":291,"path":292,"stem":293},"v3.0.0","\u002Fen\u002Freleases\u002Fversions\u002Fv3-0-0","en\u002F5.releases\u002F1.versions\u002F4.v3-0-0",{"id":295,"title":117,"body":296,"description":1240,"extension":1241,"links":1242,"meta":1247,"navigation":1248,"path":118,"seo":1249,"stem":119,"__hash__":1250},"docs_en\u002Fen\u002F3.components\u002F2.text\u002F2.input-number.md",{"type":297,"value":298,"toc":1215},"minimark",[299,307,312,317,340,344,395,399,433,436,572,597,619,623,635,638,657,661,677,680,683,690,693,697,704,707,711,714,730,733,737,744,747,751,771,774,778,791,794,798,805,808,812,816,841,844,920,925,929,966,970,1007,1139,1183,1208,1212],[300,301,302,306],"p",{},[303,304,305],"code",{},"v-model: number | null",".",[308,309,311],"h2",{"id":310},"usage","Usage",[313,314,316],"h3",{"id":315},"decimal-places-and-thousands-separators","Decimal places and thousands separators",[300,318,319,322,323,326,327,330,331,322,334,336,337,339],{},[303,320,321],{},"decimal"," defaults to ",[303,324,325],{},"false",", allowing only integers; a positive integer sets the number of decimal places, and ",[303,328,329],{},"true"," allows any number. ",[303,332,333],{},"thousand-separator",[303,335,329],{},", showing thousands separators on blur; pass ",[303,338,325],{}," for numbers such as years or codes that should not have them.",[341,342],"component-example",{"name":343},"input-number-decimal",[345,346,347,362,375],"ul",{},[348,349,350,351,354,355,358,359,361],"li",{},"While typing, the sign, decimal point and trailing zeros are kept; incomplete input (such as just ",[303,352,353],{},"-",") binds ",[303,356,357],{},"null",". On blur, the value is rounded and padded according to ",[303,360,321],{},", and thousands separators are shown.",[348,363,364,365,367,368,370,371,374],{},"Non-numeric characters and decimals beyond the set places cannot be typed, and pasted text is reverted too. When ",[303,366,321],{}," is ",[303,369,325],{}," or ",[303,372,373],{},"0",", the decimal point cannot be typed.",[348,376,377,378,367,381,384,385,367,387,370,389,391,392,394],{},"On focus, the text switches to the editable form without separators. ",[303,379,380],{},"inputmode",[303,382,383],{},"numeric"," when ",[303,386,321],{},[303,388,325],{},[303,390,373],{},", and ",[303,393,321],{}," otherwise, so phones show the matching number keyboard.",[313,396,398],{"id":397},"step-buttons","Step buttons",[300,400,401,404,405,408,409,412,413,416,417,420,421,424,425,428,429,432],{},[303,402,403],{},"buttons"," shows increment and decrement buttons (off by default), ",[303,406,407],{},"step"," is the amount per step (",[303,410,411],{},"1"," by default), and ",[303,414,415],{},"min",", ",[303,418,419],{},"max"," limit stepping with the buttons and keys. ",[303,422,423],{},"orientation"," sets the button layout: ",[303,426,427],{},"horizontal"," (default) puts decrement on the left and increment on the right and centers the number; ",[303,430,431],{},"vertical"," stacks both on the right and keeps the number right-aligned.",[341,434],{"name":435},"input-number-step",[345,437,438,461,467,484,500,543,555,562],{},[348,439,440,444,445,447,448,416,450,416,452,454,455,457,458,460],{},[441,442,443],"strong",{},"Keyboard",": with ",[303,446,403],{},", or when any of ",[303,449,407],{},[303,451,415],{},[303,453,419],{}," is passed, ArrowUp \u002F ArrowDown steps once in the focused input, PageUp \u002F PageDown steps 10 times, and Home \u002F End jump to ",[303,456,415],{}," \u002F ",[303,459,419],{}," (when set). Without these settings the arrow keys behave as in a normal text input. The buttons are not in the Tab order and are labelled \"Increment\" and \"Decrement\" (following the locale).",[348,462,463,466],{},[441,464,465],{},"Press and hold",": holding a button for more than 0.4 seconds keeps stepping until a limit is reached or the button is released. Pressing a button does not move focus away from the input.",[348,468,469,472,473,475,476,478,479,481,482,306],{},[441,470,471],{},"Empty value",": when the value is ",[303,474,357],{},", both increment and decrement start at ",[303,477,415],{},", or at ",[303,480,373],{}," without ",[303,483,415],{},[348,485,486,489,490,493,494,497,498,306],{},[441,487,488],{},"No floating-point errors",": steps are computed in decimal, so repeatedly adding ",[303,491,492],{},"0.25"," never gives ",[303,495,496],{},"0.7500000001","; the result is rounded to the places allowed by ",[303,499,321],{},[348,501,502,509,510,512,513,515,516,518,519,521,522,524,525,527,528,530,531,533,534,536,537,539,540,542],{},[441,503,504,506,507],{},[303,505,407],{}," and ",[303,508,321],{},": when ",[303,511,407],{}," has more decimal places than ",[303,514,321],{}," allows (for example ",[303,517,492],{}," with ",[303,520,321],{}," set to ",[303,523,325],{},"), the step is rounded to what ",[303,526,321],{}," allows (at least one smallest unit, ",[303,529,411],{}," for ",[303,532,325],{},") with a console warning. A ",[303,535,407],{}," that is not a number above 0, or a ",[303,538,415],{}," greater than ",[303,541,419],{},", is also ignored with a warning.",[348,544,545,548,549,551,552,554],{},[441,546,547],{},"Limits",": the increment button is disabled when the value is at or above ",[303,550,419],{},", and the decrement button at or below ",[303,553,415],{},". Both are disabled while disabled, loading, in a skeleton or in a disabled form.",[348,556,557,558,561],{},"Each step triggers the ",[303,559,560],{},"UFormField"," input and change validation, just like typing.",[348,563,564,506,566,568,569,306],{},[303,565,403],{},[303,567,423],{}," can have site-wide defaults, for example to show the buttons across the project: ",[303,570,571],{},"shuoUi.components.inputNumber.buttons: true",[573,574,575,506,577,579,580,583,584,506,587,590,591,596],"warning",{},[303,576,415],{},[303,578,419],{}," only limit the buttons and keys. ",[441,581,582],{},"A typed value outside the range is not corrected","; the bound value stays as typed, and stepping from it moves back into the range. Keep validating the range in the schema with ",[303,585,586],{},"v.minValue",[303,588,589],{},"v.maxValue","; see ",[592,593,595],"a",{"href":594},"#with-form-validation","With form validation"," below.",[300,598,599,600,457,603,606,607,610,611,614,615,618],{},"In horizontal layout the decrement button takes the place of the left ",[303,601,602],{},"icon",[303,604,605],{},"leadingIcon"," (the ",[303,608,609],{},"#leading"," slot still follows the button); use ",[303,612,613],{},"orientation=\"vertical\""," when you need a left icon. The increment button sits to the right of the unit, the ",[303,616,617],{},"#trailing"," slot and the loading icon, and the padding on both sides follows their actual width, so the number and unit are never pushed out.",[313,620,622],{"id":621},"unit","Unit",[300,624,625,626,367,628,630,631,634],{},"When ",[303,627,621],{},[303,629,329],{},", \"NTD\" is shown (\"元\" in Traditional Chinese, switching with the locale). The text can be changed in ",[592,632,47],{"href":633},"\u002Fgetting-started\u002Ftheme\u002Fmessages#overridable-items","; passing a string shows that text. Units vary in length, so the right padding follows the unit's actual width and the number never overlaps the unit.",[341,636],{"name":637},"input-number-unit",[300,639,640,506,642,644,645,649,650,652,653,457,655,306],{},[303,641,621],{},[303,643,333],{}," can also have site-wide defaults; see ",[592,646,648],{"href":647},"\u002Fgetting-started\u002Ftheme\u002Fcomponent-defaults#configurable-props","Configurable props",". The site-wide ",[303,651,621],{}," only accepts ",[303,654,329],{},[303,656,325],{},[313,658,660],{"id":659},"variants","Variants",[300,662,663,664,416,667,506,670,673,674,306],{},"Uses the ",[303,665,666],{},"variant",[303,668,669],{},"color",[303,671,672],{},"highlight"," of ",[303,675,676],{},"UInput",[341,678],{"name":679},"input-number-variant",[313,681,682],{"id":602},"Icon",[300,684,663,685,673,687,689],{},[303,686,602],{},[303,688,676],{},", shown on the left alongside the unit.",[341,691],{"name":692},"input-number-icon",[313,694,696],{"id":695},"size-and-states","Size and states",[300,698,699,700,703],{},"While loading, the spinner sits to the right of the unit and the number and unit move left to make room. See ",[592,701,102],{"href":702},"\u002Fcomponents\u002Foverview\u002Fcommon"," for the behavior shared by all states.",[341,705],{"name":706},"input-number-states",[308,708,710],{"id":709},"examples","Examples",[313,712,595],{"id":713},"with-form-validation",[300,715,716,717,720,721,506,723,725,726,729],{},"Use ",[303,718,719],{},"requiredNumber"," for required fields and add ranges with ",[303,722,586],{},[303,724,589],{},"; use ",[303,727,728],{},"optionalNonNegativeNumber"," for optional non-negative numbers. What gets validated and submitted is a number, without separators.",[341,731],{"name":732},"input-number-validation",[313,734,736],{"id":735},"step-buttons-with-validation","Step buttons with validation",[300,738,739,506,741,743],{},[303,740,415],{},[303,742,419],{}," do not replace validation: the buttons in this example only stop at 0, and the schema checks the upper limit; stepping above 40 shows the error right away.",[341,745],{"name":746},"input-number-step-vali