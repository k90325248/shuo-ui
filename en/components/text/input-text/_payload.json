cons","Toggle icons",[281,371,372,375,376,379],{},[284,373,374],{},"reveal-icon"," is shown while masked (press it to reveal the text), and ",[284,377,378],{},"conceal-icon"," is shown while the text is revealed (press it to mask again).",[317,381],{"name":382},"input-text-mask-icons",[294,384,386],{"id":385},"variants","Variants",[281,388,389,390,341,393,396,397,400,401,287],{},"Uses the ",[284,391,392],{},"variant",[284,394,395],{},"color"," and ",[284,398,399],{},"highlight"," of ",[284,402,403],{},"UInput",[317,405],{"name":406},"input-text-variant",[294,408,410],{"id":409},"icon","Icon",[281,412,389,413,400,415,417,418,303,421,423],{},[284,414,409],{},[284,416,403],{},"; when ",[284,419,420],{},"trailing",[284,422,306],{},", the icon goes on the right.",[317,425],{"name":426},"input-text-icon",[294,428,430],{"id":429},"size-and-states","Size and states",[281,432,433,434,438],{},"When disabled, the text can still be revealed; during the skeleton it cannot be used. See ",[435,436,87],"a",{"href":437},"\u002Fcomponents\u002Foverview\u002Fcommon"," for the behavior shared by all states.",[317,440],{"name":441},"input-text-states",[289,443,445],{"id":444},"examples","Examples",[294,447,449],{"id":448},"with-form-validation","With form validation",[281,451,452,453,456,457,460],{},"Use ",[284,454,455],{},"requiredText"," for required fields and check the format separately with ",[284,458,459],{},"v.regex",". Masking only affects the display; the original text is what gets validated and submitted.",[317,462],{"name":463},"input-text-validation",[294,465,467],{"id":466},"leading-icon-with-mask","Leading icon with mask",[281,469,470,473],{},[284,471,472],{},"#leading"," goes on the left while the eye button stays on the right, so both can be used together.",[317,475],{"name":476},"input-text-leading-mask",[294,478,480],{"id":479},"clear-button","Clear button",[281,482,483,484,487,488,492],{},"Put a clear button in ",[284,485,486],{},"#trailing",". When masked or loading,