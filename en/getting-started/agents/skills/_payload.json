es","\u002Fen\u002Freleases","en\u002F5.releases",[273],{"title":274,"icon":12,"path":275,"stem":276,"children":277,"page":12},"Versions","\u002Fen\u002Freleases\u002Fversions","en\u002F5.releases\u002F1.versions",[278,282],{"title":279,"path":280,"stem":281},"v3.1.0","\u002Fen\u002Freleases\u002Fversions\u002Fv3-1-0","en\u002F5.releases\u002F1.versions\u002F1.v3-1-0",{"title":283,"path":284,"stem":285},"v3.0.0","\u002Fen\u002Freleases\u002Fversions\u002Fv3-0-0","en\u002F5.releases\u002F1.versions\u002F2.v3-0-0",{"id":287,"title":87,"body":288,"description":638,"extension":639,"links":640,"meta":641,"navigation":642,"path":88,"seo":643,"stem":89,"__hash__":644},"docs_en\u002Fen\u002F1.getting-started\u002F5.agents\u002F2.skills.md",{"type":289,"value":290,"toc":628},"minimark",[291,296,300,308,312,315,357,366,374,379,390,418,425,463,466,484,487,503,512,516,521,524,532,536,545,553,557,569,572,590,594,597,624],[292,293,295],"h2",{"id":294},"what-are-skills","What are Skills?",[297,298,299],"p",{},"Skills are structured knowledge files that give AI coding agents context about a library, framework, or codebase. The agent loads a skill directly into its context and can refer to it throughout the conversation.",[297,301,302,303,307],{},"Shuo UI provides a ",[304,305,306],"strong",{},"usage skill"," that teaches AI agents to build forms and query pages with Shuo UI.",[292,309,311],{"id":310},"usage","Usage",[297,313,314],{},"The usage skill gives AI agents comprehensive knowledge about building with Shuo UI. It covers:",[316,317,318,322,325,341,344,347,354],"ul",{},[319,320,321],"li",{},"Installation and CSS setup",[319,323,324],{},"The v-model types, main props, slots and common pitfalls of all 17 components",[319,326,327,328,332,333,336,337,340],{},"Form validation with ",[329,330,331],"code",{},"UForm",", ",[329,334,335],{},"UFormField"," and Valibot, and the shared rules (",[329,338,339],{},"requiredText"," and others)",[319,342,343],{},"The empty-value contract of each component and how to initialize state",[319,345,346],{},"The query card with a result list and server-side pagination",[319,348,349,350,353],{},"The ",[329,351,352],{},"shuoUi"," module options: site-wide defaults, locales and messages, theming",[319,355,356],{},"Display utilities for dates, numbers, phones and months",[297,358,359,360,365],{},"The skill includes additional references that the AI agent loads on demand based on the task, keeping responses focused and context-efficient. When it needs a full props table or more examples, the skill points the agent to the ",[361,362,364],"a",{"href":363},"\u002Fgetting-started\u002Fagents\u002Fllms-txt#markdown-version-of-a-single-page","markdown version"," of the matching docs page.",[367,368,369,370,373],"note",{},"Once installed, you can invoke the skill by typing ",[329,371,372],{},"\u002Fshuo-ui"," in your agent's chat.",[375,376,378],"h3",{"id":377},"skills-cli","Skills CLI",[297,380,349,381,389],{},[361,382,386],{"href":383,"rel":384},"https:\u002F\u002Fskills.sh",[385],"nofollow",[329,387,388],{},"skills"," CLI is the easiest way to install the Shuo UI skill. It supports many agents, including Cursor, Claude Code, Codex, Windsurf and Cline.",[391,392,397],"pre",{"className":393,"code":394,"language":395,"meta":396,"style":396},"language-bash shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","npx skills add k90325248\u002Fshuo-ui\n","bash","",[329,398,399],{"__ignoreMap":396},[400,401,404,408,412,415],"span",{"class":402,"line":403},"line",1,[400,405,407],{"class":406},"sBMFI","npx",[400,409,411],{"class":410},"sfazB"," skills",[400,413,414],{"class":410}," add",[400,416,417],{"class":410}," k90325248\u002Fshuo-ui\n",[297,419,420,421,424],{},"Target specific agents with the ",[329,422,423],{},"--agent"," flag:",[391,426,428],{"className":393,"code":427,"language":395,"meta":396,"style":396},"npx skills add k90325248\u002Fshuo-ui --agent cursor\nnpx skills add k90325248\u002Fshuo-ui --agent claude-code\n",[329,429,430,447],{"__ignoreMap":396},[400,431,432,434,436,438,441,444],{"class":402,"line":403},[400,433,407],{"class":406},[400,435,411],{"class":410},[400,437,414],{"class":410},[400,439,440],{"class":410}," k90325248\u002Fshuo-ui",[400,442,443],{"class":410}," --agent",[400,445,446],{"class":410}," cursor\n",[400,448,450,452,454,456,458,460],{"class":402,"line":449},2,[400,451,407],{"class":406},[400,453,411],{"class":410},[400,455,414],{"class":410},[400,457,440],{"class":410},[400,459,443],{"class":410},[400,461,462],{"class":410}," claude-code\n",[297,464,465],{},"Or install globally so the skill is available across all your projects:",[391,467,469],{"className":393,"code":468,"language":395,"meta":396,"style":396},"npx skills add k90325248\u002Fshuo-ui --global\n",[329,470,471],{"__ignoreMap":396},[400,472,473,475,477,479,481],{"class":402,"line":403},[400,474,407],{"class":406},[400,476,411],{"class":410},[400,478,414],{"class":410},[400,480,440],{"class":410},[400,482,483],{"class":410}," --global\n",[297,485,486],{},"If cloning from GitHub is slow on your network, you can install directly from the docs site instead:",[391,488,490],{"className":393,"code":489,"language":395,"meta":396,"style":396},"npx skills add https:\u002F\u002Fk90325248.github.io\u002Fshuo-ui\n",[329,491,492],{"__ignoreMap":396},[400,493,494,496,498,500],{"class":402,"line":403},[400,495,407],{"class":406},[400,497,411],{"class":410},[400,499,414],{"class":410},[400,501,502],{"class":410}," https:\u002F\u002Fk90325248.github.io\u002Fshuo-ui\n",[504,505,506,507,511],"tip",{},"Visit ",[361,508,510],{"href":383,"rel":509},[385],"skills.sh"," to learn more about the skills ecosystem and browse other skills.",[375,513,515],{"id":514},"cursor","Cursor",[517,518,520],"h4",{"id":519},"quick-install","Quick install",[297,522,523],{},"Click the button below to install the Shuo UI skill directly in Cursor:",[525,526],"u-button",{"color":527,"icon":528,"label":529,"to":5