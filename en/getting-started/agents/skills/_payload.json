,330,334,337,353,356,359,366],"ul",{},[331,332,333],"li",{},"Installation and CSS setup",[331,335,336],{},"The v-model types, main props, slots and common pitfalls of all 17 components",[331,338,339,340,344,345,348,349,352],{},"Form validation with ",[341,342,343],"code",{},"UForm",", ",[341,346,347],{},"UFormField"," and Valibot, and the shared rules (",[341,350,351],{},"requiredText"," and others)",[331,354,355],{},"The empty-value contract of each component and how to initialize state",[331,357,358],{},"The query card with a result list and server-side pagination",[331,360,361,362,365],{},"The ",[341,363,364],{},"shuoUi"," module options: site-wide defaults, locales and messages, theming",[331,367,368],{},"Display utilities for dates, numbers, phones and months",[309,370,371,372,377],{},"The skill includes additional references that the AI agent loads on demand based on the task, keeping responses focused and context-efficient. When it needs a full props table or more examples, the skill points the agent to the ",[373,374,376],"a",{"href":375},"\u002Fgetting-started\u002Fagents\u002Fllms-txt#markdown-version-of-a-single-page","markdown version"," of the matching docs page.",[379,380,381,382,385],"note",{},"Once installed, you can invoke the skill by typing ",[341,383,384],{},"\u002Fshuo-ui"," in your agent's chat.",[387,388,390],"h3",{"id":389},"skills-cli","Skills CLI",[309,392,361,393,401],{},[373,394,398],{"href":395,"rel":396},"https:\u002F\u002Fskills.sh",[397],"nofollow",[341,399,400],{},"skills"," CLI is the easiest way to install the Shuo UI skill. It supports many agents, including Cursor, Claude Code, Codex, Windsurf and Cline.",[403,404,409],"pre",{"className":405,"code":406,"language":407,"meta":408,"style":408},"language-bash shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","npx skills add k90325248\u002Fshuo-ui\n","bash","",[341,410,411],{"__ignoreMap":408},[412,413,416,420,424,427],"span",{"class":414,"line":415},"line",1,[412,417,419],{"class":418},"sBMFI","npx",[412,421,423],{"class":422},"sfazB"," skills",[412,425,426],{"class":422}," add",[412,428,429],{"class":422}," k90325248\u002Fshuo-ui\n",[309,431,432,433,436],{},"Target specific agents with the ",[341,434,435],{},"--agent"," flag:",[403,438,440],{"className":405,"code":439,"language":407,"meta":408,"style":408},"npx skills add k90325248\u002Fshuo-ui --agent cursor\nnpx skills add k90325248\u002Fshuo-ui --agent claude-code\n",[341,441,442,459],{"__ignoreMap":408},[412,443,444,446,448,450,453,456],{"class":414,"line":415},[412,445,419],{"class":418},[412,447,423],{"class":422},[412,449,426],{"class":422},[412,451,452],{"class":422}," k90325248\u002Fshuo-ui",[412,454,455],{"class":422}," --agent",[412,457,458],{"class":422}," cursor\n",[412,460,462,464,466,468,470,472],{"class":414,"line":461},2,[412,463,419],{"class":418},[412,465,423],{"class":422},[412,467,426],{"class":422},[412,469,452],{"class":422},[412,471,455],{"class":422},[412,473,474],{"class":422}," claude-code\n",[309,476,477],{},"Or install globally so the skill is available across all your projects:",[403,479,481],{"className":405,"code":480,"language":407,"meta":408,"style":408},"npx skills add k90325248\u002Fshuo-ui --global\n",[341,482,483],{"__ignoreMap":408},[412,484,485,487,489,491,493],{"class":414,"line":415},[412,486,419],{"class":418},[412,488,423],{"class":422},[412,490,426],{"class":422},[412,492,452],{"class":422},[412,494,495],{"class":422}," --global\n",[309,497,498],{},"If cloning from GitHub is slow on your network, you can install directly from the docs site instead:",[403,500,502],{"className":405,"code":501,"language":407,"meta":408,"style":408},"npx skills add https:\u002F\u002Fk90325248.github.io\u002Fshuo-ui\n",[341,503,504],{"__ignoreMap":408},[412,505,506,508,510,512],{"class":414,"line":415},[412,507,419],{"class":418},[412,509,423],{"class":422},[412,511,426],{"class":422},[412,513,514],{"class":422}," https:\u002F\u002Fk90325