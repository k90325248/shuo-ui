es","\u002Fen\u002Freleases","en\u002F5.releases",[273],{"title":274,"icon":12,"path":275,"stem":276,"children":277,"page":12},"Versions","\u002Fen\u002Freleases\u002Fversions","en\u002F5.releases\u002F1.versions",[278],{"title":279,"path":280,"stem":281},"v3.0.0","\u002Fen\u002Freleases\u002Fversions\u002Fv3-0-0","en\u002F5.releases\u002F1.versions\u002F1.v3-0-0",{"id":283,"title":87,"body":284,"description":634,"extension":635,"links":636,"meta":637,"navigation":638,"path":88,"seo":639,"stem":89,"__hash__":640},"docs_en\u002Fen\u002F1.getting-started\u002F5.agents\u002F2.skills.md",{"type":285,"value":286,"toc":624},"minimark",[287,292,296,304,308,311,353,362,370,375,386,414,421,459,462,480,483,499,508,512,517,520,528,532,541,549,553,565,568,586,590,593,620],[288,289,291],"h2",{"id":290},"what-are-skills","What are Skills?",[293,294,295],"p",{},"Skills are structured knowledge files that give AI coding agents context about a library, framework, or codebase. The agent loads a skill directly into its context and can refer to it throughout the conversation.",[293,297,298,299,303],{},"Shuo UI provides a ",[300,301,302],"strong",{},"usage skill"," that teaches AI agents to build forms and query pages with Shuo UI.",[288,305,307],{"id":306},"usage","Usage",[293,309,310],{},"The usage skill gives AI agents comprehensive knowledge about building with Shuo UI. It covers:",[312,313,314,318,321,337,340,343,350],"ul",{},[315,316,317],"li",{},"Installation and CSS setup",[315,319,320],{},"The v-model types, main props, slots and common pitfalls of all 17 components",[315,322,323,324,328,329,332,333,336],{},"Form validation with ",[325,326,327],"code",{},"UForm",", ",[325,330,331],{},"UFormField"," and Valibot, and the shared rules (",[325,334,335],{},"requiredText"," and others)",[315,338,339],{},"The empty-value contract of each component and how to initialize state",[315,341,342],{},"The query card with a result list and server-side pagination",[315,344,345,346,349],{},"The ",[325,347,348],{},"shuoUi"," module options: site-wide defaults, locales and messages, theming",[315,351,352],{},"Display utilities for dates, numbers, phones and months",[293,354,355,356,361],{},"The skill includes additional references that the AI agent loads on demand based on the task, keeping responses focused and context-efficient. When it needs a full props table or more examples, the skill points the agent to the ",[357,358,360],"a",{"href":359},"\u002Fgetting-started\u002Fagents\u002Fllms-txt#markdown-version-of-a-single-page","markdown version"," of the matching docs page.",[363,364,365,366,369],"note",{},"Once installed, you can invoke the skill by typing ",[325,367,368],{},"\u002Fshuo-ui"," in your agent's chat.",[371,372,374],"h3",{"id":373},"skills-cli","Skills CLI",[293,376,345,377,385],{},[357,378,382],{"href":379,"rel":380},"https:\u002F\u002Fskills.sh",[381],"nofollow",[325,383,384],{},"skills"," CLI is the easiest way to install the Shuo UI skill. It supports many agents, including Cursor, Claude Code, Codex, Windsurf and Cline.",[387,388,393],"pre",{"className":389,"code":390,"language":391,"meta":392,"style":392},"language-bash shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","npx skills add k90325248\u002Fshuo-ui\n","bash","",[325,394,395],{"__ignoreMap":392},[396,397,400,404,408,411],"span",{"class":398,"line":399},"line",1,[396,401,403],{"class":402},"sBMFI","npx",[396,405,407],{"class":406},"sfazB"," skills",[396,409,410],{"class":406}," add",[396,412,413],{"class":406}," k90325248\u002Fshuo-ui\n",[293,415,416,417,420],{},"Target specific agents with the ",[325,418,419],{},"--agent"," flag:",[387,422,424],{"className":389,"code":423,"language":391,"meta":392,"style":392},"npx skills add k90325248\u002Fshuo-ui --agent cursor\nnpx skills add k90325248\u002Fshuo-ui --agent claude-code\n",[325,425,426,443],{"__ignoreMap":392},[396,427,428,430,432,434,437,440],{"class":398,"line":399},[396,429,403],{"class":402}