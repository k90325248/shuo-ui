validation"," under Utilities for the parameters and behavior of each rule:",[338,339,340,353],"table",{},[341,342,343],"thead",{},[344,345,346,350],"tr",{},[347,348,349],"th",{},"Rule",[347,351,352],{},"Fields",[354,355,356,367,377,387,397],"tbody",{},[344,357,358,364],{},[359,360,361],"td",{},[308,362,363],{},"requiredText('Field name')",[359,365,366],{},"Text, string values of select menus and radio groups, date strings, multi-line text",[344,368,369,374],{},[359,370,371],{},[308,372,373],{},"requiredNumber('Field name')",[359,375,376],{},"Numbers",[344,378,379,384],{},[359,380,381],{},[308,382,383],{},"requiredArray('Field name', itemSchema)",[359,385,386],{},"Checkbox groups, multiple select menus",[344,388,389,394],{},[359,390,391],{},[308,392,393],{},"optionalEmail('Field name')",[359,395,396],{},"Optional email",[344,398,399,404],{},[359,400,401],{},[308,402,403],{},"optionalNonNegativeNumber('Field name')",[359,405,406],{},"Optional non-negative numbers such as amounts, terms, scores and rates",[304,408,409,410,413,414,417],{},"The default error message is \"field name + description\", where the field name is the label on screen, for example \"Name is required\". Messages can be overridden with the module option ",[308,411,412],{},"shuoUi.messages.validation","; see ",[333,415,47],{"href":416},"\u002Fgetting-started\u002Ftheme\u002Fmessages",".",[419,420,425],"pre",{"className":421,"code":422,"language":423,"meta":424,"style":424},"language-ts shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","import * as v from 'valibot';\n\nconst schema = v.object({\n  name: requiredText('Name'),\n  amount: requiredNumber('Amount'),\n  email: v.pipe(requiredText('Email'), v.email('Email is invalid')),\n  backupEmail: optionalEmail('Backup email'),\n  approvedAmount: optionalNonNegativeNumber('Approved amount')\n});\n","ts","",[308,426,427,463,470,498,526,550,605,629,652],{"__ignoreMap":424},[428,429,432,436,440,443,447,450,453,457,460],"sp