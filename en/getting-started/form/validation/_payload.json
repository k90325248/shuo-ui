54,355],{},"requiredText('Field name')",[351,357,358],{},"Text, string values of select menus and radio groups, date strings, multi-line text",[336,360,361,366],{},[351,362,363],{},[300,364,365],{},"requiredNumber('Field name')",[351,367,368],{},"Numbers",[336,370,371,376],{},[351,372,373],{},[300,374,375],{},"requiredArray('Field name', itemSchema)",[351,377,378],{},"Checkbox groups, multiple select menus",[336,380,381,386],{},[351,382,383],{},[300,384,385],{},"optionalEmail('Field name')",[351,387,388],{},"Optional email",[336,390,391,396],{},[351,392,393],{},[300,394,395],{},"optionalNonNegativeNumber('Field name')",[351,397,398],{},"Optional non-negative numbers such as amounts, terms, scores and rates",[296,400,401,402,405,406,409],{},"The default error message is \"field name + description\", where the field name is the label on screen, for example \"Name is required\". Messages can be overridden with the module option ",[300,403,404],{},"shuoUi.messages.validation","; see ",[325,407,47],{"href":408},"\u002Fgetting-started\u002Ftheme\u002Fmessages",".",[411,412,417],"pre",{"className":413,"code":414,"language":415,"meta":416,"style":416},"language-ts shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","import * as v from 'valibot';\n\nconst schema = v.object({\n  name: requiredText('Name'),\n  amount: requiredNumber('Amount'),\n  email: v.pipe(requiredText('Email'), v.email('Email is invalid')),\n  backupEmail: optionalEmail('Backup email'),\n  approvedAmount: optionalNonNegativeNumber('Approved amount')\n});\n","ts","",[300,418,419,455,462,490,518,542,597,621,644],{"__ignoreMap":416},[420,421,424,428,432,435,439,442,445,449,452],"span",{"class":422,"line":423},"line",1,[420,425,427],{"class":426},"s7zQu","import",[420,429,431],{"class":430},"sMK4o"," *",[420,433,434],{"class":426}," as",[420,436,438],{"class":437},"sTEyZ"," v ",[420,440,441],{"class":426},"from",[420,443,444],{"class":430}," '",[420,446,448],{"class":447},"sfazB