20,591,451],{"class":430},[420,593,594],{"class":437},"))",[420,596,517],{"class":430},[420,598,600,603,605,608,610,612,615,617,619],{"class":422,"line":599},7,[420,601,602],{"class":495},"  backupEmail",[420,604,499],{"class":430},[420,606,607],{"class":482}," optionalEmail",[420,609,486],{"class":437},[420,611,451],{"class":430},[420,613,614],{"class":447},"Backup email",[420,616,451],{"class":430},[420,618,514],{"class":437},[420,620,517],{"class":430},[420,622,624,627,629,632,634,636,639,641],{"class":422,"line":623},8,[420,625,626],{"class":495},"  approvedAmount",[420,628,499],{"class":430},[420,630,631],{"class":482}," optionalNonNegativeNumber",[420,633,486],{"class":437},[420,635,451],{"class":430},[420,637,638],{"class":447},"Approved amount",[420,640,451],{"class":430},[420,642,643],{"class":437},")\n",[420,645,647,650,652],{"class":422,"line":646},9,[420,648,649],{"class":430},"}",[420,651,514],{"class":437},[420,653,454],{"class":430},[296,655,656,657,659],{},"Add reusable format, length or range rules to the shared file; cross-field rules specific to one page stay in that form. Compose them with Valibot ",[300,658,556],{}," instead of building a separate validation config language.",[296,661,662,663,666,667,670,671,674,675,678,679,682,683,687],{},"File fields (",[300,664,665],{},"ShuoFile",") bind ",[300,668,669],{},"File | null",". Combine Valibot's ",[300,672,673],{},"v.file",", ",[300,676,677],{},"v.mimeType"," and ",[300,680,681],{},"v.maxSize"," for required, type and size checks; see ",[325,684,686],{"href":685},"\u002Fcomponents\u002Fphone-file\u002Ffile#with-form-validation","With form validation"," on the File page.",[689,690,691,692,409],"note",{},"Dates and options are currently only checked for being required. Add rules for date formats, whether an option is still valid, cross-field conditions, numeric ranges and so on as needed, for example ",[300,693,694],{},"v.pipe(v.number(), v.minValue(1), v.maxValue(100))",[317,696,698],{"id":697},"empty-values-and-types","Empty values and types",[296,700,701,702,705,706,709,710,713,714,716,717,720,721,725,726,729,730,678,733,736,737,739],{},"Components write ",[300,703,704],{},"null"," \u002F ",[300,707,708],{},"undefined"," bound by the parent back as the agreed empty value (",[300,711,712],{},"''"," for text, ",[300,715,704],{}," for numbers, ",[300,718,719],{},"[]"," for date ranges and so on; see ",[325,722,724],{"href":723},"\u002Fcomponents\u002Foverview\u002Fcommon#empty-values","Empty values","). Unexpected values are cleared, and most components also log a ",[300,727,728],{},"console.warn"," (",[300,731,732],{},"ShuoSelectMenu",[300,734,735],{},"ShuoMonths"," only clear without warning; see the same section). An unselected radio group is ",[300,738,712],{},", so options should not use an empty string as their value.",[296,741,742,743,705,745,747,748,674,751,754],{},"The input types of the shared schemas accept ",[300,744,704],{},[300,746,708],{}," while editing, and the output after validation narrows to ",[300,749,750],{},"string",[300,752,753],{},"number"," or an array of the item type, so you do not need to change the components' empty-value contract.",[317,756,758],{"id":757},"display-and-interaction","Display and interaction",[760,761,762,770,788],"ul",{},[763,764,765,766,769],"li",{},"We recommend the built-in theme (",[300,767,768],{},"theme: true",") for error messages: a floating style inset in the field's bottom border that does not add to the field height. Keep enough spacing between fields, and avoid clipping overflowing content in the containers.",[763,771,772,775,776,779,780,783,784,787],{},[300,773,774],{},"UForm"," only fires ",[300,777,778],{},"@submit"," after validation passes; read the validated data from ",[300,781,782],{},"event.data",". When validation fails, ",[300,785,786],{},"@error"," fires.",[763,789,790,791,794],{},"Use the default validation timing on input, blur and change. When resetting, besides clearing the state, call the form's ",[300,792,793],{},"clear()"," to clear the errors.",[796,797,798],"style",{},"html pre.shiki code .s7zQu, html code.shiki .s7zQu{--shiki-light:#39ADB5;--shiki-light-font-style:italic;--shiki-default:#89DDFF;--shiki-default-font-style:italic;--shiki-dark:#89DDFF;--shiki-dark-font-style:italic}html pre.shiki code .sMK4o, html code.shiki .sMK4o{--shiki-light:#39ADB5;--shiki-default:#89DDFF;--shiki-dark:#89DDFF}html pre.shiki code .sTEyZ, html code.shiki .sTEyZ{--shiki-light:#90A4AE;--shiki-default:#EEFFFF;--shiki-dark:#BABED8}html pre.shiki code .sfazB, html code.shiki .sfazB{--shiki-light:#91B859;--shiki-default:#C3E88D;--shiki-dark:#C3E88D}html pre.shiki code .spNyl, html code.shiki .spNyl{--shiki-light:#9C3EDA;--shiki-default:#C792EA;--shiki-dark:#C792EA}html pre.shiki code .s2Zo4, html code.shiki .s2Zo4{--shiki-light:#6182B8;--shiki-default:#82AAFF;--shiki-dark:#82AAFF}html pre.shiki code .swJcz, html code.shiki .swJcz{--shiki-light:#E53935;--shiki-default:#F07178;--shiki-dark:#F07178}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dar