ach form composes its own schema, and business rules stay out of the input components. See ",[337,338,62],"a",{"href":339},"\u002Futils\u002Fform\u002Fvalidation"," under Utilities for the parameters and behavior of each rule:",[342,343,344,357],"table",{},[345,346,347],"thead",{},[348,349,350,354],"tr",{},[351,352,353],"th",{},"Rule",[351,355,356],{},"Fields",[358,359,360,371,381,391,401],"tbody",{},[348,361,362,368],{},[363,364,365],"td",{},[312,366,367],{},"requiredText('Field name')",[363,369,370],{},"Text, string values of select menus and radio groups, date strings, multi-line text",[348,372,373,378],{},[363,374,375],{},[312,376,377],{},"requiredNumber('Field name')",[363,379,380],{},"Numbers",[348,382,383,388],{},[363,384,385],{},[312,386,387],{},"requiredArray('Field name', itemSchema)",[363,389,390],{},"Checkbox groups, multiple select menus",[348,392,393,398],{},[363,394,395],{},[312,396,397],{},"optionalEmail('Field name')",[363,399,400],{},"Optional email",[348,402,403,408],{},[363,404,405],{},[312,406,407],{},"optionalNonNegativeNumber('Field name')",[363,409,410],{},"Optional non-negative numbers such as amounts, terms, scores and rates",[308,412,413,414,417,418,421],{},"The default error message is \"field name + description\", where the field name is the label on screen, for example \"Name is required\". Messages can be overridden with the module option ",[312,415,416],{},"shuoUi.messages.validation","; see ",[337,419,47],{"href":420},"\u002Fgetting-started\u002Ftheme\u002Fmessages",".",[423,424,429],"pre",{"className":425,"code":426,"language":427,"meta":428,"style":428},"language-ts shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","import * as v from 'valibot';\n\nconst schema = v.object({\n  name: requiredText('Name'),\n  amount: requiredNumber('Amount'),\n  email: v.pipe(requiredText('Email'), v.email('Email is invalid')),\n  backupEmail: optionalEmail('Backup email'),\n  approvedAmount: optionalNonNegativeNumber('Approved amount')\n});\n","ts","",[312,430,431,467,474,502,530,554,609,633,656],{"__ignoreMap":428},[432,433,436,440,444,447,451,454,457,461,464],"span",{"class":434,"line":435},"line",1,[432,437,439],{"class":438},"s7zQu","import",[432,441,443],{"class":442},"sMK4o"," *",[432,445,446],{"class":438}," as",[432,448,450],{"class":449},"sTEyZ"," v ",[432,452,453],{"class":438},"from",[432,455,456],{"class":442}," '",[432,458,460],{"class":459},"sfazB","valibot",[432,462,463],{"class":442},"'",[432,465,466],{"class":442},";\n",[432,468,470],{"class":434,"line":469},2,[432,471,473],{"emptyLinePlaceholder":472},true,"\n",[432,475,477,481,484,487,490,492,496,499],{"class":434,"line":476},3,[432,478,480],{"class":479},"spNyl","const",[432,482,483],{"class":449}," schema ",[432,485,486],{"class":442},"=",[432,488,489],{"class":449}," v",[432,491,421],{"class":442},[432,493,495],{"class":494},"s2Zo4","object",[432,497,498],{"class":449},"(",[432,500,501],{"class":442},"{\n",[432,503,505,509,512,515,517,519,522,524,527],{"class":434,"line":504},4,[432,506,508],{"class":507},"swJcz","  name",[432,510,511],{"class":442},":",[432,513,514],{"class":494}," requiredText",[432,516,498],{"class":449},[432,518,463],{"class":442},[432,520,521],{"class":459},"Name",[432,523,463],{"class":442},[432,525,526],{"class":449},")",[432,528,529],{"class":442},",\n",[432,531,533,536,538,541,543,545,548,550,552],{"class":434,"line":532},5,[432,534,535],{"class":507},"  amount",[432,537,511],{"class":442},[432,539,540],{"class":494}," requiredNumber",[432,542,498],{"class":449},[432,544,463],{"class":442},[432,546,547],{"class":459},"Amount",[432,549,463],{"class":442},[432,551,526],{"class":449},[432,553,529],{"class":442},[432,555,557,560,562,564,566,569,571,574,576,578,581,583,585,588,590,592,595,597,599,602,604,607],{"class":434,"line":556},6,[432,558,559],{"class":507},"  email",[432,561,511],{"class":442},[432,563,489],{"class":449},[432,565,421],{"class":442},[432,567,568],{"class":494},"p