,367],{},"requiredArray('Field name', itemSchema)",[343,369,370],{},"Checkbox groups, multiple select menus",[328,372,373,378],{},[343,374,375],{},[292,376,377],{},"optionalEmail('Field name')",[343,379,380],{},"Optional email",[328,382,383,388],{},[343,384,385],{},[292,386,387],{},"optionalNonNegativeNumber('Field name')",[343,389,390],{},"Optional non-negative numbers such as amounts, terms, scores and rates",[288,392,393,394,397,398,401],{},"The default error message is \"field name + description\", where the field name is the label on screen, for example \"Name is required\". Messages can be overridden with the module option ",[292,395,396],{},"shuoUi.messages.validation","; see ",[317,399,47],{"href":400},"\u002Fgetting-started\u002Ftheme\u002Fmessages",".",[403,404,409],"pre",{"className":405,"code":406,"language":407,"meta":408,"style":408},"language-ts shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","import * as v from 'valibot';\n\nconst schema = v.object({\n  name: requiredText('Name'),\n  amount: requiredNumber('Amount'),\n  email: v.pipe(requiredText('Email'), v.email('Email is invalid')),\n  backupEmail: optionalEmail('Backup email'),\n  approvedAmount: optionalNonNegativeNumber('Approved amount')\n});\n","ts","",[292,410,411,447,454,482,510,534,589,613,636],{"__ignoreMap":408},[412,413,416,420,424,427,431,434,437,441,444],"span",{"class":414,"line":415},"line",1,[412,417,419],{"class":418},"s7zQu","import",[412,421,423],{"class":422},"sMK4o"," *",[412,425,426],{"class":418}," as",[412,428,430],{"class":429},"sTEyZ"," v ",[412,432,433],{"class":418},"from",[412,435,436],{"class":422}," '",[412,438,440],{"class":439},"sfazB","valibot",[412,442,443],{"class":422},"'",[412,445,446],{"class":422},";\n",[412,448,450],{"class":414,"line":449},2,[412,451,453],{"emptyLinePlaceholder":452},true,"\n",[412,455,457,461,464,467,470,472,476,479],{"class":414,"line":456},3,[412,458,460],{"class":459},"spNyl","const",[412,462,463],{"c