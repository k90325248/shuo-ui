":595},7,[416,597,598],{"class":491},"  backupEmail",[416,600,495],{"class":426},[416,602,603],{"class":478}," optionalEmail",[416,605,482],{"class":433},[416,607,447],{"class":426},[416,609,610],{"class":443},"Backup email",[416,612,447],{"class":426},[416,614,510],{"class":433},[416,616,513],{"class":426},[416,618,620,623,625,628,630,632,635,637],{"class":418,"line":619},8,[416,621,622],{"class":491},"  approvedAmount",[416,624,495],{"class":426},[416,626,627],{"class":478}," optionalNonNegativeNumber",[416,629,482],{"class":433},[416,631,447],{"class":426},[416,633,634],{"class":443},"Approved amount",[416,636,447],{"class":426},[416,638,639],{"class":433},")\n",[416,641,643,646,648],{"class":418,"line":642},9,[416,644,645],{"class":426},"}",[416,647,510],{"class":433},[416,649,450],{"class":426},[292,651,652,653,655],{},"Add reusable format, length or range rules to the shared file; cross-field rules specific to one page stay in that form. Compose them with Valibot ",[296,654,552],{}," instead of building a separate validation config language.",[292,657,658,659,662,663,666,667,670,671,674,675,678,679,683],{},"File fields (",[296,660,661],{},"ShuoFile",") bind ",[296,664,665],{},"File | null",". Combine Valibot's ",[296,668,669],{},"v.file",", ",[296,672,673],{},"v.mimeType"," and ",[296,676,677],{},"v.maxSize"," for required, type and size checks; see ",[321,680,682],{"href":681},"\u002Fcomponents\u002Fphone-file\u002Ffile#with-form-validation","With form validation"," on the File page.",[685,686,687,688,405],"note",{},"Dates and options are currently only checked for being required. Add rules for date formats, whether an option is still valid, cross-field conditions, numeric ranges and so on as needed, for example ",[296,689,690],{},"v.pipe(v.number(), v.minValue(1), v.maxValue(100))",[313,692,694],{"id":693},"empty-values-and-types","Empty values and types",[292,696,697,698,701,702,705,706,709,710,712,713,716,717,721,722,725,726,674,729,732,733,735],{},"Components write ",[296,699,700],{},"null"," \u002F ",[296,703,704],{},"undefined"," bound by the parent back as the agreed empty value (",[296,707,708],{},"''"," for text, ",[296,711,700],{}," for numbers, ",[296,714,715],{},"[]"," for date ranges and so on; see ",[321,718,720],{"href":719},"\u002Fcomponents\u002Foverview\u002Fcommon#empty-values","Empty values","). Unexpected values are cleared, and most components also log a ",[296,723,724],{},"console.warn"," (",[296,727,728],{},"ShuoSelectMenu",[296,730,731],{},"ShuoMonths"," only clear without warning; see the same section). An unselected radio group is ",[296,734,708],{},", so options should not use an empty string as their value.",[292,737,738,739,701,741,743,744,670,747,750],{},"The input types of the shared schemas accept ",[296,740,700],{},[296,742,704],{}," while editing, and the output after validation narrows to ",[296,745,746],{},"string",[296,748,749],{},"number"," or an array of the item type, so you do not need to change the components' empty-value contract.",[313,752,754],{"id":753},"display-and-interaction","Display and interaction",[756,757,758,766,784],"ul",{},[759,760,761,762,765],"li",{},"We recommend the built-in theme (",[296,763,764],{},"theme: true",") for error messages: a floating style inset in the field's bottom border that does not add to the field height. Keep enough spacing between fields, and avoid clipping overflowing content in the containers.",[759,767,768,771,772,775,776,779,780,783],{},[296,769,770],{},"UForm"," only fires ",[296,773,774],{},"@submit"," after validation passes; read the validated data from ",[296,777,778],{},"event.data",". When validation fails, ",[296,781,782],{},"@error"," fires.",[759,785,786,787,790],{},"Use the default validation timing on input, blur and change. When resetting, besides clearing the state, call the form's ",[296,788,789],{},"clear()"," to clear the errors.",[792,793,794],"style",{},"html pre.shiki code .s7zQu, html code.shiki .s7zQu{--shiki-l