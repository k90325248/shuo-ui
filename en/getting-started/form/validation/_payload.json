r",{},[343,344,345],"th",{},"Rule",[343,347,348],{},"Fields",[350,351,352,363,373,383,393],"tbody",{},[340,353,354,360],{},[355,356,357],"td",{},[304,358,359],{},"requiredText('Field name')",[355,361,362],{},"Text, string values of select menus and radio groups, date strings, multi-line text",[340,364,365,370],{},[355,366,367],{},[304,368,369],{},"requiredNumber('Field name')",[355,371,372],{},"Numbers",[340,374,375,380],{},[355,376,377],{},[304,378,379],{},"requiredArray('Field name', itemSchema)",[355,381,382],{},"Checkbox groups, multiple select menus",[340,384,385,390],{},[355,386,387],{},[304,388,389],{},"optionalEmail('Field name')",[355,391,392],{},"Optional email",[340,394,395,400],{},[355,396,397],{},[304,398,399],{},"optionalNonNegativeNumber('Field name')",[355,401,402],{},"Optional non-negative numbers such as amounts, terms, scores and rates",[300,404,405,406,409,410,413],{},"The default error message is \"field name + description\", where the field name is the label on screen, for example \"Name is required\". Messages can be overridden with the module option ",[304,407,408],{},"shuoUi.messages.validation","; see ",[329,411,47],{"href":412},"\u002Fgetting-started\u002Ftheme\u002Fmessages",".",[415,416,421],"pre",{"className":417,"code":418,"language":419,"meta":420,"style":420},"language-ts shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","import * as v from 'valibot';\n\nconst schema = v.object({\n  name: requiredText('Name'),\n  amount: requiredNumber('Amount'),\n  email: v.pipe(requiredText('Email'), v.email('Email is invalid')),\n  backupEmail: optionalEmail('Backup email'),\n  approvedAmount: optionalNonNegativeNumber('Approved amount')\n});\n","ts","",[304,422,423,459,466,494,522,546,601,625,648],{"__ignoreMap":420},[424,425,428,432,436,439,443,446,449,453,456],"span",{"class":426,"line":427},"line",1,[424,429,431],{"class":430},"s7zQu","import",[424,433,435],{"class":434},"sMK4o"," *",[424,437,438],{"class":430}