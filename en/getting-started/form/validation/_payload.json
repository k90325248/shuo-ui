ss":455},"Email",[428,578,459],{"class":438},[428,580,522],{"class":445},[428,582,583],{"class":438},",",[428,585,485],{"class":445},[428,587,417],{"class":438},[428,589,590],{"class":490},"email",[428,592,494],{"class":445},[428,594,459],{"class":438},[428,596,597],{"class":455},"Email is invalid",[428,599,459],{"class":438},[428,601,602],{"class":445},"))",[428,604,525],{"class":438},[428,606,608,611,613,616,618,620,623,625,627],{"class":430,"line":607},7,[428,609,610],{"class":503},"  backupEmail",[428,612,507],{"class":438},[428,614,615],{"class":490}," optionalEmail",[428,617,494],{"class":445},[428,619,459],{"class":438},[428,621,622],{"class":455},"Backup email",[428,624,459],{"class":438},[428,626,522],{"class":445},[428,628,525],{"class":438},[428,630,632,635,637,640,642,644,647,649],{"class":430,"line":631},8,[428,633,634],{"class":503},"  approvedAmount",[428,636,507],{"class":438},[428,638,639],{"class":490}," optionalNonNegativeNumber",[428,641,494],{"class":445},[428,643,459],{"class":438},[428,645,646],{"class":455},"Approved amount",[428,648,459],{"class":438},[428,650,651],{"class":445},")\n",[428,653,655,658,660],{"class":430,"line":654},9,[428,656,657],{"class":438},"}",[428,659,522],{"class":445},[428,661,462],{"class":438},[304,663,664,665,667],{},"Add reusable format, length or range rules to the shared file; cross-field rules specific to one page stay in that form. Compose them with Valibot ",[308,666,564],{}," instead of building a separate validation config language.",[304,669,670,671,674,675,678,679,682,683,686,687,690,691,695],{},"File fields (",[308,672,673],{},"ShuoFile",") bind ",[308,676,677],{},"File | null",". Combine Valibot's ",[308,680,681],{},"v.file",", ",[308,684,685],{},"v.mimeType"," and ",[308,688,689],{},"v.maxSize"," for required, type and size checks; see ",[333,692,694],{"href":693},"\u002Fcomponents\u002Fphone-file\u002Ffile#with-form-validation","With form validation"," on the File page.",[697,698,699,700,417],"note",{},"Dates and options are currently only checked for being required. Add rules for date formats, whether an option is still valid, cross-field conditions, numeric ranges and so on as needed, for example ",[308,701,702],{},"v.pipe(v.number(), v.minValue(1), v.maxValue(100))",[325,704,706],{"id":705},"empty-values-and-types","Empty values and types",[304,708,709,710,713,714,717,718,721,722,724,725,728,729,733,734,737,738,686,741,744,745,747],{},"Components write ",[308,711,712],{},"null"," \u002F ",[308,715,716],{},"undefined"," bound by the parent back as the agreed empty value (",[308,719,720],{},"''"," for text, ",[308,723,712],{}," for numbers, ",[308,726,727],{},"[]"," for date ranges and so on; see ",[333,730,732],{"href":731},"\u002Fcomponents\u002Foverview\u002Fcommon#empty-values","Empty values","). Unexpected values are cleared, and most components also log a ",[308,735,736],{},"console.warn"," (",[308,739,740],{},"ShuoSelectMenu",[308,742,743],{},"ShuoMonths"," only clear without warning; see the same section). An unselected radio group is ",[308,746,720],{},", so options should not use an empty string as their value.",[304,749,750,751,713,753,755,756,682,759,762],{},"The input types of the shared schemas accept ",[308,752,712],{},[308,754,716],{}," while editing, and the output after validation narrows to ",[308,757,758],{},"string",[308,760,761],{},"number"," or an array of the item type, so you do not need to change the components' empty-value contract.",[325,764,766],{"id":765},"display-and-interaction","Display and interaction",[768,769,770,778,796],"ul",{},[771,772,773,774,777],"li",{},"We recommend the built-in theme (",[308,775,776],{},"theme: true",") for error messages: a floating style inset in the field's bottom border that does not add to the field height. Keep enough spacing between fields, and avoid clipping overflowing content in the containers.",[771,779,780,783,784,787,788,791,792,795],{},[308,781,782],{},"UForm"," only fires ",[308,785,786],{},"@submit"," after validation passes; read the validated data from ",[308,789,790],{},"event.data",". When validation fails, ",[308,793,794],{},"@error"," fires.",[771,797,798,799,802],{},"Use the default validation timing on input, blur and change. When resetting, besides clearing the state, call the form's ",[308,800,801],{},"clear()"," to clear the errors.",[804,805,806],"style",{},"html pre.shiki code .s7zQu, html code.shiki .s7zQu{--shiki-light:#39ADB5;--shiki-light-font-style:italic;--shiki-default:#89DDFF;--shiki-default-font-style:italic;--shiki-dark:#89DDFF;--shiki-dark-font-style:italic}html pre.shiki code .sMK4o, html code.shiki .sMK4o{--shiki-light:#39ADB5;--shiki-default:#89DDFF;--shiki-dark:#89DDFF}html pre.shiki code .sTEyZ, html code.shiki .sTEyZ{--shiki-light:#90A4AE;--shiki-default:#EEFFFF;--shiki-dark:#BABED8}html pre.shiki code .sfazB, html code.shiki .sfazB{--shiki-light:#91B859;--shiki-default:#C3E88D;--shiki-dark:#C3E88D}html pre.shiki code .spNyl, html code.shiki .spNyl{--shiki-light:#9C3EDA;--shiki-default:#C792EA;--shiki-dark:#C792EA}html pre.shiki code .s2Zo4, html code.shiki .s2Zo4{--shiki-light:#6182B8;--shiki-default:#82AAFF;--shiki-dark:#82AAFF}html pre.shiki code .swJcz, html code.shiki .swJcz{--shiki-light:#E53935;--shiki-default:#F07178;--shiki-dark:#F07178}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}h