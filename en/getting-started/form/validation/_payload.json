77,378],{},[285,379,380],{},"optionalNonNegativeNumber('Field name')",[336,382,383],{},"Optional non-negative numbers such as amounts, terms, scores and rates",[281,385,386,387,390,391,394],{},"The default error message is \"field name + description\", where the field name is the label on screen, for example \"Name is required\". Messages can be overridden with the module option ",[285,388,389],{},"shuoUi.messages.validation","; see ",[310,392,47],{"href":393},"\u002Fgetting-started\u002Ftheme\u002Fmessages",".",[396,397,402],"pre",{"className":398,"code":399,"language":400,"meta":401,"style":401},"language-ts shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","import * as v from 'valibot';\n\nconst schema = v.object({\n  name: requiredText('Name'),\n  amount: requiredNumber('Amount'),\n  email: v.pipe(requiredText('Email'), v.email('Email is invalid')),\n  backupEmail: optionalEmail('Backup email'),\n  approvedAmount: optionalNonNegativeNumber('Approved amount')\n});\n","ts","",[285,403,404,440,447,475,503,527,582,606,629],{"__ignoreMap":401},[405,406,409,413,417,420,424,427,430,434,437],"span",{"class":407,"line":408},"line",1,[405,410,412],{"class":411},"s7zQu","import",[405,414,416],{"class":415},"sMK4o"," *",[405,418,419],{"class":411}," as",[405,421,423],{"class":422},"sTEyZ"," v ",[405,425,426],{"class":411},"from",[405,428,429],{"class":415}," '",[405,431,433],{"class":432},"sfazB","valibot",[405,435,436],{"class":415},"'",[405,438,439],{"class":415},";\n",[405,441,443],{"class":407,"line":442},2,[405,444,446],{"emptyLinePlaceholder":445},true,"\n",[405,448,450,454,457,460,463,465,469,472],{"class":407,"line":449},3,[405,451,453],{"class":452},"spNyl","const",[405,455,456],{"class":422}," schema ",[405,458,459],{"class":415},"=",[405,461,462],{"class":422}," v",[405,464,394],{"class":415},[405,466,468],{"class":467},"s2Zo4","object",[405,470,471],{"class":422},"(",[405,473,474],{"class":415},"{\n",[405,476,478,482,485,488,490,