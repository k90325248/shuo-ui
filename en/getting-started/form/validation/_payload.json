,357,362],{},[347,358,359],{},[296,360,361],{},"requiredNumber('Field name')",[347,363,364],{},"Numbers",[332,366,367,372],{},[347,368,369],{},[296,370,371],{},"requiredArray('Field name', itemSchema)",[347,373,374],{},"Checkbox groups, multiple select menus",[332,376,377,382],{},[347,378,379],{},[296,380,381],{},"optionalEmail('Field name')",[347,383,384],{},"Optional email",[332,386,387,392],{},[347,388,389],{},[296,390,391],{},"optionalNonNegativeNumber('Field name')",[347,393,394],{},"Optional non-negative numbers such as amounts, terms, scores and rates",[292,396,397,398,401,402,405],{},"The default error message is \"field name + description\", where the field name is the label on screen, for example \"Name is required\". Messages can be overridden with the module option ",[296,399,400],{},"shuoUi.messages.validation","; see ",[321,403,47],{"href":404},"\u002Fgetting-started\u002Ftheme\u002Fmessages",".",[407,408,413],"pre",{"className":409,"code":410,"language":411,"meta":412,"style":412},"language-ts shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","import * as v from 'valibot';\n\nconst schema = v.object({\n  name: requiredText('Name'),\n  amount: requiredNumber('Amount'),\n  email: v.pipe(requiredText('Email'), v.email('Email is invalid')),\n  backupEmail: optionalEmail('Backup email'),\n  approvedAmount: optionalNonNegativeNumber('Approved amount')\n});\n","ts","",[296,414,415,451,458,486,514,538,593,617,640],{"__ignoreMap":412},[416,417,420,424,428,431,435,438,441,445,448],"span",{"class":418,"line":419},"line",1,[416,421,423],{"class":422},"s7zQu","import",[416,425,427],{"class":426},"sMK4o"," *",[416,429,430],{"class":422}," as",[416,432,434],{"class":433},"sTEyZ"," v ",[416,436,437],{"class":422},"from",[416,439,440],{"class":426}," '",[416,442,444],{"class":443},"sfazB","valibot",[416,446,447],{"class":426},"'",[416,449,450],{"class":426},";\n",[416,452,454],{"class":418,"line":453},2,[416,455,457],{"emptyLinePlaceho