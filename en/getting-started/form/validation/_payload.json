ass":434},[424,585,586],{"class":486},"email",[424,588,490],{"class":441},[424,590,455],{"class":434},[424,592,593],{"class":451},"Email is invalid",[424,595,455],{"class":434},[424,597,598],{"class":441},"))",[424,600,521],{"class":434},[424,602,604,607,609,612,614,616,619,621,623],{"class":426,"line":603},7,[424,605,606],{"class":499},"  backupEmail",[424,608,503],{"class":434},[424,610,611],{"class":486}," optionalEmail",[424,613,490],{"class":441},[424,615,455],{"class":434},[424,617,618],{"class":451},"Backup email",[424,620,455],{"class":434},[424,622,518],{"class":441},[424,624,521],{"class":434},[424,626,628,631,633,636,638,640,643,645],{"class":426,"line":627},8,[424,629,630],{"class":499},"  approvedAmount",[424,632,503],{"class":434},[424,634,635],{"class":486}," optionalNonNegativeNumber",[424,637,490],{"class":441},[424,639,455],{"class":434},[424,641,642],{"class":451},"Approved amount",[424,644,455],{"class":434},[424,646,647],{"class":441},")\n",[424,649,651,654,656],{"class":426,"line":650},9,[424,652,653],{"class":434},"}",[424,655,518],{"class":441},[424,657,458],{"class":434},[300,659,660,661,663],{},"Add reusable format, length or range rules to the shared file; cross-field rules specific to one page stay in that form. Compose them with Valibot ",[304,662,560],{}," instead of building a separate validation config language.",[300,665,666,667,670,671,674,675,678,679,682,683,686,687,691],{},"File fields (",[304,668,669],{},"ShuoFile",") bind ",[304,672,673],{},"File | null",". Combine Valibot's ",[304,676,677],{},"v.file",", ",[304,680,681],{},"v.mimeType"," and ",[304,684,685],{},"v.maxSize"," for required, type and size checks; see ",[329,688,690],{"href":689},"\u002Fcomponents\u002Fphone-file\u002Ffile#with-form-validation","With form validation"," on the File page.",[693,694,695,696,413],"note",{},"Dates and options are currently only checked for being required. Add rules for date formats, whether an option is still valid, cross-field conditions, numeric ranges and so on as needed, for example ",[304,697,698],{},"v.pipe(v.number(), v.minValue(1), v.maxValue(100))",[321,700,702],{"id":701},"empty-values-and-types","Empty values and types",[300,704,705,706,709,710,713,714,717,718,720,721,724,725,729,730,733,734,682,737,740,741,743],{},"Components write ",[304,707,708],{},"null"," \u002F ",[304,711,712],{},"undefined"," bound by the parent back as the agreed empty value (",[304,715,716],{},"''"," for text, ",[304,719,708],{}," for numbers, ",[304,722,723],{},"[]"," for date ranges and so on; see ",[329,726,728],{"href":727},"\u002Fcomponents\u002Foverview\u002Fcommon#empty-values","Empty values","). Unexpected values are cleared, and most components also log a ",[304,731,732],{},"console.warn"," (",[304,735,736],{},"ShuoSelectMenu",[304,738,739],{},"ShuoMonths"," only clear without warning; see the same section). An unselected radio group is ",[304,742,716],{},", so options should not use an empty string as their value.",[300,745,746,747,709,749,751,752,678,755,758],{},"The input types of the shared schemas accept ",[304,748,708],{},[304,750,712],{}," while editing, and the output after validation narrows to ",[304,753,754],{},"string",[304,756,757],{},"number"," or an array of the item type, so you do not need to change the components' empty-value contract.",[321,760,762],{"id":761},"display-and-interaction","Display and interaction",[764,765,766,774,792],"ul",{},[767,768,769,770,773],"li",{},"We recommend the built-in theme (",[304,771,772],{},"theme: true",") for error messages: a floating style inset in the field's bottom border that does not add to the field height. Keep enough spacing between fields, and avoid clipping overflowing content in the containers.",[767,775,776,779,780,783,784,787,788,791],{},[304,777,778],{},"UForm"," only fires ",[304,781,782],{},"@submit"," after validation passes; read the validated data from ",[304,785,786],{},"event.data",". When validation fails, ",[304,789,790],{},"@error"," fires.",[767,793,794,795,798],{},"Use the default validation timing on input, blur and change. When resetting, besides clearing the state, call the form's ",[304,796,797],{},"clear()"," to clear the errors.",[800,801,802],"style",{},"html pre.shiki code .s7zQu, html code.shiki .s7zQu{--shiki-light:#39ADB5;--shiki-light-font-style:italic;--shiki-default:#89DDFF;--shiki-default-font-style:italic;--shiki-dark:#89DDFF;--shiki-dark-font-style:italic}html pre.shiki code .sMK4o, html code.shiki .sMK4o{--shiki-light:#39ADB5;--shiki-default:#89DDFF;--shiki-dark:#89DDFF}html pre.shiki code .sTEyZ, html code.shiki .sTEyZ{--shiki-light:#90A4AE;--shiki-default:#EEFFFF;--shiki-dark:#BABED8}html pre.shiki code .sfazB, html code.shiki .sfazB{--shiki-light:#91B859;--shiki-default:#C3E88D;--shiki-dark:#C3E88D}html pre.shiki code .spNyl, html code.shiki .spNyl{--shiki-light:#9C3EDA;--shiki-default:#C792EA;--shiki-dark:#C792EA}html pre.shiki code .s2Zo4, html code.shiki .s2Zo4{--shiki-light:#6182B8;--shiki-default:#82AAFF;--shiki-dark:#82AAFF}html pre.shiki code .swJcz, html code.shiki .swJcz{--shiki-light:#E53935;--shiki-default:#F07178;--shiki-dark:#F07178}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-d