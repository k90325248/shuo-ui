8,369,372,373,376,377,380,381,383,384,376,387,390,391,393],"li",{},[338,339,340,341,343,344,347,348,355],"strong",{},"Minimum ",[312,342,314],{}," is now ",[312,345,346],{},"^4.12.2"," (",[349,350,354],"a",{"href":351,"rel":352},"https:\u002F\u002Fgithub.com\u002Fnuxt\u002Fui\u002Fsecurity\u002Fadvisories\u002FGHSA-x9jw-j844-v24h",[353],"nofollow","GHSA-x9jw-j844-v24h",", CVSS 9.8):"," before 4.12.2, Nuxt UI components passed ",[312,358,359],{},"as"," straight to reka-ui's ",[312,362,363],{},"Primitive",", so an object carrying a ",[312,366,367],{},"template"," was compiled and run by Vue's CJS server renderer during SSR. Projects that render untrusted markdown through Comark or MDC (",[312,370,371],{},"@nuxt\u002Fcontent","), or let untrusted data reach ",[312,374,375],{},"app.config.ui"," or ",[312,378,379],{},"\u003CUTheme :props>",", could have arbitrary commands run on the server. Shuo UI components do not use ",[312,382,359],{},", ",[312,385,386],{},"resolveAs",[312,388,389],{},"UTheme"," themselves, but they share your project's ",[312,392,314],{},", so the peer dependency minimum is raised and installing will prompt you to upgrade.",[308,395,396],{},"To upgrade:",[398,399,404],"pre",{"className":400,"code":401,"language":402,"meta":403,"style":403},"language-bash shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","pnpm add @nuxt\u002Fui@^4.12.2\n","bash","",[312,405,406],{"__ignoreMap":403},[407,408,411,415,419],"span",{"class":409,"line":410},"line",1,[407,412,414],{"class":413},"sBMFI","pnpm",[407,416,418],{"class":417},"sfazB"," add",[407,420,421],{"class":417}," @nuxt\u002Fui@^4.12.2\n",[327,423,425],{"id":424},"bug-fixes","🐛 Bug Fixes",[332,427,428],{},[335,429,430,433,434,437,438,441],{},[338,431,432],{},"Full-text tooltip closed right away when moving focus between options:"," when Tab in ",[312,435,436],{},"ShuoCheckboxGroup"," or the arrow keys in ",[312,439,440],{},"ShuoRadioGroup"," moved to another truncated option, the tooltip closed and reopened, and the old tooltip, not yet unmounted, received Reka's open event and closed the new one with it. The tooltip now stays open while focus is inside the group and updates to the current option's text and position; it still closes when focus leaves the group.",[327,443,445],{"id":444},"installation","📦 Installation",[398,447,449],{"className":400,"code":448,"language":402,"meta":403,"style":403},"pnpm add github:k90325248\u002Fshuo-ui#v3.2.2\npnpm add @iconify-json\u002Flucide # recommended, icons are bundled\n",[312,450,451,460],{"__ignoreMap":403},[407,452,453,455,457],{"class":409,"line":410},[407,454,414],{"class":413},[407,456,418],{"class":417},[407,458,459],{"class":417}," github:k90325248\u002Fshuo-ui#v3.2.2\n",[407,461,463,465,467,470],{"class":409,"line":462},2,[407,464,414],{"class":413},[407,466,418],{"class":417},[407,468,469],{"class":417}," @iconify-json\u002Flucide",[407,471,473],{"class":472},"sHwdD"," # recommended, icons are bundled\n",[308,475,476,477,480,481,484,485,488],{},"Enable the module in ",[312,478,479],{},"nuxt.config.ts"," and add ",[312,482,483],{},"@import '@shuo\u002Fui\u002Fcss';"," to your CSS; see ",[349,486,22],{"href":487},"\u002Fgetting-started\u002Foverview\u002Finstallation"," on the docs site.",[327,490,492],{"id":491},"requirements","📋 Requirements",[494,495,496,509],"table",{},[497,498,499],"thead",{},[500,501,502,506],"tr",{},[503,504,505],"th",{},"Package",[503,507,508],{},"Version",[510,511,512,523],"tbody",{},[500,513,514,518],{},[515,516,517],"td",{},"Nuxt",[515,519,520],{},[312,521,522],{},"^4.6.2",[500,524,525,529],{},[515,526,527],{},[312,528,314],{},[515,530,531],{},[312,532,346],{},[534,535,536],"style",{},"html pre.shiki code .sBMFI, html code.shiki .sBMFI{--shiki-light:#E2931D;--shiki-default:#FFCB6B;--shiki-dark:#FFCB6B}html pre.shiki code .sfazB, html code.shiki .sfazB{--shiki-light:#91B859;--shiki-default:#C3E88D;--shiki-dark:#C3E88D}html .light .shiki span {color: var(--shi