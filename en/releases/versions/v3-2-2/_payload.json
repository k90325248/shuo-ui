ow ",[308,341,342],{},"^4.12.2"," (",[345,346,350],"a",{"href":347,"rel":348},"https:\u002F\u002Fgithub.com\u002Fnuxt\u002Fui\u002Fsecurity\u002Fadvisories\u002FGHSA-x9jw-j844-v24h",[349],"nofollow","GHSA-x9jw-j844-v24h",", CVSS 9.8):"," before 4.12.2, Nuxt UI components passed ",[308,354,355],{},"as"," straight to reka-ui's ",[308,358,359],{},"Primitive",", so an object carrying a ",[308,362,363],{},"template"," was compiled and run by Vue's CJS server renderer during SSR. Projects that render untrusted markdown through Comark or MDC (",[308,366,367],{},"@nuxt\u002Fcontent","), or let untrusted data reach ",[308,370,371],{},"app.config.ui"," or ",[308,374,375],{},"\u003CUTheme :props>",", could have arbitrary commands run on the server. Shuo UI components do not use ",[308,378,355],{},", ",[308,381,382],{},"resolveAs",[308,384,385],{},"UTheme"," themselves, but they share your project's ",[308,388,310],{},", so the peer dependency minimum is raised and installing will prompt you to upgrade.",[304,391,392],{},"To upgrade:",[394,395,400],"pre",{"className":396,"code":397,"language":398,"meta":399,"style":399},"language-bash shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","pnpm add @nuxt\u002Fui@^4.12.2\n","bash","",[308,401,402],{"__ignoreMap":399},[403,404,407,411,415],"span",{"class":405,"line":406},"line",1,[403,408,410],{"class":409},"sBMFI","pnpm",[403,412,414],{"class":413},"sfazB"," add",[403,416,417],{"class":413}," @nuxt\u002Fui@^4.12.2\n",[323,419,421],{"id":420},"bug-fixes","🐛 Bug Fixes",[328,423,424],{},[331,425,426,429,430,433,434,437],{},[334,427,428],{},"Full-text tooltip closed right away when moving focus between options:"," when Tab in ",[308,431,432],{},"ShuoCheckboxGroup"," or the arrow keys in ",[308,435,436],{},"ShuoRadioGroup"," moved to another truncated option, the tooltip closed and reopened, and the old tooltip, not yet unmounted, received Reka's open event and closed the new one with it. The tooltip now stays open while focus is inside the group and updates to the current option's text and position; it still closes when focus leaves the group.",[323,439,441],{"id":440},"installation","📦 Installation",[394,443,445],{"className":396,"code":444,"language":398,"meta":399,"style":399},"pnpm add github:k90325248\u002Fshuo-ui#v3.2.2\npnpm add @iconify-json\u002Flucide # recommended, icons are bundled\n",[308,446,447,456],{"__ignoreMap":399},[403,448,449,451,453],{"class":405,"line":406},[403,450,410],{"class":409},[403,452,414],{"class":413},[403,454,455],{"class":413}," github:k90325248\u002Fshuo-ui#v3.2.2\n",[403,457,459,461,463,466],{"class":405,"line":458},2,[403,460,410],{"class":409},[403,462,414],{"class":413},[403,464,465],{"class":413}," @iconify-json\u002Flucide",[403,467,469],{"class":468},"sHwdD"," # recommended, icons are bundled\n",[304,471,472,473,476,477,480,481,484],{},"Enable the module in ",[308,474,475],{},"nuxt.config.ts"," and add ",[308,478,479],{},"@import '@shuo\u002Fui\u002Fcss';"," to your CSS; see ",[345,482,22],{"href":483},"\u002Fgetting-started\u002Foverview\u002Finstallation"," on the docs site.",[323,486,488],{"id":487},"requirements","📋 Requirements",[490,491,492,505],"table",{},[493,494,495],"thead",{},[496,497,498,502],"tr",{},[499,500,501],"th",{},"Package",[499,503,504],{},"Version",[506,507,508,519],"tbody",{},[496,509,510,514],{},[511,512,513],"td",{},"Nuxt",[511,515,516],{},[308,517,518],{},"^4.6.2",[496,520,521,525],{},[511,522,523],{},[308,524,310],{},[511,526,527],{},[308,528,342],{},[530,531,532],"style",{},"html pre.shiki code .sBMFI, html code.shiki .sBMFI{--shiki-light:#E2931D;--shiki-default:#FFCB6B;--shiki-dark:#FFCB6B}html pre.shiki code .sfazB, html code.shiki .sfazB{--shiki-light:#91B859;--shiki-default:#C3E88D;--shiki-dark:#C3E88D}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(