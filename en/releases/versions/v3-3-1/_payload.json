e). If the last toast was closed while the pointer was over it (calling ",[332,333,334],"code",{},"toast.remove()",", clicking an action, swiping it away, or clicking X in browsers where buttons do not take focus on click), the toasts stayed paused and the next toast never started its timer. Shuo UI now has reka-ui resume the timer when a new toast appears and nothing should pause it (the window is focused and neither the pointer nor focus is on the toasts). Toasts still pause while hovered and while the window is unfocused.",[316,337,339],{"id":338},"new-option","✨ New option",[321,341,342],{},[324,343,344,354,355,358,359],{},[327,345,346,349,350,353],{},[332,347,348],{},"shuoUi.toastPauseFix"," (default ",[332,351,352],{},"true","):"," turns the fix above on or off; set it to ",[332,356,357],{},"false"," to disable it. The fix and this option will be removed once reka-ui fixes the bug: ",[360,361,52],"a",{"href":362},"\u002Fgetting-started\u002Ftheme\u002Fmodule-options",[316,364,366],{"id":365},"installation","📦 Installation",[368,369,374],"pre",{"className":370,"code":371,"language":372,"meta":373,"style":373},"language-bash shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","pnpm add github:k90325248\u002Fshuo-ui#v3.3.1\npnpm add @iconify-json\u002Flucide # recommended, icons are bundled\n","bash","",[332,375,376,392],{"__ignoreMap":373},[377,378,381,385,389],"span",{"class":379,"line":380},"line",1,[377,382,384],{"class":383},"sBMFI","pnpm",[377,386,388],{"class":387},"sfazB"," add",[377,390,391],{"class":387}," github:k90325248\u002Fshuo-ui#v3.3.1\n",[377,393,395,397,399,402],{"class":379,"line":394},2,[377,396,384],{"class":383},[377,398,388],{"class":387},[377,400,401],{"class":387}," @iconify-json\u002Flucide",[377,403,405],{"class":404},"sHwdD"," # recommended, icons are bundled\n",[312,407,408,409,412,413,416,417,420],{},"Enable the module in ",[332,410,411],{},"nuxt.config.ts"," and add ",[332,414,415],{},"@import '@shuo\