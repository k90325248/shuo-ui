":325},"from",[319,342,343],{"class":329}," '",[319,345,347],{"class":346},"sfazB","valibot",[319,349,350],{"class":329},"'",[319,352,353],{"class":329},";\n",[319,355,357],{"class":321,"line":356},2,[319,358,360],{"emptyLinePlaceholder":359},true,"\n",[319,362,364,368,371,374,377,380,384,387],{"class":321,"line":363},3,[319,365,367],{"class":366},"spNyl","const",[319,369,370],{"class":336}," schema ",[319,372,373],{"class":329},"=",[319,375,376],{"class":336}," v",[319,378,379],{"class":329},".",[319,381,383],{"class":382},"s2Zo4","object",[319,385,386],{"class":336},"(",[319,388,389],{"class":329},"{\n",[319,391,393,397,400,403,405,407,410,412,415],{"class":321,"line":392},4,[319,394,396],{"class":395},"swJcz","  name",[319,398,399],{"class":329},":",[319,401,402],{"class":382}," requiredText",[319,404,386],{"class":336},[319,406,350],{"class":329},[319,408,409],{"class":346},"Name",[319,411,350],{"class":329},[319,413,414],{"class":336},")",[319,416,417],{"class":329},",\n",[319,419,421,424,426,429,431,433,436,438,440],{"class":321,"line":420},5,[319,422,423],{"class":395},"  amount",[319,425,399],{"class":329},[319,427,428],{"class":382}," requiredNumber",[319,430,386],{"class":336},[319,432,350],{"class":329},[319,434,435],{"class":346},"Amount",[319,437,350],{"class":329},[319,439,414],{"class":336},[319,441,417],{"class":329},[319,443,445,448,450,453,455,457,460,462,465,467,469,472],{"class":321,"line":444},6,[319,446,447],{"class":395},"  types",[319,449,399],{"class":329},[319,451,452],{"class":382}," requiredArray",[319,454,386],{"class":336},[319,456,350],{"class":329},[319,458,459],{"class":346},"Types",[319,461,350],{"class":329},[319,463,464],{"class":329},",",[319,466,376],{"class":336},[319,468,379],{"class":329},[319,470,471],{"class":382},"string",[319,473,474],{"class":336},"())\n",[319,476,478,481,483],{"class":321,"line":477},7,[319,479,480],{"class":329},"}",[319,482,414],{"class":336},[319,484,353],{"class":329},[486,487,488,508,526],"ul",{},[489,490,491,492,495,496,499,500,503,504,379],"li",{},"The ",[305,493,494],{},"label"," parameter is the field name on screen; the default error message is \"field name + description\", for example \"Name is required\". Messages follow the Nuxt UI locale and are produced at validation time, so validating again after switching gives the new locale. Override them with the module option ",[305,497,498],{},"shuoUi.messages.validation"," or ",[305,501,502],{},"shuoUi.locales","; see ",[505,506,47],"a",{"href":507},"\u002Fgetting-started\u002Ftheme\u002Fmessages",[489,509,510,511,514,515,518,519,521,522,525],{},"The input types accept ",[305,512,513],{},"null"," and ",[305,516,517],{},"undefined"," while editing, and the output after validation narrows to ",[305,520,471],{},", ",[305,523,524],{},"number"," or an array, so you do not need to change the components' empty-value contract.",[489,527,528,529,532],{},"See ",[505,530,62],{"href":531},"\u002Fgetting-started\u002Fform\u002Fvalidation"," for forms, empty values and error display as a whole.",[534,535,536,537,540,541,543,544,547],"note",{},"If your project uses ",[305,538,539],{},"import * as v from 'valibot'",", install ",[305,542,347],{}," as well (",[305,545,546],{},"pnpm add valibot","); pnpm does not let a project import a package's dependencies directly.",[296,549,551],{"id":550},"api","API",[553,554,556],"h3",{"id":555},"requiredtext","requiredText",[310,558,560],{"className":312,"code":559,"language":314,"meta":315,"style":315},"requiredText(label: string)\n",[305,561,562],{"__ignoreMap":315},[319,563,564,566],{"class":321,"line":322},[319,565,556],{"class":382},[319,567,568],{"class":336},"(label: string)\n",[301,570,571,572,521,574,576],{},"Required text. Rejects ",[305,573,513],{},[305,575,517],{},", empty strings, whitespace only and non-string values, and keeps the original text (no trimming). For text inputs, multi-line text, string values of select menus and radio groups, and date strings.",[578,579,580],"field-group",{},[581,582,584],"field",{":required":583,"name":494,"type":471},"true","Field name, used in the error message.",[553,586,588],{"id":587},"requirednumber","requiredNumber",[310,590,592],{"className":312,"code":591,"language":314,"meta":315,"style":315},"requiredNumber(label: string)\n",[305,593,594],{"__ignoreMap":315},[319,595,596,598],{"class":321,"line":322},[319,597,588],{"class":382},[319,599,568],{"class":336},[301,601,602,603,606,607,610],{},"Required number. Accepts ",[305,604,605],{},"0",", negative numbers and decimals; empty values and strings show \"is required\", and ",[305,608,609],{},"NaN"," and infinity show \"must be a valid number\".",[578,612,613],{},[581,614,584],{":required":583,"name":494,"type":471},[553,616,618],{"id":617},"requiredarray","requiredArray",[310,620,622],{"className":312,"code":621,"language":314,"meta":315,"style":315},"requiredArray(label: string, itemSchema: GenericSchema)\n",[305,623,624],{"__ignoreMap":315},[319,625,626,628,631,633],{"class":321,"line":322},[319,627,618],{"class":382},[319,629,630],{"class":336},"(label: string",[319,632,464],{"class":329},[319,634,635],{"class":336}," itemSchema: GenericSchema)\n",[301,637,638,639,514,641,643],{},"Required array with at least one item. Empty arrays, ",[305,640,513],{},[305,642,517],{}," fail. For checkbox groups and multiple select menus.",[578,645,646,648],{},[581,647,584],{":required":583,"name":494,"type":471},[581,649,652,653,656],{":required":583,"name":650,"type":651},"itemSchema","GenericSchema","The schema of each item, such as ",[305,654,655],{},"v.string()","; the valid option values are composed by each page rather than fixed in the shared rule.",[553,658,660],{"id":659},"optionalemail","optionalEmail",[310,662,664],{"className":312,"code":663,"language":314,"meta":315,"style":315},"optionalEmail(label: string)\n",[305,665,666],{"__ignoreMap":315},[319,667,668,670],{"class":321,"line":322},[319,669,660],{"class":382},[319,671,568],{"class":336},[301,673,674,675,678,679,681],{},"Optional email. Empty strings pass; a value must be a valid email, otherwise \"has an invalid format\" is shown. For a required email, chain ",[305,676,677],{},"v.email"," after ",[305,680,556],{}," instead.",[578,683,684],{},[581,685,584],{":required":583,"name":494,"type":471},[553,687,689],{"id":688},"optionalnonnegativenumber","optionalNonNegativeNumber",[310,691,693],{"className":312,"code":692,"language":314,"meta":315,"style":315},"optionalNonNegativeNumber(label: string)\n",[305,694,695],{"__ignoreMap":315},[319,696,697,699],{"class":321,"line":322},[319,698,689],{"class":382},[319,700,568],{"class":336},[301,702,703,704,706,707,709,710,712],{},"Optional non-negative number. ",[305,705,513],{}," passes; ",[305,708,605],{}," and decimals are accepted; negative numbers show \"must be at least 0\", and ",[305,711,609],{},", infinity and non-numbers show \"must be a valid number\". For optional fields such as amounts, terms, scores and rates.",[578,714,715],{},[581,716,584],{":required":583,"name":494,"type":471},[296,718,720],{"id":719},"examples","Examples",[553,722,724],{"id":723},"combining-with-other-valibot-rules","Combining with other Valibot rules",[301,726,727,728,399],{},"The shared rules are ordinary Valibot schemas, so you can add conditions with ",[305,729,730],{},"v.pipe",[310,732,734],{"className":312,"code":733,"language":314,"meta":315,"style":315},"import * as v from 'valibot';\n\nconst schema = v.object({\n  \u002F\u002F Required email: the required rule followed by a format check\n  email: v.pipe(requiredText('Email'), v.email('Email is invalid')),\n\n  \u002F\u002F Optional whole number of terms\n  terms: v.pipe(\n    optionalNonNegativeNumber('Terms'),\n    v.check(\n      (value) => value === null || Number.isInteger(value),\n      'Terms must be a whole number'\n    )\n  ),\n\n  \u002F\u002F The backup email can be left empty\n  backupEmail: optionalEmail('Backup email')\n});\n",[305,735,736,756,760,778,78