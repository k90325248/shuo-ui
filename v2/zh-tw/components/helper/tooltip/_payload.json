,359],{},"kbds","、",[319,362,363],{},"content",[319,365,366],{},"arrow",[319,368,369],{},"delayDuration"," 等參數與 Nuxt UI 相同。",[372,373],"component-example",{"name":374},"tooltip-text",[348,376,377],{"id":377},"觸控長按",[315,379,380],{},"觸控裝置上按住觸發元素約 0.5 秒即顯示提示，放開後保持顯示，點擊其他位置或捲動頁面時關閉。",[382,383,384,388,391,394],"ul",{},[385,386,387],"li",{},"長按顯示提示時，放開手指不會觸發觸發元素原本的動作（點擊、勾選、開啟選單等）。",[385,389,390],{},"一般點擊照常觸發原本的動作，不顯示提示；點擊造成的聚焦也不顯示。",[385,392,393],{},"按住後移動手指視為捲動，不顯示提示。",[385,395,396],{},"長按期間不顯示瀏覽器的長按選單，觸發元素內的文字不會被選取（輸入框除外）。",[315,398,399,402,403,406],{},[319,400,401],{},"touch"," 設為 ",[319,404,405],{},"false"," 時與 Nuxt UI 原本的行為相同，觸控無法開啟提示。",[372,408],{"name":409},"tooltip-touch",[315,411,412,413,416,417,421],{},"要全站關閉時設定 ",[319,414,415],{},"components.tooltip.touch: false","，元件庫內的提示也會一起關閉，見",[418,419,42],"a",{"href":420},"\u002Fgetting-started\u002Ftheme\u002Fcomponent-defaults","。",[348,423,424],{"id":424},"開啟狀態",[315,426,427,428,431,432,435],{},"以 ",[319,429,430],{},"v-model:open"," 綁定開啟狀態，可由程式開啟或關閉；未綁定時可用 ",[319,433,434],{},"default-open"," 設定初始狀態。",[372,437],{"name":438},"tooltip-open",[344,440,442],{"id":441},"props","Props",[444,445],"component-props",{"name":325},[344,447,449],{"id":448},"slots","Slots",[451,452,453,466],"table",{},[454,455,456],"thead",{},[457,458,459,463],"tr",{},[460,461,462],"th",{},"Slot",[460,464,465],{},"說明",[467,468,469,480],"tbody",{},[457,470,471,477],{},[472,473,474],"td",{},[319,475,476],{},"default",[472,478,479],{},"觸發元素",[457,481,482,486],{},[472,483,484],{},[319,485,363],{},[472,487,488,489],{},"自訂提示內容，同 Nuxt UI 的 ",[319,490,363],{},[344,492,493],{"id":493},"更新紀錄",[495,496],"component-changelog",{"name":325},{"title":498,"searchDepth":499,"depth":499,"links":500},"",2,[501,507,508,509],{"id":346,"depth":499,"text":346,"children":502},[503,505,506],{"id":350,"depth":504,"text":350},3,{"id":377,"depth":504,"text":377},{"id":424,"depth":504,"text":424},{"id":441,"depth":499,"text":442},{"id":448,"depth":499,"text":449},{"id":493,"dep