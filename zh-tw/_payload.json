5,"page":12},"版本","\u002Fzh-tw\u002Freleases\u002Fversions","zh-tw\u002F5.releases\u002F1.versions",[286,290,294],{"title":287,"path":288,"stem":289},"v1.2.0","\u002Fzh-tw\u002Freleases\u002Fversions\u002Fv1-2-0","zh-tw\u002F5.releases\u002F1.versions\u002F1.v1-2-0",{"title":291,"path":292,"stem":293},"v1.1.0","\u002Fzh-tw\u002Freleases\u002Fversions\u002Fv1-1-0","zh-tw\u002F5.releases\u002F1.versions\u002F2.v1-1-0",{"title":295,"path":296,"stem":297},"v1.0.1","\u002Fzh-tw\u002Freleases\u002Fversions\u002Fv1-0-1","zh-tw\u002F5.releases\u002F1.versions\u002F3.v1-0-1",{"id":299,"title":300,"body":301,"description":300,"extension":510,"meta":511,"navigation":512,"path":513,"seo":514,"stem":517,"__hash__":518},"landing_zh_tw\u002Fzh-tw\u002Findex.md","",{"type":302,"value":303,"toc":507},"minimark",[304,336,368,385,455,493],[305,306,307,311,322],"u-page-hero",{},[308,309,310],"template",{"v-slot:title":300},"Shuo UI",[308,312,313,314,321],{"v-slot:description":300},"依照我們專案的表單寫法整理出來的 ",[315,316,320],"a",{"href":317,"rel":318},"https:\u002F\u002Fui.nuxt.com",[319],"nofollow","Nuxt UI"," 元件。把各專案重複實作的遮罩、千分位、民國年、查詢卡片等功能集中到一個模組，大家用同一套，維護也只需要改一個地方。",[308,323,324,330],{"v-slot:links":300},[325,326,5],"u-button",{"to":327,"size":328,"trailing-icon":329},"\u002Fgetting-started\u002Foverview\u002Finstallation","xl","i-lucide-arrow-right",[325,331,335],{"to":332,"color":333,"size":328,"variant":334},"\u002Fgetting-started\u002Foverview\u002Fintroduction","neutral","subtle","了解更多",[337,338,339,342,345],"u-page-section",{},[308,340,341],{"v-slot:title":300},"為什麼要做這個模組",[308,343,344],{"v-slot:description":300},"過去每個專案都會各自寫一套表單元件：身分證要遮蔽、金額要千分位、日期要顯示民國年、查詢頁要有可收合的條件區塊。功能大同小異，但寫法、參數名稱和細節各不相同，修一個問題要到每個專案各改一次。",[346,347,352,358,363],"div",{"className":348},[349,350,351],"grid","gap-6","md:grid-cols-3",[353,354,357],"u-page-card",{"icon":355,"title":356},"i-lucide-copy-check","寫法一致","同樣的需求用同樣的元件和參數，換專案、接手別人的程式碼時不用重新熟悉。",[353,359,362],{"icon":360,"title":361},"i-lucide-wrench","集中維護","問題修一次，各專案更新版本就能拿到，不用再到處複製貼上。",[353,364,367],{"icon":365,"title":366},"i-lucide-feather","不另起爐灶","元件都建立在 Nuxt UI 之上，只補上我們常用的部分，其餘照 Nuxt UI 文件使用即可。",[337,369,370,373,376],{},[308,371,372],{"v-slot:title":300},"實際用起來的樣子",[308,374,375],{"v-slot:description":300},"下面是一組真的可以操作的欄位。打開開關，可以看到每個元件在資料載入中時的骨架效果；關掉後，原本填的內容都還在。",[346,377,381],{"className":378},[379,380],"mx-auto","max-w-3xl",[382,383],"component-example",{"name":384},"home-form",[337,386,387,390],{},[308,388,389],{"v-slot:title":300},"它幫你處理了哪些事",[308,391,392,402,420,428,436,447],{"v-slot:features":300},[393,394,396,399],"u-page-feature",{"icon":395},"i-lucide-layers",[308,397,398],{"v-slot:title":300},"沿用 Nuxt UI",[308,400,401],{"v-slot:description":300},"沒有另外宣告的 Nuxt UI 參數、插槽與 ref 都能直接使用，型別也會一併推導。",[393,403,405,408],{"icon":404},"i-lucide-scan-line",[308,406,407],{"v-slot:title":300},"一致的狀態",[308,409,410,411,415,416,419],{"v-slot:description":300},"尺寸、停用、載入中與骨架在每個表單元件上的行為都相同，並會跟著 ",[412,413,414],"code",{},"UFormField","、",[412,417,418],{},"UForm"," 走。",[393,421,422,425],{"icon":50},[308,423,424],{"v-slot:title":300},"繁體中文預設",[308,426,427],{"v-slot:description":300},"驗證訊息、提示文字與無障礙標籤預設為繁體中文，需要時可在模組設定覆寫。",[393,429,430,433],{"icon":65},[308,431,432],{"v-slot:title":300},"共用驗證規則",[308,434,435],{"v-slot:description":300},"常用的必填、數字等 Valibot 規則已經寫好並自動匯入，錯誤訊息格式全站一致。",[393,437,438,440],{"icon":45},[308,439,275],{"v-slot:title":300},[308,441,442,443,446],{"v-slot:description":300},"尺寸、顯示格式、圖示等可在 ",[412,444,445],{},"nuxt.config.ts"," 統一設定，元件上明確傳入的值仍然優先。",[393,448,449,452],{"icon":40},[308,450,451],{"v-slot:title":300},"樣式交給專案",[308,453,454],{"v-slot:description":300},"使用 Nuxt UI 的語意色與 CSS 變數，顏色和主題由使用的專案決定，不會被元件庫綁死。",[337,456,457,460,463],{},[308,458,459],{"v-slot:title":300},"有哪些元件",[308,461,462],{"v-slot:description":300},"目前共 16 個元件，大致分成下面幾類。每個元件頁都有可操作的範例和完整參數表。",[346,464,468,472,476,480,484,489],{"className":465},[349,350,466,467],"sm:grid-cols-2","lg:grid-cols-3",[353,469,471],{"icon":101,"title":92,"to":470},"\u002Fcomponents\u002Ftext\u002Finput-text","ShuoInputText、ShuoInputNumber、ShuoTextarea",[353,473,475],{"icon":142,"title":115,"to":474},"\u002Fcomponents\u002Fchoice\u002Fselect-menu","ShuoSelectMenu、ShuoCheckbox、ShuoRadioGroup、ShuoCheckboxGroup、ShuoSwitch",[353,477,479],{"icon":159,"title":150,"to":478},"\u002Fcomponents\u002Fdate\u002Fdatepicker","ShuoDatepicker、ShuoMonths",[353,481,483],{"icon":176,"title":167,"to":482},"\u002Fcomponents\u002Fphone-file\u002Fphone","ShuoPhone、ShuoFile",[353,485,488],{"icon":486,"title":184,"to":487},"i-lucide-layout-list","\u002Fcomponents\u002Flayout\u002Fquery-card","ShuoQueryCard、ShuoListCard、ShuoTable",[353,490,492],{"icon":216,"title":207,"to":491},"\u002Fcomponents\u002Fhelper\u002Finfo-tooltip","ShuoInfoTooltip、ShuoTooltip",[337,494,495,498,501],{},[308,496,497],{"v-slot:title":300},"一起維護",[308,499,500],{"v-slot:description":300},"這個模組是為了多個專案共用而做的，所以新增功能時會先想：這是不是大部分專案都會遇到的需求？只有單一專案用得到的特殊行為，建議留在該專案內，透過 Nuxt UI 原本的參數或插槽處理，讓元件庫保持簡單、好維護。",[308,502,503],{"v-slot:links":300},[325,504,506],{"to":505,"color":333,"trailing-icon":329,"variant":334},"\u002Fgetting-started\u002Foverview\u002Fquick-start","從第一個表單開始",{"title":300,"searchDepth":508,"depth":508,"links":509},2,[],"md",{},true,"\u002Fzh-tw",{"title":515,"description":516},"基於 Nuxt UI 的表單元件庫","基於 Nuxt UI 的表單元件庫，以 Nuxt Module 提供。","zh-tw\u002Findex","9I_zbmH70VNkQo_Zj3k7JQIoO7a-hiAysprJxFRKR5g",1793083682275]