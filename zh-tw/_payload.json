utils\u002Fform","zh-tw\u002F4.utils\u002F1.form",[227],{"title":228,"path":229,"stem":230,"badge":231,"icon":65},"Validation","\u002Fzh-tw\u002Futils\u002Fform\u002Fvalidation","zh-tw\u002F4.utils\u002F1.form\u002F1.validation","驗證規則",{"title":233,"icon":12,"path":234,"stem":235,"children":236,"page":12},"顯示格式","\u002Fzh-tw\u002Futils\u002Fformat","zh-tw\u002F4.utils\u002F2.format",[237,243],{"title":238,"path":239,"stem":240,"badge":241,"icon":242},"Date","\u002Fzh-tw\u002Futils\u002Fformat\u002Fdate","zh-tw\u002F4.utils\u002F2.format\u002F1.date","日期","i-lucide-calendar",{"title":244,"path":245,"stem":246,"badge":247,"icon":107},"Number","\u002Fzh-tw\u002Futils\u002Fformat\u002Fnumber","zh-tw\u002F4.utils\u002F2.format\u002F2.number","數字",{"title":249,"icon":12,"path":250,"stem":251,"children":252,"page":12},"欄位拆合","\u002Fzh-tw\u002Futils\u002Ffield","zh-tw\u002F4.utils\u002F3.field",[253,256],{"title":166,"path":254,"stem":255,"badge":169,"icon":170},"\u002Fzh-tw\u002Futils\u002Ffield\u002Fphone","zh-tw\u002F4.utils\u002F3.field\u002F1.phone",{"title":155,"path":257,"stem":258,"badge":259,"icon":159},"\u002Fzh-tw\u002Futils\u002Ffield\u002Fmonths","zh-tw\u002F4.utils\u002F3.field\u002F2.months","月數",{"title":261,"icon":12,"path":262,"stem":263,"children":264,"page":12},"設定","\u002Fzh-tw\u002Futils\u002Fsettings","zh-tw\u002F4.utils\u002F4.settings",[265],{"title":266,"path":267,"stem":268,"badge":269,"icon":45},"ComponentDefaults","\u002Fzh-tw\u002Futils\u002Fsettings\u002Fcomponent-defaults","zh-tw\u002F4.utils\u002F4.settings\u002F1.component-defaults","全站預設值",{"id":271,"title":272,"body":273,"description":272,"extension":482,"meta":483,"navigation":484,"path":485,"seo":486,"stem":489,"__hash__":490},"landing_zh_tw\u002Fzh-tw\u002Findex.md","",{"type":274,"value":275,"toc":479},"minimark",[276,308,340,357,427,465],[277,278,279,283,294],"u-page-hero",{},[280,281,282],"template",{"v-slot:title":272},"Shuo UI",[280,284,285,286,293],{"v-slot:description":272},"依照我們專案的表單寫法整理出來的 ",[287,288,292],"a",{"href":289,"rel":290},"https:\u002F\u002Fui.nuxt.com",[291],"nofollow","Nuxt UI"," 元件。把各專案重複實作的遮罩、千分位、民國年、查詢卡片等功能集中到一個模組，大家用同一套，維護也只需要改一個地方。",[280,295,296,302],{"v-slot:links":272},[297,298,5],"u-button",{"to":299,"size":300,"trailing-icon":301},"\u002Fgetting-started\u002Foverview\u002Finstallation","xl","i-lucide-arrow-right",[297,303,307],{"to":304,"color":305,"size":300,"variant":306},"\u002Fgetting-started\u002Foverview\u002Fintroduction","neutral","subtle","了解更多",[309,310,311,314,317],"u-page-section",{},[280,312,313],{"v-slot:title":272},"為什麼要做這個模組",[280,315,316],{"v-slot:description":272},"過去每個專案都會各自寫一套表單元件：身分證要遮蔽、金額要千分位、日期要顯示民國年、查詢頁要有可收合的條件區塊。功能大同小異，但寫法、參數名稱和細節各不相同，修一個問題要到每個專案各改一次。",[318,319,324,330,335],"div",{"className":320},[321,322,323],"grid","gap-6","md:grid-cols-3",[325,326,329],"u-page-card",{"icon":327,"title":328},"i-lucide-copy-check","寫法一致","同樣的需求用同樣的元件和參數，換專案、接手別人的程式碼時不用重新熟悉。",[325,331,334],{"icon":332,"title":333},"i-lucide-wrench","集中維護","問題修一次，各專案更新版本就能拿到，不用再到處複製貼上。",[325,336,339],{"icon":337,"title":338},"i-lucide-feather","不另起爐灶","元件都建立在 Nuxt UI 之上，只補上我們常用的部分，其餘照 Nuxt UI 文件使用即可。",[309,341,342,345,348],{},[280,343,344],{"v-slot:title":272},"實際用起來的樣子",[280,346,347],{"v-slot:description":272},"下面是一組真的可以操作的欄位。打開開關，可以看到每個元件在資料載入中時的骨架效果；關掉後，原本填的內容都還在。",[318,349,353],{"className":350},[351,352],"mx-auto","max-w-3xl",[354,355],"component-example",{"name":356},"home-form",[309,358,359,362],{},[280,360,361],{"v-slot:title":272},"它幫你處理了哪些事",[280,363,364,374,392,400,408,419],{"v-slot:features":272},[365,366,368,371],"u-page-feature",{"icon":367},"i-lucide-layers",[280,369,370],{"v-slot:title":272},"沿用 Nuxt UI",[280,372,373],{"v-slot:description":272},"沒有另外宣告的 Nuxt UI 參數、插槽與 ref 都能直接使用，型別也會一併推導。",[365,375,377,380],{"icon":376},"i-lucide-scan-line",[280,378,379],{"v-slot:title":272},"一致的狀態",[280,381,382,383,387,388,391],{"v-slot:description":272},"尺寸、停用、載入中與骨架在每個表單元件上的行為都相同，並會跟著 ",[384,385,386],"code",{},"UFormField","、",[384,389,390],{},"UForm"," 走。",[365,393,394,397],{"icon":50},[280,395,396],{"v-slot:title":272},"繁體中文預設",[280,398,399],{"v-slot:description":272},"驗證訊息、提示文字與無障礙標籤預設為繁體中文，需要時可在模組設定覆寫。",[365,401,402,405],{"icon":65},[280,403,404],{"v-slot:title":272},"共用驗證規則",[280,406,407],{"v-slot:description":272},"常用的必填、數字等 Valibot 規則已經寫好並自動匯入，錯誤訊息格式全站一致。",[365,409,410,412],{"icon":45},[280,411,269],{"v-slot:title":272},[280,413,414,415,418],{"v-slot:description":272},"尺寸、顯示格式、圖示等可在 ",[384,416,417],{},"nuxt.config.ts"," 統一設定，元件上明確傳入的值仍然優先。",[365,420,421,424],{"icon":40},[280,422,423],{"v-slot:title":272},"樣式交給專案",[280,425,426],{"v-slot:description":272},"使用 Nuxt UI 的語意色與 CSS 變數，顏色和主題由使用的專案決定，不會被元件庫綁死。",[309,428,429,432,435],{},[280,430,431],{"v-slot:title":272},"有哪些元件",[280,433,434],{"v-slot:description":272},"目前共 16 個元件，大致分成下面幾類。每個元件頁都有可操作的範例和完整參數表。",[318,436,440,444,448,452,456,461],{"className":437},[321,322,438,439],"sm:grid-cols-2","lg:grid-cols-3",[325,441,443],{"icon":101,"title":92,"to":442},"\u002Fcomponents\u002Ftext\u002Finput-text","ShuoInputText、ShuoInputNumber、ShuoTextarea",[325,445,447],{"icon":142,"title":115,"to":446},"\u002Fcomponents\u002Fchoice\u002Fselect-menu","ShuoSelectMenu、ShuoCheckbox、ShuoRadioGroup、ShuoCheckboxGroup",[325,449,451],{"icon":153,"title":144,"to":450},"\u002Fcomponents\u002Fdate\u002Fdatepicker","ShuoDatepicker、ShuoMonths",[325,453,455],{"icon":170,"title":161,"to":454},"\u002Fcomponents\u002Fphone-file\u002Fphone","ShuoPhone、ShuoFile",[325,457,460],{"icon":458,"title":178,"to":459},"i-lucide-layout-list","\u002Fcomponents\u002Flayout\u002Fquery-card","ShuoQueryCard、ShuoListCard、ShuoTable",[325,462,464],{"icon":210,"title":201,"to":463},"\u002Fcomponents\u002Fhelper\u002Finfo-tooltip","ShuoInfoTooltip、ShuoTooltip",[309,466,467,470,473],{},[280,468,469],{"v-slot:title":272},"一起維護",[280,471,472],{"v-slot:description":272},"這個模組是為了多個專案共用而做的，所以新增功能時會先想：這是不是大部分專案都會遇到的需求？只有單一專案用得到的特殊行為，建議留在該專案內，透過 Nuxt UI 原本的參數或插槽處理，讓元件庫保持簡單、好維護。",[280,474,475],{"v-slot:links":272},[297,476,478],{"to":477,"color":305,"trailing-icon":301,"variant":306},"\u002Fgetting-started\u002Foverview\u002Fquick-start","從第一個表單開始",{"title":272,"searchDepth":480,"depth":480,"links":481},2,[],"md",{},true,"\u002Fzh-tw",{"title":487,"description":488},"基於 Nuxt UI 的表單元件庫","基於 Nuxt UI 的表單元件庫，以 Nuxt Module 提供。","zh-tw\u002Findex","TpfYpyJwyl6CUllWqp2ExZiJhQFLWrpayFBqIknOSkc",1792954449613]