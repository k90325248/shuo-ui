getting-started\u002Foverview\u002Finstallation","xl","i-lucide-arrow-right",[344,350,354],{"to":351,"color":352,"size":347,"variant":353},"\u002Fgetting-started\u002Foverview\u002Fintroduction","neutral","subtle","了解更多",[356,357,358,361,364],"u-page-section",{},[327,359,360],{"v-slot:title":319},"為什麼要做這個模組",[327,362,363],{"v-slot:description":319},"過去每個專案都會各自寫一套表單元件：身分證要遮蔽、金額要千分位、日期要顯示民國年、查詢頁要有可收合的條件區塊。功能大同小異，但寫法、參數名稱和細節各不相同，修一個問題要到每個專案各改一次。",[365,366,371,377,382],"div",{"className":367},[368,369,370],"grid","gap-6","md:grid-cols-3",[372,373,376],"u-page-card",{"icon":374,"title":375},"i-lucide-copy-check","寫法一致","同樣的需求用同樣的元件和參數，換專案、接手別人的程式碼時不用重新熟悉。",[372,378,381],{"icon":379,"title":380},"i-lucide-wrench","集中維護","問題修一次，各專案更新版本就能拿到，不用再到處複製貼上。",[372,383,386],{"icon":384,"title":385},"i-lucide-feather","不另起爐灶","元件都建立在 Nuxt UI 之上，只補上我們常用的部分，其餘照 Nuxt UI 文件使用即可。",[356,388,389,392,395],{},[327,390,391],{"v-slot:title":319},"實際用起來的樣子",[327,393,394],{"v-slot:description":319},"下面是一組真的可以操作的欄位。打開開關，可以看到每個元件在資料載入中時的骨架效果；關掉後，原本填的內容都還在。",[365,396,400],{"className":397},[398,399],"mx-auto","max-w-3xl",[401,402],"component-example",{"name":403},"home-form",[356,405,406,409],{},[327,407,408],{"v-slot:title":319},"它幫你處理了哪些事",[327,410,411,421,439,447,455,466],{"v-slot:features":319},[412,413,415,418],"u-page-feature",{"icon":414},"i-lucide-layers",[327,416,417],{"v-slot:title":319},"沿用 Nuxt UI",[327,419,420],{"v-slot:description":319},"沒有另外宣告的 Nuxt UI 參數、插槽與 ref 都能直接使用，型別也會一併推導。",[412,422,424,427],{"icon":423},"i-lucide-scan-line",[327,425,426],{"v-slot:title":319},"一致的狀態",[327,428,429,430,434,435,438],{"v-slot:description":319},"尺寸、停用、載入中與骨架在每個表單元件上的行為都相同，並會跟著 ",[431,432,433],"code",{},"UFormField","、",[431,436,437],{},"UForm"," 走。",[412,440,441,444],{"icon":50},[327,442,443],{"v-slot:title":319},"繁體中文預設",[327,445,446],{"v-slot:description":319},"驗證訊息、提示文字與無障礙標籤預設為繁體中文，需要時可在模組設定覆寫。",[412,448,449,452],{"icon":65},[327,450,451],{"v-slot:title":319},"共用驗證規則",[327,453,454],{"v-slot:description":319},"常用的必填、數字等 Valibot 規則已經寫好並自動匯入，錯誤訊息格式全站一致。",[412,456,457,459],{"icon":45},[327,458,290],{"v-slot:title":319},[327,460,461,462,465],{"v-slot:description":319},"尺寸、顯示格式、圖示等可在 ",[431,463,464],{},"nuxt.config.ts"," 統一設定，元件上明確傳入的值仍然優先。",[412,467,468,471],{"icon":40},[327,469,470],{"v-slot:title":319},"樣式交給專案",[327,472,473],{"v-slot:description":319},"使用 Nuxt UI 的語意色與 CSS 變數，顏色和主題由使用的專案決定，不會被元件庫綁死。",[356,475,476,479,482],{},[327,477,478],{"v-slot:title":319},"有哪些元件",[327,480,481],{"v-slot:description":319},"目前共 16 個元件，大致分成下面幾類。每個元件頁都有可操作的範例和完整參數表。",[365,483,487,491,495,499,503,508],{"className":484},[368,369,485,486],"sm:grid-cols-2","lg:grid-cols-3",[372,488,490],{"icon":116,"title":107,"to":489},"\u002Fcomponents\u002Ftext\u002Finput-text","ShuoInputText、ShuoInputNumber、ShuoTextarea",[372,492,494],{"icon":157,"title":130,"to":493},"\u002Fcomponents\u002Fchoice\u002Fselect-menu","ShuoSelectMenu、ShuoCheckbox、ShuoRadioGroup、ShuoCheckboxGroup、ShuoSwitch",[372,496,498],{"icon":174,"title":165,"to":497},"\u002Fcomponents\u002Fdate\u002Fdatepicker","ShuoDatepicker、ShuoMonths",[372,500,502],{"icon":191,"title":182,"to":501},"\u002Fcomponents\u002Fphone-file\u002Fphone","ShuoPhone、ShuoFile",[372,504,507],{"icon":505,"title":199,"to":506},"i-lucide-layout-list","\u002Fcomponents\u002Flayout\u002Fquery-card","ShuoQueryCard、ShuoListCard、ShuoTable",[372,509,511],{"icon":231,"title":222,"to":510},"\u002Fcomponents\u002Fhelper\u002Finfo-tooltip","ShuoInfoTooltip、ShuoTooltip",[356,513,514,517,520],{},[327,515,516],{"v-slot:title":319},"一起維護",[327,518,519],{"v-slot:description":319},"這個模組是為了多個專案共用而做的，所以新增功能時會先想：這是不是大部分專案都會遇到的需求？只有單一專案用得到的特殊行為，建議留在該專案內，透過 Nuxt UI 原本的參數或插槽處理，讓元件庫保持簡單、好維護。",[327,521,522],{"v-slot:links":319},[344,523,525],{"to":524,"color":352,"trailing-icon":348,"variant":353},"\u002Fgetting-started\u002Foverview\u002Fquick-start","從第一個表單開始",{"title":319,"searchDepth":527,"depth":527,"links":528},2,[],"md",{},true,"\u002Fzh-tw",{"title":534,"description":535},"基於 Nuxt UI 的表單元件庫","基於 Nuxt UI 的表單元件庫，以 Nuxt Module 提供。","zh-tw\u002Findex","9I_zbmH70VNkQo_Zj3k7JQIoO7a-hiAysprJxFRKR5g",1793087848535]