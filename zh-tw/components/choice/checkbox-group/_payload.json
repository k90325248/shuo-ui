342],"h3",{"id":342},"選項",[319,344,345,348,349,352,353,355,356,359,360,362,363,365,366,334],{},[322,346,347],{},"items"," 可傳物件或字串：物件選項以 ",[322,350,351],{},"label"," 顯示、",[322,354,328],{}," 為綁定值，",[322,357,358],{},"disabled"," 停用單一選項（已勾選的停用選項維持勾選）；字串選項的 ",[322,361,351],{}," 與 ",[322,364,328],{}," 皆為該字串。全部未勾選時綁定值為 ",[322,367,368],{},"[]",[370,371],"component-example",{"name":372},"checkbox-group-items",[340,374,375],{"id":375},"排列方向",[319,377,378,381,382,385,386,389,390,393,394,397,398,401,402,405,406,397,408,410,411,397,414,397,417,420,421,334],{},[322,379,380],{},"orientation"," 預設 ",[322,383,384],{},"auto","，依視窗寬度在 ",[322,387,388],{},"breakpoint","（預設 ",[322,391,392],{},"md","）前後切換垂直與水平排列；",[322,395,396],{},"horizontal","、",[322,399,400],{},"vertical"," 固定方向，不受視窗寬度影響。選項文字被省略時，滑鼠移入或鍵盤聚焦會顯示完整文字提示，觸控裝置長按選項顯示（見 ",[331,403,233],{"href":404},"\u002Fcomponents\u002Fhelper\u002Ftooltip#%E8%A7%B8%E6%8E%A7%E9%95%B7%E6%8C%89","）；長按顯示提示時不會勾選選項。",[322,407,380],{},[322,409,388],{}," 以及 ",[322,412,413],{},"label-key",[322,415,416],{},"value-key",[322,418,419],{},"ui"," 可在全站設定預設值，見",[331,422,424],{"href":423},"\u002Fgetting-started\u002Ftheme\u002Fcomponent-defaults#%E5%8F%AF%E8%A8%AD%E5%AE%9A%E7%9A%84%E9%A0%85%E7%9B%AE","可設定的項目",[370,426],{"name":427},"checkbox-group-orientation",[340,429,430],{"id":430},"響應式分欄",[319,432,433,434,437,438,441],{},"使用 ",[322,435,436],{},"orientation=\"grid\"","，透過 ",[322,439,440],{},"ui.fieldset"," 覆寫 Tailwind 分欄與斷點 class。預設一欄，每列至少維持同尺寸輸入框高度；保留省略提示與骨架行為。",[370,443],{"name":444},"checkbox-group-grid",[319,446,447,448,450,451,454,455,458,459,461],{},"第一組設定為預設一欄、md 起兩欄、xl 起四欄。",[322,449,388],{}," 只用於 ",[322,452,453],{},"orientation=\"auto\""," 的水平／垂直切換；grid 的斷點由 class 控制。",[322,456,457],{},"class"," 設定外框，",[322,460,440],{}," 設定選項容器。請使用完整靜態 class，讓 Tailwind 能掃描產生樣式。",[340,463,464],{"id":464},"自訂選項欄位",[319,466,467,468,397,470,472,473,476,477,397,479,481],{},"後端選項欄位不是 ",[322,469,351],{},[322,471,328],{}," 時（例如 ",[322,474,475],{},"{ Code, Name }","），以 ",[322,478,413],{},[322,480,416],{}," 指定，不必先轉換資料：",[370,483],{"name":484},"checkbox-group-keys",[486,487,488,507,535,558],"ul",{},[489,490,491,495,496,499,500,503,504,334],"li",{},[492,493,494],"strong",{},"綁定值須為字串","：",[322,497,498],{},"v-model"," 型別維持 ",[322,501,502],{},"string[]","。後端代碼若是數字，請先轉成字串，例如 ",[322,505,506],{},"items.map((item) => ({ ...item, Code: String(item.Code) }))",[489,508,509,517,518,397,521,524,525,397,527,529,530,397,532,534],{},[492,510,511,512,397,514,516],{},"原始的 ",[322,513,351],{},[322,515,328],{}," 欄位會被取代","：元件把每個物件選項轉成「原始欄位 + 依 ",[322,519,520],{},"labelKey",[322,522,523],{},"valueKey"," 解析的 ",[322,526,351],{},[322,528,328],{},"」。原始資料本身就有 ",[322,531,351],{},[322,533,328],{}," 欄位時，會被解析出的值取代。",[489,536,537,540,541,544,545,397,548,551,552,397,555,334],{},[322,538,539],{},"#item-append"," 的 ",[322,542,543],{},"item"," 是轉換後的物件，同時取得原始欄位（",[322,546,547],{},"item.Code",[322,549,550],{},"item.Name","）與 ",[322,553,554],{},"item.label",[322,556,557],{},"item.value",[489,559,560,561,563,564,566,567,570],{},"開發模式下，第一個物件選項缺少 ",[322,562,520],{}," 或 ",[322,565,523],{}," 指定的欄位時，主控台會警告一次（含元件與欄位名稱）；正式環境不檢查。",[322,568,569],{},"ShuoSelectMenu"," 也有相同檢查。",[340,572,573],{"id":573},"選項說明",[319,575,576,577,580,581,584],{},"選項的 ",[322,578,579],{},"description"," 欄位（或以 ",[322,582,583],{},"description-key"," 指定的欄位）顯示在選項文字下方。沒有說明的選項高度對齊同尺寸的輸入框；有說明的選項往下撐高，說明文字換行。水平排列時整列一起撐高，所有選項的第一行文字互相對齊，說明不會擠壓其他選項的文字。",[370,586],{"name":587},"checkbox-group-description",[340,589,590],{"id":590},"顏色與圖示",[319,592,593,594,540,597,362,600,495,603,605,606,608,609,611],{},"沿用 ",[322,595,596],{},"UCheckboxGroup",[322,598,599],{},"color",[322,601,602],{},"icon",[322,604,599],{}," 改變勾選時的顏色，",[322,607,602],{}," 是勾選時顯示的圖示；單一選項也可用選項的 ",[322,610,602],{}," 欄位指定。",[370,613],{"name":614},"checkbox-group-color",[340,616,617],{"id":617},"尺寸與狀態",[319,619,620,621,624,625,334],{},"水平排列時高度對齊同尺寸輸入框，範例右側放了同尺寸的 ",[322,622,623],{},"ShuoInputText"," 方便比對。載入中以轉圈圖示取代各選項按鈕並停用；各狀態的共通行為見",[331,626,102],{"href":627},"\u