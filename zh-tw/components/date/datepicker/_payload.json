,674],{},"民國模式下，",[314,670,649],{}," 至少為 1911\u002F01\u002F01，",[314,673,656],{}," 的下限至少為 1911。",[475,676,677,679],{},[314,678,649],{}," 傳字串時可用斜線或連字號分隔，可含時分（秒）。",[475,681,682,683,626],{},"年與年月模式以整年、整月比較 ",[314,684,649],{},[341,686,687],{"id":687},"圖示與清除按鈕",[311,689,690,693,694,697,698,701,702,705,706,710,711,317,713,715,716,719,720,722,723,726,727,626],{},[314,691,692],{},"clear"," 顯示清除按鈕，預設開啟（傳 ",[314,695,696],{},":clear=\"false\""," 關閉；包在 ",[314,699,700],{},"required"," 的 ",[314,703,704],{},"UFormField"," 內時預設關閉，規則同 ",[331,707,709],{"href":708},"\u002Fcomponents\u002Fchoice\u002Fselect-menu#%E6%B8%85%E9%99%A4%E6%8C%89%E9%88%95","SelectMenu 的清除按鈕","），清除後綁定值為 ",[314,712,480],{},[314,714,589],{},"）。",[314,717,718],{},"calendar-icon"," 是尾端的日曆圖示，預設 ",[314,721,263],{},"；",[314,724,725],{},"clear-icon"," 是清除按鈕的圖示，預設 ",[314,728,729],{},"i-lucide-x",[468,731],{"name":732},"datepicker-icons",[341,734,735],{"id":735},"驗證狀態",[311,737,738,741,742,745,746,749,750,753,754,757,758,760],{},[314,739,740],{},"ShuoDatepicker"," 沒有 ",[314,743,744],{},"color","，改以 ",[314,747,748],{},"state"," 表示驗證結果：",[314,751,752],{},"false"," 顯示錯誤、",[314,755,756],{},"true"," 顯示成功，未指定時為一般樣式。放在 ",[314,759,704],{}," 內且欄位有錯誤時，一律顯示錯誤。",[468,762],{"name":763},"datepicker-feedback",[341,765,766],{"id":766},"尺寸與狀態",[311,768,769,770,626],{},"載入中以轉圈圖示取代尾端日曆圖示並停用輸入。各狀態的共通行為見",[331,771,102],{"href":772},"\u002Fcomponents\u002Foverview\u002Fcommon",[468,774],{"name":775},"datepicker-states",[337,777,778],{"id":778},"範例",[341,780,781],{"id":781},"搭配表單驗證",[311,783,784,785,788,789,792,793,795,796,626],{},"單選用 ",[314,786,787],{},"requiredText","，範圍用 ",[314,790,791],{},"requiredArray","。只選了起日的範圍不會提交、不觸發 change，因此仍會顯示必填錯誤。放在 ",[314,794,704],{}," 內時接入欄位的 id、name、尺寸、停用與錯誤狀態，見",[331,797,799],{"href":798},"\u002Fcomponents\u002Foverview\u002Fcommon#%E6%90%AD%E9%85%8D-uform-%E8%88%87-uformfield","搭配 UForm 與 UFormField",[468,801],{"name":802},"datepicker-validation",[341,804,640],{"id":640},[311,806,807,808,325,810,812,813,815,816,818],{},"查詢 API 的起迄是兩個欄位時，只綁 ",[314,809,324],{},[314,811,328],{},"；搭配 ",[314,814,531],{}," 直接使用 ",[314,817,527],{}," 格式。",[468,820],{"name":821},"datepicker-start-end",[341,823,824],{"id":824},"起迄互相限制",[311,826,827,828,325,830,832],{},"用兩個單選日期分別輸入起日與迄日時，以對方的值作為 ",[314,829,652],{},[314,831,649],{},"，避免起日晚於迄日。",[468,834],{"name":835},"datepicker-linked-range",[337,837,838],{"id":838},"互動說明",[341,840,841],{"id":841},"選取流程",[472,843,844,851,859,865,871],{},[475,845,846,850],{},[847,848,849],"strong",{},"年、年月、日期","：選取即套用並關閉選單，不再顯示確認／取消按鈕。",[475,852,853,856,857,626],{},[847,854,855],{},"範圍","：僅選起日時保留草稿，父層三個綁定值維持原值；起迄皆選完才一次提交並關閉。中途點外面、按 Esc 或關閉選單，捨棄草稿並恢復上次完整範圍；原本為空值則保持 ",[314,858,589],{},[475,860,861,864],{},[847,862,863],{},"日期時分／秒","：選取日期後，立即帶入完整日期時間並切到時間面板；時間沿用既有值，空值以套件初始化的本地目前時間為準。調整時間即更新，點外面關閉即可保留。",[475,866,867,870],{},[847,868,869],{},"日期時間範圍","：先選完兩個日期，再切換到起迄時間面板，兩端的時間都可即時修改。",[475,872,873,874,325,877,626],{},"單選切換為範圍時清空並等待完整選擇；關閉範圍時保留起日作為單選值，並清空 ",[314,875,876],{},"start",[314,878,879],{},"end",[341,881,882],{"id":882},"鍵盤操作",[311,884,885],{},"開啟選單時焦點移到已選日期（或年份、月份），未選取時移到第一個可選項目。方向鍵移動焦點，Enter 選取，Esc 關閉；選單關閉時若焦點仍在選單內，回到輸入框。選單 teleport 至 body，無法以 Tab 進入。",[341,887,888],{"id":888},"日曆顯示",[311,890,891],{},"日曆以週日為每週第一天，固定顯示六週；前後月份的日期以較淡文字呈現。換月使用透明度過場，避免水平位移產生捲軸。",[311,893,894,895,897,898,626],{},"月份與星期名稱、年份清單的「年」字、年與年月模式的「115 年 10 月」格式，以及範圍的分隔符號「～」都依語系切換（英文為「10\u002F115」與「–」）；民國年或西元年仍由 ",[314,896,501],{}," 決定。見",[331,899,47],{"href":900},"\u002Fgetting-started\u002Ftheme\u002Fmessages",[337,902,334],{"id":334},[355,904,905,917],{},[358,906,907],{},[361,908,909,911,914],{},[364,910,334],{},[364,912,913],{},"型別",[364,915,916],{},"說明",[375,918,919,942,957],{},[361,920,921,925,934],{},[380,922,923],{},[314,924,334],{},[380,926,927,928,931,932],{},"單選 ",[314,929,930],{},"string","；範圍 ",[314,933,320],{},[380,935,936,937,939,940,626],{},"永遠使用西元字串，範圍以起迄陣列表示；單選空值 ",[314,938,480],{},"，範圍空值 ",[314,941,589],{},[361,943,944,948,952],{},[380,945,946],{},[314,947,324],{},[380,