},"year-range"," 是年份清單的西元範圍，預設 ",[318,663,664],{},"[1900, 2100]",[472,666],{"name":667},"datepicker-limits",[476,669,670,679,684],{},[479,671,672,673,675,676,678],{},"民國模式下，",[318,674,653],{}," 至少為 1911\u002F01\u002F01，",[318,677,660],{}," 的下限至少為 1911。",[479,680,681,683],{},[318,682,653],{}," 傳字串時可用斜線或連字號分隔，可含時分（秒）。",[479,685,686,687,630],{},"年與年月模式以整年、整月比較 ",[318,688,653],{},[345,690,691],{"id":691},"圖示與清除按鈕",[315,693,694,697,698,701,702,705,706,709,710,714,715,321,717,719,720,723,724,726,727,730,731,630],{},[318,695,696],{},"clear"," 顯示清除按鈕，預設開啟（傳 ",[318,699,700],{},":clear=\"false\""," 關閉；包在 ",[318,703,704],{},"required"," 的 ",[318,707,708],{},"UFormField"," 內時預設關閉，規則同 ",[335,711,713],{"href":712},"\u002Fcomponents\u002Fchoice\u002Fselect-menu#%E6%B8%85%E9%99%A4%E6%8C%89%E9%88%95","SelectMenu 的清除按鈕","），清除後綁定值為 ",[318,716,484],{},[318,718,593],{},"）。",[318,721,722],{},"calendar-icon"," 是尾端的日曆圖示，預設 ",[318,725,263],{},"；",[318,728,729],{},"clear-icon"," 是清除按鈕的圖示，預設 ",[318,732,733],{},"i-lucide-x",[472,735],{"name":736},"datepicker-icons",[345,738,739],{"id":739},"驗證狀態",[315,741,742,745,746,749,750,753,754,757,758,761,762,764],{},[318,743,744],{},"ShuoDatepicker"," 沒有 ",[318,747,748],{},"color","，改以 ",[318,751,752],{},"state"," 表示驗證結果：",[318,755,756],{},"false"," 顯示錯誤、",[318,759,760],{},"true"," 顯示成功，未指定時為一般樣式。放在 ",[318,763,708],{}," 內且欄位有錯誤時，一律顯示錯誤。",[472,766],{"name":767},"datepicker-feedback",[345,769,770],{"id":770},"尺寸與狀態",[315,772,773,774,630],{},"載入中以轉圈圖示取代尾端日曆圖示並停用輸入。各狀態的共通行為見",[335,775,102],{"href":776},"\u002Fcomponents\u002Foverview\u002Fcommon",[472,778],{"name":779},"datepicker-states",[341,781,782],{"id":782},"範例",[345,784,785],{"id":785},"搭配表單驗證",[315,787,788,789,792,793,796,797,799,800,630],{},"單選用 ",[318,790,791],{},"requiredText","，範圍用 ",[318,794,795],{},"requiredArray","。只選了起日的範圍不會提交、不觸發 change，因此仍會顯示必填錯誤。放在 ",[318,798,708],{}," 內時接入欄位的 id、name、尺寸、停用與錯誤狀態，見",[335,801,803],{"href":802},"\u002Fcomponents\u002Foverview\u002Fcommon#%E6%90%AD%E9%85%8D-uform-%E8%88%87-uformfield","搭配 UForm 與 UFormField",[472,805],{"name":806},"datepicker-validation",[345,808,644],{"id":644},[315,810,811,812,329,814,816,817,819,820,822],{},"查詢 API 的起迄是兩個欄位時，只綁 ",[318,813,328],{},[318,815,332],{},"；搭配 ",[318,818,535],{}," 直接使用 ",[318,821,531],{}," 格式。",[472,824],{"name":825},"datepicker-start-end",[345,827,828],{"id":828},"起迄互相限制",[315,830,831,832,329,834,836],{},"用兩個單選日期分別輸入起日與迄日時，以對方的值作為 ",[318,833,656],{},[318,835,653],{},"，避免起日晚於迄日。",[472,838],{"name":839},"datepicker-linked-range",[341,841,842],{"id":842},"互動說明",[345,844,845],{"id":845},"選取流程",[476,847,848,855,863,869,875],{},[479,849,850,854],{},[851,852,853],"strong",{},"年、年月、日期","：選取即套用並關閉選單，不再顯示確認／取消按鈕。",[479,856,857,860,861,630],{},[851,858,859],{},"範圍","：僅選起日時保留草稿，父層三個綁定值維持原值；起迄皆選完才一次提交並關閉。中途點外面、按 Esc 或關閉選單，捨棄草稿並恢復上次完整範圍；原本為空值則保持 ",[318,862,593],{},[479,864,865,868],{},[851,866,867],{},"日期時分／秒","：選取日期後，立即帶入完整日期時間並切到時間面板；時間沿用既有值，空值以套件初始化的本地目前時間為準。調整時間即更新，點外面關閉即可保留。",[479,870,871,874],{},[851,872,873],{},"日期時間範圍","：先選完兩個日期，再切換到起迄時間面板，兩端的時間都可即時修改。",[479,876,877,878,329,881,630],{},"單選切換為範圍時清空並等待完整選擇；關閉範圍時保留起日作為單選值，並清空 ",[318,879,880],{},"start",[318,882,883],{},"end",[345,885,886],{"id":886},"鍵盤操作",[315,888,889],{},"開啟選單時焦點移到已選日期（或年份、月份），未選取時移到第一個可選項目。方向鍵移動焦點，Enter 選取，Esc 關閉；選單關閉時若焦點仍在選單內，回到輸入框。選單 teleport 至 body，無法以 Tab 進入。",[345,891,892],{"id":892},"日曆顯示",[315,894,895],{},"日曆以週日為每週第一天，固定顯示六週；前後月份的日期以較淡文字呈現。換月使用透明度過場，避免水平位移產生捲軸。",[315,897,898,899,901,902,630],{},"月份與星期名稱、年份清單的「年」字、年與年月模式的「115 年 10 月」格式，以及範圍的分隔符號「～」都依語系切換（英文為「10\u002F115」與「–」）；民國年或西元年仍由 ",[318,900,505],{}," 決定。見",[335,903,47],{"href":904},"\u002Fgetting-started\u002Ftheme\u002Fmessages",[341,906,338],{"id":338},[359,908,909,921],{},[362,910,911],{},[365,912,913,915,918],{},[368,914,338],{},[368,916,917],{},"型別",[368,919,920],{},"說明",[379,922,923,946,961],{},[365,924,925,929,938],{},[384,926,927],{},[318,928,338],{},[384,930,931,932,935,936],{},"單選 ",[318,933,934],{},"string","；範圍 ",[318,937,324],{},[384,939,940,941,943,944,630],{},"永遠使用西元字串，範圍以起迄陣列表示；單選空值 ",[318,942,484],{},"，範圍空值 ",[318,945,593],{},[365,947,948,952,956],{},[384,949,950],{},[318,951,328],{},[384,953,954],{},[318,955,934],{},[384,957,958,959,630],{},"範圍起日，可獨立回填，非範圍時為 ",[318,960,484],{},[365,962,963,967,971],{},[384,964,965],{},[318,966,332],{},[384,968,969],{},[318,970,934],{},[384,972,973,974,630],{},"範圍迄日，可獨立回填，尚無完整範圍或非範圍時為 ",[318,975,484],{},[341,977,979],{"id":978},"props","Props",[981,982],"component-props",{":exclude":983,"name":744},"[\"start\", \"end\"]",[315,985,986,329,989,329,992,329,995,329,998,329,1001,1004,1005,630,1008,329,1010,329,1013,329,1016,329,1018,329,1020,1023,1024,630],{},[318,987,988],{},"size",[318,990,991],{},"disabled",[318,993,994],{},"loading",[318,996,997],{},"skeleton",[318,999,1000],{},"id",[318,1002,1003],{},"name"," 的行為見",[335,1006,102],{"href":1007},"\u002Fcomponents\u002Foverview\u002Fcommon#%E5%85%B1%E7%94%A8%E5%8F%83%E6%95%B8",[318,1009,696],{},[318,1011,1012],{},"calendarIcon",[318,1014,1015],{},"clearIcon",[318,1017,505],{},[318,1019,509],{},[318,1021,1022],{},"yearRange"," 可在全站設定預設值，見",[335,1025,1027],{"href":1026},"\u002Fgetting-started\u002Ftheme\u002Fcomponent-defaults#%E5%8F%AF%E8%A8%AD%E5%AE%9A%E7%9A%84%E9%A0%85%E7%9B%AE","可設定的項目",[1029,1030,1031,1032,1035,1036,329,1039,329,1042,329,1045,329,1048,1051],"note",{},"元件只開放上表的參數，不繼承 ",[318,1033,1034],{},"@vuepic\u002Fvue-datepicker"," 的全部 props；",[318,1037,1038],{},"auto-apply",[318,1040,1041],{},"flow",[318,1043,1044],{},"config",[318,1046,1047],{},"formats",[318,1049,1050],{},"model-type"," 等由元件內部統一管理。",[341,1053,1054],{"id":1054},"樣式",[315,1056,1057,1058,1061,1062,329,1065,1068,1069,1072,1073,1075,1076,329,1079,719],{},"沒有 ",[318,1059,1060],{},"ui"," prop。",[318,1063,1064],{},"class",[318,1066,1067],{},"style"," 等 HTML attributes 套用在外層容器，不會透傳到日期套件。外層內建 ",[318,1070,1071],{},"relative block w-full min-w-0","，",[318,1074,1064],{}," 以 tailwind-merge 與其合併，衝突時優先，可覆寫寬度與最小寬度（例如 ",[318,1077,1078],{},"class=\"w-40\"",[3