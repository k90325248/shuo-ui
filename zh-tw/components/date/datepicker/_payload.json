199},"#%E9%80%B1%E8%B5%B7%E5%A7%8B%E6%97%A5%E8%88%87%E9%A1%AF%E7%A4%BA%E6%98%9F%E6%9C%9F",[334,1201,578],{}," 改變），固定顯示六週；前後月份的日期以較淡文字呈現。換月使用透明度過場，避免水平位移產生捲軸。",[331,1204,1205,1206,1208,1209,667],{},"月份與星期名稱、年份清單的「年」字、年與年月模式的「115 年 10 月」格式，以及範圍的分隔符號「～」都依語系切換（英文為「10\u002F115」與「–」）；民國年或西元年仍由 ",[334,1207,560],{}," 決定。見",[351,1210,47],{"href":662},[357,1212,354],{"id":354},[375,1214,1215,1227],{},[378,1216,1217],{},[381,1218,1219,1221,1224],{},[384,1220,354],{},[384,1222,1223],{},"型別",[384,1225,1226],{},"說明",[395,1228,1229,1252,1267],{},[381,1230,1231,1235,1244],{},[400,1232,1233],{},[334,1234,354],{},[400,1236,1237,1238,1241,1242],{},"單選 ",[334,1239,1240],{},"string","；範圍 ",[334,1243,340],{},[400,1245,1246,1247,1249,1250,667],{},"永遠使用西元字串，範圍以起迄陣列表示；單選空值 ",[334,1248,534],{},"，範圍空值 ",[334,1251,887],{},[381,1253,1254,1258,1262],{},[400,1255,1256],{},[334,1257,344],{},[400,1259,1260],{},[334,1261,1240],{},[400,1263,1264,1265,667],{},"範圍起日，可獨立回填，非範圍時為 ",[334,1266,534],{},[381,1268,1269,1273,1277],{},[400,1270,1271],{},[334,1272,348],{},[400,1274,1275],{},[334,1276,1240],{},[400,1278,1279,1280,667],{},"範圍迄日，可獨立回填，尚無完整範圍或非範圍時為 ",[334,1281,534],{},[357,1283,1285],{"id":1284},"props","Props",[1287,1288],"component-props",{":exclude":1289,"name":1045},"[\"start\", \"end\"]",[331,1291,1292,345,1295,345,1298,345,1301,345,1304,345,1307,1310,1311,667,1314,345,1316,345,1319,345,1322,345,1325,345,1327,345,1329,345,1331,345,1334,345,1337,1340,1341,667],{},[334,1293,1294],{},"size",[334,1296,1297],{},"disabled",[334,1299,1300],{},"loading",[334,1302,1303],{},"skeleton",[334,1305,1306],{},"id",[334,1308,1309],{},"name"," 的行為見",[351,1312,102],{"href":1313},"\u002Fcomponents\u002Foverview\u002Fcommon#%E5%85%B1%E7%94%A8%E5%8F%83%E6%95%B8",[334,1315,986],{},[334,1317,1318],{},"calendarIcon",[334,1320,1321],{},"timeIcon",[334,1323,1324],{},"clearIcon",[334,1326,560],{},[334,1328,563],{},[334,1330,679],{},[334,1332,1333],{},"yearRange",[334,1335,1336],{},"weekStart",[334,1338,1339],{},"showWeekd