,534,341],{},[307,536,498],{}," 的格式、型別錯誤、民國下限之前的日期，或範圍起日晚於迄日時，元件會清空綁定值，並以 ",[307,539,540],{},"console.warn"," 留下 ",[307,543,544],{},"[ShuoDatepicker] modelValue 格式不符，已清空："," 或 ",[307,547,548],{},"起迄相反"," 紀錄。切換 ",[307,551,341],{},[307,553,494],{},[307,555,498],{}," 後，若既有值不符合新設定，同樣會清空並警告；請同時回填符合新設定的值。",[304,558,559,560,563,564,318,567,570],{},"同一輪清空只送出一次 ",[307,561,562],{},"update:modelValue","（或 ",[307,565,566],{},"update:start",[307,568,569],{},"update:end","）事件；起迄相反時不會先同步出排序後的暫時值。",[334,572,573],{"id":573},"範圍綁定",[304,575,576,579,580,583],{},[307,577,578],{},"range"," 開啟範圍選擇。主陣列與獨立起迄同步，方便對接不同 API。只會提交完整起迄陣列或 ",[307,581,582],{},"[]","，不回傳半個範圍。",[461,585],{"name":586},"datepicker-range",[465,588,589,595,620,623],{},[468,590,591,592,594],{},"初始化同時提供兩種綁定時，以主 ",[307,593,327],{}," 為準；之後可由父層更新主值或起迄。",[468,596,597,598,600,601,603,604,545,607,610,611,613,614,616,617,619],{},"清空時主值為 ",[307,599,582],{},"，起迄為 ",[307,602,473],{},"。父層綁定 ",[307,605,606],{},"null",[307,608,609],{},"undefined"," 時，元件回寫為單選 ",[307,612,473],{},"、範圍 ",[307,615,582],{},"、起迄 ",[307,618,473],{},"。",[468,621,622],{},"只綁起迄時允許分次回填，單邊格式不符只清空該端，兩端皆有值但起日晚於迄日則兩端都清空。",[468,624,625,626,629,630,634],{},"不需要主陣列時，可以只寫 ",[307,627,628],{},"\u003CShuoDatepicker v-model:start=\"start\" v-model:end=\"end\" range \u002F>","，見",[324,631,633],{"href":632},"#%E5%8F%AA%E7%B6%81%E5%AE%9A%E8%B5%B7%E8%BF%84","只綁定起迄","。迄日須配合起日使用，元件不將單獨迄日視為完整範圍。",[334,636,637],{"id":637},"可選日期範圍",[304,639,640,318,643,646,647,650,651,619],{},[307,641,642],{},"min-date",[307,644,645],{},"max-date"," 限制可選的最早與最晚日期，範圍外的日期無法選取；",[307,648,649],{},"year-range"," 是年份清單的西元範圍，預設 ",[307,652,653],{},"[1900, 2100]",[461,655],{"name":656},"datepicker-limits",[465,658,659,668,673],{},[468,660,661,662,664,665,667],{},"民國模式下，",[307,663,642],{}," 至少為 1911\u002F01\u002F01，",[307,666,649],{}," 的下限至少為 1911。",[468,669,670,672],{},[307,671,642],{}," 傳字串時可用斜線或連字號分隔，可含時分（秒）。",[468,674,675,676,619],{},"年與年月模式以整年、整月比較 ",[307,677,642],{},[334,679,680],{"id":680},"圖示與清除按鈕",[304,682,683,686,687,310,689,691,692,695,696,698,699,702,703,619],{},[307,684,685],{},"clearable"," 顯示清除按鈕，預設關閉，清除後綁定值為 ",[307,688,473],{},[307,690,582],{},"）。",[307,693,694],{},"calendar-icon"," 是尾端的日曆圖示，預設 ",[307,697,248],{},"；",[307,700,701],{},"clear-icon"," 是清除按鈕的圖示，預設 ",[307,704,705],{},"i-lucide-x",[461,707],{"name":708},"datepicker-icons",[334,710,711],{"id":711},"驗證狀態",[304,713,714,717,718,721,722,725,726,729,730,733,734,737],{},[307,715,716],{},"ShuoDatepicker"," 沒有 ",[307,719,720],{},"color","，改以 ",[307,723,724],{},"state"," 表示驗證結果：",[307,727,728],{},"false"," 顯示錯誤、",[307,731,732],{},"true"," 顯示成功，未指定時為一般樣式。放在 ",[307,735,736],{},"UFormField"," 內且欄位有錯誤時，一律顯示錯誤。",[461,739],{"name":740},"datepicker-feedback",[334,742,743],{"id":743},"尺寸與狀態",[304,745,746,747,619],{},"載入中以轉圈圖示取代尾端日曆圖示並停用輸入。各狀態的共通行為見",[324,748,87],{"href":749},"\u002Fcomponents\u002Foverview\u002Fcommon",[461,751],{"name":752},"datepicker-states",[330,754,755],{"id":755},"範例",[334,757,758],{"id":758},"搭配表單驗證",[304,760,761,762,765,766,769,770,772,773,619],{},"單選用 ",[307,763,764],{},"requiredText","，範圍用 ",[307,767,768],{},"requiredArray","。只選了起日的範圍不會提交、不觸發 change，因此仍會顯示必填錯誤。放在 ",[307,771,736],{}," 內時接入欄位的 id、name、尺寸、停用與錯誤狀態，見",[324,774,776],{"href":775},"\u002Fcomponents\u002Foverview\u002Fcommon#%E6%90%AD%E9%85%8D-uform-%E8%88%87-uformfield","搭配 UForm 與 UFormField",[461,778],{"name":779},"datepicker-validation",[334,781,633],{"id":633},[304,783,784,785,318,787,789,790,792,793,795],{},"查詢 API 的起迄是兩個欄位時，只綁 ",[307,786,317],{},[307,788,321],{},"；搭配 ",[307,791,524],{}," 直接使用 ",[307,794,520],{}," 格式。",[461,797],{"name":798},"datepicker-start-end",[334,800,801],{"id":801},"起迄互相限制",[304,803,804,805,318,807,809],{},"用兩個單選日期分別輸入起日與迄日時，以對方的值作為 ",[307,806,645],{},[307,808,642],{},"，避免起日晚於迄日。",[461,811],{"name":812},"datepicker-linked-range",[330,814,815],{"id":815},"互動說明",[334,817,818],{"id":818},"選取流程",[465,820,821,828,836,842,848],{},[468,822,823,827],{},[824,825,826],"strong",{},"年、年月、日期","：選取即套用並關閉選單，不再顯示確認／取消按鈕。",[468,829,830,833,834,619],{},[824,831,832],{},"範圍","：僅選起日時保留草稿，父層三個綁定值維持原值；起迄皆選完才一次提交並關閉。中途點外面、按 Esc 或關閉選單，捨棄草稿並恢復上次完整範圍；原本為空值則保持 ",[307,835,582],{},[468,837,838,841],{},[824,839,840],{},"日期時分／秒","：選取日期後，立即帶入完整日期時間並切到時間面板；時間沿用既有值，空值以套件初始化的本地目前時間為準。調整時間即更新，點外面關閉即可保留。",[468,843,844,847],{},[824,845,846],{},"日期時間範圍","：先選完兩個日期，再切換到起迄時間面板，兩端的時間都可即時修改。",[468,849,850,851,318,854,619],{},"單選切換為範圍時清空並等待完整選擇；關閉範圍時保留起日作為單選值，並清空 ",[307,852,853],{},"start",[307,855,856],{},"end",[334,858,859],{"id":859},"鍵盤操作",[304,861,862],{},"開啟選單時焦點移到已選日期（或年份、月份），未選取時移到第一個可選項目。方向鍵移動焦點，Enter 選取，Esc 關閉；選單關閉時若焦點仍在選單內，回到輸入框。選單 teleport 至 body，無法以 Tab 進入。",[334,864,865],{"id":865},"日曆顯示",[304,867,868],{},"日曆以週日為每週第一天，固定顯示六週；前後月份的日期以較淡文字呈現。換月使用透明度過場，避免水平位移產生捲軸。",[304,870,871,872,874,875,619],{},"月份與星期名稱、年份清單的「年」字、年與年月模式的「115 年 10 月」格式，以及範圍的分隔符號「～」都依語系切換（英文為「10\u002F115」與「–」）；民國年或西元年仍由 ",[307,873,494],{}," 決定。見",[324,876,47],{"href":877},"\u002Fgetting-started\u002Ftheme\u002Fmessages",[330,879,327],{"id":327},[348,881,882,894],{},[351,883,884],{},[354,885,886,888,891],{},[357,887,327],{},[357,889,890],{},"型別",[357,892,893],{},"說明",[368,895,896,919,934],{},[354,897,898,902,911],{},[373,899,900],{},[307,901,327],{},[373,903,904,905,908,909],{},"單選 ",[307,906,907],{},"string","；範圍 ",[307,910,313],{},[373,912,913,914,916,917,619],{},"永遠使用西元字串，範圍以起迄陣列表示；單選空值 ",[307,915,473],{},"，範圍空值 ",[307,918,582],{},[354,920,921,925,929],{},[373,922,923],{},[307,924,317],{},[373,926,927],{},[307,928,907],{},[373,930,931,932,619],{},"範圍起日，可獨立回填，非範圍時為 ",[307,933,473],{},[354,935,936,940,944],{},[373,937,938],{},[307,939,321],{},[373,941,942],{},[307,943,907],{},[373,945,946,947,619],{},"範圍迄日，可獨立回填，尚無完整範圍或非範圍時為 ",[307,948,473],{},[330,950,952],{"id":951},"props","Props",[954,955],"component-props",{":exclude":956,"name":716},"[\"start\", \"end\"]",[304,958,959,318,962,318,965,318,968,318,971,318,974,977,978,619,981,318,983,318,986,318,989,318,991,318,993,996,997,619],{},[307,960,961],{},"size",[307,963,964],{},"