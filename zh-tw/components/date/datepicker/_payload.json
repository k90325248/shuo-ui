undefined"," 時，元件回寫為單選 ",[279,584,445],{},"、範圍 ",[279,587,554],{},"、起迄 ",[279,590,445],{},"。",[440,593,594],{},"只綁起迄時允許分次回填，單邊格式不符只清空該端，兩端皆有值但起日晚於迄日則兩端都清空。",[440,596,597,598,601,602,606],{},"不需要主陣列時，可以只寫 ",[279,599,600],{},"\u003CShuoDatepicker v-model:start=\"start\" v-model:end=\"end\" range \u002F>","，見",[296,603,605],{"href":604},"#%E5%8F%AA%E7%B6%81%E5%AE%9A%E8%B5%B7%E8%BF%84","只綁定起迄","。迄日須配合起日使用，元件不將單獨迄日視為完整範圍。",[306,608,609],{"id":609},"可選日期範圍",[276,611,612,290,615,618,619,622,623,591],{},[279,613,614],{},"min-date",[279,616,617],{},"max-date"," 限制可選的最早與最晚日期，範圍外的日期無法選取；",[279,620,621],{},"year-range"," 是年份清單的西元範圍，預設 ",[279,624,625],{},"[1900, 2100]",[433,627],{"name":628},"datepicker-limits",[437,630,631,640,645],{},[440,632,633,634,636,637,639],{},"民國模式下，",[279,635,614],{}," 至少為 1911\u002F01\u002F01，",[279,638,621],{}," 的下限至少為 1911。",[440,641,642,644],{},[279,643,614],{}," 傳字串時可用斜線或連字號分隔，可含時分（秒）。",[440,646,647,648,591],{},"年與年月模式以整年、整月比較 ",[279,649,614],{},[306,651,652],{"id":652},"圖示與清除按鈕",[276,654,655,658,659,282,661,663,664,667,668,670,671,674,675,591],{},[279,656,657],{},"clearable"," 顯示清除按鈕，預設關閉，清除後綁定值為 ",[279,660,445],{},[279,662,554],{},"）。",[279,665,666],{},"calendar-icon"," 是尾端的日曆圖示，預設 ",[279,669,242],{},"；",[279,672,673],{},"clear-icon"," 是清除按鈕的圖示，預設 ",[279,676,677],{},"i-lucide-x",[433,679],{"name":680},"datepicker-icons",[306,682,683],{"id":683},"驗證狀態",[276,685,686,689,690,693,694,697,698,701,702,705,706,709],{},[279,687,688],{},"ShuoDatepicker"," 沒有 ",[279,691,692],{},"color","，改以 ",[279,695,696],{},"state"," 表示驗證結果：",[279,699,700],{},"false"," 顯示錯誤、",[279,703,704],{},"true"," 顯示成功，未指定時為一般樣式。放在 ",[279,707,708],{},"UFormField"," 內且欄位有錯誤時，一律顯示錯誤。",[433,711],{"name":712},"datepicker-feedback",[306,714,715],{"id":715},"尺寸與狀態",[276,717,718,719,591],{},"載入中以轉圈圖示取代尾端日曆圖示並停用輸入。各狀態的共通行為見",[296,720,87],{"href":721},"\u002Fcomponents\u002Foverview\u002Fcommon",[433,723],{"name":724},"datepicker-states",[302,726,727],{"id":727},"範例",[306,729,730],{"id":730},"搭配表單驗證",[276,732,733,734,737,738,741,742,744,745,591],{},"單選用 ",[279,735,736],{},"requiredText","，範圍用 ",[279,739,740],{},"requiredArray","。只選了起日的範圍不會提交、不觸發 change，因此仍會顯示必填錯誤。放在 ",[279,743,708],{}," 內時接入欄位的 id、name、尺寸、停用與錯誤狀態，見",[296,746,748],{"href":747},"\u002Fcomponents\u002Foverview\u002Fcommon#%E6%90%AD%E9%85%8D-uform-%E8%88%87-uformfield","搭配 UForm 與 UFormField",[433,750],{"name":751},"datepicker-validation",[306,753,605],{"id":605},[276,755,756,757,290,759,761,762,764,765,767],{},"查詢 API 的起迄是兩個欄位時，只綁 ",[279,758,289],{},[279,760,293],{},"；搭配 ",[279,763,496],{}," 直接使用 ",[279,766,492],{}," 格式。",[433,769],{"name":770},"datepicker-start-end",[306,772,773],{"id":773},"起迄互相限制",[276,775,776,777,290,779,781],{},"用兩個單選日期分別輸入起日與迄日時，以對方的值作為 ",[279,778,617],{},[279,780,614],{},"，避免起日晚於迄日。",[433,783],{"name":784},"datepicker-linked-range",[302,786,787],{"id":787},"互動說明",[306,789,790],{"id":790},"選取流程",[437,792,793,800,808,814,820],{},[440,794,795,799],{},[796,797,798],"strong",{},"年、年月、日期","：選取即套用並關閉選單，不再顯示確認／取消按鈕。",[440,801,802,805,806,591],{},[796,803,804],{},"範圍","：僅選起日時保留草稿，父層三個綁定值維持原值；起迄皆選完才一次提交並關閉。中途點外面、按 Esc 或關閉選單，捨棄草稿並恢復上次完整範圍；原本為空值則保持 ",[279,807,554],{},[440,809,810,813],{},[796,811,812],{},"日期時分／秒","：選取日期後，立即帶入完整日期時間並切到時間面板；時間沿用既有值，空值以套件初始化的本地目前時間為準。調整時間即更新，點外面關閉即可保留。",[440,815,816,819],{},[796,817,818],{},"日期時間範圍","：先選完兩個日期，再切換到起迄時間面板，兩端的時間都可即時修改。",[440,821,822,823,290,826,591],{},"單選切換為範圍時清空並等待完整選擇；關閉範圍時保留起日作為單選值，並清空 ",[279,824,825],{},"start",[279,827,828],{},"end",[306,830,831],{"id":831},"鍵盤操作",[276,833,834],{},"開啟選單時焦點移到已選日期（或年份、月份），未選取時移到第一個可選項目。方向鍵移動焦點，Enter 選取，Esc 關閉；選單關閉時若焦點仍在選單內，回到輸入框。選單 teleport 至 body，無法以 Tab 進入。",[306,836,837],{"id":837},"日曆顯示",[276,839,840],{},"日曆以週日為每週第一天，固定顯示六週；前後月份的日期以較淡文字呈現。換月使用透明度過場，避免水平位移產生捲軸。",[276,842,843,844,846,847,591],{},"月份與星期名稱、年份清單的「年」字、年與年月模式的「115 年 10 月」格式，以及範圍的分隔符號「～」都依語系切換（英文為「10\u002F115」與「–」）；民國年或西元年仍由 ",[279,845,466],{}," 決定。見",[296,848,47],{"href":849},"\u002Fgetting-started\u002Ftheme\u002Fmessages",[302,85