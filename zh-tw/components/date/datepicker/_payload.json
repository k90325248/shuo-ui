符只清空該端，兩端皆有值但起日晚於迄日則兩端都清空。",[491,647,648,649,652,653,657],{},"不需要主陣列時，可以只寫 ",[330,650,651],{},"\u003CShuoDatepicker v-model:start=\"start\" v-model:end=\"end\" range \u002F>","，見",[347,654,656],{"href":655},"#%E5%8F%AA%E7%B6%81%E5%AE%9A%E8%B5%B7%E8%BF%84","只綁定起迄","。迄日須配合起日使用，元件不將單獨迄日視為完整範圍。",[357,659,660],{"id":660},"可選日期範圍",[327,662,663,341,666,669,670,673,674,642],{},[330,664,665],{},"min-date",[330,667,668],{},"max-date"," 限制可選的最早與最晚日期，範圍外的日期無法選取；",[330,671,672],{},"year-range"," 是年份清單的西元範圍，預設 ",[330,675,676],{},"[1900, 2100]",[484,678],{"name":679},"datepicker-limits",[488,681,682,691,696],{},[491,683,684,685,687,688,690],{},"民國模式下，",[330,686,665],{}," 至少為 1911\u002F01\u002F01，",[330,689,672],{}," 的下限至少為 1911。",[491,692,693,695],{},[330,694,665],{}," 傳字串時可用斜線或連字號分隔，可含時分（秒）。",[491,697,698,699,642],{},"年與年月模式以整年、整月比較 ",[330,700,665],{},[357,702,703],{"id":703},"圖示與清除按鈕",[327,705,706,709,710,333,712,714,715,718,719,721,722,725,726,642],{},[330,707,708],{},"clearable"," 顯示清除按鈕，預設關閉，清除後綁定值為 ",[330,711,496],{},[330,713,605],{},"）。",[330,716,717],{},"calendar-icon"," 是尾端的日曆圖示，預設 ",[330,720,263],{},"；",[330,723,724],{},"clear-icon"," 是清除按鈕的圖示，預設 ",[330,727,728],{},"i-lucide-x",[484,730],{"name":731},"datepicker-icons",[357,733,734],{"id":734},"驗證狀態",[327,736,737,740,741,744,745,748,749,752,753,756,757,760],{},[330,738,739],{},"ShuoDatepicker"," 沒有 ",[330,742,743],{},"color","，改以 ",[330,746,747],{},"state"," 表示驗證結果：",[330,750,751],{},"false"," 顯示錯誤、",[330,754,755],{},"true"," 顯示成功，未指定時為一般樣式。放在 ",[330,758,759],{},"UFormField"," 內且欄位有錯誤時，一律顯示錯誤。",[484,762],{"name":763},"datepicker-feedback",[357,765,766],{"id":766},"尺寸與狀態",[327,768,769,770,642],{},"載入中以轉圈圖示取代尾端日曆圖示並停用輸入。各狀態的共通行為見",[347,771,102],{"href":772},"\u002Fcomponents\u002Foverview\u002Fcommon",[484,774],{"name":775},"datepicker-states",[353,777,778],{"id":778},"範例",[357,780,781],{"id":781},"搭配表單驗證",[327,783,784,785,788,789,792,793,795,796,642],{},"單選用 ",[330,786,787],{},"requiredText","，範圍用 ",[330,790,791],{},"requiredArray","。只選了起日的範圍不會提交、不觸發 change，因此仍會顯示必填錯誤。放在 ",[330,794,759],{}," 內時接入欄位的 id、name、尺寸、停用與錯誤狀態，見",[347,797,799],{"href":798},"\u002Fcomponents\u002Foverview\u002Fcommon#%E6%90%AD%E9%85%8D-uform-%E8%88%87-uformfield","搭配 UForm 與 UFormField",[484,801],{"name":802},"datepicker-validation",[357,804,656],{"id":656},[327,806,807,808,341,810,812,813,815,816,818],{},"查詢 API 的起迄是兩個欄位時，只綁 ",[330,809,340],{},[330,811,344],{},"；搭配 ",[330,814,547],{}," 直接使用 ",[330,817,543],{}," 格式。",[484,820],{"name":821},"datepicker-start-end",[357,823,824],{"id":824},"起迄互相限制",[327,826,827,828,341,830,832],{},"用兩個單選日期分別輸入起日與迄日時，以對方的值作為 ",[330,829,668],{},[330,831,665],{},"，避免起日晚於迄日。",[484,834],{"name":835},"datepicker-linked-range",[353,837,838],{"id":838},"互動說明",[357,840,841],{"id":841},"選取流程",[488,843,844,851,859,865,871],{},[491,845,846,850],{},[847,848,849],"strong",{},"年、年月、日期","：選取即套用並關閉選單，不再顯示確認／取消按鈕。",[491,852,853,856,857,642],{},[847,854,855],{},"範圍","：僅選起日時保留草稿，父層三個綁定值維持原值；起迄皆選完才一次提交並關閉。中途點外面、按 Esc 或關閉選單，捨棄草稿並恢復上次完整範圍；原本為空值則保持 ",[330,858,605],{},[491,860,861,864],{},[847,862,863],{},"日期時分／秒","：選取日期後，立即帶入完整日期時間並切到時間面板；時間沿用既有值，空值以套件初始化的本地目前時間為準。調整時間即更新，點外面關閉即可保留。",[491,866,867,870],{},[847,868,869],{},"日期時間範圍","：先選完兩個日期，再切換到起迄時間面板，兩端的時間都可即時修改。",[491,872,873,874,341,877,642],{},"單選切換為範圍時清空並等待完整選擇；關閉範圍時保留起日作為單選值，並清空 ",[330,875,876],{},"start",[330,878,879],{},"end",[357,881,882],{"id":882},"鍵盤操作",[327,884,885],{},"開啟選單時焦點移到已選日期（或年份、月份），未選取時移到第一個可選項目。方向鍵移動焦點，Enter 選取，Esc 關閉；選單關閉時若焦點仍在選單內，回到輸入框。選單 teleport 至 body，無法以 Tab 進入。",[357,887,888],{"id":888},"日曆顯示",[327,890,891],{},"日曆以週日為每週第一天，固定顯示六週；前後月份的日期以較淡文字呈現。換月使用透明度過場，避免水平位移產生捲軸。",[327,893,894,895,897,898,642],{},"月份與星期名稱、年份清單的「年」字、年與年月模式的「115 年 10 月」格式，以及範圍的分隔符號「～」都依語系切換（英文為「10\u002F115」與「–」）；民國年或西元年仍由 ",[330,896,517],{}," 決定。見",[347,899,47],{"href":900},"\u002Fgetting-started\u002Ftheme\u002Fmessages",[353,902,350],{"id":350},[371,904,905,917],{},[374,906,907],{},[377,908,909,911,914],{},[380,910,350],{},[380,912,913],{},"型別",[380,915