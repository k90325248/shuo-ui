iew\u002Fcommon#%E6%90%AD%E9%85%8D-uform-%E8%88%87-uformfield","搭配 UForm 與 UFormField",[480,797],{"name":798},"datepicker-validation",[353,800,652],{"id":652},[323,802,803,804,337,806,808,809,811,812,814],{},"查詢 API 的起迄是兩個欄位時，只綁 ",[326,805,336],{},[326,807,340],{},"；搭配 ",[326,810,543],{}," 直接使用 ",[326,813,539],{}," 格式。",[480,816],{"name":817},"datepicker-start-end",[353,819,820],{"id":820},"起迄互相限制",[323,822,823,824,337,826,828],{},"用兩個單選日期分別輸入起日與迄日時，以對方的值作為 ",[326,825,664],{},[326,827,661],{},"，避免起日晚於迄日。",[480,830],{"name":831},"datepicker-linked-range",[349,833,834],{"id":834},"互動說明",[353,836,837],{"id":837},"選取流程",[484,839,840,847,855,861,867],{},[487,841,842,846],{},[843,844,845],"strong",{},"年、年月、日期","：選取即套用並關閉選單，不再顯示確認／取消按鈕。",[487,848,849,852,853,638],{},[843,850,851],{},"範圍","：僅選起日時保留草稿，父層三個綁定值維持原值；起迄皆選完才一次提交並關閉。中途點外面、按 Esc 或關閉選單，捨棄草稿並恢復上次完整範圍；原本為空值則保持 ",[326,854,601],{},[487,856,857,860],{},[843,858,859],{},"日期時分／秒","：選取日期後，立即帶入完整日期時間並切到時間面板；時間沿用既有值，空值以套件初始化的本地目前時間為準。調整時間即更新，點外面關閉即可保留。",[487,862,863,866],{},[843,864,865],{},"日期時間範圍","：先選完兩個日期，再切換到起迄時間面板，兩端的時間都可即時修改。",[487,868,869,870,337,873,638],{},"單選切換為範圍時清空並等待完整選擇；關閉範圍時保留起日作為單選值，並清空 ",[326,871,872],{},"start",[326,874,875],{},"end",[353,877,878],{"id":878},"鍵盤操作",[323,880,881],{},"開啟選單時焦點移到已選日期（或年份、月份），未選取時移到第一個可選項目。方向鍵移動焦點，Enter 選取，Esc 關閉；選單關閉時若焦點仍在選單內，回到輸入框。選單 teleport 至 body，無法以 Tab 進入。",[353,883,884],{"id":884},"日曆顯示",[323,886,887],{},"日曆以週日為每週第一天，固定顯示六週；前後月份的日期以較淡文字呈現。換月使用透明度過場，避免水平位移產生捲軸。",[323,889,890,891,893,894,638],{},"月份與星期名稱、年份清單的「年」字、年與年月模式的「115 年 10 月」格式，以及範圍的分隔符號「～」都依語系切換（英文為「10\u002F115」與「–」）；民國年或西元年仍由 ",[326,892,513],{}," 決定。見",[343,895,47],{"href":896},"\u002Fgetting-started\u002Ftheme\u002Fmessages",[349,898,346],{"id":346},[367,900,901,913],{},[370,902,903],{},[373,904,905,907,910],{},[376,906,346],{},[376,908,909],{},"型別",[376,911,912],{},"說明",[387,914,915,938,953],{},[373,916,917,921,930],{},[392,918,919],{},[326,920,346],{},[392,922,923,924,927,928],{},"單選 ",[326,925,926],{},"string