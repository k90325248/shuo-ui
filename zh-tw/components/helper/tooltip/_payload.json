404,407,411,452,455],[276,277,278,279,283,284,287,288,290,291,293,294,296],"p",{},"Nuxt UI 的 ",[280,281,282],"code",{},"UTooltip"," 只在滑鼠移入或鍵盤聚焦時顯示，手機上點擊、按住都不會出現。",[280,285,286],{},"ShuoTooltip"," 沿用 ",[280,289,282],{}," 的全部參數與 slot，只補上觸控裝置的長按顯示，把 ",[280,292,282],{}," 改成 ",[280,295,286],{}," 即可。",[276,298,299,300,303],{},"元件庫內的提示都使用它：",[280,301,302],{},"ShuoInfoTooltip"," 與下拉選單、日期選擇器、檔案選擇、核取方塊、選項群組的文字截斷提示，在手機上一樣長按顯示。",[305,306,307],"h2",{"id":307},"用法",[309,310,311],"h3",{"id":311},"提示文字",[276,313,314,317,318,321,322,321,325,321,328,331],{},[280,315,316],{},"text"," 為提示內容，觸發元素放在預設 slot。",[280,319,320],{},"kbds","、",[280,323,324],{},"content",[280,326,327],{},"arrow",[280,329,330],{},"delayDuration"," 等參數與 Nuxt UI 相同。",[333,334],"component-example",{"name":335},"tooltip-text",[309,337,338],{"id":338},"觸控長按",[276,340,341],{},"觸控裝置上按住觸發元素約 0.5 秒即顯示提示，放開後保持顯示，點擊其他位置或捲動頁面時關閉。",[343,344,345,349,352,355],"ul",{},[346,347,348],"li",{},"長按顯示提示時，放開手指不會觸發觸發元素原本的動作（點擊、勾選、開啟選單等）。",[346,350,351],{},"一般點擊照常觸發原本的動作，不顯示提示；點擊造成的聚焦也不顯示。",[346,353,354],{},"按住後移動手指視為捲動，不顯示提示。",[346,356,357],{},"長按期間不顯示瀏覽器的長按選單，觸發元素內的文字不會被選取（輸入框除外）。",[276,359,360,363,364,367],{},[280,361,362],{},"touch"," 設為 ",[280,365,366],{},"false"," 時與 Nuxt UI 原本的行為相同，觸控無法開啟提示。",[333,369],{"name":370},"tooltip-touch",[276,372,373,374,377,378,382],{},"要全站關閉時設定 ",[280,375,376],{},"components.tooltip.touch: false","，元件庫內的提示也會一起關閉，見",[379,380,42],"a",{"href":381},"\u002Fgetting-started\u002Ftheme\u002Fcomponent-defaults","。",[309,384,385],{"id":385},"開啟狀態",[276,387,388,389,392,393,396],{},"以 ",[280,390,391],{},"v-model:open"," 綁定開啟狀態，可由程式開啟或關閉；未綁定時可用 ",[280,394,395],{},"default-open"," 設定初始狀態。",[333,398],{"name":399},"tooltip-open",[305,401,403],{"id":402},"props","Props",[405,406],"component-props",{"name":286},[305,408,410],{"id":409},"slots","Slots",[412,413,414,427],"table",{},[415,416,417],"thead",{},[418,419,420,424],"tr",{},[421,422,423],"th",{},"Slot",[421,425,426],{},"說明",[428,429,430,441],"tbody",{},[418,431,432