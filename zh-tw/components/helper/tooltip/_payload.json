}," 即可。",[323,345,346,347,350],{},"元件庫內的提示都使用它：",[327,348,349],{},"ShuoInfoTooltip"," 與下拉選單、日期選擇器、檔案選擇、核取方塊、選項群組的文字截斷提示，在手機上一樣長按顯示。",[352,353,354],"h2",{"id":354},"用法",[356,357,358],"h3",{"id":358},"提示文字",[323,360,361,364,365,368,369,368,372,368,375,378],{},[327,362,363],{},"text"," 為提示內容，觸發元素放在預設 slot。",[327,366,367],{},"kbds","、",[327,370,371],{},"content",[327,373,374],{},"arrow",[327,376,377],{},"delayDuration"," 等參數與 Nuxt UI 相同。",[380,381],"component-example",{"name":382},"tooltip-text",[356,384,385],{"id":385},"觸控長按",[323,387,388],{},"觸控裝置上按住觸發元素約 0.5 秒即顯示提示，放開後保持顯示，點擊其他位置或捲動頁面時關閉。",[390,391,392,396,399,402],"ul",{},[393,394,395],"li",{},"長按顯示提示時，放開手指不會觸發觸發元素原本的動作（點擊、勾選、開啟選單等）。",[393,397,398],{},"一般點擊照常觸發原本的動作，不顯示提示；點擊造成的聚焦也不顯示。",[393,400,401],{},"按住後移動手指視為捲動，不顯示提示。",[393,403,404],{},"長按期間不顯示瀏覽器的長按選單，觸發元素內的文字不會被選取（輸入框除外）。",[323,406,407,410,411,414],{},[327,408,409],{},"touch"," 設為 ",[327,412,413],{},"false"," 時與 Nuxt UI 原本的行為相同，觸控無法開啟提示。",[380,416],{"name":417},"tooltip-touch",[323,419,420,421,424,425,429],{},"要全站關閉時設定 ",[327,422,423],{},"components.tooltip.touch: false","，元件庫內的提示也會一起關閉，見",[426,427,42],"a",{"href":428},"\u002Fgetting-started\u002Ftheme\u002Fcomponent-defaults","。",[356,431,432],{"id":432},"開啟狀態",[323,434,435,436,439,440,443],{},"以 ",[327,437,438],{},"v-model:open"," 綁定開啟狀態，可由程式開啟或關閉；未綁定時可用 ",[327,441,442],{},"default-open"," 設定初始狀態。",[380,445],{"name":446},"tooltip-open",[352,448,450],{"id":449},"props","Props",[452,453],"component-props",{"name":333},[352,455,457],{"id":456},"slots","Slots",[459,460,461,474],"table",{},[462,463,464],"thead",{},[465,466,467,471],"tr",{},[468,469,470],"th",{},"Slot",[468,472,473],{},"說明",[475,476,477,488],"tbody",{},[465,478,479,485],{},[480,481,482],"td",{},[327,483,484],{},"default",[480,486,487],{},"觸發元素",[465,489,490,494],{},[480,491,492],{},[327,493,371],{},[480,495,496,497],{},"自訂提示內容，同 Nuxt UI 的 ",[327,498,371],{},[352,500,501],{"id":501},"更新紀錄",[503,504],"component-changelog",{"name":333},{"title":506,"