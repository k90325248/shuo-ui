點擊造成的聚焦也不顯示。",[374,381,382],{},"按住後移動手指視為捲動，不顯示提示。",[374,384,385],{},"長按期間不顯示瀏覽器的長按選單，觸發元素內的文字不會被選取（輸入框除外）。",[304,387,388,391,392,395],{},[308,389,390],{},"touch"," 設為 ",[308,393,394],{},"false"," 時與 Nuxt UI 原本的行為相同，觸控無法開啟提示。",[361,397],{"name":398},"tooltip-touch",[304,400,401,402,405,406,410],{},"要全站關閉時設定 ",[308,403,404],{},"components.tooltip.touch: false","，元件庫內的提示也會一起關閉，見",[407,408,42],"a",{"href":409},"\u002Fgetting-started\u002Ftheme\u002Fcomponent-defaults","。",[337,412,413],{"id":413},"開啟狀態",[304,415,416,417,420,421,424],{},"以 ",[308,418,419],{},"v-model:open"," 綁定開啟狀態，可由程式開啟或關閉；未綁定時可用 ",[308,422,423],{},"default-open"," 設定初始狀態。",[361,426],{"name":427},"tooltip-open",[333,429,431],{"id":430},"props","Props",[433,434],"component-props",{"name":314},[333,436,438],{"id":437},"slots","Slots",[440,441,442,455],"table",{},[443,444,445],"thead",{},[446,447,448,452],"tr",{},[449,450,451],"th",{},"Slot",[449,453,454],{},"說明",[456,457,458,469],"tbody",{},[446,459,460,466],{},[461,462,463],"td",{},[308,464,465],{},"default",[461,467,468],{},"觸發元素",[446,470,471,475],{},[461,472,473],{},[308,474,352],{},[461,476,477,478],{},"自訂提示內容，同 Nuxt UI 的 ",[308,479,352],{},[333,481,482],{"id":482},"更新紀錄",[484,485],"component-changelog",{"name":314},{"title":487,"searchDepth":488,"depth":488,"links":489},"",2,[490,496,497,498],{"id":335,"depth":488,"text":335,"children":491},[492,494,495],{"id":339,"depth":493,"text":339},3,{"id":366,"depth":493,"text":366},{"id":413,"depth":493,"text":413},{"id":430,"depth":488,"text":431},{"id":437,"depth":488,"text":438},{"id":482,"depth":488,"text":482},"基於 UTooltip 的提示，補上觸控裝置長按顯示。","md",[502],{"label":310,"icon":503,"to":504,"target":505},"i-simple-icons-nuxtdotjs","https:\u002F\u002Fui.nuxt.com\u002Fdocs\u002Fcomponents\u002Ftooltip","_blank",{},{"title":218,"badge":221,"icon":222},{"title":218,"description":499},"JWDSlJpiiJnEO9Wi_u0vEvO_R10STSULu5G8oP_prVE",[511,513],{"title":212,"path":213,"stem":214,"description":512,"badge":215,"icon":216