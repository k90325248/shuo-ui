{},[284,847,335],{},[284,849,338],{},"）自行顯示載入圖示，固定使用 Nuxt UI 的 ",[284,852,853],{},"appConfig.ui.icons.loading","，因此也排除 ",[284,856,857],{},"loadingIcon","，寫了不會生效；",[284,860,320],{}," 由 ",[284,863,743],{}," 顯示載入圖示，",[284,866,857],{}," 照常可用。",[828,869,870,871,873,874,877,878,302],{},"事件照常經 ",[284,872,833],{}," 轉給底層元件，型別取自底層元件的 emits，例如 ",[284,875,876],{},"@blur"," 的參數為 ",[284,879,880],{},"FocusEvent",[828,882,883,884,287,887,890],{},"核取方塊與群組不支援說明文字（",[284,885,886],{},"description",[284,888,889],{},"descriptionKey","）：說明會撐高選項，破壞與輸入框對齊的高度。",[828,892,893,894,897,898,547,901,903,904,906,907,909],{},"核取方塊與群組也不支援 Nuxt UI 的 ",[284,895,896],{},"variant","（card、table）、",[284,899,900],{},"indicator",[284,902,438],{},"：card、table 的外框與內距會撐高選項；",[284,905,900],{}," 會移動勾選框，載入中的轉圈圖示固定在左側勾選框的位置；",[284,908,438],{}," 只改 card、table 的外框顏色。傳入時型別會報錯，執行時也不會套用。",[448,911,913],{"id":912},"slots","Slots",[280,915,916,917,287,920,923,924,926,927,929,930,287,933,936],{},"輸入框類元件可用 ",[284,918,919],{},"#leading",[284,921,922],{},"#trailing"," 在前後放圖示或按鈕；",[284,925,320],{}," 可用 ",[284,928,743],{}," 的全部 slot。核取方塊與群組則有元件自有的 ",[284,931,932],{},"#append",[284,934,935],{},"#item-append","，在選項文字旁放附加內容。",[304,938],{"name":939},"common-slots",[825,941,942,949],{},[828,943,944,359,946,948],{},[284,945,317],{},[284,947,922],{}," 和單位、載入圖示並排，不會互相取代。",[828,950,951,952,302],{},"各 slot 的參數見元件頁，例如",[367,953,955],{"href":954},"\u002Fcomponents\u002Fchoice\u002Fradio-group#%E9%81%B8%E9%A0%85%E9%99%84%E5%8A%A0%E5%85%A7%E5%AE%B9","選項附加內容",[448,957,617],{"id":958},"對外提供的-ref",[280,960,961],{},"以 template ref 取得元件後，可透過表格中的 ref 操作底層的原生元素，例如聚焦、全選或展開選單。",[304,963],{"name":964},"common-expose",[276,966,967],{"id":967},"骨架",[280,969,970,971,973],{},"骨架保留原控制項的排版空間，沿用 ",[284,972,352],{},"、寬度、textarea 行數及選項群組排列，不另設固定高度。啟用期間不可點擊或鍵盤操作，Tooltip 與已開啟的選單會關閉。",[280,975,976],{},"常見用法是編輯頁向後端取資料時，用同一個載入狀態控制所有欄位的骨架。按「重新載入資料」看看：骨架期間版面不變，資料回來後直接填入。",[304,978],{"name":979},"common-skeleton",[280,981,982,983,985,986,988,989,991],{},"和 ",[284,984,290],{}," 的差別：",[284,987,290],{}," 保留目前的值、在欄位內顯示轉圈圖示，適合欄位自己在處理（例如查詢下拉選項）；",[284,990,293],{}," 蓋住整個欄位，適合整頁資料還沒回來、目前的值沒有意義的時候。",[276,993,994],{"id":994},"多語系",[280,996,997,998,1001,1002,287,1005,1008,1009,302],{},"元件的文案（提示文字、無障礙名稱、驗證訊息、日期選擇器文字等）跟隨 Nuxt UI 的語系（",[284,999,1000],{},"\u003CUApp :locale>","），內建繁體中文與英文，切換時已顯示的元件立即更新；各頁提到的預設文字為繁體中文。明確傳入的文字 prop（例如 ",[284,1003,1004],{},"title",[284,1006,1007],{},"placeholder","）不受語系影響。設定與覆寫方式見",[367,1010,47],{"href":1011},"\u002Fgetting-started\u002Ftheme\u002Fmessages",[280,1013,1014],{},"文件網站右上角調色盤選單的「元件語系」可以切換頁面上元件範例的語系，預設跟隨文件語言。",[276,1016,1017],{"id":1017},"空值約定",[280,1019,1020,1021,1024,1025,1028,1029,287,1031,287,1033,287,1035,287,1037,287,1039,1041,1042,1045,1046,1049,1050,287,1052,1054],{},"父層綁定 ",[284,1022,1023],{},"null","／",[284,1026,1027],{},"undefined"," 時，下列元件會回寫約定空值；型別錯誤等非預期值也會清空為約定空值。掛載時與之後由父層回填皆適用。清空非預期值時，",[284,1030,314],{},[284,1032,335],{},[284,1034,317],{},[284,1036,332],{},[284,1038,344],{},[284,1040,323],{}," 會以 ",[284,1043,1044],{},"console.warn","（",[284,1047,1048],{},"[Shuo元件名] … 已清空","）留下紀錄；",[284,1051,320],{},[284,1053,341],{}," 只清空，不警告。",[598,1056,1057,1066],{},[601,1058,1059],{},[604,1060,1061,1063],{},[607,1062,77],{},[607,1064,1065],{},"空值",[619,1067,1068,1085,1103,1115],{},[604,1069,1070,1080],{},[624,1071,1072,287,1074,287,1076,287,1078],{},[284,1073,314],{},[284,1075,335],{},[284,1077,332],{},[284,1079,344],{},[624,1081,1082],{},[284,1083,1084],{},"''",[604,1086,1087,1091],{},[624,1088,1089],{},[284,1090,320],{},[624,1092,1093,1096,1097,1099,1100],{},[284,1094,1095],{},"emptyValue","（預設 ",[284,1098,1084],{},"）；多選 ",[284,1101,1102],{},"[]",[604,1104,1105,1111],{},[624,1106,1107,287,1109],{},[284,1108,317],{},[284,1110,341],{},[624,1112,1113],{},[284,1114,1023],{},[604,1116,1117,1121],{},[624,1118,1119],{},[284,1120,323],{},[624,1122,1123,1124,1126,1127],{},"單選 ",[284,1125,1084],{},"、範圍 ",[284,1128,1102],{},[280,1130,1131,1132,1134,1135,1137,1138,302],{},"按「套用後端回傳的 null」，模擬後端把每個欄位都回傳 ",[284,1133,1023],{},"，下方的綁定值會改成各元件約定的空值；",[284,1136,329],{}," 不回寫，維持 ",[284,1139,1023],{},[304,1141],{"name":1142},"common-empty-value",[280,1144,1145],{},"下列元件不回寫父層的值：",[825,1147,1148,1158,1167],{},[828,1149,1150,1152,1153,1155,1156,302],{},[284,1151,329],{},"：",[284,1154,1023],{}," 或非陣列值顯示為全部未勾選，勾選後回寫完整陣列；清空為 ",[284,1157,1102],{},[828,1159,1160,1162,1163,1166],{},[284,1161,326],{},"：綁定值不等於 ",[284,1164,1165],{},"trueValue"," 時顯示未勾選。",[828,1168,1169,1171,1172,302],{},[284,1170,338],{},"：清除後為 ",[284,1173,1023],{},[1175,1176,1177],"style",{},"html pre.shiki code .sHwdD, html code.shiki .sHwdD{--shiki-light:#90A4AE;--shiki-light-font-style:italic;--shiki-default:#546E7A;--shiki-default-font-style:italic;--shiki-dark:#676E95;--shiki-dark-font-style:italic}html pre.shiki code .sMK4o, html code.shiki .sMK4o{--shiki-light:#39ADB5;--shiki-default:#89DDFF;--shiki-dark:#89DDFF}html pre.shiki code .swJcz, html code.shiki .swJcz{--shiki-light:#E53935;--shiki-default:#F07178;--shiki-dark:#F07178}html pre.shiki code .spNyl, html code.shiki .spNyl{--shiki-light:#9C3EDA;--shiki-default:#C792EA;--shiki-dark:#C792EA}html pre.shiki code .sfazB, html code.shiki .sfazB{--shiki-light:#91B859;--shiki-default:#C3E88D;--shiki-dark:#C3E88D}html pre.shiki code .sTEyZ, html code.shiki .sTEyZ{--shiki-light:#90A4AE;--shiki-default:#EEFFFF;--shiki-dark:#BABED8}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shik