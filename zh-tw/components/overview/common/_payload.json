916,364],{},[331,918,385],{},[331,920,388],{},"）自行顯示載入圖示，固定使用 Nuxt UI 的 ",[331,923,924],{},"appConfig.ui.icons.loading","，因此也排除 ",[331,927,928],{},"loadingIcon","，寫了不會生效；",[331,931,367],{}," 由 ",[331,934,793],{}," 顯示載入圖示，",[331,937,928],{}," 照常可用。",[899,940,941,942,944,945,948,949,349],{},"事件照常經 ",[331,943,904],{}," 轉給底層元件，型別取自底層元件的 emits，例如 ",[331,946,947],{},"@blur"," 的參數為 ",[331,950,951],{},"FocusEvent",[899,953,954,955,958,959,961,962,965,966,968],{},"核取方塊、開關與群組支援說明文字（",[331,956,957],{},"description","，群組以選項的 ",[331,960,957],{}," 欄位或 ",[331,963,964],{},"descriptionKey"," 指定）：沒有說明時高度對齊同尺寸的輸入框；有說明時撐高，說明文字換行，第一行文字仍與沒有說明的欄位對齊。顯示文字（",[331,967,892],{},"）維持單行，超出時省略並以 Tooltip 顯示完整文字。",[899,970,971,972,975,976,597,979,981,982,984,985,987,988,990,991,334,994,473,997,999,1000,1004,1005,597,1007,1009],{},"核取方塊與複選群組不支援 Nuxt UI 的 ",[331,973,974],{},"variant","（card、table）、",[331,977,978],{},"indicator",[331,980,488],{},"：card、table 的外框與內距會撐高選項；",[331,983,978],{}," 會移動勾選框，載入中的轉圈圖示固定在左側勾選框的位置；",[331,986,488],{}," 只改 card、table 的外框顏色。傳入時型別會報錯，執行時也不會套用。單選群組支援 ",[331,989,974],{},"（",[331,992,993],{},"list",[331,995,996],{},"card",[331,998,978],{},"，見 ",[417,1001,1003],{"href":1002},"\u002Fcomponents\u002Fchoice\u002Fradio-group#%E5%8D%A1%E7%89%87%E5%A4%96%E8%A7%80","RadioGroup 的卡片外觀","；",[331,1006,648],{},[331,1008,488],{}," 同樣不支援。",[498,1011,1013],{"id":1012},"slots","Slots",[327,1015,1016,1017,334,1020,1023,1024,1026,1027,1029,1030,334,1033,1036],{},"輸入框類元件可用 ",[331,1018,1019],{},"#leading",[331,1021,1022],{},"#trailing"," 在前後放圖示或按鈕；",[331,1025,367],{}," 可用 ",[331,1028,793],{}," 的全部 slot。核取方塊與群組則有元件自有的 ",[331,1031,1032],{},"#append",[331,1034,1035],{},"#item-append","，在選項文字旁放附加內容。",[351,1038],{"name":1039},"common-slots",[896,1041,1042,1049],{},[899,1043,1044,409,1046,1048],{},[331,1045,364],{},[331,1047,1022],{}," 和單位、載入圖示並排，不會互相取代。",[899,1050,1051,1052,349],{},"各 slot 的參數見元件頁，例如",[417,1053,1055],{"href":1054},"\u002Fcomponents\u002Fchoice\u002Fradio-group#%E9%81%B8%E9%A0%85%E9%99%84%E5%8A%A0%E5%85%A7%E5%AE%B9","選項附加內容",[498,1057,667],{"id":1058},"對外提供的-ref",[327,1060,1061],{},"以 template ref 取得元件後，可透過表格中的 ref 操作底層的原生元素，例如聚焦、全選或展開選單。",[351,1063],{"name":1064},"common-expose",[323,1066,1067],{"id":1067},"骨架",[327,1069,1070,1071,1073],{},"骨架保留原控制項的排版空間，沿用 ",[331,1072,402],{},"、寬度、textarea 行數及選項群組排列，不另設固定高度。啟用期間不可點擊或鍵盤操作，Tooltip 與已開啟的選單會關閉。",[327,1075,1076],{},"常見用法是編輯頁向後端取資料時，用同一個載入狀態控制所有欄位的骨架。按「重新載入資料」看看：骨架期間版面不變，資料回來後直接填入。",[351,1078],{"name":1079},"common-skeleton",[327,1081,1082,1083,1085,1086,1088,1089,1091],{},"和 ",[331,1084,337],{}," 的差別：",[331,1087,337],{}," 保留目前的值、在欄位內顯示轉圈圖示，適合欄位自己在處理（例如查詢下拉選項）；",[331,1090,340],{}," 蓋住整個欄位，適合整頁資料還沒回來、目前的值沒有意義的時候。",[323,1093,1094],{"id":1094},"多語系",[327,1096,1097,1098,1101,1102,334,1105,1108,1109,349],{},"元件的文案（提示文字、無障礙名稱、驗證訊息、日期選擇器文字等）跟隨 Nuxt UI 的語系（",[331,1099,1100],{},"\u003CUApp :locale>","），內建繁體中文與英文，切換時已顯示的元件立即更新；各頁提到的預設文字為繁體中文。明確傳入的文字 prop（例如 ",[331,1103,1104],{},"title",[331,1106,1107],{},"placeholder","）不受語系影響。設定與覆寫方式見",[417,1110,47],{"href":1111},"\u002Fgetting-started\u002Ftheme\u002Fmessages",[327,1113,1114],{},"文件網站右上角調色盤選單的「元件語系」可以切換頁面上元件範例的語系，預設跟隨文件語言。",[323,1116,1117],{"id":1117},"空值約定",[327,1119,1120,1121,1124,1125,1128,1129,334,1131,334,1133,334,1135,334,1137,334,1139,1141,1142,990,1145,1148,1149,334,1151,1153],{},"父層綁定 ",[331,1122,1123],{},"null","／",[331,1126,1127],{},"undefined"," 時，下列元件會回寫約定空值；型別錯誤等非預期值也會清空為約定空值。掛載時與之後由父層回填皆適用。清空非預期值時，",[331,1130,361],{},[331,1132,385],{},[331,1134,364],{},[331,1136,379],{},[331,1138,394],{},[331,1140,370],{}," 會以 ",[331,1143,1144],{},"console.warn",[331,1146,1147],{},"[Shuo元件名] … 已清空","）留下紀錄；",[331,1150,367],{},[331,1152,391],{}," 只清空，不警告。",[648,1155,1156,1165],{},[651,1157,1158],{},[654,1159,1160,1162],{},[657,1161,92],{},[657,1163,1164],{},"空值",[669,1166,1167,1184,1202,1214],{},[654,1168,1169,1179],{},[674,1170,1171,334,1173,334,1175,334,1177],{},[331,1172,361],{},[331,1174,385],{},[331,1176,379],{},[331,1178,394],{},[674,1180,1181],{},[331,1182,1183],{},"''",[654,1185,1186,1190],{},[674,1187,1188],{},[331,1189,367],{},[674,1191,1192,1195,1196,1198,1199],{},[331,1193,1194],{},"emptyValue","（預設 ",[331,1197,1183],{},"）；多選 ",[331,1200,1201],{},"[]",[654,1203,1204,1210],{},[674,1205,1206,334,1208],{},[331,1207,364],{},[331,1209,391],{},[674,1211,1212],{},[331,1213,1123],{},[654,1215,1216,1220],{},[674,1217,1218],{},[331,1219,370],{},[674,1221,1222,1223,1225,1226],{},"單選 ",[331,1224,1183],{},"、範圍 ",[331,1227,1201],{},[327,1229,1230,1231,1233,1234,1236,1237,349],{},"按「套用後端回傳的 null」，模擬後端把每個欄位都回傳 ",[331,1232,1123],{},"，下方的綁定值會改成各元件約定的空值；",[331,1235,376],{}," 不回寫，維持 ",[331,1238,1123],{},[351,1240],{"name":1241},"common-empty-value",[327,1243,1244],{},"下列元件不回寫父層的值：",[896,1246,1247,1257,1266],{},[899,1248,1249,1251,1252,1254,1255,349],{},[331,1250,376],{},"：",[331,1253,1123],{}," 或非陣列值顯示為全部未勾選，勾選後回寫完整陣列；清空為 ",[331,1256,1201],{},[899,1258,1259,1261,1262,1265],{},[331,1260,373],{},"：綁定值不等於 ",[331,1263,1264],{},"trueValue"," 時顯示未勾選。",[899,1267,1268,1270,1271,349],{},[331,1269,388],{},"：清除後為 ",[331,1272,1123],{},[1274,1275,1276],"style",{},"html pre.shiki code .sHwdD, html code.shiki .sHwdD{--shiki-light:#90A4AE;--shiki-light-font-style:italic;--shiki-default:#546E7A;--shiki-default-font-style:italic;--shiki-dark:#676E95;--shiki-dark-font-style:italic}html pre.shiki code .sMK4o, html code.shiki .sMK4o{--shiki-light:#39ADB5;--shiki-default:#89DDFF;--shiki-dark:#89DDFF}html pre.shiki code .swJcz, html code.shiki .swJcz{--shiki-light:#E53935;--shiki-default:#F07178;--shiki-dark:#F07178}html pre.shiki code .spNyl, html code.shiki .spNyl{--shiki-light:#9C3EDA;--shiki-default:#C792EA;--shiki-dark:#C792EA}html pre.shiki code .sfazB, html code.shiki .sfazB{--shiki-light:#91B859;--shiki-default:#C3E88D;--shiki-dark:#C3E88D}html pre.shiki code .sTEyZ, html code.shiki .sTEyZ{--shiki-light:#90A4AE;--shiki-default:#EEFFFF;--shiki-dark:#BABED8}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);fon