914,947,960,977],"ul",{},[907,908,909,910,913],"li",{},"繼承的 props 只用於型別推導，執行時經 ",[339,911,912],{},"$attrs"," 傳給底層元件。",[907,915,916,917,920,921,342,923,342,925,342,927,929,930,933,934,937,938,940,941,943,944,946],{},"元件自行處理的 props 不列入繼承，不會出現在自動補全，例如 ",[339,918,919],{},"modelValue","。輸入框類元件（",[339,922,369],{},[339,924,372],{},[339,926,393],{},[339,928,396],{},"）自行顯示載入圖示，固定使用 Nuxt UI 的 ",[339,931,932],{},"appConfig.ui.icons.loading","，因此也排除 ",[339,935,936],{},"loadingIcon","，寫了不會生效；",[339,939,375],{}," 由 ",[339,942,801],{}," 顯示載入圖示，",[339,945,936],{}," 照常可用。",[907,948,949,950,952,953,956,957,357],{},"事件照常經 ",[339,951,912],{}," 轉給底層元件，型別取自底層元件的 emits，例如 ",[339,954,955],{},"@blur"," 的參數為 ",[339,958,959],{},"FocusEvent",[907,961,962,963,966,967,969,970,973,974,976],{},"核取方塊、開關與群組支援說明文字（",[339,964,965],{},"description","，群組以選項的 ",[339,968,965],{}," 欄位或 ",[339,971,972],{},"descriptionKey"," 指定）：沒有說明時高度對齊同尺寸的輸入框；有說明時撐高，說明文字換行，第一行文字仍與沒有說明的欄位對齊。顯示文字（",[339,975,900],{},"）維持單行，超出時省略並以 Tooltip 顯示完整文字。",[907,978,979,980,983,984,605,987,989,990,992,993,995,996,998,999,342,1002,481,1005,1007,1008,1012,1013,605,1015,1017],{},"核取方塊與複選群組不支援 Nuxt UI 的 ",[339,981,982],{},"variant","（card、table）、",[339,985,986],{},"indicator",[339,988,496],{},"：card、table 的外框與內距會撐高選項；",[339,991,986],{}," 會移動勾選框，載入中的轉圈圖示固定在左側勾選框的位置；",[339,994,496],{}," 只改 card、table 的外框顏色。傳入時型別會報錯，執行時也不會套用。單選群組支援 ",[339,997,982],{},"（",[339,1000,1001],{},"list",[339,1003,1004],{},"card",[339,1006,986],{},"，見 ",[425,1009,1011],{"href":1010},"\u002Fcomponents\u002Fchoice\u002Fradio-group#%E5%8D%A1%E7%89%87%E5%A4%96%E8%A7%80","RadioGroup 的卡片外觀","；",[339,1014,656],{},[339,1016,496],{}," 同樣不支援。",[506,1019,1021],{"id":1020},"slots","Slots",[335,1023,1024,1025,342,1028,1031,1032,1034,1035,1037,1038,342,1041,1044],{},"輸入框類元件可用 ",[339,1026,1027],{},"#leading",[339,1029,1030],{},"#trailing"," 在前後放圖示或按鈕；",[339,1033,375],{}," 可用 ",[339,1036,801],{}," 的全部 slot。核取方塊與群組則有元件自有的 ",[339,1039,1040],{},"#append",[339,1042,1043],{},"#item-append","，在選項文字旁放附加內容。",[359,1046],{"name":1047},"common-slots",[904,1049,1050,1057],{},[907,1051,1052,417,1054,1056],{},[339,1053,372],{},[339,1055,1030],{}," 和單位、載入圖示並排，不會互相取代。",[907,1058,1059,1060,357],{},"各 slot 的參數見元件頁，例如",[425,1061,1063],{"href":1062},"\u002Fcomponents\u002Fchoice\u002Fradio-group#%E9%81%B8%E9%A0%85%E9%99%84%E5%8A%A0%E5%85%A7%E5%AE%B9","選項附加內容",[506,1065,675],{"id":1066},"對外提供的-ref",[335,1068,1069],{},"以 template ref 取得元件後，可透過表格中的 ref 操作底層的原生元素，例如聚焦、全選或展開選單。",[359,1071],{"name":1072},"common-expose",[331,1074,1075],{"id":1075},"骨架",[335,1077,1078,1079,1081],{},"骨架保留原控制項的排版空間，沿用 ",[339,1080,410],{},"、寬度、textarea 行數及選項群組排列，不另設固定高度。啟用期間不可點擊或鍵盤操作，Tooltip 與已開啟的選單會關閉。",[335,1083,1084],{},"常見用法是編輯頁向後端取資料時，用同一個載入狀態控制所有欄位的骨架。按「重新載入資料」看看：骨架期間版面不變，資料回來後直接填入。",[359,1086],{"name":1087},"common-skeleton",[335,1089,1090,1091,1093,1094,1096,1097,1099],{},"和 ",[339,1092,345],{}," 的差別：",[339,1095,345],{}," 保留目前的值、在欄位內顯示轉圈圖示，適合欄位自己在處理（例如查詢下拉選項）；",[339,1098,348],{}," 蓋住整個欄位，適合整頁資料還沒回來、目前的值沒有意義的時候。",[331,1101,1102],{"id":1102},"多語系",[335,1104,1105,1106,1109,1110,342,1113,1116,1117,357],{},"元件的文案（提示文字、無障礙名稱、驗證訊息、日期選擇器文字等）跟隨 Nuxt UI 的語系（",[339,1107,1108],{},"\u003CUApp :locale>","），內建繁體中文與英文，切換時已顯示的元件立即更新；各頁提到的預設文字為繁體中文。明確傳入的文字 prop（例如 ",[339,1111,1112],{},"title",[339,1114,1115],{},"placeholder","）不受語系影響。設定與覆寫方式見",[425,1118,47],{"href":1119},"\u002Fgetting-started\u002Ftheme\u002Fmessages",[335,1121,1122],{},"文件網站右上角調色盤選單的「元件語系」可以切換頁面上元件範例的語系，預設跟隨文件語言。",[331,1124,1125],{"id":1125},"空值約定",[335,1127,1128,1129,1132,1133,1136,1137,342,1139,342,1141,342,1143,342,1145,342,1147,1149,1150,998,1153,1156,1157,342,1159,1161],{},"父層綁定 ",[339,1130,1131],{},"null","／",[339,1134,1135],{},"undefined"," 時，下列元件會回寫約定空值；型別錯誤等非預期值也會清空為約定空值。掛載時與之後由父層回填皆適用。清空非預期值時，",[339,1138,369],{},[339,1140,393],{},[339,1142,372],{},[339,1144,387],{},[339,1146,402],{},[339,1148,378],{}," 會以 ",[339,1151,1152],{},"console.warn",[339,1154,1155],{},"[Shuo元件名] … 已清空","）留下紀錄；",[339,1158,375],{},[339,1160,399],{}," 只清空，不警告。",[656,1163,1164,1173],{},[659,1165,1166],{},[662,1167,1168,1170],{},[665,1169,92],{},[665,1171,1172],{},"空值",[677,1174,1175,1192,1210,1222],{},[662,1176,1177,1187],{},[682,1178,1179,342,1181,342,1183,342,1185],{},[339,1180,369],{},[339,1182,393],{},[339,1184,387],{},[339,1186,402],{},[682,1188,1189],{},[339,1190,1191],{},"''",[662,1193,1194,1198],{},[682,1195,1196],{},[339,1197,375],{},[682,1199,1200,1203,1204,1206,1207],{},[339,1201,1202],{},"emptyValue","（預設 ",[339,1205,1191],{},"）；多選 ",[339,1208,1209],{},"[]",[662,1211,1212,1218],{},[682,1213,1214,342,1216],{},[339,1215,372],{},[339,1217,399],{},[682,1219,1220],{},[339,1221,1131],{},[662,1223,1224,1228],{},[682,1225,1226],{},[339,1227,378],{},[682,1229,1230,1231,1233,1234],{},"單選 ",[339,1232,1191],{},"、範圍 ",[339,1235,1209],{},[335,1237,1238,1239,1241,1242,1244,1245,357],{},"按「套用後端回傳的 null」，模擬後端把每個欄位都回傳 ",[339,1240,1131],{},"，下方的綁定值會改成各元件約定的空值；",[339,1243,384],{}," 不回寫，維持 ",[339,1246,1131],{},[359,1248],{"name":1249},"common-empty-value",[335,1251,1252],{},"下列元件不回寫父層的值：",[904,1254,1255,1265,1274],{},[907,1256,1257,1259,1260,1262,1263,357],{},[339,1258,384],{},"：",[339,1261,1131],{}," 或非陣列值顯示為全部未勾選，勾選後回寫完整陣列；清空為 ",[339,1264,1209],{},[907,1266,1267,1269,1270,1273],{},[339,1268,381],{},"：綁定值不等於 ",[339,1271,1272],{},"trueValue"," 時顯示未勾選。",[907,1275,1276,1278,1279,357],{},[339,1277,396],{},"：清除後為 ",[339,1280,1131],{},[1282,1283,1284],"style",{},"html pre.shiki code .sHwdD, html code.shiki .sHwdD{--shiki-light:#90A4AE;--shiki-light-font-style:italic;--shiki-default:#546E7A;--shiki-default-font-style:italic;--shiki-dark:#676E95;--shiki-dark-font-style:italic}html pre.shiki code .sMK4o, html code.shiki .sMK4o{--shiki-light:#39ADB5;--shiki-default:#89DDFF;--shiki-dark:#89DDFF}html pre.shiki code .swJcz, html code.shiki .swJcz{--shiki-light:#E53935;--shiki-default:#F07178;--shiki-dark:#F07178}html pre.shiki code .spNyl, html code.shiki .spNyl{--shiki-light:#9C3EDA;--shiki-default:#C792EA;--shiki-dark:#C792EA}ht