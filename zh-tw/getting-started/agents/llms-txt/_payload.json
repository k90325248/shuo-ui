":575},"docs_zh_tw\u002Fzh-tw\u002F1.getting-started\u002F5.agents\u002F1.llms-txt.md",{"type":332,"value":333,"toc":553},"minimark",[334,339,343,346,378,381,384,396,400,407,427,430,433,447,451,456,459,463,479,489,493,496,500,510,517,521,524,528,543,546],[335,336,338],"h2",{"id":337},"什麼是-llmstxt","什麼是 LLMs.txt？",[340,341,342],"p",{},"LLMs.txt 是專為大型語言模型（LLM）設計的文件格式。Shuo UI 的文件網站提供 LLMs.txt 檔案，整理元件庫的元件、props、工具函式與使用方式，讓 AI 工具能據此協助開發。",[335,344,345],{"id":345},"可用的路徑",[347,348,349,366],"ul",{},[350,351,352,365],"li",{},[353,354,355],"strong",{},[356,357,361],"a",{"href":358,"rel":359},"https:\u002F\u002Fk90325248.github.io\u002Fshuo-ui\u002Fllms.txt",[360],"nofollow",[362,363,364],"code",{},"\u002Fllms.txt","：所有頁面的索引，每頁附上標題、說明與 markdown 連結（約 4K tokens）",[350,367,368,377],{},[353,369,370],{},[356,371,374],{"href":372,"rel":373},"https:\u002F\u002Fk90325248.github.io\u002Fshuo-ui\u002Fllms-full.txt",[360],[362,375,376],{},"\u002Fllms-full.txt","：完整文件合併成單一檔案，包含元件範例、props、工具函式與版本紀錄（超過 10 萬 tokens）",[340,379,380],{},"兩個檔案都同時收錄繁體中文與英文的頁面。",[335,382,383],{"id":383},"選擇合適的檔案",[385,386,387,392,393,395],"note",{},[353,388,389,390],{},"大多數情況請先用 ",[362,391,364],{},"，它包含所有頁面的連結，一般的 context window 就放得下，AI 工具可以再依需要讀取個別頁面。只有在需要完整範例、且 AI 工具支援大型 context（200K tokens 以上）時才使用 ",[362,394,376],{},"。",[335,397,399],{"id":398},"單一頁面的-markdown-版本","單一頁面的 markdown 版本",[340,401,402,403,406],{},"每個頁面都有 markdown 版本，在網址後面加上 ",[362,404,405],{},".md"," 即可，例如：",[347,408,409,418],{},[350,410,411],{},[356,412,415],{"href":413,"rel":414},"https:\u002F\u002Fk90325248.github.io\u002Fshuo-ui\u002Fzh-tw\u002Fgetting-started\u002Foverview\u002Finstallation.md",[360],[362,416,417],{},"\u002Fzh-tw\u002Fgetting-started\u002Foverview\u002Finstallation.md",[350,419,420],{},[356,421,424],{"href":422,"rel":423},"https:\u002F\u002Fk90325248.github.io\u002Fshuo-ui\u002Fen\u002Fcomponents\u002Ftext\u002Finput-text.md",[360],[362,425,426],{},"\u002Fen\u002Fcomponents\u002Ftext\u002Finput-text.md",[340,428,429],{},"只需要某個元件的說明時，直接提供該頁的 markdown 比整份文件更省 tokens。",[335,431,432],{"id":432},"使用注意事項",[434,435,436,439,440,443,444,446],"warning",{},[353,437,438],{},"@ 符號必須手動輸入","：在 Cursor 或 Windsurf 的對話框中，",[362,441,442],{},"@"," 符號要親手輸入，貼上的 ",[362,445,442],{}," 不會被辨識為 context 引用。",[335,448,450],{"id":449},"搭配-ai-工具使用","搭配 AI 工具使用",[452,453,455],"h3",{"id":454},"cursor","Cursor",[340,457,458],{},"在 Cursor 中引用 LLMs.txt，讓 AI 更準確地協助撰寫 Shuo UI 表單。",[460,461,462],"h4",{"id":462},"使用方式",[464,465,466,472],"ol",{},[350,467,468,471],{},[353,469,470],{},"直接引用","：提問時附上 LLMs.txt 的網址",[350,473,474,475,478],{},"使用 ",[362,476,477],{},"@docs"," 將網址加入專案的 context",[340,480,481],{},[356,482,485,486,488],{"href":483,"rel":484},"https:\u002F\u002Fcursor.com\u002Fdocs\u002Fagent\u002Fprompting",[360],"進一步了解 Cursor 的提示與 ",[362,487,442],{}," 引用",[452,490,492],{"id":491},"windsurf","Windsurf",[340,494,495],{},"Windsurf 可以直接讀取 Shuo UI 的 LLMs.txt，了解元件用法與慣例。",[460,497,499],{"id":498},"在-windsurf-中使用","在 Windsurf 中使用",[347,501,502,507],{},[350,503,474,504,506],{},[362,505,477],{}," 引用 LLMs.txt 的網址",[350,508,509],{},"在 workspace 建立固定規則，引用這些網址",[340,511,512],{},[356,513,516],{"href":514,"rel":515},"https:\u002F\u002Fdocs.windsurf.com\u002Fwindsurf\u002Fcascade\u002Fweb-search",[360],"進一步了解 Windsurf 的網頁與文件搜尋",[452,518,520],{"id":519},"其他-ai-工具","其他 AI 工具",[340,522,523],{},"任何支援 LLMs.txt 的 AI 工具都可以透過這些路徑理解 Shuo UI。",[460,525,527],{"id":526},"chatgptclaude-等-llm-的提示範例","ChatGPT、Claude 等 LLM 的提示範例",[347,529,530,537],{},[350,531,532,533,536],{},"「請參考 Shuo UI 文件：",[356,534,358],{"href":358,"rel":535},[360],"」",[350,538,539,540,536],{},"「請依照 Shuo UI 完整文件撰寫：",[356,541,372],{"href":372,"rel":542},[360],[335,544,545],{"id":545},"網站地圖",[340,547,548,549,395],{},"所有頁面的清單見",[356,550,545],{"href":551,"rel":552},"https:\u002F\u002Fk90325248.github.io\u002Fshuo-ui\u002Fsitemap.md",[360],{"title":554,"searchDepth":555,"depth":555,"links":556},"",2,[557,558,559,560,561,562,568],{"id":337,"depth":555,"text":338},{"id":345,"depth":555,"text"