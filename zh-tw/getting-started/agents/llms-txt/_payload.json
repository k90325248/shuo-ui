,380,392,396,403,423,426,429,443,447,452,455,459,475,485,489,492,496,506,513,517,520,524,539,542],[331,332,334],"h2",{"id":333},"什麼是-llmstxt","什麼是 LLMs.txt？",[336,337,338],"p",{},"LLMs.txt 是專為大型語言模型（LLM）設計的文件格式。Shuo UI 的文件網站提供 LLMs.txt 檔案，整理元件庫的元件、props、工具函式與使用方式，讓 AI 工具能據此協助開發。",[331,340,341],{"id":341},"可用的路徑",[343,344,345,362],"ul",{},[346,347,348,361],"li",{},[349,350,351],"strong",{},[352,353,357],"a",{"href":354,"rel":355},"https:\u002F\u002Fk90325248.github.io\u002Fshuo-ui\u002Fllms.txt",[356],"nofollow",[358,359,360],"code",{},"\u002Fllms.txt","：所有頁面的索引，每頁附上標題、說明與 markdown 連結（約 4K tokens）",[346,363,364,373],{},[349,365,366],{},[352,367,370],{"href":368,"rel":369},"https:\u002F\u002Fk90325248.github.io\u002Fshuo-ui\u002Fllms-full.txt",[356],[358,371,372],{},"\u002Fllms-full.txt","：完整文件合併成單一檔案，包含元件範例、props、工具函式與版本紀錄（超過 10 萬 tokens）",[336,375,376],{},"兩個檔案都同時收錄繁體中文與英文的頁面。",[331,378,379],{"id":379},"選擇合適的檔案",[381,382,383,388,389,391],"note",{},[349,384,385,386],{},"大多數情況請先用 ",[358,387,360],{},"，它包含所有頁面的連結，一般的 context window 就放得下，AI 工具可以再依需要讀取個別頁面。只有在需要完整範例、且 AI 工具支援大型 context（200K tokens 以上）時才使用 ",[358,390,372],{},"。",[331,393,395],{"id":394},"單一頁面的-markdown-版本","單一頁面的 markdown 版本",[336,397,398,399,402],{},"每個頁面都有 markdown 版本，在網址後面加上 ",[358,400,401],{},".md"," 即可，例如：",[343,404,405,414],{},[346,406,407],{},[352,408,411],{"href":409,"rel":410},"https:\u002F\u002Fk90325248.github.io\u002Fshuo-ui\u002Fzh-tw\u002Fgetting-started\u002Foverview\u002Finstallation.md",[356],[358,412,413],{},"\u002Fzh-tw\u002Fgetting-started\u002Foverview\u002Finstallation.md",[346,415,416],{},[352,417,420],{"href":418,"rel":419},"https:\u002F\u002Fk90325248.github.io\u002Fshuo-ui\u002Fen\u002Fcomponents\u002Ftext\u002Finput-text.md",[356],[358,421,422],{},"\u002Fen\u002Fcomponents\u002Ftext\u002Finput-text.md",[336,424,425],{},"只需要某個元件的說明時，直接提供該頁的 markdown 比整份文件更省 tokens。",[331,427,428],{"id":428},"使用注意事項",[430,431,432,435,436,439,440,442],"warning",{},[349,433,434],{},"@ 符號必須手動輸入","：在 Cursor 或 Windsurf 的對話框中，",[358,437,438],{},"@"," 符號要親手輸入，貼上的 ",[358,441,438],{}," 不會被辨識為 context 引用。",[331,444,446],{"id":445},"搭配-ai-工具使用","搭配 AI 工具使用",[448,449,451],"h3",{"id":450},"cursor","Cursor",[336,453,454],{},"在 Cursor 中引用 LLMs.txt，讓 AI 更準確地協助撰寫 Shuo UI 表單。",[456,457,458],"h4",{"id":458},"使用方式",[460,461,462,468],"ol",{},[346,463,464,467],{},[349,465,466],{},"直接引用","：提問時附上 LLMs.txt 的網址",[346,469,470,471,474],{},"使用 ",[358,472,473],{},"@docs"," 將網址加入專案的 context",[336,476,477],{},[352,478,481,482,484],{"href":479,"rel":480},"https:\u002F\u002Fcursor.com\u002Fdocs\u002Fagent\u002Fprompting",[356],"進一步了解 Cursor 的提示與 ",[358,483,438],{}," 引用",[448,486,488],{"id":487},"windsurf","Windsurf",[336,490,491],{},"Windsurf 可以直接讀取 Shuo UI 的 LLMs.txt，了解元件用法與慣例。",[456,493,495],{"id":494},"在-windsurf-中使用","在 Windsurf 中使用",[343,497,498,503],{},[346,499,470,500,502],{},[358,501,473],{}," 引用 LLMs.txt 的網址",[346,504,505],{},"在 workspace 建立固定規則，引用這些網址",[336,507,508],{},[352,509,512],{"href":510,"rel":511},"https:\u002F\u002Fdocs.windsurf.com\u002Fwindsurf\u002Fcascade\u002Fweb-search",[356],"進一步了解 Windsurf 的網頁與文件搜尋",[448,514,516],{"id":515},"其他-ai-工具","其他 AI 工具",[336,518,519],{},"任何支援 LLMs.txt 的 AI 工具都可以透過這些路徑理解 Shuo UI。",[456,521,523],{"id":522},"chatgptclaude-等-llm-的提示範例","ChatGPT、Claude 等 LLM 的提示範例",[343,525,526,533],{},[346,527,528,529,532],{},"「請參考 Shuo UI 文件：",[352,530,354],{"href":354,"rel":531},[356],"」",[346,534,535,536,532],{},"「請依照 Shuo UI 完整文件撰寫：",[352,537,368],{"href":368,"rel":538},[356],[331,540,541],{"id":541},"網站地圖",[336,543,544,545,391],{},"所有頁面的清單見",[352,546,541],{"href":547,"rel":548},"https:\u002F\u002Fk90325248.github.io\u002Fshuo-ui\u002Fsitemap.md",[356],{"title":550,"searchDepth":551,"depth":551,"links":552},"",2,[553,554,555,556,557,558,564],{"id":333,"depth":551,"text":334},{"id":341,"depth":551,"text":341},{"id":379,"depth":551,"text":379},{"id":394,"depth":551,"text":395},{"id":428,"depth":551,"text":428},{"id":445,"depth":551,"text":446,"children":559},