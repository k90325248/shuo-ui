\u002Fshuo-ui\u002Fllms.txt",[344],"nofollow",[346,347,348],"code",{},"\u002Fllms.txt","：所有頁面的索引，每頁附上標題、說明與 markdown 連結（約 4K tokens）",[334,351,352,361],{},[337,353,354],{},[340,355,358],{"href":356,"rel":357},"https:\u002F\u002Fk90325248.github.io\u002Fshuo-ui\u002Fllms-full.txt",[344],[346,359,360],{},"\u002Fllms-full.txt","：完整文件合併成單一檔案，包含元件範例、props、工具函式與版本紀錄（超過 10 萬 tokens）",[324,363,364],{},"兩個檔案都同時收錄繁體中文與英文的頁面。",[319,366,367],{"id":367},"選擇合適的檔案",[369,370,371,376,377,379],"note",{},[337,372,373,374],{},"大多數情況請先用 ",[346,375,348],{},"，它包含所有頁面的連結，一般的 context window 就放得下，AI 工具可以再依需要讀取個別頁面。只有在需要完整範例、且 AI 工具支援大型 context（200K tokens 以上）時才使用 ",[346,378,360],{},"。",[319,381,383],{"id":382},"單一頁面的-markdown-版本","單一頁面的 markdown 版本",[324,385,386,387,390],{},"每個頁面都有 markdown 版本，在網址後面加上 ",[346,388,389],{},".md"," 即可，例如：",[331,392,393,402],{},[334,394,395],{},[340,396,399],{"href":397,"rel":398},"https:\u002F\u002Fk90325248.github.io\u002Fshuo-ui\u002Fzh-tw\u002Fgetting-started\u002Foverview\u002Finstallation.md",[344],[346,400,401],{},"\u002Fzh-tw\u002Fgetting-started\u002Foverview\u002Finstallation.md",[334,403,404],{},[340,405,408],{"href":406,"rel":407},"https:\u002F\u002Fk90325248.github.io\u002Fshuo-ui\u002Fen\u002Fcomponents\u002Ftext\u002Finput-text.md",[344],[346,409,410],{},"\u002Fen\u002Fcomponents\u002Ftext\u002Finput-text.md",[324,412,413],{},"只需要某個元件的說明時，直接提供該頁的 markdown 比整份文件更省 tokens。",[319,415,416],{"id":416},"使用注意事項",[418,419,420,423,424,427,428,430],"warning",{},[337,421,422],{},"@ 符號必須手動輸入","：在 Cursor 或 Windsurf 的對話框中，",[346,425,426],{},"@"," 符號要親手輸入，貼上的 ",[346,429,426],{}," 不會被辨識為 context 引用。",[319,432,434],{"id":433},"搭配-ai-工具使用","搭配 AI 工具使用",[436,437,439],"h3",{"id":438},"cursor","Cursor",[324,441,442],{},"在 Cursor 中引用 LLMs.txt，讓 AI 更準確地協助撰寫 Shuo UI 表單。",[444,445,446],"h4",{"id":446},"使用方式",[448,449,450,456],"ol",{},[334,451,452,455],{},[337,453,454],{},"直接引用","：提問時附上 LLMs.txt 的網址",[334,457,458,459,462],{},"使用 ",[346,460,461],{},"@docs"," 將網址加入專案的 context",[324,464,465],{},[340,466,469,470,472],{"href":467,"rel":468},"https:\u002F\u002Fcursor.com\u002Fdocs\u002Fagent\u002Fprompting",[344],"進一步了解 Cursor 的提示與 ",[346,471,426],{}," 引用",[436,474,476],{"id":475},"windsurf","Windsurf",[324,478,479],{},"Windsurf 可以直接讀取 Shuo UI 的 LLMs.txt，了解元件用法與慣例。",[444,481,483],{"id":482},"在-windsurf-中使用","在 Windsurf 中使用",[331,485,486,491],{},[334,487,458,488,490],{},[346,489,461],{}," 引用 LLMs.txt 的網址",[334,492,493],{},"在 workspace 建立固定規則，引用這些網址",[324,495,496],{},[340,497,500],{"href":498,"rel":499},"https:\u002F\u002Fdocs.windsurf.com\u002Fwindsurf\u002Fcascade\u002Fweb-search",[344],"進一步了解 Windsurf 的網頁與文件搜尋",[436,502,504],{"id":503},"其他-ai-工具","其他 AI 工具",[324,506,507],{},"任何支援 LLMs.txt 的 AI 工具都可以透過這些路徑理解 Shuo UI。",[444,509,511],{"id":510},"chatgptclaude-等-llm-的提示範例","ChatGPT、Claude 等 LLM 的提示範例",[331,513,514,521],{},[334,515,516,517,520],{},"「請參考 Shuo UI 文件：",[340,518,342],{"href":342,"rel":519},[344],"」",[334,522,523,524,520],{},"「請依照 Shuo UI 完整文件撰寫：",[340,525,356],{"href":356,"rel":526},[344],[319,528,529],{"id":529},"網站地圖",[324,531,532,533,379],{},"所有頁面的清單見",[340,534,529],{"href":535,"rel":536},"https:\u002F\u002Fk90325248.github.io\u002Fshuo-ui\u002Fsitemap.md",[344],{"title":538,"searchDepth":539,"depth":539,"links":540},"",2,[541,542,543,544,545,546,552],{"id":321,"depth":539,"text":322},{"id":329,"depth":539,"text":329},{"id":367,"depth":539,"text":367},{"id":382,"depth":539,"text":383},{"id":416,"depth":539,"text":416},{"id":433,"depth":539,"text":434,"children":547},[548,550,551],{"id":438,"depth":549,"text":439},3,{"id":475,"depth":549,"text":476},{"id":503,"depth":549,"text":504},{"id":529,"depth":539,"text":529},"讓 Cursor、Windsurf、GitHub Copilot、ChatGPT、Claude 等 AI 工具理解 Shuo UI 的元件、設定與寫法。","md",null,{},{"icon":85},{"title":82,"description":553},"ZEd09i6iHVXnYO6yxUsXiExXuqmje8vBXs-2HwEJ_4U",[561,563],{"title":72,"path":73,"stem":74,"description":562,"icon":75,"children":-1},"自動匯入的元件與工具函式、型別別名，以及與 Nuxt UI 搭配的注意事項。",{"title":87,