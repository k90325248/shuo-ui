[335,336,337,354],"ul",{},[338,339,340,353],"li",{},[341,342,343],"strong",{},[344,345,349],"a",{"href":346,"rel":347},"https:\u002F\u002Fk90325248.github.io\u002Fshuo-ui\u002Fllms.txt",[348],"nofollow",[350,351,352],"code",{},"\u002Fllms.txt","：所有頁面的索引，每頁附上標題、說明與 markdown 連結（約 4K tokens）",[338,355,356,365],{},[341,357,358],{},[344,359,362],{"href":360,"rel":361},"https:\u002F\u002Fk90325248.github.io\u002Fshuo-ui\u002Fllms-full.txt",[348],[350,363,364],{},"\u002Fllms-full.txt","：完整文件合併成單一檔案，包含元件範例、props、工具函式與版本紀錄（超過 10 萬 tokens）",[328,367,368],{},"兩個檔案都同時收錄繁體中文與英文的頁面。",[323,370,371],{"id":371},"選擇合適的檔案",[373,374,375,380,381,383],"note",{},[341,376,377,378],{},"大多數情況請先用 ",[350,379,352],{},"，它包含所有頁面的連結，一般的 context window 就放得下，AI 工具可以再依需要讀取個別頁面。只有在需要完整範例、且 AI 工具支援大型 context（200K tokens 以上）時才使用 ",[350,382,364],{},"。",[323,385,387],{"id":386},"單一頁面的-markdown-版本","單一頁面的 markdown 版本",[328,389,390,391,394],{},"每個頁面都有 markdown 版本，在網址後面加上 ",[350,392,393],{},".md"," 即可，例如：",[335,396,397,406],{},[338,398,399],{},[344,400,403],{"href":401,"rel":402},"https:\u002F\u002Fk90325248.github.io\u002Fshuo-ui\u002Fzh-tw\u002Fgetting-started\u002Foverview\u002Finstallation.md",[348],[350,404,405],{},"\u002Fzh-tw\u002Fgetting-started\u002Foverview\u002Finstallation.md",[338,407,408],{},[344,409,412],{"href":410,"rel":411},"https:\u002F\u002Fk90325248.github.io\u002Fshuo-ui\u002Fen\u002Fcomponents\u002Ftext\u002Finput-text.md",[348],[350,413,414],{},"\u002Fen\u002Fcomponents\u002Ftext\u002Finput-text.md",[328,416,417],{},"只需要某個元件的說明時，直接提供該頁的 markdown 比整份文件更省 tokens。",[323,419,420],{"id":420},"使用注意事項",[422,423,424,427,428,431,432,434],"warning",{},[341,425,426],{},"@ 符號必須手動輸入","：在 Cursor 或 Windsurf 的對話框中，",[350,429,430],{},"@"," 符號要親手輸入，貼上的 ",[350,433,430],{}," 不會被辨識為 context 引用。",[323,436,438],{"id":437},"搭配-ai-工具使用","搭配 AI 工具使用",[440,441,443],"h3",{"id":442},"cursor","Cursor",[328,445,446],{},"在 Cursor 中引用 LLMs.txt，讓 AI 更準確地協助撰寫 Shuo UI 表單。",[448,449,450],"h4",{"id":450},"使用方式",[452,453,454,460],"ol",{},[338,455,456,459],{},[341,457,458],{},"直接引用","：提問時附上 LLMs.txt 的網址",[338,461,462,463,466],{},"使用 ",[350,464,465],{},"@docs"," 將網址加入專案的 context",[328,468,469],{},[344,470,473,474,476],{"href":471,"rel":472},"https:\u002F\u002Fcursor.com\u002Fdocs\u002Fagent\u002Fprompting",[348],"進一步了解 Cursor 的提示與 ",[350,475,430],{}," 引用",[440,478,480],{"id":479},"windsurf","Windsurf",[328,482,483],{},"Windsurf 可以直接讀取 Shuo UI 的 LLMs.txt，了解元件用法與慣例。",[448,485,487],{"id":486},"在-windsurf-中使用","在 Windsurf 中使用",[335,489,490,495],{},[338,491,462,492,494],{},[350,493,465],{}," 引用 LLMs.txt 的網址",[338,496,497],{},"在 workspace 建立固定規則，引用這些網址",[328,499,500],{},[344,501,504],{"href":502,"rel":503},"https:\u002F\u002Fdocs.windsurf.com\u002Fwindsurf\u002Fcascade\u002Fweb-search",[348],"進一步了解 Windsurf 的網頁與文件搜尋",[440,506,508],{"id":507},"其他-ai-工具","其他 AI 工具",[328,510,511],{},"任何支援 LLMs.txt 的 AI 工具都可以透過這些路徑理解 Shuo UI。",[448,513,515],{"id":514},"chatgptclaude-等-llm-的提示範例","ChatGPT、Claude 等 LLM 的提示範例",[335,517,518,525],{},[338,519,520,521,524],{},"「請參考 Shuo UI 文件：",[344,522,346],{"href":346,"rel":523},[348],"」",[338,526,527,528,524],{},"「請依照 Shuo UI 完整文件撰寫：",[344,529,360],{"href":360,"rel":530},[348],[323,532,533],{"id":533},"網站地圖",[328,535,536,537,383],{},"所有頁面的清單見",[344,538,533],{"href":539,"rel":540},"https:\u002F\u002Fk90325248.github.io\u002Fshuo-ui\u002Fsitemap.md",[348],{"title":542,"searchDepth":543,"depth":543,"links":544},"",2,[545,546,547,548,549,550,556],{"id":325,"depth":543,"text":326},{"id":333,"depth":543,"text":333},{"id":371,"depth":543,"text":371},{"id":386,"depth":543,"text":387},{"id":420,"depth":543,"text":420},{"id":437,"depth":543,"text":438,"children":551},[552,554,555],{"id":442,"depth":553,"text":443},3,{"id":479,"depth":553,"text":480},{"id":507,"depth":553,"text":508},{"id":533,"depth":543,"text":533},"讓 Cursor、Windsurf、GitHub Copilot、ChatGPT、Claude 等 AI 工具理解 Shuo UI 的元件、設定與寫法。","md",null,{},{"icon":85},{"title":82,"description":557},"ZEd09i6iHVXnYO6yxUsXiExXuq