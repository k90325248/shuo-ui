,[332,333,334],"p",{},"LLMs.txt 是專為大型語言模型（LLM）設計的文件格式。Shuo UI 的文件網站提供 LLMs.txt 檔案，整理元件庫的元件、props、工具函式與使用方式，讓 AI 工具能據此協助開發。",[327,336,337],{"id":337},"可用的路徑",[339,340,341,358],"ul",{},[342,343,344,357],"li",{},[345,346,347],"strong",{},[348,349,353],"a",{"href":350,"rel":351},"https:\u002F\u002Fk90325248.github.io\u002Fshuo-ui\u002Fllms.txt",[352],"nofollow",[354,355,356],"code",{},"\u002Fllms.txt","：所有頁面的索引，每頁附上標題、說明與 markdown 連結（約 4K tokens）",[342,359,360,369],{},[345,361,362],{},[348,363,366],{"href":364,"rel":365},"https:\u002F\u002Fk90325248.github.io\u002Fshuo-ui\u002Fllms-full.txt",[352],[354,367,368],{},"\u002Fllms-full.txt","：完整文件合併成單一檔案，包含元件範例、props、工具函式與版本紀錄（超過 10 萬 tokens）",[332,371,372],{},"兩個檔案都同時收錄繁體中文與英文的頁面。",[327,374,375],{"id":375},"選擇合適的檔案",[377,378,379,384,385,387],"note",{},[345,380,381,382],{},"大多數情況請先用 ",[354,383,356],{},"，它包含所有頁面的連結，一般的 context window 就放得下，AI 工具可以再依需要讀取個別頁面。只有在需要完整範例、且 AI 工具支援大型 context（200K tokens 以上）時才使用 ",[354,386,368],{},"。",[327,389,391],{"id":390},"單一頁面的-markdown-版本","單一頁面的 markdown 版本",[332,393,394,395,398],{},"每個頁面都有 markdown 版本，在網址後面加上 ",[354,396,397],{},".md"," 即可，例如：",[339,400,401,410],{},[342,402,403],{},[348,404,407],{"href":405,"rel":406},"https:\u002F\u002Fk90325248.github.io\u002Fshuo-ui\u002Fzh-tw\u002Fgetting-started\u002Foverview\u002Finstallation.md",[352],[354,408,409],{},"\u002Fzh-tw\u002Fgetting-started\u002Foverview\u002Finstallation.md",[342,411,412],{},[348,413,416],{"href":414,"rel":415},"https:\u002F\u002Fk90325248.github.io\u002Fshuo-ui\u002Fen\u002Fcomponents\u002Ftext\u002Finput-text.md",[352],[354,417,418],{},"\u002Fen\u002Fcomponents\u002Ftext\u002Finput-text.md",[332,420,421],{},"只需要某個元件的說明時，直接提供該頁的 markdown 比整份文件更省 tokens。",[327,423,424],{"id":424},"使用注意事項",[426,427,428,431,432,435,436,438],"warning",{},[345,429,430],{},"@ 符號必須手動輸入","：在 Cursor 或 Windsurf 的對話框中，",[354,433,434],{},"@"," 符號要親手輸入，貼上的 ",[354,437,434],{}," 不會被辨識為 context 引用。",[327,440,442],{"id":441},"搭配-ai-工具使用","搭配 AI 工具使用",[444,445,447],"h3",{"id":446},"cursor","Cursor",[332,449,450],{},"在 Cursor 中引用 LLMs.txt，讓 AI 更準確地協助撰寫 Shuo UI 表單。",[452,453,454],"h4",{"id":454},"使用方式",[456,457,458,464],"ol",{},[342,459,460,463],{},[345,461,462],{},"直接引用","：提問時附上 LLMs.txt 的網址",[342,465,466,467,470],{},"使用 ",[354,468,469],{},"@docs"," 將網址加入專案的 context",[332,472,473],{},[348,474,477,478,480],{"href":475,"rel":476},"https:\u002F\u002Fcursor.com\u002Fdocs\u002Fagent\u002Fprompting",[352],"進一步了解 Cursor 的提示與 ",[354,479,434],{}," 引用",[444,482,484],{"id":483},"windsurf","Windsurf",[332,486,487],{},"Windsurf 可以直接讀取 Shuo UI 的 LLMs.txt，了解元件用法與慣例。",[452,489,491],{"id":490},"在-windsurf-中使用","在 Windsurf 中使用",[339,493,494,499],{},[342,495,466,496,498],{},[354,497,469],{}," 引用 LLMs.txt 的網址",[342,500,501],{},"在 workspace 建立固定規則，引用這些網址",[332,503,504],{},[348,505,508],{"href":506,"rel":507},"https:\u002F\u002Fdocs.windsurf.com\u002Fwindsurf\u002Fcascade\u002Fweb-search",[352],"進一步了解 Windsurf 的網頁與文件搜尋",[444,510,512],{"id":511},"其他-ai-工具","其他 AI 工具",[332,514,515],{},"任何支援 LLMs.txt 的 AI 工具都可以透過這些路徑理解 Shuo UI。",[452,517,519],{"id":518},"chatgptclaude-等-llm-的提示範例","ChatGPT、Claude 等 LLM 的提示範例",[339,521,522,529],{},[342,523,524,525,528],{},"「請參考 Shuo UI 文件：",[348,526,350],{"href":350,"rel":527},[352],"」",[342,530,531,532,528],{},"「請依照 Shuo UI 完整文件撰寫：",[348,533,364],{"href":364,"rel":534},[352],[327,536,537],{"id":537},"網站地圖",[332,539,540,541,387],{},"所有頁面的清單見",[348,542,537],{"href":543,"rel":544},"https:\u002F\u002Fk90325248.github.io\u002Fshuo-ui\u002Fsitemap.md",[352],{"title":546,"searchDepth":547,"depth":547,"links":548},"",2,[549,550,551,552,553,554,560],{"id":329,"depth":547,"text":330},{"id":337,"depth":547,"text":337},{"id":375,"depth":547,"text":375},{"id":390,"depth":547,"text":391},{"id":424,"depth":547,"text":424},{"id":441,"depth":547,"text":442,"children":555},[556,558,559],{"id":446,"depth":557,"text":447},3,{"id":483,"depth":557,"text":484},{"id":511,"depth":557,"text":512},{"id":537,"depth":547,"text":537},"讓 Cu