03,411,416,427,455,462,500,503,521,524,540,549,553,557,560,568,571,580,588,592,603,606,624,628,631,658],[331,332,334],"h2",{"id":333},"什麼是-skills","什麼是 Skills？",[336,337,338],"p",{},"Skills 是結構化的知識檔案，提供 AI coding agent 關於函式庫、框架或程式碼庫的 context。agent 會直接把 skill 載入 context，在整段對話中隨時參考。",[336,340,341,342,346],{},"Shuo UI 提供一個",[343,344,345],"strong",{},"使用 skill","，教 AI agent 用 Shuo UI 撰寫表單與查詢頁面。",[331,348,349],{"id":349},"使用方式",[336,351,352],{},"使用 skill 讓 AI agent 完整了解如何以 Shuo UI 開發，涵蓋：",[354,355,356,360,363,379,382,385,391],"ul",{},[357,358,359],"li",{},"安裝與 CSS 設定",[357,361,362],{},"17 個元件的 v-model 型別、主要 props、slots 與常見陷阱",[357,364,365,366,370,371,374,375,378],{},"搭配 ",[367,368,369],"code",{},"UForm","、",[367,372,373],{},"UFormField"," 與 Valibot 的表單驗證，以及共用規則（",[367,376,377],{},"requiredText"," 等）",[357,380,381],{},"各元件的空值約定與初始 state 寫法",[357,383,384],{},"查詢條件卡片搭配結果清單的伺服器端分頁寫法",[357,386,387,390],{},[367,388,389],{},"shuoUi"," 模組選項：全站預設值、語系與文案、主題",[357,392,393],{},"日期、數字、電話、月數的顯示工具函式",[336,395,396,397,402],{},"skill 附有額外的 references，agent 依任務需要才讀取，回答更聚焦也更省 context。需要完整 props 表或更多範例時，skill 會引導 agent 讀取文件網站上對應頁面的 ",[398,399,401],"a",{"href":400},"\u002Fgetting-started\u002Fagents\u002Fllms-txt#%E5%96%AE%E4%B8%80%E9%A0%81%E9%9D%A2%E7%9A%84-markdown-%E7%89%88%E6%9C%AC","markdown 版本","。",[404,405,406,407,410],"note",{},"安裝後，在 agent 的對話框輸入 ",[367,408,409],{},"\u002Fshuo-ui"," 即可呼叫這個 skill。",[412,413,415],"h3",{"id":414},"skills-cli","Skills CLI",[336,417,418,426],{},[398,419,423],{"href":420,"rel":421},"https:\u002F\u002Fskills.sh",[422],"nofollow",[367,424,425],{},"skills"," CLI 是安裝 Shuo UI skill 最簡單的方式，支援 Cursor、Claude Code、Codex、Windsurf、Cline 等多種 agent。",[428,429,434],"pre",{"className":430,"code":431,"language":432,"meta":433,"style":433},"language-bash shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","npx skills add k90325248\u002Fshuo-ui\n","bash","",[367,435,436],{"__ignoreMap":433},[437,438,441,445,449,452],"span",{"class":439,"line":440},"line",1,[437,442,444],{"class":443},"sBMFI","npx",[437,446,448],{"class":447},"sfazB"," skills",[437,450,451],{"class":447}," add",[437,453,454],{"class":447}," k90325248\u002Fshuo-ui\n",[336,456,457,458,461],{},"用 ",[367,459,460],{},"--agent"," 指定 agent：",[428,463,465],{"className":430,"code":464,"language":432,"meta":433,"style":433},"npx skills add k90325248\u002Fshuo-ui --agent cursor\nnpx skills add k90325248\u002Fshuo-ui --agent claude-code\n",[367,466,467,484],{"__ignoreMap":433},[437,468,469,471,473,475,478,481],{"class":439,"line":440},[437,470,444],{"class":443},[437,472,448],{"class":447},[437,474,451],{"class":447},[437,476,477],{"class":447}," k90325248\u002Fshuo-ui",[437,479,480],{"class":447}," --agent",[437,482,483],{"class":447}," cursor\n",[437,485,487,489,491,493,495,497],{"class":439,"line":486},2,[437,488,444],{"class":443},[437,490,448],{"class":447},[437,492,451],{"class":447},[437,494,477],{"class":447},[437,496,480],{"class":447},[437,498,499],{"class":447}," claude-code\n",[336,501,502],{},"或安裝到全域，讓所有專案都能使用：",[428,504,506],{"className":430,"code":505,"language":432,"meta":433,"style":433},"npx skills add k90325248\u002Fshuo-ui --global\n",[367,507,508],{"__ignoreMap":433},[437,509,510,512,514,516,518],{"class":439,"line":440},[437,511,444],{"class":443},[437,513,448],{"class":447},[437,515,451],{"class":447},[437,517,477],{"class":447},[437,519,520],{"class":447}," --global\n",[336,522,523],{},"如果從 GitHub clone 的速度較慢，也可以直接從文件網站安裝：",[428,525,527],{"className":430,"code":526,"language":432,"meta":433,"style":433},"npx skills add https:\u002F\u002Fk90325248.github.io\u002Fshuo-ui\n",[367,528,529],{"__ignoreMap":433},[437,530,531,533,535,537],{"class":439,"line":440},[437,532,444],{"class":443},[437,534,448],{"class":447},[437,536,451],{"class":447},[437,538,539],{"class":447}," https:\u002F\u002Fk90325248.github.io\u002Fshuo-ui\n",[541,542,543,544,548],"tip",{},"前往 ",[398,545,547],{"href":420,"rel":546},[422],"skills.sh"," 了解 skills 生態系