2},"docs_zh_tw\u002Fzh-tw\u002F1.getting-started\u002F5.agents\u002F2.skills.md",{"type":332,"value":333,"toc":666},"minimark",[334,339,343,351,354,357,398,407,415,420,431,459,466,504,507,525,528,544,553,557,561,564,572,575,584,592,596,607,610,628,632,635,662],[335,336,338],"h2",{"id":337},"什麼是-skills","什麼是 Skills？",[340,341,342],"p",{},"Skills 是結構化的知識檔案，提供 AI coding agent 關於函式庫、框架或程式碼庫的 context。agent 會直接把 skill 載入 context，在整段對話中隨時參考。",[340,344,345,346,350],{},"Shuo UI 提供一個",[347,348,349],"strong",{},"使用 skill","，教 AI agent 用 Shuo UI 撰寫表單與查詢頁面。",[335,352,353],{"id":353},"使用方式",[340,355,356],{},"使用 skill 讓 AI agent 完整了解如何以 Shuo UI 開發，涵蓋：",[358,359,360,364,367,383,386,389,395],"ul",{},[361,362,363],"li",{},"安裝與 CSS 設定",[361,365,366],{},"17 個元件的 v-model 型別、主要 props、slots 與常見陷阱",[361,368,369,370,374,375,378,379,382],{},"搭配 ",[371,372,373],"code",{},"UForm","、",[371,376,377],{},"UFormField"," 與 Valibot 的表單驗證，以及共用規則（",[371,380,381],{},"requiredText"," 等）",[361,384,385],{},"各元件的空值約定與初始 state 寫法",[361,387,388],{},"查詢條件卡片搭配結果清單的伺服器端分頁寫法",[361,390,391,394],{},[371,392,393],{},"shuoUi"," 模組選項：全站預設值、語系與文案、主題",[361,396,397],{},"日期、數字、電話、月數的顯示工具函式",[340,399,400,401,406],{},"skill 附有額外的 references，agent 依任務需要才讀取，回答更聚焦也更省 context。需要完整 props 表或更多範例時，skill 會引導 agent 讀取文件網站上對應頁面的 ",[402,403,405],"a",{"href":404},"\u002Fgetting-started\u002Fagents\u002Fllms-txt#%E5%96%AE%E4%B8%80%E9%A0%81%E9%9D%A2%E7%9A%84-markdown-%E7%89%88%E6%9C%AC","markdown 版本","。",[408,409,410,411,414],"note",{},"安裝後，在 agent 的對話框輸入 ",[371,412,413],{},"\u002Fshuo-ui"," 即可呼叫這個 skill。",[416,417,419],"h3",{"id":418},"skills-cli","Skills CLI",[340,421,422,430],{},[402,423,427],{"href":424,"rel":425},"https:\u002F\u002Fskills.sh",[426],"nofollow",[371,428,429],{},"skills"," CLI 是安裝 Shuo UI skill 最簡單的方式，支援 Cursor、Claude Code、Codex、Windsurf、Cline 等多種 agent。",[432,433,438],"pre",{"className":434,"code":435,"language":436,"meta":437,"style":437},"language-bash shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","npx skills add k90325248\u002Fshuo-ui\n","bash","",[371,439,440],{"__ignoreMap":437},[441,442,445,449,453,456],"span",{"class":443,"line":444},"line",1,[441,446,448],{"class":447},"sBMFI","npx",[441,450,452],{"class":451},"sfazB"," skills",[441,454,455],{"class":451}," add",[441,457,458],{"class":451}," k90325248\u002Fshuo-ui\n",[340,460,461,462,465],{},"用 ",[371,463,464],{},"--agent"," 指定 agent：",[432,467,469],{"className":434,"code":468,"language":436,"meta":437,"style":437},"npx skills add k90325248\u002Fshuo-ui --agent cursor\nnpx skills add k90325248\u002Fshuo-ui --agent claude-code\n",[371,470,471,488],{"__ignoreMap":437},[441,472,473,475,477,479,482,485],{"class":443,"line":444},[441,474,448],{"class":447},[441,476,452],{"class":451},[441,478,455],{"class":451},[441,480,481],{"class":451}," k90325248\u002Fshuo-ui",[441,483,484],{"class":451}," --agent",[441,486,487],{"class":451}," cursor\n",[441,489,491,493,495,497,499,501],{"class":443,"line":490},2,[441,492,448],{"class":447},[441,494,452],{"class":451},[441,496,455],{"class":451},[441,498,481],{"class":451},[441,500,484],{"class":451},[441,502,503],{"class":451}," claude-code\n",[340,505,506],{},"或安裝到全域，讓所有專案都能使用：",[432,508,510],{"className":434,"code":509,"language":436,"meta":437,"style":437},"npx skills add k90325248\u002Fshuo-ui --global\n",[371,511,512],{"__ignoreMap":437},[441,513,514,516,518,520,522],{"class":443,"line":444},[441,515,448],{"class":447},[441,517,452],{"class":451},[441,519,455],{"class":451},[441,521,481],{"class":451},[441,523,524],{"class":451}," --global\n",[340,526,527],{},"如果從 GitHub clone 的速度較慢，也可以直接從文件網站安裝：",[432,529,531],{"className":434,"code":530,"language":436,"meta":437,"style":437},"npx skills add https:\u002F\u002Fk90325248.github.io\u002Fshuo-ui\n",[371,532,533],{"__ignoreMap":437},[441,534,535,537,539,541],{"class":443,"line":444},[441,536,448],{"class":447},[441,538,452],{"class":451},[441,540,455],{"class":451},[441,542,543],{"class":451}," http