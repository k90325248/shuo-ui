s？",[332,333,334],"p",{},"Skills 是結構化的知識檔案，提供 AI coding agent 關於函式庫、框架或程式碼庫的 context。agent 會直接把 skill 載入 context，在整段對話中隨時參考。",[332,336,337,338,342],{},"Shuo UI 提供一個",[339,340,341],"strong",{},"使用 skill","，教 AI agent 用 Shuo UI 撰寫表單與查詢頁面。",[327,344,345],{"id":345},"使用方式",[332,347,348],{},"使用 skill 讓 AI agent 完整了解如何以 Shuo UI 開發，涵蓋：",[350,351,352,356,359,375,378,381,387],"ul",{},[353,354,355],"li",{},"安裝與 CSS 設定",[353,357,358],{},"17 個元件的 v-model 型別、主要 props、slots 與常見陷阱",[353,360,361,362,366,367,370,371,374],{},"搭配 ",[363,364,365],"code",{},"UForm","、",[363,368,369],{},"UFormField"," 與 Valibot 的表單驗證，以及共用規則（",[363,372,373],{},"requiredText"," 等）",[353,376,377],{},"各元件的空值約定與初始 state 寫法",[353,379,380],{},"查詢條件卡片搭配結果清單的伺服器端分頁寫法",[353,382,383,386],{},[363,384,385],{},"shuoUi"," 模組選項：全站預設值、語系與文案、主題",[353,388,389],{},"日期、數字、電話、月數的顯示工具函式",[332,391,392,393,398],{},"skill 附有額外的 references，agent 依任務需要才讀取，回答更聚焦也更省 context。需要完整 props 表或更多範例時，skill 會引導 agent 讀取文件網站上對應頁面的 ",[394,395,397],"a",{"href":396},"\u002Fgetting-started\u002Fagents\u002Fllms-txt#%E5%96%AE%E4%B8%80%E9%A0%81%E9%9D%A2%E7%9A%84-markdown-%E7%89%88%E6%9C%AC","markdown 版本","。",[400,401,402,403,406],"note",{},"安裝後，在 agent 的對話框輸入 ",[363,404,405],{},"\u002Fshuo-ui"," 即可呼叫這個 skill。",[408,409,411],"h3",{"id":410},"skills-cli","Skills CLI",[332,413,414,422],{},[394,415,419],{"href":416,"rel":417},"https:\u002F\u002Fskills.sh",[418],"nofollow",[363,420,421],{},"skills"," CLI 是安裝 Shuo UI skill 最簡單的方式，支援 Cursor、Claude Code、Codex、Windsurf、Cline 等多種 agent。",[424,425,430],"pre",{"className":426,"code":427,"language":428,"meta":429,"style":429},"language-bash shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","npx skills add k90325248\u002Fshuo-ui\n","bash","",[363,431,432],{"__ignoreMap":429},[433,434,437,441,445,448],"span",{"class":435,"line":436},"line",1,[433,438,440],{"class":439},"sBMFI","npx",[433,442,444],{"class":443},"sfazB"," skills",[433,446,447],{"class":443}," add",[433,449,450],{"class":443}," k90325248\u002Fshuo-ui\n",[332,452,453,454,457],{},"用 ",[363,455,456],{},"--agent"," 指定 agent：",[424,459,461],{"className":426,"code":460,"language":428,"meta":429,"style":429},"npx skills add k90325248\u002Fshuo-ui --agent cursor\nnpx skills add k90325248\u002Fshuo-ui --agent claude-code\n",[363,462,463,480],{"__ignoreMap":429},[433,464,465,467,469,471,474,477],{"class":435,"line":436},[433,466,440],{"class":439},[433,468,444],{"class":443},[433,470,447],{"class":443},[433,472,473],{"class":443}," k90325248\u002Fshuo-ui",[433,475,476],{"class":443}," --agent",[433,478,479],{"class":443}," cursor\n",[433,481,483,485,487,489,491,493],{"class":435,"line":482},2,[433,484,440],{"class":439},[433,486,444],{"class":443},[433,488,447],{"class":443},[433,490,473],{"class":443},[433,492,476],{"class":443},[433,494,495],{"class":443}," claude-code\n",[332,497,498],{},"或安裝到全域，讓所有專案都能使用：",[424,500,502],{"className":426,"code":501,"language":428,"meta":429,"style":429},"npx skills add k90325248\u002Fshuo-ui --global\n",[363,503,504],{"__ignoreMap":429},[433,505,506,508,510,512,514],{"class":435,"line":436},[433,507,440],{"class":439},[433,509,444],{"class":443},[433,511,447],{"class":443},[433,513,473],{"class":443},[433,515,516],{"class":443}," --global\n",[332,518,519],{},"如果從 GitHub clone 的速度較慢，也可以直接從文件網站安裝：",[424,521,523],{"className":426,"code":522,"language":428,"meta":429,"style":429},"npx skills add https:\u002F\u002Fk90325248.github.io\u002Fshuo-ui\n",[363,524,525],{"__ignoreMap":429},[433,526,527,529,531,533],{"class":435,"line":436},[433,528,440],{"class":439},[433,530,444],{"class":443},[433,532,447],{"class":443},[433,534,535],{"class":443}," https:\u002F\u002Fk90325248.github.io\u002Fshuo-ui\n",[537,538,539,540,544],"tip",{},"前往 ",[394,541,543],{"href":416,"rel":542},[418],"skills.sh"," 了解 skills 生態系並瀏覽其他 skill。",[408,546,548],{"id":547},"cursor","Cursor",[550,551,552],"h4",{"id":552},"快速安裝",[332,554,555],{},"點擊下方按鈕，直接在 Cursor 安裝 Shuo UI skill：",[557,558