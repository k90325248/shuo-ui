s_zh_tw\u002Fzh-tw\u002F5.releases\u002F1.versions\u002F1.v3-3-1.md",{"type":332,"value":333,"toc":492},"minimark",[334,338,343,359,363,386,389,428,443,447,488],[335,336,337],"p",{},"修正 Nuxt UI 的 toast 卡住的問題：在特定操作後跳出的新 toast 沒有進度條，也不會自動關閉。從 3.3.0 升級不需要修改程式碼。",[339,340,342],"h2",{"id":341},"bug-fixes","🐛 Bug Fixes",[344,345,346],"ul",{},[347,348,349,353,354,358],"li",{},[350,351,352],"strong",{},"新 toast 沒有進度條、不會自動關閉："," 這是 reka-ui 2.11.0（目前最新版）的 bug。滑鼠停在 toast 上時，關掉最後一個 toast（呼叫 ",[355,356,357],"code",{},"toast.remove()","、點 action、滑動關閉，或在點按鈕不會取得焦點的瀏覽器上點 X），toast 的暫停狀態不會解除，下一個 toast 就不會計時。Shuo UI 現在會在新 toast 出現、而且此刻不該暫停（視窗聚焦、滑鼠與焦點都不在 toast 上）時，讓 reka-ui 恢復計時。滑鼠停在 toast 上、視窗失焦時仍會照常暫停。",[339,360,362],{"id":361},"新選項","✨ 新選項",[344,364,365],{},[347,366,367,377,378,381,382],{},[350,368,369,372,373,376],{},[355,370,371],{},"shuoUi.toastPauseFix","（預設 ",[355,374,375],{},"true","）："," 上述修正的開關，設為 ",[355,379,380],{},"false"," 可停用。reka-ui 修好後，修正與這個選項會一併移除：",[383,384,52],"a",{"href":385},"\u002Fgetting-started\u002Ftheme\u002Fmodule-options",[339,387,388],{"id":22},"📦 安裝",[390,391,396],"pre",{"className":392,"code":393,"language":394,"meta":395,"style":395},"language-bash shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","pnpm add github:k90325248\u002Fshuo-ui#v3.3.1\npnpm add @iconify-json\u002Flucide # 建議，圖示會直接打包\n","bash","",[355,397,398,414],{"__ignoreMap":395},[399,400,403,407,411],"span",{"class":401,"line":402},"line",1,[399,404,406],{"class":405},"sBMFI","pnpm",[399,408,410],{"class":409},"sfazB"," add",[399,412,413],{"class":409}," github:k90325248\u002Fshuo-ui#v3.3.1\n",[399,415,417,419,421,424],{"class":401,"line":416},2,[399,418,406],{"class":405},[399,420,410],{"class":409},[399,422,423],{"class":409}," @iconify-json\u002Flucide",[399,425,427],{"class":426},"sHwdD"," # 建議，圖示會直接打包\n",[335,429,430,431,434,435,438,439,442],{},"在 ",[355,432,433],{},"nuxt.config.ts"," 啟用模組，並在 CSS 加上 ",[355,436,437],{},"@import '@shuo\u002Fui\u002Fcss';",