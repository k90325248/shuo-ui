\n",[331,599,600,601,545,603,605],{},"文字必填。拒絕 ",[335,602,544],{},[335,604,548],{},"、空字串、純空白與非字串值，保留原始文字（不去除前後空白）。適用文字輸入、多行文字、下拉選單與單選群組的字串值、日期字串。",[607,608,609],"field-group",{},[610,611,613],"field",{":required":612,"name":524,"type":501},"true","欄位名稱，用於錯誤訊息。",[582,615,617],{"id":616},"requirednumber","requiredNumber",[340,619,621],{"className":342,"code":620,"language":344,"meta":345,"style":345},"requiredNumber(label: string)\n",[335,622,623],{"__ignoreMap":345},[349,624,625,627],{"class":351,"line":352},[349,626,617],{"class":412},[349,628,597],{"class":366},[331,630,631,632,635,636,639],{},"數字必填。接受 ",[335,633,634],{},"0","、負數與小數；空值與字串顯示「為必填」，",[335,637,638],{},"NaN"," 與無限大顯示「必須是有效數字」。",[607,641,642],{},[610,643,613],{":required":612,"name":524,"type":501},[582,645,647],{"id":646},"requiredarray","requiredArray",[340,649,651],{"className":342,"code":650,"language":344,"meta":345,"style":345},"requiredArray(label: string, itemSchema: GenericSchema)\n",[335,652,653],{"__ignoreMap":345},[349,654,655,657,660,662],{"class":351,"line":352},[349,656,647],{"class":412},[349,658,659],{"class":366},"(label: string",[349,661,494],{"class":359},[349,663,664],{"class":366}," itemSchema: GenericSchema)\n",[331,666,667,668,670,671,673],{},"陣列必填，至少一項。空陣列、",[335,669,544],{}," 與 ",[335,672,548],{}," 不通過。適用複選群組與多選下拉選單。",[607,675,676,678],{},[610,677,613],{":required":612,"name":524,"type":501},[610,679,682,683,686],{":required":612,"name":680,"type":681},"itemSchema","GenericSchema","每個項目的 schema，例如 ",[335,684,685],{},"v.string()","；選項的合法值由頁面自行組合，不寫死在共用規則。",[582,688,690],{"id":689},"optionalemail","optionalEmail",[340,692,694],{"className":342,"code":693,"language":344,"meta":345,"style":345},"optionalEmail(label: string)\n",[335,695,696],{"__ignoreMap":345},[349,697,698,700],{"class":351,"line":352},[349,699,690],{"class":412},[349,701,597],{"class":366},[331,703,704,705,707,708,538],{},"選填電子信箱。空字串通過；有值時須符合 email 格式，否則顯示「格式錯誤」。必填的信箱改用 ",[335,706,585],{}," 串接 ",[335,709,710],{},"v.