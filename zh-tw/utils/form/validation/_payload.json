,593],"h3",{"id":592},"requiredtext","requiredText",[348,595,597],{"className":350,"code":596,"language":352,"meta":353,"style":353},"requiredText(label: string)\n",[343,598,599],{"__ignoreMap":353},[357,600,601,603],{"class":359,"line":360},[357,602,593],{"class":420},[357,604,605],{"class":374},"(label: string)\n",[339,607,608,609,553,611,613],{},"文字必填。拒絕 ",[343,610,552],{},[343,612,556],{},"、空字串、純空白與非字串值，保留原始文字（不去除前後空白）。適用文字輸入、多行文字、下拉選單與單選群組的字串值、日期字串。",[615,616,617],"field-group",{},[618,619,621],"field",{":required":620,"name":532,"type":509},"true","欄位名稱，用於錯誤訊息。",[590,623,625],{"id":624},"requirednumber","requiredNumber",[348,627,629],{"className":350,"code":628,"language":352,"meta":353,"style":353},"requiredNumber(label: string)\n",[343,630,631],{"__ignoreMap":353},[357,632,633,635],{"class":359,"line":360},[357,634,625],{"class":420},[357,636,605],{"class":374},[339,638,639,640,643,644,647],{},"數字必填。接受 ",[343,641,642],{},"0","、負數與小數；空值與字串顯示「為必填」，",[343,645,646],{},"NaN"," 與無限大顯示「必須是有效數字」。",[615,649,650],{},[618,651,621],{":required":620,"name":532,"type":509},[590,653,655],{"id":654},"requiredarray","requiredArray",[348,657,659],{"className":350,"code":658,"language":352,"meta":353,"style":353},"requiredArray(label: string, itemSchema: GenericSchema)\n",[343,660,661],{"__ignoreMap":353},[357,662,663,665,668,670],{"class":359,"line":360},[357,664,655],{"class":420},[357,666,667],{"class":374},"(label: string",[357,669,502],{"class":367},[357,671,672],{"class":374}," itemSchema: GenericSchema)\n",[339,674,675,676,678,679,681],{},"陣列必填，至少一項。空陣列、",[343,677,552],{}," 與 ",[343,680,556],{}," 不通過。適用複選群組與多選下拉選單。",[615,683,684,686],{},[618,685,621],{":required":620,"name":532,"type":509},[618,687,690,691,694],{":required":620,"name":688,"type":689},"itemSchema","GenericSchema","每個項目的 schema，例如 ",[343,692,693],{},"v.string()","；選項的合法值由頁面自行組合，不寫死在共用規則。",[590,696,698],{"id":697},"optionalemail","optionalEmail",[348,700,702],{"className":350,"code":701,"language":352,"met