ing)\n",[339,594,595],{"__ignoreMap":349},[353,596,597,599],{"class":355,"line":356},[353,598,589],{"class":416},[353,600,601],{"class":370},"(label: string)\n",[335,603,604,605,549,607,609],{},"文字必填。拒絕 ",[339,606,548],{},[339,608,552],{},"、空字串、純空白與非字串值，保留原始文字（不去除前後空白）。適用文字輸入、多行文字、下拉選單與單選群組的字串值、日期字串。",[611,612,613],"field-group",{},[614,615,617],"field",{":required":616,"name":528,"type":505},"true","欄位名稱，用於錯誤訊息。",[586,619,621],{"id":620},"requirednumber","requiredNumber",[344,623,625],{"className":346,"code":624,"language":348,"meta":349,"style":349},"requiredNumber(label: string)\n",[339,626,627],{"__ignoreMap":349},[353,628,629,631],{"class":355,"line":356},[353,630,621],{"class":416},[353,632,601],{"class":370},[335,634,635,636,639,640,643],{},"數字必填。接受 ",[339,637,638],{},"0","、負數與小數；空值與字串顯示「為必填」，",[339,641,642],{},"NaN"," 與無限大顯示「必須是有效數字」。",[611,645,646],{},[614,647,617],{":required":616,"name":528,"type":505},[586,649,651],{"id":650},"requiredarray","requiredArray",[344,653,655],{"className":346,"code":654,"language":348,"meta":349,"style":349},"requiredArray(label: string, itemSchema: GenericSchema)\n",[339,656,657],{"__ignoreMap":349},[353,658,659,661,664,666],{"class":355,"line":356},[353,660,651],{"class":416},[353,662,663],{"class":370},"(label: string",[353,665,498],{"class":363},[353,667,668],{"class":370}," itemSchema: GenericSchema)\n",[335,670,671,672,674,675,677],{},"陣列必填，至少一項。空陣列、",[339,673,548],{}," 與 ",[339,676,552],{}," 不通過。適用複選群組與多選下拉選單。",[611,679,680,682],{},[614,681,617],{":required":616,"name":528,"type":505},[614,683,686,687,690],{":required":616,"name":684,"type":685},"itemSchema","GenericSchema","每個項目的 schema，例如 ",[339,688,689],{},"v.string()","；選項的合法值由頁面自行組合，不寫死在共用規則。",[586,692,694],{"id":693},"optionalemail","optionalEmail",[344,696,698],{"className":346,"code":697,"language":348,"meta":349,"style":349},"optionalEmail(label: string)\n",[339,699,700],{"__ignoreMap":349},[353,701,702,704],{"class":355,"line":356},[353,703,694],{"class":416}